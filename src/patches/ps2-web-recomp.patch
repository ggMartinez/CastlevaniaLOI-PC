+++ b/runtime/src/gs/native/convert.hpp
@@ -0,0 +1,59 @@
+#pragma once
+
+#include "../gs.hpp"
+
+#include <cstdint>
+#include <vector>
+
+// The native renderer's view of a GS primitive: its draw state (what picks a GPU pipeline), its target (the
+// frame and depth buffers it draws into) and its vertices in GPU form. Pure: no GPU, no globals.
+namespace ps2::gs::native {
+
+// Everything about a primitive's state that changes how pixels come out, normalised so that equal keys draw
+// alike: an alpha test that always fails becomes what its fail mode writes.
+struct DrawKey {
+    std::uint8_t topology = 2;  // 0 points, 1 lines, 2 triangles
+    bool textured = false, fog = false, gouraud = false, stq = false;
+    std::uint8_t tfx = 0, tcc = 0;               // TEX0: modulate, decal, highlight, highlight2; RGB or RGBA
+    bool blend = false;
+    std::uint8_t blend_a = 0, blend_b = 0, blend_c = 0, blend_d = 0;  // (A-B)*C+D: 0 Cs/As, 1 Cd/Ad, 2 zero/FIX
+    std::uint8_t blend_fix = 0;
+    std::uint8_t alpha_test = 1, alpha_ref = 0, alpha_fail = 0;  // ATST (1: always, no test), AREF, AFAIL
+    bool depth_test = false, depth_write = true;
+    std::uint8_t depth_func = 1;                 // ZTST: 0 never, 1 always, 2 >=, 3 >
+    std::uint32_t colour_mask = 0;               // FBMSK: 1 bits are not written
+    bool colour_wrap = false;                    // COLCLAMP off: colours wrap instead of clamping
+    std::uint8_t wrap_s = 0, wrap_t = 0;         // CLAMP WMS, WMT
+    bool linear_mag = false;                     // TEX1 MMAG
+    bool fba = false;                            // FBA: the stored alpha gets its top bit (not the blending)
+    bool operator==(const DrawKey &) const = default;
+};
+
+// A vertex for the GPU: x, y in PS2 pixels (XYOFFSET taken off), z in 0..1 of the depth format's range;
+// s, t, q as the GS has them (STQ), or texels and q 1 (UV); colour as the GS's bytes (128 is 1.0); fog 0..1.
+struct GpuVertex {
+    float x, y, z;
+    float s, t, q;
+    std::uint8_t rgba[4];
+    float fog;
+};
+
+// The buffers a primitive draws into, with addresses in 256-byte blocks (TBP's unit).
+struct Target {
+    std::uint32_t fbp, fbw, psm, zbp, zpsm;
+    bool operator==(const Target &) const = default;
+};
+
+DrawKey key_of(const State &s, int ctx);
+Target target_of(const State &s, int ctx);
+// A shadow volume face (red only into a 16-bit target, Cs*FIX+Cd with FIX 128, colours wrapping): +1 or -1,
+// the 5-bit step its red adds; 0 for any other draw.
+int shadow_step(const State &s, int ctx, const Vertex &last);
+// One primitive as gs.cpp hands it (1, 2 or 3 vertices): a sprite becomes two triangles.
+void convert(const State &s, int ctx, const Vertex *v, int count, std::vector<GpuVertex> &out);
+// The same from what convert reads of the state: the primitive's attributes (PRIM, or PRMODE as PRMODECONT
+// says), and its context's XYOFFSET and ZBUF.
+std::uint64_t attributes_of(const State &s);
+void convert(std::uint64_t attributes, std::uint64_t xyoffset, std::uint64_t zbuf, const Vertex *v, int count, std::vector<GpuVertex> &out);
+
+}
