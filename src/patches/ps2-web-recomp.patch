diff --git a/tests/graphics_settings_test.cpp b/tests/graphics_settings_test.cpp
new file mode 100644
index 0000000..7f97d82
--- /dev/null
+++ b/tests/graphics_settings_test.cpp
@@ -0,0 +1,143 @@
+// Tests the graphics settings file (settings.ini) shared by the launcher and the game: run the built
+// graphics_settings_test; it exits 0 when every check passes and prints the first failure otherwise.
+#include "ps2/graphics.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <filesystem>
+#include <fstream>
+#include <sstream>
+#include <string>
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+std::string temp_file(const char *name, const std::string &text) {
+    const std::string path = (std::filesystem::temp_directory_path() / name).string();
+    std::ofstream(path, std::ios::binary) << text;
+    return path;
+}
+
+std::string read(const std::string &path) {
+    std::ifstream in(path, std::ios::binary);
+    std::stringstream s;
+    s << in.rdbuf();
+    return s.str();
+}
+
+void round_trip() {
+    ps2::Graphics g;
+    g.api = ps2::Api::vulkan;
+    g.scale = 5;
+    g.vsync = false;
+    g.widescreen = g.fullscreen = g.fxaa = g.fsr = g.sharpen = g.bloom = g.deband = g.crt = g.crt_curvature = g.vignette = g.grain = true;
+    g.sharpen_strength = 0.25f;
+    g.bloom_strength = 0.75f;
+    g.crt_scanlines = 0.8f;
+    g.vignette_strength = 0.1f;
+    g.grain_strength = 0.9f;
+    g.brightness = -0.2f;
+    g.contrast = 1.3f;
+    g.saturation = 0.4f;
+    g.gamma = 1.8f;
+    g.third_person = g.camera_invert_x = g.camera_invert_y = true;
+    g.camera_distance = 1250.0f;
+    g.camera_speed = 2.5f;
+    g.native_renderer = true;
+    g.resolution = 1080;
+    g.frame_rate = 144;
+    const std::string path = temp_file("graphics_round_trip.ini", "");
+    ps2::save_graphics(path, g);
+    const ps2::Graphics l = ps2::load_graphics(path);
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-4f; };
+    check(l.api == ps2::Api::vulkan && l.scale == 5 && !l.vsync, "round_trip: api, scale, vsync");
+    check(l.widescreen && l.fullscreen && l.fxaa && l.fsr && l.sharpen && l.bloom && l.deband && l.crt && l.crt_curvature && l.vignette && l.grain,
+          "round_trip: switches");
+    check(near(l.sharpen_strength, 0.25f) && near(l.bloom_strength, 0.75f) && near(l.crt_scanlines, 0.8f) && near(l.vignette_strength, 0.1f) &&
+              near(l.grain_strength, 0.9f),
+          "round_trip: strengths");
+    check(near(l.brightness, -0.2f) && near(l.contrast, 1.3f) && near(l.saturation, 0.4f) && near(l.gamma, 1.8f), "round_trip: colour");
+    check(l.third_person && l.camera_invert_x && l.camera_invert_y && near(l.camera_distance, 1250.0f) && near(l.camera_speed, 2.5f), "round_trip: camera");
+    check(l.native_renderer, "round_trip: the native renderer");
+    check(l.resolution == 1080, "round_trip: a direct resolution");
+    check(l.frame_rate == 144, "round_trip: a frame rate of 144");
+}
+
+void old_file() {
+    const std::string path = temp_file("graphics_old.ini", "iso=x\nfullscreen=1\nwidescreen=0\nscale=3\n");
+    const ps2::Graphics l = ps2::load_graphics(path);
+    const ps2::Graphics d;
+    check(l.fullscreen && !l.widescreen && l.scale == 3, "old_file: existing keys");
+    check(l.api == d.api && l.vsync == d.vsync && l.fxaa == d.fxaa && l.bloom == d.bloom && l.gamma == d.gamma, "old_file: new keys at defaults");
+    check(!l.third_person && l.camera_distance == d.camera_distance && l.camera_speed == d.camera_speed, "old_file: the original camera by default");
+    check(!l.native_renderer, "old_file: the accurate renderer by default");
+    check(l.resolution == 0, "old_file: the multiple, no direct resolution");
+    check(l.frame_rate == 60, "old_file: the original 60 fps");
+    ps2::save_graphics(path, l);
+    check(read(path).find("iso=x\n") != std::string::npos, "old_file: save keeps iso");
+    check(read(path).find("bloom_strength=") != std::string::npos, "old_file: save writes every key");
+}
+
+void clamps() {
+    check(ps2::load_graphics(temp_file("graphics_c1.ini", "scale=9\n")).scale == 6, "clamps: scale 9 -> 6");
+    check(ps2::load_graphics(temp_file("graphics_c2.ini", "scale=0\n")).scale == 1, "clamps: scale 0 -> 1");
+    check(ps2::load_graphics(temp_file("graphics_c3.ini", "bloom_strength=7\n")).bloom_strength == 1.0f, "clamps: bloom_strength 7 -> 1");
+    check(ps2::load_graphics(temp_file("graphics_c4.ini", "gamma=9\n")).gamma == 2.0f, "clamps: gamma 9 -> 2");
+    check(ps2::load_graphics(temp_file("graphics_c5.ini", "api=metal\n")).api == ps2::Api::vulkan, "clamps: api metal -> vulkan (the default)");
+    check(ps2::load_graphics(temp_file("graphics_c6.ini", "api=d3d12\n")).api == ps2::Api::d3d12, "clamps: api d3d12 kept");
+    check(ps2::load_graphics(temp_file("graphics_c7.ini", "camera_distance=50\n")).camera_distance == 400.0f, "clamps: camera_distance 50 -> 400");
+    check(ps2::load_graphics(temp_file("graphics_c8.ini", "camera_speed=9\n")).camera_speed == 3.0f, "clamps: camera_speed 9 -> 3");
+    check(ps2::Graphics{}.api == ps2::Api::vulkan, "defaults: Vulkan");
+    check(!ps2::load_graphics(temp_file("graphics_c9.ini", "renderer=other\n")).native_renderer, "clamps: renderer other -> accurate");
+    check(ps2::load_graphics(temp_file("graphics_c10.ini", "resolution=1000\n")).resolution == 0, "clamps: resolution 1000 (not offered) -> the multiple");
+    check(ps2::load_graphics(temp_file("graphics_c11.ini", "frame_rate=display\n")).frame_rate == 60, "clamps: frame_rate display -> 60");
+    check(ps2::load_graphics(temp_file("graphics_c12.ini", "frame_rate=30\n")).frame_rate == 60, "clamps: frame_rate 30 -> 60");
+}
+
+void resolutions() {
+    const auto near = [](float a, float b) { return std::fabs(a - b) < 1e-3f; };
+    ps2::Graphics g;
+    g.scale = 2;
+    check(ps2::whole_scale(g) == 2, "resolutions: no direct one, the multiple");
+    float across = 0, down = 0;
+    ps2::native_scale(g, across, down);
+    check(across == 2.0f && down == 2.0f, "resolutions: native at the multiple");
+    const int lines[] = {720, 1080, 1440, 2160}, whole[] = {2, 3, 4, 5};
+    for (int i = 0; i < 4; ++i) {
+        g.resolution = lines[i];
+        check(ps2::whole_scale(g) == whole[i], "resolutions: the accurate renderer at the smallest multiple reaching it");
+    }
+    g.resolution = 1080;
+    ps2::native_scale(g, across, down);
+    check(near(across * 512.0f, 1440.0f) && near(down * 448.0f, 1080.0f), "resolutions: 1080p at 4:3 is 1440 x 1080");
+    g.widescreen = true;
+    ps2::native_scale(g, across, down);
+    check(near(across * 512.0f, 1920.0f) && near(down * 448.0f, 1080.0f), "resolutions: 1080p at 16:9 is 1920 x 1080");
+    check(std::string(ps2::resolution_label(1080)) == "1080p", "resolutions: label 1080p");
+    check(std::string(ps2::resolution_label(2160)) == "2160p (4K)", "resolutions: label 4K");
+}
+
+void labels() {
+    check(std::string(ps2::scale_label(1)) == "1x (~480p)", "labels: 1x");
+    check(std::string(ps2::scale_label(5)) == "5x (~2160p, 4K)", "labels: 5x");
+    check(std::string(ps2::scale_label(6)) == "6x (~2880p, 5K)", "labels: 6x");
+}
+
+}
+
+int main() {
+    round_trip();
+    old_file();
+    clamps();
+    labels();
+    resolutions();
+    if (!g_failures) std::printf("graphics settings: all checks passed\n");
+    return g_failures ? 1 : 0;
+}
