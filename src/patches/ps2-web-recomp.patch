diff --git a/runtime/src/gs/native/convert.cpp b/runtime/src/gs/native/convert.cpp
new file mode 100644
index 0000000..c7fb93e
--- /dev/null
+++ b/runtime/src/gs/native/convert.cpp
@@ -0,0 +1,133 @@
+#include "convert.hpp"
+
+#include <algorithm>
+
+namespace ps2::gs::native {
+
+namespace {
+
+std::uint32_t bits(std::uint64_t v, int lo, int n) { return static_cast<std::uint32_t>((v >> lo) & ((1ull << n) - 1)); }
+
+// The primitive's attributes (shading, texture, fog, blend, UV, context): from PRIM, or from PRMODE when
+// PRMODECONT says so; the primitive type is always PRIM's.
+std::uint64_t attributes(const State &s) { return (s.prmodecont & 1u) ? s.prim : ((s.prim & 7u) | (s.prmode & ~7ull)); }
+
+double depth_range(std::uint32_t zpsm) {
+    switch (zpsm) {
+    case 0x30: return 4294967295.0;
+    case 0x31: return 16777215.0;
+    default: return 65535.0;
+    }
+}
+
+}  // namespace
+
+DrawKey key_of(const State &s, int ctx) {
+    const Context &c = s.ctx[ctx & 1];
+    const std::uint64_t a = attributes(s);
+    DrawKey k;
+    const std::uint32_t type = bits(a, 0, 3);
+    k.topology = type == 0 ? 0 : (type == 1 || type == 2) ? 1 : 2;
+    k.gouraud = bits(a, 3, 1);
+    k.textured = bits(a, 4, 1);
+    k.fog = bits(a, 5, 1);
+    k.blend = bits(a, 6, 1);
+    k.stq = !bits(a, 8, 1);
+    if (k.textured) {
+        k.tcc = static_cast<std::uint8_t>(bits(c.tex0, 34, 1));
+        k.tfx = static_cast<std::uint8_t>(bits(c.tex0, 35, 2));
+        k.wrap_s = static_cast<std::uint8_t>(bits(c.clamp, 0, 2));
+        k.wrap_t = static_cast<std::uint8_t>(bits(c.clamp, 2, 2));
+        k.linear_mag = bits(c.tex1, 5, 1);
+    } else {
+        k.stq = false;
+    }
+    if (k.blend) {
+        k.blend_a = static_cast<std::uint8_t>(bits(c.alpha, 0, 2));
+        k.blend_b = static_cast<std::uint8_t>(bits(c.alpha, 2, 2));
+        k.blend_c = static_cast<std::uint8_t>(bits(c.alpha, 4, 2));
+        k.blend_d = static_cast<std::uint8_t>(bits(c.alpha, 6, 2));
+        k.blend_fix = static_cast<std::uint8_t>(bits(c.alpha, 32, 8));
+    }
+    k.colour_mask = bits(c.frame, 32, 32);
+    k.colour_wrap = !(s.colclamp & 1u);
+    k.fba = c.fba & 1u;
+    k.depth_test = bits(c.test, 16, 1);
+    k.depth_func = static_cast<std::uint8_t>(bits(c.test, 17, 2));
+    k.depth_write = !bits(c.zbuf, 32, 1);
+    if (bits(c.test, 0, 1)) {
+        const std::uint32_t atst = bits(c.test, 1, 3), afail = bits(c.test, 12, 2);
+        if (atst == 0) {
+            // Every pixel fails: what is written is its fail mode's.
+            switch (afail) {
+            case 0: k.colour_mask = 0xFFFFFFFFu, k.depth_write = false; break;  // keep: nothing
+            case 1: k.depth_write = false; break;                               // frame buffer only
+            case 2: k.colour_mask = 0xFFFFFFFFu; break;                         // depth only
+            default: k.colour_mask |= 0xFF000000u, k.depth_write = false; break;  // RGB only
+            }
+        } else if (atst != 1) {
+            k.alpha_test = static_cast<std::uint8_t>(atst);
+            k.alpha_ref = static_cast<std::uint8_t>(bits(c.test, 4, 8));
