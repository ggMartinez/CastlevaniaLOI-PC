+            const Span &s = *std::prev(it);
+            const std::uint64_t in_file = at - static_cast<std::uint64_t>(s.sector) * kSector;
+            chunk = static_cast<std::size_t>(std::min<std::uint64_t>(bytes - done, static_cast<std::uint64_t>(s.sector + s.sectors) * kSector - at));
+            std::size_t got = 0;
+            if (in_file < s.size) {
+#if defined(_WIN32)
