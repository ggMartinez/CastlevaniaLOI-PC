+#endif
+                got = std::fread(dst + done, 1, static_cast<std::size_t>(std::min<std::uint64_t>(chunk, s.size - in_file)), s.file);
+            }
+            std::memset(dst + done + got, 0, chunk - got);
+        } else {
+            const std::uint64_t next = it == g_spans.end() ? ~0ull : static_cast<std::uint64_t>(it->sector) * kSector;
+            chunk = static_cast<std::size_t>(std::min<std::uint64_t>(bytes - done, next - at));
+            std::memset(dst + done, 0, chunk);
+            if (!g_warned_unmapped) {
+                g_warned_unmapped = true;
+                std::fprintf(stderr, "[disc] read of sector %u, which holds no file (the disc's own tables?): zeros (shown once)\n", sector);
+            }
+        }
+        done += chunk;
+    }
+    return bytes;
