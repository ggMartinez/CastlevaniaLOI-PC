new file mode 100644
index 0000000..6b586b7
--- /dev/null
+++ b/host/game_entry.cpp
@@ -0,0 +1,13 @@
+// Compiled into game.dll together with the generated code: the one entry point the runner
+// looks up after loading the DLL. Everything else the game code needs it imports from the runner.
+void register_generated_code();
+void register_generated_vu();
+void register_generated_vu0();
+void register_generated_iop();
+
+extern "C" __declspec(dllexport) void ps2_register_game() {
+    register_generated_code();
+    register_generated_vu();
+    register_generated_vu0();
+    register_generated_iop();
+}
