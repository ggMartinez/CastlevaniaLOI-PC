@@ -0,0 +1,31 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// Textures and palettes out of GS memory, for the native renderer: decoded once into RGBA8 (red in the low
+// byte, alpha as the GS's byte, where 0x80 is opaque), the palette already applied. Pure: no GPU.
+namespace ps2::gs::native {
+
+// What a decoded texture depends on: where and how it is stored, its data, and the palette it was decoded with.
+struct TexKey {
+    std::uint32_t tbp, tbw, psm, tw, th;
+    std::uint64_t palette_hash;
+    std::uint64_t data_hash;  // the GS memory it was decoded from
+    bool operator==(const TexKey &) const = default;
+};
+
+// The palette a texture uses, read from GS memory (CBP, CPSM: 32- or 16-bit, CSM1 layout) as the GS loads it,
+// into the palette buffer's index space: an 8-bit palette fills entries 0..255, a 4-bit one entries
+// CSA*16..CSA*16+15 (the others are left as they are).
+void decode_palette(const std::uint8_t *mem, std::uint64_t tex0, std::uint64_t texa, std::uint32_t out[256]);
+
+// The texture TEX0 describes (TW x TH texels): 32/24/16-bit formats (alpha from TEXA for 24 and 16 bits),
+// 8- and 4-bit ones through palette (4-bit at CSA*16 + index). palette may be null for the direct formats.
+void decode(const std::uint8_t *mem, std::uint64_t tex0, std::uint64_t texa, const std::uint32_t *palette, std::vector<std::uint32_t> &rgba);
+// decode in two steps, so a palette change re-colours without reading GS memory again: the stored values
+// (colours, or palette indices) row by row, then those as RGBA8.
+void read_raw(const std::uint8_t *mem, std::uint64_t tex0, std::vector<std::uint32_t> &raw);
+void to_rgba(std::uint64_t tex0, std::uint64_t texa, const std::uint32_t *palette, const std::vector<std::uint32_t> &raw, std::vector<std::uint32_t> &rgba);
+
+}
