+    // presented, from game frame <frame> on, as <dir>/present_<n>.ppm.
+    static const char *const many = std::getenv("PS2_CAPTURE_PRESENTS");
+    static unsigned long long many_from = 0, many_count = 0, many_done = 0;
+    static std::string many_dir;
+    if (many && many_dir.empty()) {
