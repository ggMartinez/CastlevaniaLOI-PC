+#pragma once
+
+#include <cstdint>
+
+// The third-person camera: an orbit around the player that the right stick turns, in place of the
+// game's own camera (the player's choice, Graphics::third_person; R1 switches between the two while
+// playing). The game is told where its camera is (Options::third_person_camera): the instruction that
+// ends its camera update, which the translator probes, and where the camera keeps its target, eye and
+// world-to-camera matrix, and the player's world matrix. At that instruction the eye is moved and the
+// matrix rebuilt, before the game makes its inverse and hands both to the renderer.
+namespace ps2 {
+
+struct Cpu;
+
+namespace camera {
+
+// Called by the translated code's probes: true when `pc` was the camera's.
+bool hook(Cpu &c, std::uint32_t pc);
+// Controller input on its way to the game: with the third-person camera chosen, R1 switches cameras and
+// the game doesn't see it; while the third-person camera is on, the right stick is the camera's and the
+// game sees it centred.
+std::uint16_t filter_buttons(std::uint16_t pressed);
+std::uint8_t filter_right_stick(int axis, std::uint8_t value);
+// The angle the left stick is turned by, so that "up" walks away from the camera on screen (0 when the
+// game's own camera is on).
+float stick_turn();
+
+}
+
+}
