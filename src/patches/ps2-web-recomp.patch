+#pragma once
+
+union SDL_Event;
+struct SDL_Window;
+
+// The in-game F10 menu: the graphics options over the game picture, drawn with Dear ImGui into the
+// presentation pass. While it's open the game is paused (threaded runs) and gets no input.
+namespace menu {
+
+void init(SDL_Window *window, bool can_pause);
+bool open();
+void toggle();
+// Called for every SDL event; true when the menu used it (it's open), so the game doesn't see it.
+bool handle_event(const SDL_Event &e);
+// Builds the menu's frame; called on the presenting thread right before each presentation.
+void frame();
+
+}
