+    g_layer1 = layer1;
+    g_size = sectors * kSector;
+    g_probe = {};
+    g_warned_unmapped = false;
+    g_reader = read_spans;
+    std::fprintf(stderr, "[disc] %s: %zu files extracted from the disc, %llu sectors, layer 1 at %u\n", dir.string().c_str(), g_spans.size(),
