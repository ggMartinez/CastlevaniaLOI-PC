+#pragma once
+// What the IOP modules' translated code (ioprecomp) uses from the runtime: the IOP's registers,
+// its memory and the kernel calls that can switch threads. Each block is a run of the module's
+// instructions that the interpreter's dispatch loop calls in place of interpreting them.
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2::iop {
+
+struct Cpu {
+    std::uint32_t r[32];
