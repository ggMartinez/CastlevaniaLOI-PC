diff --git a/runtime/src/graphics.cpp b/runtime/src/graphics.cpp
new file mode 100644
index 0000000..0452765
--- /dev/null
+++ b/runtime/src/graphics.cpp
@@ -0,0 +1,178 @@
+#include "ps2/graphics.hpp"
+
+#include <algorithm>
+#include <cstdlib>
+#include <fstream>
+#include <map>
+#include <mutex>
+#include <sstream>
+#include <vector>
+
+namespace ps2 {
+
+namespace {
+
+std::mutex g_mutex;
+Graphics g_graphics;
+std::vector<std::function<void(const Graphics &, const Graphics &)>> g_listeners;
+
+// The graphics keys, in the order they're written.
+const char *const kKeys[] = {"api",         "scale",       "vsync",         "widescreen",    "fullscreen", "aa",         "upscale",
+                             "sharpen",     "sharpen_strength", "bloom",    "bloom_strength", "brightness", "contrast",  "saturation",
+                             "gamma",       "deband",      "crt",           "crt_scanlines", "crt_curvature", "vignette", "vignette_strength",
+                             "grain",       "grain_strength", "camera",      "camera_distance", "camera_speed", "camera_invert_x",
+                             "camera_invert_y", "renderer",    "resolution",  "frame_rate"};
+
+bool is_graphics_key(const std::string &k) {
+    return std::find_if(std::begin(kKeys), std::end(kKeys), [&](const char *g) { return k == g; }) != std::end(kKeys);
+}
+
+std::map<std::string, std::string> read_keys(const std::string &ini) {
+    std::map<std::string, std::string> keys;
+    std::ifstream in(ini);
+    std::string line;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (const auto eq = line.find('='); eq != std::string::npos) keys[line.substr(0, eq)] = line.substr(eq + 1);
+    }
+    return keys;
+}
+
+}
+
+Graphics load_graphics(const std::string &ini) {
+    const auto keys = read_keys(ini);
+    Graphics g;
+    const auto text = [&](const char *k) -> const std::string * {
+        const auto it = keys.find(k);
+        return it == keys.end() ? nullptr : &it->second;
+    };
+    const auto flag = [&](const char *k, bool &v) {
+        if (const std::string *s = text(k)) v = *s == "1";
+    };
+    const auto number = [&](const char *k, float &v, float lo, float hi) {
+        if (const std::string *s = text(k)) v = std::clamp(std::strtof(s->c_str(), nullptr), lo, hi);
+    };
+    if (const std::string *s = text("api")) g.api = *s == "d3d12" ? Api::d3d12 : Api::vulkan;
+    if (const std::string *s = text("scale")) g.scale = std::clamp(std::atoi(s->c_str()), 1, 6);
+    flag("vsync", g.vsync);
+    flag("widescreen", g.widescreen);
+    flag("fullscreen", g.fullscreen);
+    if (const std::string *s = text("aa")) g.fxaa = *s == "fxaa";
+    if (const std::string *s = text("upscale")) g.fsr = *s == "fsr";
+    flag("sharpen", g.sharpen);
+    number("sharpen_strength", g.sharpen_strength, 0.0f, 1.0f);
+    flag("bloom", g.bloom);
+    number("bloom_strength", g.bloom_strength, 0.0f, 1.0f);
+    number("brightness", g.brightness, -0.5f, 0.5f);
+    number("contrast", g.contrast, 0.5f, 1.5f);
+    number("saturation", g.saturation, 0.0f, 2.0f);
+    number("gamma", g.gamma, 0.5f, 2.0f);
+    flag("deband", g.deband);
+    flag("crt", g.crt);
+    number("crt_scanlines", g.crt_scanlines, 0.0f, 1.0f);
+    flag("crt_curvature", g.crt_curvature);
+    flag("vignette", g.vignette);
+    number("vignette_strength", g.vignette_strength, 0.0f, 1.0f);
+    flag("grain", g.grain);
+    number("grain_strength", g.grain_strength, 0.0f, 1.0f);
+    if (const std::string *s = text("camera")) g.third_person = *s == "third_person";
+    number("camera_distance", g.camera_distance, 400.0f, 2000.0f);
+    number("camera_speed", g.camera_speed, 0.25f, 3.0f);
+    flag("camera_invert_x", g.camera_invert_x);
+    flag("camera_invert_y", g.camera_invert_y);
+    if (const std::string *s = text("renderer")) g.native_renderer = *s == "native";
+    if (const std::string *s = text("frame_rate")) g.frame_rate = std::clamp(std::atoi(s->c_str()), 60, 1000);
+    if (const std::string *s = text("resolution")) {
+        const int lines = std::atoi(s->c_str());
+        if (std::find(std::begin(kResolutions), std::end(kResolutions), lines) != std::end(kResolutions)) g.resolution = lines;
+    }
+    return g;
+}
+
+void save_graphics(const std::string &ini, const Graphics &g) {
+    std::vector<std::string> kept;
+    {
+        std::ifstream in(ini);
+        std::string line;
+        while (std::getline(in, line)) {
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            const auto eq = line.find('=');
+            if (eq == std::string::npos || !is_graphics_key(line.substr(0, eq))) kept.push_back(line);
+        }
+    }
+    std::ostringstream out;
+    for (const std::string &line : kept)
+        if (!line.empty()) out << line << "\n";
+    const auto b = [](bool v) { return v ? "1" : "0"; };
+    out << "api=" << (g.api == Api::vulkan ? "vulkan" : "d3d12") << "\nscale=" << g.scale << "\nvsync=" << b(g.vsync) << "\nwidescreen=" << b(g.widescreen)
+        << "\nfullscreen=" << b(g.fullscreen) << "\naa=" << (g.fxaa ? "fxaa" : "off") << "\nupscale=" << (g.fsr ? "fsr" : "default")
+        << "\nsharpen=" << b(g.sharpen) << "\nsharpen_strength=" << g.sharpen_strength << "\nbloom=" << b(g.bloom)
+        << "\nbloom_strength=" << g.bloom_strength << "\nbrightness=" << g.brightness << "\ncontrast=" << g.contrast << "\nsaturation=" << g.saturation
+        << "\ngamma=" << g.gamma << "\ndeband=" << b(g.deband) << "\ncrt=" << b(g.crt) << "\ncrt_scanlines=" << g.crt_scanlines
+        << "\ncrt_curvature=" << b(g.crt_curvature) << "\nvignette=" << b(g.vignette) << "\nvignette_strength=" << g.vignette_strength
+        << "\ngrain=" << b(g.grain) << "\ngrain_strength=" << g.grain_strength << "\ncamera=" << (g.third_person ? "third_person" : "original")
+        << "\ncamera_distance=" << g.camera_distance << "\ncamera_speed=" << g.camera_speed << "\ncamera_invert_x=" << b(g.camera_invert_x)
+        << "\ncamera_invert_y=" << b(g.camera_invert_y) << "\nrenderer=" << (g.native_renderer ? "native" : "accurate")
+        << "\nresolution=" << g.resolution << "\nframe_rate=" << g.frame_rate << "\n";
+    std::ofstream(ini, std::ios::binary) << out.str();
+}
+
+const char *scale_label(int scale) {
+    static const char *const kLabels[] = {"1x (~480p)", "2x (~900p)", "3x (~1440p)", "4x (~1800p)", "5x (~2160p, 4K)", "6x (~2880p, 5K)"};
+    return kLabels[std::clamp(scale, 1, 6) - 1];
+}
+
+const char *resolution_label(int lines) {
+    switch (lines) {
+    case 720: return "720p";
+    case 1080: return "1080p";
+    case 1440: return "1440p";
+    case 2160: return "2160p (4K)";
+    default: return "";
+    }
+}
+
+int whole_scale(const Graphics &g) {
+    if (!g.resolution) return std::clamp(g.scale, 1, 6);
+    return std::clamp((g.resolution + 447) / 448, 1, 6);
+}
+
+void native_scale(const Graphics &g, float &across, float &down) {
+    if (!g.resolution) {
+        across = down = static_cast<float>(std::clamp(g.scale, 1, 6));
+        return;
+    }
+    const float lines = static_cast<float>(g.resolution);
+    down = lines / 448.0f;
+    across = lines * (g.widescreen ? 16.0f / 9.0f : 4.0f / 3.0f) / 512.0f;
+}
+
+Graphics graphics() {
+    std::lock_guard lock(g_mutex);
+    return g_graphics;
+}
+
+void set_graphics(const Graphics &g) {
+    Graphics before;
+    std::vector<std::function<void(const Graphics &, const Graphics &)>> listeners;
+    {
+        std::lock_guard lock(g_mutex);
+        before = g_graphics;
+        g_graphics = g;
+        listeners = g_listeners;
+    }
+    for (const auto &l : listeners) l(before, g);
+}
+
+void add_graphics_listener(std::function<void(const Graphics &, const Graphics &)> listener) {
+    std::lock_guard lock(g_mutex);
+    g_listeners.push_back(std::move(listener));
+}
+
+std::string &graphics_file() {
+    static std::string path;
+    return path;
+}
+
+}
