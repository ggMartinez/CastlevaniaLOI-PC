+// Code patches: "name address original replacement" per line (hex words), # comments. The
+// original must be what the executable has there, and both must be plain instructions (no
+// branch or jump), so that either can be emitted in place, delay slots included.
+std::map<std::uint32_t, CodePatch> read_code_patches(const std::string &path, const Image &image, const Program &program) {
+    static const char *const kFlags[] = {"widescreen"};  // ps2::code_patch_on's bits, in order
+    std::ifstream in(path);
+    if (!in) throw std::runtime_error("cannot read " + path);
+    std::map<std::uint32_t, CodePatch> out;
+    std::string line;
+    while (std::getline(in, line)) {
+        if (const auto hash = line.find('#'); hash != std::string::npos) line.resize(hash);
+        std::istringstream words(line);
+        std::string name;
+        std::uint32_t address = 0, original = 0, replacement = 0;
+        if (!(words >> name)) continue;
+        if (!(words >> std::hex >> address >> original >> replacement)) throw std::runtime_error("bad code patch line: " + line);
+        std::uint32_t flag = 0;
+        while (flag < std::size(kFlags) && name != kFlags[flag]) ++flag;
+        if (flag == std::size(kFlags)) throw std::runtime_error("unknown code patch switch " + name);
+        const auto word = image.word(address);
+        if (!word || *word != original || !program.is_code(address))
+            throw std::runtime_error(std::format("code patch at 0x{:08X}: the executable has no such instruction there", address));
+        if (flow(decode(original, address).op) != Flow::None || flow(decode(replacement, address).op) != Flow::None)
+            throw std::runtime_error(std::format("code patch at 0x{:08X}: only plain instructions can be patched", address));
+        if (replacement != original) out[address] = CodePatch{replacement, flag};
+    }
+    std::printf("%zu code patches\n", out.size());
+    return out;
+}
