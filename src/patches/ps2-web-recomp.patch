 namespace {
 
+#ifdef PS2_GAME_DLL
+// The game's translated code lives in game.dll (built from the player's own disc), beside the
+// executable unless --game names another file.
+bool load_game(std::string path) {
+    if (path.empty()) {
+        char exe[MAX_PATH];
+        const DWORD n = GetModuleFileNameA(nullptr, exe, MAX_PATH);
+        path.assign(exe, n);
+        path = path.substr(0, path.find_last_of("\\/") + 1) + "game.dll";
+    }
+    HMODULE dll = LoadLibraryA(path.c_str());
+    if (!dll) {
+        std::fprintf(stderr, "cannot load the game code %s (error %lu)\n", path.c_str(), GetLastError());
+        return false;
+    }
+    using Register = void (*)();
+    const auto reg = reinterpret_cast<Register>(reinterpret_cast<void *>(GetProcAddress(dll, "ps2_register_game")));
+    if (!reg) {
+        std::fprintf(stderr, "%s has no ps2_register_game\n", path.c_str());
+        return false;
+    }
+    reg();
+    return true;
+}
+#endif
