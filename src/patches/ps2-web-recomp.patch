@@ -0,0 +1,22 @@
+#pragma once
+
+namespace ps2::state {
+class Stream;
+}
+
+namespace ps2::iop::padman {
+
+// The game's pad driver (PADMAN.IRX) in native code, in place of its translated module: the libpad RPC
+// server (0x80000100) and, each frame, one command per open port to its DualShock and the 128-byte
+// state block copied to the EE. It keeps each port's state where PADMAN keeps it, in IOP memory, at
+// the same addresses and offsets, so the game's own writes there (vibration) land as they always did.
+// Installed when the game loads PADMAN.IRX (unless PS2_NATIVE_PAD=0). Checked against the translated
+// module block by block: boot, every button and stick, a pad plugged into port 2 and pulled out, and
+// save states; vibration through the same mailbox.
+void install();
+bool enabled();
+// Each frame, at the start of vblank.
+void vblank();
+void state(ps2::state::Stream &s);
+
+}
