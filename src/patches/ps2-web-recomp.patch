+
+// A read of the extracted disc: file bytes where a file sat, zeros past its end and between files.
+std::size_t read_spans(std::uint64_t offset, void *out, std::size_t bytes) {
+    std::lock_guard lock(g_spans_mutex);
+    auto *dst = static_cast<std::uint8_t *>(out);
+    std::size_t done = 0;
+    while (done < bytes) {
+        const std::uint64_t at = offset + done;
+        const auto sector = static_cast<std::uint32_t>(at / kSector);
+        const auto it = std::upper_bound(g_spans.begin(), g_spans.end(), sector, [](std::uint32_t s, const Span &x) { return s < x.sector; });
+        std::size_t chunk;
