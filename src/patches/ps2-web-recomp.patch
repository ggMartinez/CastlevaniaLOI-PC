index 0000000..ed9271c
--- /dev/null
+++ b/runtime/src/iop/compiled.cpp
@@ -0,0 +1,119 @@
+// The IOP modules' translated code (ioprecomp, built into game.dll): which blocks are in use, and
+// the memory and kernel calls those blocks make. A module's blocks are used only while it is
+// loaded at the address it was translated for with the same code; anything else is interpreted.
+#include "compiled.hpp"
+
+#include "iop.hpp"
+#include "kernel.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace ps2::iop {
+
+namespace {
+
+std::vector<gen::Module> g_registered;
+std::vector<const gen::Block *> g_table;  // by physical address / 4
+bool g_any = false;
+
+std::vector<JournalEntry> *g_journal = nullptr;
+bool g_touched_io = false;
+
+bool in_ram(std::uint32_t a) { return phys(a) < kRamSize; }
+
+void journal(std::uint32_t a, unsigned size) {
+    if (!g_journal) return;
+    if (!in_ram(a)) {
+        g_touched_io = true;
+        return;
+    }
+    JournalEntry e{a, size, 0, 0};
+    std::memcpy(&e.old, ram_ptr(a), size);
+    g_journal->push_back(e);
+}
+
+}
+
+namespace gen {
+
+void register_module(const Module &m) { g_registered.push_back(m); }
+
+std::uint32_t ld8(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read8(a);
+}
+std::uint32_t ld16(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read16(a);
+}
+std::uint32_t ld32(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read32(a);
+}
+void st8(std::uint32_t a, std::uint32_t v) {
+    journal(a, 1);
+    write8(a, static_cast<std::uint8_t>(v));
+}
+void st16(std::uint32_t a, std::uint32_t v) {
+    journal(a, 2);
+    write16(a, static_cast<std::uint16_t>(v));
+}
+void st32(std::uint32_t a, std::uint32_t v) {
+    journal(a, 4);
+    write32(a, v);
+}
+bool switch_pending() { return kernel::switch_pending(); }
+void syscall(Cpu &c, std::uint32_t pc) {
+    if (g_journal) g_touched_io = true;
+    kernel::syscall(c, pc);
+    c.r[0] = 0;
+}
+void set_status(Cpu &c, std::uint32_t value) {
+    if (g_journal) g_touched_io = true;
+    kernel::set_status(c, value);
+}
+void brk(std::uint32_t pc) { std::fprintf(stderr, "[iop] break at 0x%08X\n", pc); }
+
+}
+
+void refresh_compiled() {
+    static const bool off = std::getenv("PS2_IOP_INTERPRET") || std::getenv("PS2_IOP_PROBE");
+    if (g_table.empty()) g_table.assign(kRamSize / 4, nullptr);
+    else std::fill(g_table.begin(), g_table.end(), nullptr);
+    g_any = false;
+    if (off) return;
+    for (const gen::Module &m : g_registered) {
+        bool loaded = false;
+        for (const auto &[id, mod] : kernel::modules()) loaded = loaded || mod.base == m.base;
+        if (!loaded || m.base + m.text_size > kRamSize) continue;
+        if (gen::code_hash(ram_ptr(m.base), m.text_size) != m.hash) {
+            std::fprintf(stderr, "[iop] %s at 0x%08X is not the code it was translated from: interpreted\n", m.name, m.base);
+            continue;
+        }
+        for (std::uint32_t i = 0; i < m.count; ++i) g_table[(phys(m.blocks[i].pc) & (kRamSize - 1)) >> 2] = &m.blocks[i];
+        g_any = true;
+    }
+}
+
+const gen::Block *compiled_block(std::uint32_t pc) {
+    if (!g_any) return nullptr;
+    const std::uint32_t p = phys(pc);
+    return p < kRamSize ? g_table[p >> 2] : nullptr;
+}
+
+void begin_journal(std::vector<JournalEntry> &entries) {
+    entries.clear();
+    g_journal = &entries;
+    g_touched_io = false;
+}
+
+bool end_journal() {
+    g_journal = nullptr;
+    return !g_touched_io;
+}
+
+}
