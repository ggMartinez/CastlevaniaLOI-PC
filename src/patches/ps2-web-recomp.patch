+// Called every frame on the presenting thread: picks up finished quick saves and loads, lets the
+// message expire and draws the display again when something on it changed.
+void refresh_osd() {
+    switch (g_state_done.exchange(0)) {
+    case 1: osd_message("State saved", 0x80FF80); break;
+    case 2: osd_message("State loaded", 0x80FF80); break;
+    case 3: osd_message("Saving the state failed", 0xFF8080); break;
+    case 4: osd_message("Loading the state failed", 0xFF8080); break;
+    default: break;
+    }
+    if (!g_osd_message.empty() && SDL_GetTicks64() >= g_osd_message_until) {
+        g_osd_message.clear();
+        g_osd_dirty = true;
+    }
+    if (!g_osd_dirty || !g_gpu_present) return;
+    g_osd_dirty = false;
+    std::vector<OsdLine> lines;
+    if (g_osd_stats) lines = g_stats_lines.empty() ? std::vector<OsdLine>{{"Measuring...", 0xFFFFFF}} : g_stats_lines;
+    if (!g_osd_message.empty()) lines.push_back({g_osd_message, g_osd_message_rgb});
+    if (lines.empty()) {
+        ps2::set_osd(nullptr, 0, 0);
+        return;
+    }
+#ifdef _WIN32
+    draw_osd(lines);
+#endif
+}
+
+void state_done(bool loading, bool success) { g_state_done.store(success ? (loading ? 2 : 1) : (loading ? 4 : 3)); }
+
+// F5 / F6: one quick save slot, quick.state in the --states folder.
+void quick_state(bool loading) {
+    if (ps2::g_options.state_dir.empty()) {
+        osd_message("Save states are off (no --states folder)", 0xFF8080);
+        return;
+    }
+    std::error_code ec;
+    std::filesystem::create_directories(ps2::g_options.state_dir, ec);
+    const std::string path = (std::filesystem::path(ps2::g_options.state_dir) / "quick.state").string();
+    // A failed load leaves the machine half replaced and stops the game, so only load what exists.
+    if (loading && !std::filesystem::exists(path)) {
+        osd_message("No quick save yet: F5 saves one", 0xFF8080);
+        return;
+    }
+    if (!ps2::request_state_operation(loading, path.c_str(), state_done)) osd_message("Busy, try again", 0xFF8080);
+    else osd_message(loading ? "Loading the state..." : "Saving the state...", 0xFFFFFF);
+}
