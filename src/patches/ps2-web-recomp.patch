+
+// The player's graphics settings, shared by the launcher and the game (settings.ini): the launcher edits
+// them, the game reads them at start (--settings) and its F10 menu changes them while playing.
+namespace ps2 {
+
+enum class Api { d3d12, vulkan };
+
+struct Graphics {
+    Api api = Api::vulkan;  // the proven path; Direct3D 12 is the newer, less played one
+    int scale = 1;  // 1..6
+    bool vsync = true, widescreen = false, fullscreen = false, fxaa = false, fsr = false;
+    bool sharpen = false, bloom = false, deband = false, crt = false, crt_curvature = false, vignette = false, grain = false;
+    float sharpen_strength = 0.5f, bloom_strength = 0.5f, crt_scanlines = 0.5f, vignette_strength = 0.5f, grain_strength = 0.3f;  // 0..1
+    float brightness = 0.0f, contrast = 1.0f, saturation = 1.0f, gamma = 1.0f;  // -0.5..0.5, 0.5..1.5, 0..2, 0.5..2
+};
+
+// Missing keys keep their defaults and values out of range are clamped.
+Graphics load_graphics(const std::string &ini);
+// Rewrites the graphics keys and keeps every other line (the launcher's iso=).
+void save_graphics(const std::string &ini, const Graphics &g);
+// "1x (~480p)" to "6x (~2880p, 5K)": the game's 448 lines times the scale, named after the nearest
+// common resolution.
+const char *scale_label(int scale);
+
+// The running game's settings: a copy, safe to take from any thread.
+Graphics graphics();
+// Applies a change while playing: every listener sees the old and the new settings.
