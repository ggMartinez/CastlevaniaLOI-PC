index 0000000..812114a
--- /dev/null
+++ b/runtime/src/camera.cpp
@@ -0,0 +1,155 @@
+#include "ps2/camera.hpp"
+
+#include "ps2/cpu.hpp"
+#include "ps2/graphics.hpp"
+#include "ps2/memory.hpp"
+#include "ps2/system.hpp"
+
+#include <algorithm>
+#include <atomic>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+
+namespace ps2::camera {
+
+namespace {
+
+constexpr std::uint16_t kR1 = 0x0800;            // in the controller's button mask
+constexpr float kAboveRoot = 300.0f;             // the point looked at, above the player's root (y points down)
+constexpr float kRoomJump = 250.0f;              // a move this large in one frame is a new room (or a loaded state)
+constexpr float kYawRate = 0.045f, kPitchRate = 0.03f;  // radians per frame at full stick, speed 1
+constexpr float kPitchMin = -0.35f, kPitchMax = 1.2f, kPitchStart = 0.30f;
+
+// Where the game keeps its camera: "hook:target:eye:matrix:player" (hex), offsets into the camera object
+// the hook finds in s0; the player's world matrix at a fixed address.
+struct Spec {
+    bool valid = false;
+    std::uint32_t hook = 0, target = 0, eye = 0, matrix = 0, player = 0;
+};
+
+const Spec &spec() {
+    static const Spec s = [] {
+        Spec r;
+        const std::string &text = g_options.third_person_camera;
+        if (text.empty()) return r;
+        unsigned hook, target, eye, matrix, player;
+        if (std::sscanf(text.c_str(), "%x:%x:%x:%x:%x", &hook, &target, &eye, &matrix, &player) == 5)
+            r = Spec{true, hook, target, eye, matrix, player};
+        else
+            std::fprintf(stderr, "[camera] bad --third-person-camera %s\n", text.c_str());
+        return r;
+    }();
+    return s;
+}
+
+std::atomic<bool> g_chosen{false};  // the player chose the third-person camera (settings)
+std::atomic<bool> g_on{true};       // ... and has it on (R1)
+std::atomic<std::uint8_t> g_stick[2] = {0x80, 0x80};
+std::atomic<float> g_turn{0.0f};
+bool g_r1_down = false;
+
+bool active() { return spec().valid && g_chosen && g_on; }
+
+struct Orbit {
+    bool started = false;
+    float yaw = 0, pitch = kPitchStart;
+    float last_player[3] = {};
+} g_orbit;
+
+float read_f(std::uint32_t a) {
+    float v;
+    std::memcpy(&v, g_ram + (a & (kRamSize - 1)), 4);
+    return v;
+}
+
+}  // namespace
+
+std::uint16_t filter_buttons(std::uint16_t pressed) {
+    if (!spec().valid || !g_chosen) {
+        g_r1_down = false;
+        return pressed;
+    }
+    const bool r1 = (pressed & kR1) != 0;
+    if (r1 && !g_r1_down) g_on = !g_on;
+    g_r1_down = r1;
+    return static_cast<std::uint16_t>(pressed & ~kR1);
+}
+
+std::uint8_t filter_right_stick(int axis, std::uint8_t value) {
+    g_stick[axis & 1] = value;
+    return active() ? 0x80 : value;
+}
+
+float stick_turn() { return active() ? g_turn.load() : 0.0f; }
+
+bool hook(Cpu &c, std::uint32_t pc) {
+    const Spec &s = spec();
+    if (!s.valid || pc != s.hook) return false;
+    const Graphics g = graphics();
+    if (g.third_person && !g_chosen) g_on = true;  // choosing it in the menu turns it on
+    g_chosen = g.third_person;
+    if (!active()) {
+        g_orbit.started = false;
+        g_turn = 0.0f;
+        return true;
+    }
+    const std::uint32_t cam = c.r[16].w[0] & (kRamSize - 1);
+    float target[3], game_eye[3], player[3], facing[2];
+    for (int k = 0; k < 3; ++k) {
+        target[k] = read_f(cam + s.target + 4 * k);
+        game_eye[k] = read_f(cam + s.eye + 4 * k);
+        player[k] = read_f(s.player + 48 + 4 * k);
+    }
+    facing[0] = read_f(s.player + 32);
+    facing[1] = read_f(s.player + 40);
+    const float game_facing = std::atan2(target[0] - game_eye[0], target[2] - game_eye[2]);
+    // Look at the player, unless the matrix isn't near what the game looks at (then keep the game's point).
+    if (std::hypot(player[0] - target[0], player[2] - target[2]) < 1500.0f) {
+        target[0] = player[0];
+        target[1] = player[1] - kAboveRoot;
+        target[2] = player[2];
+    }
+    const float jump = std::hypot(player[0] - g_orbit.last_player[0], player[2] - g_orbit.last_player[2]);
+    if (!g_orbit.started) {
+        // Turned on: start where the game's camera is, so the picture doesn't jump.
+        g_orbit.yaw = game_facing + 3.14159265f;
+        g_orbit.pitch = kPitchStart;
+        g_orbit.started = true;
+    } else if (jump > kRoomJump && std::hypot(facing[0], facing[1]) > 0.5f) {
+        // A new room: start behind the player, looking where he looks.
+        g_orbit.yaw = std::atan2(-facing[0], -facing[1]);
+        g_orbit.pitch = kPitchStart;
+    }
+    std::memcpy(g_orbit.last_player, player, sizeof player);
+    const auto stick = [](std::uint8_t v) {
+        const float f = (static_cast<int>(v) - 128) / 127.0f;
+        return std::fabs(f) < 0.2f ? 0.0f : f;
+    };
+    g_orbit.yaw += stick(g_stick[0]) * kYawRate * g.camera_speed * (g.camera_invert_x ? -1.0f : 1.0f);
+    g_orbit.pitch = std::clamp(g_orbit.pitch + stick(g_stick[1]) * kPitchRate * g.camera_speed * (g.camera_invert_y ? -1.0f : 1.0f), kPitchMin, kPitchMax);
+    const float d = g.camera_distance;
+    const float eye[3] = {target[0] + std::sin(g_orbit.yaw) * std::cos(g_orbit.pitch) * d, target[1] - std::sin(g_orbit.pitch) * d,
+                          target[2] + std::cos(g_orbit.yaw) * std::cos(g_orbit.pitch) * d};
+    // Look-at, as the game builds it: z forward, x level, y = z cross x; rows are world axes.
+    float f[3] = {target[0] - eye[0], target[1] - eye[1], target[2] - eye[2]};
+    const float fl = std::sqrt(f[0] * f[0] + f[1] * f[1] + f[2] * f[2]);
+    for (float &v : f) v /= fl;
+    const float xl = std::hypot(f[2], f[0]);
+    const float x[3] = {f[2] / xl, 0.0f, -f[0] / xl};
+    const float y[3] = {f[1] * x[2] - f[2] * x[1], f[2] * x[0] - f[0] * x[2], f[0] * x[1] - f[1] * x[0]};
+    float m[16] = {x[0], y[0], f[0], 0, x[1], y[1], f[1], 0, x[2], y[2], f[2], 0, 0, 0, 0, 1};
+    for (int k = 0; k < 3; ++k) {
+        const float *axis = k == 0 ? x : k == 1 ? y : f;
+        m[12 + k] = -(eye[0] * axis[0] + eye[1] * axis[1] + eye[2] * axis[2]);
+    }
+    std::memcpy(g_ram + cam + s.target, target, 12);
+    std::memcpy(g_ram + cam + s.eye, eye, 12);
+    std::memcpy(g_ram + cam + s.matrix, m, sizeof m);
+    // The game steers the player by its own camera's facing: the left stick is turned by the difference.
+    g_turn = std::atan2(target[0] - eye[0], target[2] - eye[2]) - game_facing;
+    return true;
+}
+
+}
