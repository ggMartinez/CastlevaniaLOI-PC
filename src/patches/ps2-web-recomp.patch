+// F5 / F6: one quick save slot, quick.state in the --states folder.
+void quick_state(bool loading) {
+    if (ps2::g_options.state_dir.empty()) {
+        osd_message("Save states are off (no --states folder)", 0xFF8080);
+        return;
+    }
+    std::error_code ec;
+    std::filesystem::create_directories(ps2::g_options.state_dir, ec);
+    const std::string path = (std::filesystem::path(ps2::g_options.state_dir) / "quick.state").string();
+    // A failed load leaves the machine half replaced and stops the game, so only load what exists.
+    if (loading && !std::filesystem::exists(path)) {
+        osd_message("No quick save yet: F5 saves one", 0xFF8080);
+        return;
+    }
+    if (!ps2::request_state_operation(loading, path.c_str(), state_done)) osd_message("Busy, try again", 0xFF8080);
+    else osd_message(loading ? "Loading the state..." : "Saving the state...", 0xFFFFFF);
+}
