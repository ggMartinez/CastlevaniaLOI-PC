@@ -0,0 +1,110 @@
+// Tests the GS's pixel layouts (runtime/src/gs/swizzle.cpp), the one copy both renderers use: run the built
+// gs_swizzle_test; it exits 0 when every check passes and prints each failure otherwise.
+#include "gs/swizzle.hpp"
+#include "gs/gs.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+using namespace ps2::gs;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+std::uint32_t pattern(std::uint32_t x, std::uint32_t y) { return (x * 2654435761u) ^ (y * 40503u) ^ 0x5A5A5A5Au; }
+
+// 256 pixels wide: a width every format allows (8- and 4-bit pages are 128 wide).
+void round_trip_every_format() {
+    struct Format { std::uint32_t psm, mask; };
+    const Format formats[] = {{PSMCT32, 0xFFFFFFFFu}, {PSMCT24, 0xFFFFFFu}, {PSMCT16, 0xFFFFu}, {PSMCT16S, 0xFFFFu}, {PSMT8, 0xFFu},
+                              {PSMT4, 0xFu},          {PSMZ32, 0xFFFFFFFFu},  {PSMZ24, 0xFFFFFFu},  {PSMZ16, 0xFFFFu},     {PSMZ16S, 0xFFFFu},
+                              {PSMT8H, 0xFFu},        {PSMT4HL, 0xFu},        {PSMT4HH, 0xFu}};
+    for (const Format &f : formats) {
+        std::vector<std::uint8_t> mem(kMemorySize, 0);
+        for (std::uint32_t y = 0; y < 130; ++y)
+            for (std::uint32_t x = 0; x < 140; ++x) swizzle::write_pixel(mem.data(), f.psm, 64, 4, x, y, pattern(x, y));
+        bool ok = true;
+        for (std::uint32_t y = 0; y < 130 && ok; ++y)
+            for (std::uint32_t x = 0; x < 140 && ok; ++x) ok = swizzle::read_pixel(mem.data(), f.psm, 64, 4, x, y) == (pattern(x, y) & f.mask);
+        char what[64];
+        std::snprintf(what, sizeof what, "round trip, format 0x%02X", f.psm);
+        check(ok, what);
+    }
+}
+
+void ct32_block_order() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    swizzle::write_pixel(mem.data(), PSMCT32, 0, 1, 8, 0, 0x11223344u);
+    swizzle::write_pixel(mem.data(), PSMCT32, 0, 1, 0, 8, 0x55667788u);
+    std::uint32_t a, b;
+    std::memcpy(&a, mem.data() + 256, 4);
+    std::memcpy(&b, mem.data() + 512, 4);
+    check(a == 0x11223344u, "CT32 (8,0) is the first word of block 1");
+    check(b == 0x55667788u, "CT32 (0,8) is the first word of block 2");
+}
+
+void t4_nibbles() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    swizzle::write_pixel(mem.data(), PSMT4, 0, 2, 0, 0, 0x3);
+    swizzle::write_pixel(mem.data(), PSMT4, 0, 2, 0, 2, 0xA);
+    swizzle::write_pixel(mem.data(), PSMT4, 0, 2, 8, 0, 0x5);
+    check(mem[0] == 0x03, "T4 (0,0) low nibble of byte 0");
+    check(mem[1] == 0x05, "T4 (8,0) low nibble of byte 1");
+    check(mem[32] == 0xA0, "T4 (0,2) high nibble of byte 32 (the next column word)");
+}
+
+void ct24_keeps_alpha_byte() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    swizzle::write_pixel(mem.data(), PSMCT32, 0, 1, 5, 5, 0xAABBCCDDu);
+    swizzle::write_pixel(mem.data(), PSMCT24, 0, 1, 5, 5, 0x00112233u);
+    check(swizzle::read_pixel(mem.data(), PSMCT32, 0, 1, 5, 5) == 0xAA112233u, "CT24 writes leave the alpha byte");
+}
+
+void wraps_like_the_gs() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    // Block 0x3FFF's page continues past 4 MB: it wraps to the start.
+    swizzle::write_pixel(mem.data(), PSMCT32, 0x3FE0, 1, 63, 31, 0xCAFEF00Du);
+    check(swizzle::read_pixel(mem.data(), PSMCT32, 0x3FE0, 1, 63, 31) == 0xCAFEF00Du, "addresses wrap at 4 MB");
+}
+
+// read_row is the fast path the native renderer decodes textures with: it must read what read_pixel reads,
+// across pages, from unaligned starts, and wrapping at 4 MB.
+void rows_match_pixels() {
+    const std::uint32_t formats[] = {PSMCT32, PSMCT24, PSMCT16, PSMCT16S, PSMT8, PSMT4, PSMZ32, PSMZ24, PSMZ16, PSMZ16S, PSMT8H, PSMT4HL, PSMT4HH};
+    std::vector<std::uint8_t> mem(kMemorySize);
+    for (std::size_t i = 0; i < mem.size(); ++i) mem[i] = static_cast<std::uint8_t>(pattern(static_cast<std::uint32_t>(i), 7));
+    for (const std::uint32_t psm : formats)
+        for (const std::uint32_t bp : {64u, 0x3F00u}) {
+            bool ok = true;
+            std::vector<std::uint32_t> row(300);
+            for (std::uint32_t y = 0; y < 140 && ok; y += 3) {
+                swizzle::read_row(mem.data(), psm, bp, 4, 5, y, 250, row.data());
+                for (std::uint32_t i = 0; i < 250 && ok; ++i) ok = row[i] == swizzle::read_pixel(mem.data(), psm, bp, 4, 5 + i, y);
+            }
+            char what[64];
+            std::snprintf(what, sizeof what, "read_row, format 0x%02X at block 0x%X", psm, bp);
+            check(ok, what);
+        }
+}
+
+}  // namespace
+
+int main() {
+    rows_match_pixels();
+    round_trip_every_format();
+    ct32_block_order();
+    t4_nibbles();
+    ct24_keeps_alpha_byte();
+    wraps_like_the_gs();
+    if (g_failures) return 1;
+    std::printf("gs_swizzle_test: all checks passed\n");
+    return 0;
+}
