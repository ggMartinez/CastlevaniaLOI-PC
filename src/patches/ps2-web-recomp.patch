+
+void run_exact(int n, std::uint32_t address);
+
+// VU0's compiled microprograms (vurecomp --vu0), by the same key as VU1's: the code reachable
+// from the entry. An entry is looked up again only after VU0's code changes.
+std::unordered_map<std::uint64_t, ProgramFn> g_programs0;
+struct Vu0Entry {
+    std::uint32_t generation = 0;
+    ProgramFn function = nullptr;
+};
+Vu0Entry g_vu0_entries[512];
+
+void register_programs_vu0(const Program *programs, std::uint32_t count) {
+    for (std::uint32_t i = 0; i < count; ++i)
+        if (programs[i].function) g_programs0[programs[i].key] = programs[i].function;
+}
+
+ProgramFn lookup_vu0(std::uint32_t address) {
+    Vu0Entry &e = g_vu0_entries[(address & 4095u) >> 3];
+    if (e.generation == g_generation[0]) return e.function;
+    e.generation = g_generation[0];
+    const std::uint64_t key = program_key(g_vu0_code, reachable(g_vu0_code, 4095u, address & 4095u), address & 4095u);
+    const auto it = g_programs0.find(key);
+    e.function = it == g_programs0.end() ? nullptr : it->second;
+    // Porting work: PS2_VU0_RECORD=dir saves VU0's code for every entry with no compiled program,
+    // as vurecomp --vu0 takes it (and --dev-vu-recipe turns into a recipe).
+    static const char *record = std::getenv("PS2_VU0_RECORD");
+    if (!e.function && record) {
+        char name[64];
+        std::snprintf(name, sizeof name, "%016llX_%03X.bin", static_cast<unsigned long long>(key), address & 4095u);
+        const std::filesystem::path path = std::filesystem::path(record) / name;
+        if (!std::filesystem::exists(path)) {
+            std::filesystem::create_directories(record);
+            std::ofstream(path, std::ios::binary).write(reinterpret_cast<const char *>(g_vu0_code), 4096);
+            std::fprintf(stderr, "[vu0] recorded %s\n", name);
+        }
+    }
+    return e.function;
+}
+
+// A VU0 microprogram: compiled when one was built for this code, else interpreted. PS2_VU0_CHECK
+// runs both from the same state on every call and reports where they differ (the compiled
+// result is kept); PS2_VU0_CHECK=fast compares with the fast interpreter VU1 uses instead of the
+// exact one (the two differ in the last bit of some results). PS2_VU_INTERPRET interprets everything.
+void run_vu0(std::uint32_t address) {
+    static const bool interpret_only = std::getenv("PS2_VU_INTERPRET") != nullptr;
+    static const bool check = std::getenv("PS2_VU0_CHECK") != nullptr;
+    const ProgramFn fn = interpret_only ? nullptr : lookup_vu0(address);
+    if (!fn) {
+        run_exact(0, address);
+        return;
+    }
+    if (!check) {
+        fn(g_cpu.vu0, g_vu0_mem);
+        return;
+    }
+    static std::uint64_t calls = 0, mismatches = 0;
+    static std::uint8_t before_mem[4096], compiled_mem[4096];
+    const Vu0Regs before = g_cpu.vu0;
+    std::memcpy(before_mem, g_vu0_mem, sizeof before_mem);
+    fn(g_cpu.vu0, g_vu0_mem);
+    const Vu0Regs compiled = g_cpu.vu0;
+    std::memcpy(compiled_mem, g_vu0_mem, sizeof compiled_mem);
+    g_cpu.vu0 = before;
+    std::memcpy(g_vu0_mem, before_mem, sizeof before_mem);
+    static const bool against_fast = std::string(std::getenv("PS2_VU0_CHECK")) == "fast";
+    if (against_fast) run_fast(0, address);
+    else run_exact(0, address);
+    ++calls;
+    if (std::memcmp(&compiled, &g_cpu.vu0, sizeof compiled) != 0 || std::memcmp(compiled_mem, g_vu0_mem, sizeof compiled_mem) != 0) {
+        if (++mismatches <= 20) {
+            int vf = -1, vi = -1, byte = -1;
+            for (int i = 0; i < 32 && vf < 0; ++i)
+                if (std::memcmp(&compiled.vf[i], &g_cpu.vu0.vf[i], 16) != 0) vf = i;
+            for (int i = 0; i < 16 && vi < 0; ++i)
+                if (compiled.vi[i] != g_cpu.vu0.vi[i]) vi = i;
+            for (int i = 0; i < 4096 && byte < 0; ++i)
+                if (compiled_mem[i] != g_vu0_mem[i]) byte = i;
+            const Vu0Regs &x = g_cpu.vu0;
+            std::fprintf(stderr, "[vu0-check] entry %03X: vf%d vi%d acc %d q/p/i/r %d flags %d tpc %u/%u mem byte %d\n", address & 4095u, vf, vi,
+                         std::memcmp(&compiled.acc, &x.acc, 16) != 0, compiled.q != x.q || compiled.p != x.p || compiled.i != x.i || compiled.r != x.r,
+                         compiled.mac != x.mac || compiled.status != x.status || compiled.clip != x.clip, compiled.tpc, x.tpc, byte);
+            const auto show = [](const char *what, const Reg128 &a, const Reg128 &b) {
+                std::fprintf(stderr, "    %s compiled %08X %08X %08X %08X reference %08X %08X %08X %08X\n", what, a.w[0], a.w[1], a.w[2], a.w[3], b.w[0], b.w[1], b.w[2], b.w[3]);
+            };
+            if (vf >= 0) show("vf", compiled.vf[vf], x.vf[vf]);
+            if (std::memcmp(&compiled.acc, &x.acc, 16) != 0) show("acc", compiled.acc, x.acc);
+            std::fprintf(stderr, "    mac %04X/%04X status %03X/%03X clip %06X/%06X\n", compiled.mac, x.mac, compiled.status, x.status, compiled.clip, x.clip);
+        }
+    }
+    if (calls % 2000 == 0)
+        std::fprintf(stderr, "[vu0-check] %llu calls compared, %llu differ\n", static_cast<unsigned long long>(calls), static_cast<unsigned long long>(mismatches));
+    g_cpu.vu0 = compiled;
+    std::memcpy(g_vu0_mem, compiled_mem, sizeof compiled_mem);
+}
+
+void run_unit(int n, std::uint32_t address) {
     static const bool exact = std::getenv("PS2_VU_EXACT") != nullptr;
     if (n == 1 && !exact) {
         interpret(n, address);
         return;
     }
+    if (n == 0 && !exact) {
+        run_vu0(address);
+        return;
+    }
+    run_exact(n, address);
+}
+
