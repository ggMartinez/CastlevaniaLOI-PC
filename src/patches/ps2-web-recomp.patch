+        else i.kind = Kind::Plain;
+        break;
+    case 0x20: case 0x21: case 0x22: case 0x23: case 0x24: case 0x25: case 0x26: case 0x2F: i.kind = Kind::Plain; break;
+    case 0x28: case 0x29: case 0x2A: case 0x2B: case 0x2E: i.kind = Kind::Store; break;
+    default: break;  // COP2, the runtime's native-call opcode, unknown: the interpreter's
+    }
+    (void)rt;
+    return i;
+}
+
+std::string hex(std::uint32_t v) { return std::format("0x{:08X}u", v); }
+std::string reg(std::uint32_t n) { return std::format("r[{}]", n); }
+std::string addr(std::uint32_t w) { return std::format("r[{}] + {}", (w >> 21) & 31u, hex(static_cast<std::uint32_t>(simm(w)))); }
+
+// The C++ for one instruction that is not a branch, a jump, a syscall or a status write.
+std::string plain(std::uint32_t w, std::uint32_t pc) {
+    const std::uint32_t op = w >> 26, rs = (w >> 21) & 31u, rt = (w >> 16) & 31u, rd = (w >> 11) & 31u, sa = (w >> 6) & 31u;
+    const std::string Rs = reg(rs), Rt = reg(rt), Rd = reg(rd);
+    const auto set = [](std::uint32_t dst, const std::string &value) { return dst ? std::format("r[{}] = {}; ", dst, value) : std::string(); };
+    if (op == 0x00) {
+        switch (w & 63u) {
+        case 0x00: return set(rd, std::format("{} << {}", Rt, sa));
+        case 0x02: return set(rd, std::format("{} >> {}", Rt, sa));
+        case 0x03: return set(rd, std::format("static_cast<std::uint32_t>(static_cast<std::int32_t>({}) >> {})", Rt, sa));
+        case 0x04: return set(rd, std::format("{} << ({} & 31u)", Rt, Rs));
+        case 0x06: return set(rd, std::format("{} >> ({} & 31u)", Rt, Rs));
+        case 0x07: return set(rd, std::format("static_cast<std::uint32_t>(static_cast<std::int32_t>({}) >> ({} & 31u))", Rt, Rs));
+        case 0x0D: return std::format("gen::brk({}); ", hex(pc));
+        case 0x0F: return "";
+        case 0x10: return set(rd, "c.hi");
+        case 0x11: return std::format("c.hi = {}; ", Rs);
+        case 0x12: return set(rd, "c.lo");
+        case 0x13: return std::format("c.lo = {}; ", Rs);
+        case 0x18:
+            return std::format("{{ const std::int64_t p = static_cast<std::int64_t>(static_cast<std::int32_t>({})) * static_cast<std::int32_t>({}); "
+                               "c.lo = static_cast<std::uint32_t>(p); c.hi = static_cast<std::uint32_t>(static_cast<std::uint64_t>(p) >> 32); }} ",
+                               Rs, Rt);
+        case 0x19:
+            return std::format("{{ const std::uint64_t p = static_cast<std::uint64_t>({}) * {}; c.lo = static_cast<std::uint32_t>(p); c.hi = static_cast<std::uint32_t>(p >> 32); }} ",
+                               Rs, Rt);
+        case 0x1A:
+            return std::format("{{ const auto n = static_cast<std::int32_t>({}), d = static_cast<std::int32_t>({}); "
+                               "if (d == 0) {{ c.lo = n < 0 ? 1u : 0xFFFFFFFFu; c.hi = static_cast<std::uint32_t>(n); }} "
+                               "else if (n == INT32_MIN && d == -1) {{ c.lo = static_cast<std::uint32_t>(INT32_MIN); c.hi = 0; }} "
+                               "else {{ c.lo = static_cast<std::uint32_t>(n / d); c.hi = static_cast<std::uint32_t>(n % d); }} }} ",
+                               Rs, Rt);
+        case 0x1B:
+            return std::format("if ({1} == 0) {{ c.lo = 0xFFFFFFFFu; c.hi = {0}; }} else {{ c.lo = {0} / {1}; c.hi = {0} % {1}; }} ", Rs, Rt);
+        case 0x20: case 0x21: return set(rd, std::format("{} + {}", Rs, Rt));
+        case 0x22: case 0x23: return set(rd, std::format("{} - {}", Rs, Rt));
+        case 0x24: return set(rd, std::format("{} & {}", Rs, Rt));
+        case 0x25: return set(rd, std::format("{} | {}", Rs, Rt));
+        case 0x26: return set(rd, std::format("{} ^ {}", Rs, Rt));
+        case 0x27: return set(rd, std::format("~({} | {})", Rs, Rt));
+        case 0x2A: return set(rd, std::format("static_cast<std::int32_t>({}) < static_cast<std::int32_t>({}) ? 1u : 0u", Rs, Rt));
+        case 0x2B: return set(rd, std::format("{} < {} ? 1u : 0u", Rs, Rt));
+        default: return "";
+        }
+    }
+    const std::uint32_t imm = w & 0xFFFFu;
+    const std::string sext = hex(static_cast<std::uint32_t>(simm(w)));
+    switch (op) {
+    case 0x08: case 0x09: return set(rt, std::format("{} + {}", Rs, sext));
+    case 0x0A: return set(rt, std::format("static_cast<std::int32_t>({}) < {} ? 1u : 0u", Rs, simm(w)));
+    case 0x0B: return set(rt, std::format("{} < {} ? 1u : 0u", Rs, sext));
+    case 0x0C: return set(rt, std::format("{} & {}u", Rs, imm));
+    case 0x0D: return set(rt, std::format("{} | {}u", Rs, imm));
+    case 0x0E: return set(rt, std::format("{} ^ {}u", Rs, imm));
+    case 0x0F: return set(rt, hex(w << 16));
+    case 0x10:
+        if (rs == 0) {
+            const char *v = rd == 12 ? "c.status" : rd == 13 ? "c.cause" : rd == 14 ? "c.epc" : rd == 15 ? "0x1Fu" : "0u";
+            return set(rt, v);
+        }
+        if (rs == 4) {
+            if (rd == 13) return std::format("c.cause = {}; ", Rt);
+            if (rd == 14) return std::format("c.epc = {}; ", Rt);
+            return "";
+        }
+        if ((w & 63u) == 0x10) return "c.status = (c.status & ~0xFu) | ((c.status >> 2) & 0xFu); ";
+        return "";
+    case 0x20: return rt ? set(rt, std::format("static_cast<std::uint32_t>(static_cast<std::int8_t>(gen::ld8({})))", addr(w))) : std::format("gen::ld8({}); ", addr(w));
+    case 0x21: return rt ? set(rt, std::format("static_cast<std::uint32_t>(static_cast<std::int16_t>(gen::ld16({})))", addr(w))) : std::format("gen::ld16({}); ", addr(w));
+    case 0x23: return rt ? set(rt, std::format("gen::ld32({})", addr(w))) : std::format("gen::ld32({}); ", addr(w));
+    case 0x24: return rt ? set(rt, std::format("gen::ld8({})", addr(w))) : std::format("gen::ld8({}); ", addr(w));
+    case 0x25: return rt ? set(rt, std::format("gen::ld16({})", addr(w))) : std::format("gen::ld16({}); ", addr(w));
+    case 0x22:
+        return std::format("{{ const std::uint32_t a = {}, shift = (3u - (a & 3u)) * 8u; const std::uint32_t mem = gen::ld32(a & ~3u); {}(void)mem; }} ", addr(w),
+                           set(rt, std::format("(mem << shift) | (shift ? ({} & ((1u << shift) - 1u)) : 0u)", Rt)));
+    case 0x26:
+        return std::format("{{ const std::uint32_t a = {}, shift = (a & 3u) * 8u; const std::uint32_t mem = gen::ld32(a & ~3u); {}(void)mem; }} ", addr(w),
+                           set(rt, std::format("(mem >> shift) | (shift ? ({} & ~(0xFFFFFFFFu >> shift)) : 0u)", Rt)));
+    case 0x28: return std::format("gen::st8({}, {}); ", addr(w), Rt);
+    case 0x29: return std::format("gen::st16({}, {}); ", addr(w), Rt);
+    case 0x2B: return std::format("gen::st32({}, {}); ", addr(w), Rt);
+    case 0x2A:
+        return std::format("{{ const std::uint32_t a = {}, shift = (3u - (a & 3u)) * 8u; const std::uint32_t mem = gen::ld32(a & ~3u); "
+                           "gen::st32(a & ~3u, ({} >> shift) | (shift ? (mem & ~(0xFFFFFFFFu >> shift)) : 0u)); }} ",
+                           addr(w), Rt);
+    case 0x2E:
+        return std::format("{{ const std::uint32_t a = {}, shift = (a & 3u) * 8u; const std::uint32_t mem = gen::ld32(a & ~3u); "
+                           "gen::st32(a & ~3u, ({} << shift) | (shift ? (mem & ((1u << shift) - 1u)) : 0u)); }} ",
+                           addr(w), Rt);
+    case 0x2F: return "";
+    default: return "";
+    }
+}
+
+// The condition of a conditional branch, read before its delay slot runs.
+std::string condition(std::uint32_t w) {
+    const std::uint32_t op = w >> 26, rs = (w >> 21) & 31u, rt = (w >> 16) & 31u;
+    switch (op) {
+    case 0x01: return (rt & 1u) ? std::format("static_cast<std::int32_t>(r[{}]) >= 0", rs) : std::format("static_cast<std::int32_t>(r[{}]) < 0", rs);
+    case 0x04: return std::format("r[{}] == r[{}]", rs, rt);
+    case 0x05: return std::format("r[{}] != r[{}]", rs, rt);
+    case 0x06: return std::format("static_cast<std::int32_t>(r[{}]) <= 0", rs);
+    default: return std::format("static_cast<std::int32_t>(r[{}]) > 0", rs);
+    }
+}
+
+struct Block {
+    std::uint32_t pc, length;
+    std::string name, body;
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> entries;  // (pc, instructions before it): resumes after a store, called starts
+};
+
+std::vector<Block> translate(const Module &m) {
+    const std::uint32_t end = m.base + static_cast<std::uint32_t>(m.text.size() & ~3u);
+    const std::uint32_t count = (end - m.base) / 4;
+    std::vector<bool> excluded(count, false);
+    // import stub tables (rewritten by the loader) and export tables (addresses, not code)
+    for (std::uint32_t pc = m.base; pc + 4 <= end; pc += 4) {
+        const std::uint32_t w = word(m, pc);
+        if (w == 0x41E00000u && pc + 20 <= end) {
+            std::uint32_t stub = pc + 20;
+            while (stub + 8 <= end && word(m, stub) == 0x03E00008u && (word(m, stub + 4) & 0xFFFF0000u) == 0x24000000u) stub += 8;
+            for (std::uint32_t a = pc; a < stub; a += 4) excluded[(a - m.base) / 4] = true;
+        } else if (w == 0x41C00000u && pc + 20 <= end) {
+            std::uint32_t a = pc + 20;
+            while (a + 4 <= end && word(m, a)) a += 4;
+            for (std::uint32_t x = pc; x < std::min(a + 4, end); x += 4) excluded[(x - m.base) / 4] = true;
+        }
+    }
+    const auto ok = [&](std::uint32_t pc) { return pc >= m.base && pc + 4 <= end && !excluded[(pc - m.base) / 4]; };
+    std::set<std::uint32_t> leaders{m.base};
+    for (std::uint32_t pc = m.base; pc + 4 <= end; pc += 4) {
+        if (!ok(pc)) continue;
+        const std::uint32_t w = word(m, pc);
+        const Insn i = classify(w, pc);
+        if (i.kind == Kind::Branch || i.kind == Kind::Jump) {
+            if (ok(i.target) && (i.target & 3u) == 0) leaders.insert(i.target);
+        }
+        if (i.kind == Kind::Branch || i.kind == Kind::Jump || i.kind == Kind::JumpReg) leaders.insert(pc + 8);
+        if (i.kind == Kind::Syscall || i.kind == Kind::Status || i.kind == Kind::Stop) leaders.insert(pc + 4);
+        // a word holding an address in this text: a function pointer (a thread, an RPC handler)
+        if (w >= m.base && w < end && (w & 3u) == 0) leaders.insert(w);
+    }
+    // Function starts reached in ways the leaders above miss: through an address the code builds (a
+    // lui, then an addiu or ori: a thread, a callback, an interrupt handler), or from outside (the
+    // module's start routine, which the loader calls): the first instruction after the padding that
+    // follows a jr ra and its delay slot. They become entries into the block they fall in, like the
+    // resume points, so the blocks themselves stay as they are.
+    std::set<std::uint32_t> called;
+    {
+        std::uint32_t upper[32] = {};
+        bool known[32] = {};
+        for (std::uint32_t pc = m.base; pc + 4 <= end; pc += 4) {
+            if (!ok(pc)) continue;
+            const std::uint32_t w = word(m, pc), op = w >> 26, rs = (w >> 21) & 31u, rt = (w >> 16) & 31u;
+            if (op == 0x0F) {
+                upper[rt] = w << 16;
+                known[rt] = true;
+            } else if ((op == 0x09 || op == 0x0D) && known[rs]) {
+                const std::uint32_t v = op == 0x09 ? upper[rs] + static_cast<std::uint32_t>(simm(w)) : upper[rs] | (w & 0xFFFFu);
+                if (ok(v) && (v & 3u) == 0) called.insert(v);
+            }
+            if (w == 0x03E00008u) {
+                std::uint32_t a = pc + 8;
+                while (ok(a) && word(m, a) == 0) a += 4;
+                if (a > pc + 8 && ok(a)) called.insert(a);
+            }
+        }
+    }
+    std::vector<Block> blocks;
+    for (const std::uint32_t start : leaders) {
+        if (!ok(start)) continue;
+        std::string body;
+        std::uint32_t pc = start, n = 0;
+        bool closed = false;
+        std::vector<std::pair<std::uint32_t, std::uint32_t>> entries;
+        bool resume_here = false;  // the previous instruction was a store: a thread may resume here
+        while (!closed && n < 256) {
+            if (!ok(pc) || (pc != start && leaders.count(pc))) break;
+            const std::uint32_t w = word(m, pc);
+            const Insn i = classify(w, pc);
+            if (i.kind == Kind::Stop) break;
+            if (i.kind == Kind::Branch || i.kind == Kind::Jump || i.kind == Kind::JumpReg) {
+                const std::uint32_t slot = pc + 4;
+                if (!ok(slot)) break;
+                const std::uint32_t sw = word(m, slot);
+                const Kind sk = classify(sw, slot).kind;
+                if (sk != Kind::Plain && sk != Kind::Store) break;  // the interpreter runs this pair
+                if (pc != start && (resume_here || called.count(pc))) {
+                    entries.push_back({pc, n});
+                    body += std::format("  e{}:\n", n);
+                }
+                std::string head, target;
+                const std::uint32_t op = w >> 26, rs = (w >> 21) & 31u, rd = (w >> 11) & 31u, rt = (w >> 16) & 31u;
+                if (i.kind == Kind::Branch) {
+                    head = std::format("const bool taken = {}; ", condition(w));
+                    if (op == 0x01 && (rt & 0x1Eu) == 0x10u) head += std::format("r[31] = {}; ", hex(pc + 8));
+                    target = std::format("taken ? {} : {}", hex(i.target), hex(pc + 8));
+                } else if (i.kind == Kind::Jump) {
+                    if (op == 0x03) head = std::format("r[31] = {}; ", hex(pc + 8));
+                    target = hex(i.target);
+                } else {
+                    head = std::format("const std::uint32_t to = r[{}]; ", rs);
+                    if ((w & 63u) == 0x09 && rd) head += std::format("r[{}] = {}; ", rd, hex(pc + 8));
+                    target = "to";
+                }
+                n += 2;
+                body += std::format("    {{ {}{}c.pc = {}; c.npc = c.pc + 4u; return {}u - skip; }}\n", head, plain(sw, slot), target, n);
+                closed = true;
+                break;
+            }
+            if (pc != start && (resume_here || called.count(pc))) {
+                entries.push_back({pc, n});
+                body += std::format("  e{}:\n", n);
+            }
+            resume_here = i.kind == Kind::Store;
+            ++n;
+            if (i.kind == Kind::Syscall) {
+                body += std::format("    c.pc = {}; c.npc = {}; gen::syscall(c, {}); return {}u - skip;\n", hex(pc + 4), hex(pc + 8), hex(pc), n);
+                closed = true;
+                break;
+            }
+            if (i.kind == Kind::Status) {
+                body += std::format("    c.pc = {}; c.npc = {}; gen::set_status(c, r[{}]); return {}u - skip;\n", hex(pc + 4), hex(pc + 8), (w >> 16) & 31u, n);
+                closed = true;
+                break;
+            }
+            body += "    " + plain(w, pc);
+            if (i.kind == Kind::Store) body += std::format("if (gen::switch_pending()) {{ c.pc = {}; c.npc = {}; return {}u - skip; }}", hex(pc + 4), hex(pc + 8), n);
+            body += "\n";
+            pc += 4;
+        }
+        if (!n) continue;
+        if (!closed) body += std::format("    c.pc = {}; c.npc = {}; return {}u - skip;\n", hex(pc), hex(pc + 4), n);
+        std::string prologue = "    std::uint32_t skip = 0;\n";
+        if (!entries.empty()) {
+            prologue += std::format("    if (c.pc != {}) {{\n        switch (c.pc) {{\n", hex(start));
+            for (const auto &[at, before] : entries) prologue += std::format("        case {}: skip = {}u; goto e{};\n", hex(at), before, before);
+            prologue += "        default: break;\n        }\n    }\n";
+        }
+        std::string id;
+        for (const char ch : m.name) id += std::isalnum(static_cast<unsigned char>(ch)) ? ch : '_';
+        blocks.push_back({start, n, std::format("iop_{}_{:08X}", id, start), prologue + body, entries});
+    }
+    return blocks;
+}
+
+}
+
+int main(int argc, char **argv) {
+    if (argc < 3) {
+        std::fprintf(stderr, "usage: ioprecomp <relocated modules dir> <out dir>\n");
+        return 1;
+    }
+    const fs::path in_dir = argv[1], out_dir = argv[2];
+    std::vector<Module> modules;
+    if (fs::exists(in_dir))
+        for (const auto &e : fs::directory_iterator(in_dir)) {
+            if (e.path().extension() != ".bin") continue;
+            const std::string stem = e.path().stem().string();
+            const auto underscore = stem.rfind('_');
+            if (underscore == std::string::npos) continue;
+            Module m{stem.substr(0, underscore), static_cast<std::uint32_t>(std::stoul(stem.substr(underscore + 1), nullptr, 16)), {}};
+            std::ifstream f(e.path(), std::ios::binary);
+            m.text.assign(std::istreambuf_iterator<char>(f), std::istreambuf_iterator<char>());
+            modules.push_back(std::move(m));
+        }
+    std::sort(modules.begin(), modules.end(), [](const Module &a, const Module &b) { return a.base < b.base; });
+    fs::create_directories(out_dir);
+    for (const auto &e : fs::directory_iterator(out_dir))
+        if (e.path().filename().string().rfind("iop_", 0) == 0) fs::remove(e.path());
+    const std::string head = "#include \"ps2/iop_gen.hpp\"\n\n#include <cstdint>\n\nnamespace gen_iop {\n\nusing namespace ps2::iop;\n\n";
+    std::string table = head, registration;
+    std::size_t file = 0, total_blocks = 0, total_insns = 0, total_entries = 0;
+    for (const Module &m : modules) {
+        const std::vector<Block> blocks = translate(m);
+        constexpr std::size_t kPerFile = 400;
+        for (std::size_t first = 0; first < blocks.size(); first += kPerFile) {
+            std::string text = head;
+            for (std::size_t i = first; i < std::min(blocks.size(), first + kPerFile); ++i)
+                text += std::format("std::uint32_t {}(Cpu &c) {{\n    std::uint32_t *r = c.r;\n{}}}\n\n", blocks[i].name, blocks[i].body);
+            text += "}\n";
+            std::ofstream(out_dir / std::format("iop_{:03}.cpp", file++)) << text;
+        }
+        std::string id;
+        for (const char ch : m.name) id += std::isalnum(static_cast<unsigned char>(ch)) ? ch : '_';
+        for (const Block &b : blocks) table += std::format("std::uint32_t {}(Cpu &c);\n", b.name);
+        table += std::format("const gen::Block kBlocks_{}[] = {{\n", id);
+        std::size_t rows = 0;
+        for (const Block &b : blocks) {
+            table += std::format("    {{0x{:08X}u, {}u, {}}},\n", b.pc, b.length, b.name);
+            for (const auto &[at, before] : b.entries) table += std::format("    {{0x{:08X}u, {}u, {}}},\n", at, b.length - before, b.name);
+            rows += 1 + b.entries.size();
+        }
+        if (blocks.empty()) table += "    {0, 0, nullptr},\n";
+        table += "};\n\n";
+        registration += std::format("    ps2::iop::gen::register_module({{\"{}\", 0x{:08X}u, {}u, 0x{:016X}ull, gen_iop::kBlocks_{}, {}u}});\n", m.name, m.base, m.text.size(), ps2::iop::gen::code_hash(m.text.data(), m.text.size()), id, rows);
+        total_blocks += blocks.size();
+        std::size_t entries = 0;
+        for (const Block &b : blocks) {
+            total_insns += b.length;
+            entries += b.entries.size();
+        }
+        total_entries += entries;
+        std::printf("%s at 0x%08X: %zu blocks, %zu resume entries\n", m.name.c_str(), m.base, blocks.size(), entries);
+    }
+    table += "}\n\nvoid register_generated_iop() {\n" + registration + "}\n";
+    std::ofstream(out_dir / "iop_table.cpp") << table;
+    std::printf("%zu IOP modules, %zu blocks (%zu more entries to resume at), %zu instructions\n", modules.size(), total_blocks, total_entries, total_insns);
+    return 0;
+}
