diff --git a/runtime/src/iop/compiled.cpp b/runtime/src/iop/compiled.cpp
new file mode 100644
index 0000000..ed9271c
--- /dev/null
+++ b/runtime/src/iop/compiled.cpp
@@ -0,0 +1,119 @@
+// The IOP modules' translated code (ioprecomp, built into game.dll): which blocks are in use, and
+// the memory and kernel calls those blocks make. A module's blocks are used only while it is
+// loaded at the address it was translated for with the same code; anything else is interpreted.
+#include "compiled.hpp"
+
+#include "iop.hpp"
+#include "kernel.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+namespace ps2::iop {
+
+namespace {
+
+std::vector<gen::Module> g_registered;
+std::vector<const gen::Block *> g_table;  // by physical address / 4
+bool g_any = false;
+
+std::vector<JournalEntry> *g_journal = nullptr;
+bool g_touched_io = false;
+
+bool in_ram(std::uint32_t a) { return phys(a) < kRamSize; }
+
+void journal(std::uint32_t a, unsigned size) {
+    if (!g_journal) return;
+    if (!in_ram(a)) {
+        g_touched_io = true;
+        return;
+    }
+    JournalEntry e{a, size, 0, 0};
+    std::memcpy(&e.old, ram_ptr(a), size);
+    g_journal->push_back(e);
+}
+
+}
+
+namespace gen {
+
+void register_module(const Module &m) { g_registered.push_back(m); }
+
+std::uint32_t ld8(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read8(a);
+}
+std::uint32_t ld16(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read16(a);
+}
+std::uint32_t ld32(std::uint32_t a) {
+    if (g_journal && !in_ram(a)) g_touched_io = true;
+    return read32(a);
+}
+void st8(std::uint32_t a, std::uint32_t v) {
+    journal(a, 1);
+    write8(a, static_cast<std::uint8_t>(v));
+}
+void st16(std::uint32_t a, std::uint32_t v) {
+    journal(a, 2);
+    write16(a, static_cast<std::uint16_t>(v));
+}
+void st32(std::uint32_t a, std::uint32_t v) {
+    journal(a, 4);
+    write32(a, v);
+}
+bool switch_pending() { return kernel::switch_pending(); }
+void syscall(Cpu &c, std::uint32_t pc) {
+    if (g_journal) g_touched_io = true;
+    kernel::syscall(c, pc);
+    c.r[0] = 0;
+}
+void set_status(Cpu &c, std::uint32_t value) {
+    if (g_journal) g_touched_io = true;
+    kernel::set_status(c, value);
+}
+void brk(std::uint32_t pc) { std::fprintf(stderr, "[iop] break at 0x%08X\n", pc); }
+
+}
+
+void refresh_compiled() {
+    static const bool off = std::getenv("PS2_IOP_INTERPRET") || std::getenv("PS2_IOP_PROBE");
+    if (g_table.empty()) g_table.assign(kRamSize / 4, nullptr);
+    else std::fill(g_table.begin(), g_table.end(), nullptr);
+    g_any = false;
+    if (off) return;
+    for (const gen::Module &m : g_registered) {
+        bool loaded = false;
+        for (const auto &[id, mod] : kernel::modules()) loaded = loaded || mod.base == m.base;
+        if (!loaded || m.base + m.text_size > kRamSize) continue;
+        if (gen::code_hash(ram_ptr(m.base), m.text_size) != m.hash) {
+            std::fprintf(stderr, "[iop] %s at 0x%08X is not the code it was translated from: interpreted\n", m.name, m.base);
+            continue;
+        }
+        for (std::uint32_t i = 0; i < m.count; ++i) g_table[(phys(m.blocks[i].pc) & (kRamSize - 1)) >> 2] = &m.blocks[i];
+        g_any = true;
+    }
+}
+
+const gen::Block *compiled_block(std::uint32_t pc) {
+    if (!g_any) return nullptr;
+    const std::uint32_t p = phys(pc);
+    return p < kRamSize ? g_table[p >> 2] : nullptr;
+}
+
+void begin_journal(std::vector<JournalEntry> &entries) {
+    entries.clear();
+    g_journal = &entries;
+    g_touched_io = false;
+}
+
+bool end_journal() {
+    g_journal = nullptr;
+    return !g_touched_io;
+}
+
+}
diff --git a/runtime/src/iop/compiled.hpp b/runtime/src/iop/compiled.hpp
new file mode 100644
index 0000000..1f5c0c6
--- /dev/null
+++ b/runtime/src/iop/compiled.hpp
@@ -0,0 +1,22 @@
+#pragma once
+
+#include "ps2/iop_gen.hpp"
+
+#include <cstdint>
+#include <vector>
+
+namespace ps2::iop {
+
+// The translated block starting at pc, if its module's code is in use.
+const gen::Block *compiled_block(std::uint32_t pc);
+
+// PS2_IOP_CHECK: a translated block's RAM writes, so the interpreter can rerun it from the same
+// state. end_journal is false when the block touched anything but RAM (hardware, the kernel),
+// which a rerun would repeat.
+struct JournalEntry {
+    std::uint32_t address, size, old, now;
+};
+void begin_journal(std::vector<JournalEntry> &entries);
+bool end_journal();
+
+}
diff --git a/runtime/src/iop/cpu.cpp b/runtime/src/iop/cpu.cpp
index da4b3e4..b4e6744 100644
--- a/runtime/src/iop/cpu.cpp
+++ b/runtime/src/iop/cpu.cpp
@@ -1,9 +1,12 @@
+#include "compiled.hpp"
 #include "iop.hpp"
 #include "kernel.hpp"
 
+#include <algorithm>
 #include <cstdio>
 #include <cstdlib>
 #include <cstring>
+#include <unordered_map>
 #include <vector>
 
 namespace ps2::iop {
@@ -58,10 +61,114 @@ std::uint32_t fetch(std::uint32_t pc) {
     return kernel::fetch_special(pc);
 }
 
+void execute(Cpu &c, std::int64_t &budget);
+
+bool g_interpret_only = false;  // PS2_IOP_CHECK's reference runs
+
+// PS2_IOP_CHECK: a translated block, then the interpreter over the same instructions from the
+// same state; reports where they differ and keeps the interpreter's result. Blocks that touch
+// anything but RAM are run once, translated, as a rerun would repeat their side effects.
+std::uint32_t run_checked(Cpu &c, const gen::Block &b) {
+    static std::vector<JournalEntry> writes;
+    static std::uint64_t checked = 0, skipped = 0, mismatches = 0;
+    const Cpu before = c;
+    begin_journal(writes);
+    const std::uint32_t n = b.fn(c);
+    const bool pure = end_journal();
+    if (!pure || kernel::switch_pending()) {
+        ++skipped;
+        return n;
+    }
+    const Cpu compiled = c;
+    for (JournalEntry &w : writes) std::memcpy(&w.now, ram_ptr(w.address), w.size);
+    for (auto it = writes.rbegin(); it != writes.rend(); ++it) std::memcpy(ram_ptr(it->address), &it->old, it->size);
+    c = before;
+    std::int64_t budget = n;
+    g_interpret_only = true;
+    execute(c, budget);
+    g_interpret_only = false;
+    ++checked;
+    bool memory_same = true;
+    for (const JournalEntry &w : writes) {
+        std::uint32_t now = 0;
+        std::memcpy(&now, ram_ptr(w.address), w.size);
+        memory_same = memory_same && now == w.now;
+    }
+    if (std::memcmp(&compiled, &c, sizeof c) != 0 || !memory_same) {
+        if (++mismatches <= 20) {
+            int reg = -1;
+            for (int i = 0; i < 32 && reg < 0; ++i)
+                if (compiled.r[i] != c.r[i]) reg = i;
+            std::fprintf(stderr, "[iop-check] block 0x%08X (%u instructions): r%d %08X/%08X hi/lo %d pc %08X/%08X npc %08X/%08X cop0 %d memory %s\n", b.pc, n, reg,
+                         reg >= 0 ? compiled.r[reg] : 0u, reg >= 0 ? c.r[reg] : 0u, compiled.hi != c.hi || compiled.lo != c.lo, compiled.pc, c.pc, compiled.npc, c.npc,
+                         compiled.status != c.status || compiled.cause != c.cause || compiled.epc != c.epc, memory_same ? "same" : "differs");
+        }
+    }
+    if ((checked + skipped) % 20000 == 0)
+        std::fprintf(stderr, "[iop-check] %llu blocks compared, %llu differ, %llu not comparable (they touch hardware)\n", static_cast<unsigned long long>(checked),
+                     static_cast<unsigned long long>(mismatches), static_cast<unsigned long long>(skipped));
+    return n;
+}
+
+// Development measurement (PS2_IOP_COUNT[=n]): instructions run translated and interpreted, and the
+// addresses interpreted most (outside the native-call stubs), printed every n instructions (50 million
+// when no n is given).
+std::uint64_t g_compiled_count = 0, g_interpreted_count = 0, g_native_calls = 0;
+std::unordered_map<std::uint32_t, std::uint64_t> g_misses;
+
+void report_counts() {
+    std::vector<std::pair<std::uint64_t, std::uint32_t>> top;
+    for (const auto &[pc, n] : g_misses) top.push_back({n, pc});
+    std::sort(top.rbegin(), top.rend());
+    std::fprintf(stderr, "[iop-count] %llu translated, %llu interpreted, %llu native calls:", static_cast<unsigned long long>(g_compiled_count),
+                 static_cast<unsigned long long>(g_interpreted_count), static_cast<unsigned long long>(g_native_calls));
+    for (std::size_t i = 0; i < top.size() && i < 12; ++i) std::fprintf(stderr, " %08X:%llu", top[i].second, static_cast<unsigned long long>(top[i].first));
+    std::fprintf(stderr, "\n");
+}
+
 void execute(Cpu &c, std::int64_t &budget) {
     static const bool probing = load_probes();
+    static const bool check = std::getenv("PS2_IOP_CHECK") != nullptr;
+    static const char *const count_spec = std::getenv("PS2_IOP_COUNT");
+    static const bool counting = count_spec != nullptr;
+    static const std::uint64_t count_every = count_spec && std::strtoull(count_spec, nullptr, 10) ? std::strtoull(count_spec, nullptr, 10) : 50'000'000ull;
+    if (counting && g_compiled_count + g_interpreted_count > count_every) {
+        report_counts();
+        g_compiled_count = g_interpreted_count = g_native_calls = 0;
+        g_misses.clear();
+    }
     while (budget-- > 0) {
         const std::uint32_t pc = c.pc;
+        // The module's translated code from here, unless pc is a branch's delay slot: the same
+        // instructions and thread switches as below. A block may run past the slice's end (the
+        // scheduler counts that time), as the IOP's real timing has no slices to keep.
+        if (const gen::Block *b = g_interpret_only ? nullptr : compiled_block(pc); b && c.npc == pc + 4) {
+            const std::uint32_t n = check ? run_checked(c, *b) : b->fn(c);
+            budget -= static_cast<std::int64_t>(n) - 1;
+            if (counting) g_compiled_count += n;
+            if (kernel::switch_pending()) return;
+            continue;
+        }
+        // A linked import stub, "j export; nop": a call into another module's library, followed
+        // directly.
+        if (!g_interpret_only && c.npc == pc + 4) {
+            const std::uint32_t w = fetch(pc);
+            if ((w >> 26) == 2u && fetch(pc + 4) == 0) {
+                c.pc = (pc & 0xF0000000u) | ((w & 0x03FFFFFFu) << 2);
+                c.npc = c.pc + 4;
+                budget -= 1;
+                if (counting) g_compiled_count += 2;
+                continue;
+            }
+        }
+        if (counting && !g_interpret_only) {
+            if (fetch(pc) >> 26 == kHleOpcode) {
+                ++g_native_calls;
+            } else {
+                ++g_interpreted_count;
