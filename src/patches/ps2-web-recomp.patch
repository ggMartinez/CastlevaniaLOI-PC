+// Called every frame on the presenting thread: picks up finished quick saves and loads, lets the
+// message expire and draws the display again when something on it changed.
+void refresh_osd() {
+    switch (g_state_done.exchange(0)) {
+    case 1: osd_message("State saved", 0x80FF80); break;
+    case 2: osd_message("State loaded", 0x80FF80); break;
+    case 3: osd_message("Saving the state failed", 0xFF8080); break;
+    case 4: osd_message("Loading the state failed", 0xFF8080); break;
+    default: break;
+    }
+    if (!g_osd_message.empty() && SDL_GetTicks64() >= g_osd_message_until) {
+        g_osd_message.clear();
+        g_osd_dirty = true;
+    }
+    if (!g_osd_dirty || !g_gpu_present) return;
+    g_osd_dirty = false;
+    std::vector<OsdLine> lines;
+    if (g_osd_stats) lines = g_stats_lines.empty() ? std::vector<OsdLine>{{"Measuring...", 0xFFFFFF}} : g_stats_lines;
+    if (!g_osd_message.empty()) lines.push_back({g_osd_message, g_osd_message_rgb});
+    if (lines.empty()) {
+        ps2::set_osd(nullptr, 0, 0);
+        return;
+    }
+#ifdef _WIN32
+    draw_osd(lines);
+#endif
+}
