+#pragma once
+
+#include <cstdint>
+
+// The GS's pixel layouts: where each pixel of each format sits in the GS's 4 MB of memory (pages of 8 KB,
+// blocks of 256 bytes, columns, and the order within them). One copy, used by the GS emulation (gs.cpp, and
+// through tables() its GPU shaders), the native renderer and the tests.
+namespace ps2::gs::swizzle {
+
+// Byte offsets within a page, by pixel position in the page (4-bit: nibble offsets).
+struct Tables {
+    std::uint32_t off32[32][64], offz32[32][64];
+    std::uint32_t off16[64][64], off16s[64][64], offz16[64][64], offz16s[64][64];
+    std::uint32_t off8[64][128], off4[128][128];
+};
+const Tables &tables();
+
+// The address of the page holding (x, y) for a buffer at block bp, bw x 64 pixels wide, with pages of pw x ph.
+std::uint32_t page_address(std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y, std::uint32_t pw, std::uint32_t ph);
+
+// mem is the GS memory (4 MB); addresses wrap at its end, as the GS's do.
+std::uint32_t read_pixel(const std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y);
+// n pixels of row y from x0 on, as read_pixel would read them one by one (the fast path for whole textures).
+void read_row(const std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x0, std::uint32_t y, std::uint32_t n, std::uint32_t *out);
+void write_pixel(std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y, std::uint32_t value);
+
+}
