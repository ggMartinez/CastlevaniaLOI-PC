+++ b/tests/mcfs_test.cpp
@@ -0,0 +1,151 @@
+// Tests the native memory card file system (runtime/src/iop/mcfs.cpp) on a card image in memory: run the
+// built mcfs_test; it exits 0 when every check passes and prints each failure otherwise. (The card the
+// game writes through it is compared with the one MCMAN writes by running the game: see ROADMAP.md.)
+#include "iop/mcfs.hpp"
+
+#include <cstdio>
+#include <cstring>
+#include <string>
+#include <vector>
+
+using namespace ps2::iop::mcfs;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+std::uint32_t u32(const std::vector<std::uint8_t> &image, std::size_t at) {
+    std::uint32_t v;
+    std::memcpy(&v, image.data() + at, 4);
+    return v;
+}
+
+const std::uint8_t *page(const std::vector<std::uint8_t> &image, std::uint32_t n) { return image.data() + static_cast<std::size_t>(n) * kPageBytes; }
+
+// FAT entry n of a freshly formatted card: FAT clusters 9.. sit at pages 18..
+std::uint32_t fat(const std::vector<std::uint8_t> &image, std::uint32_t n) {
+    const std::uint32_t cluster = 9 + n / 256, offset = (n % 256) * 4;
+    return u32(image, static_cast<std::size_t>(cluster * 2 + offset / 512) * kPageBytes + offset % 512);
+}
+
+const Time kNow = {0, 44, 4, 21, 8, 11, 0xEA, 0x07};  // 21:04:44, 8 November 2026
+
+void ecc() {
+    std::uint8_t ff[512], out[12];
+    std::memset(ff, 0xFF, sizeof ff);
+    page_ecc(ff, out);
+    const std::uint8_t expected[12] = {0x77, 0x7F, 0x7F, 0x77, 0x7F, 0x7F, 0x77, 0x7F, 0x7F, 0x77, 0x7F, 0x7F};
+    check(std::memcmp(out, expected, 12) == 0, "error correction of an erased page");
+    std::uint8_t one[512] = {};
+    one[0] = 1;
+    page_ecc(one, out);
+    // A single 1 bit in byte 0: column parity of bit 0, line parity of index 0.
+    check(out[0] == (0x77 ^ 0x07) && out[1] == 0 && out[2] == 0x7F, "error correction of one set bit");
+}
+
+void format_blank() {
+    std::vector<std::uint8_t> image(kImageBytes, 0xFF);
+    Card card(image);
+    check(!card.formatted(), "a blank card is not formatted");
+    check(card.format(kNow) == kOk, "format succeeds");
+    card.commit();
+    check(card.formatted(), "formatted after format");
+    check(std::memcmp(page(image, 0), "Sony PS2 Memory Card Format 1.2.0.0", 35) == 0, "superblock magic and version");
+    check(u32(image, 0x34) == 41 && u32(image, 0x38) == 8135 && u32(image, 0x170) == 8001, "superblock geometry");
+    check(u32(image, 0x50) == 8 && u32(image, 16 * kPageBytes) == 9 && u32(image, 16 * kPageBytes + 31 * 4) == 40, "indirect FAT list");
+    check(fat(image, 0) == 0xFFFFFFFFu && fat(image, 1) == 0x7FFFFFFFu && fat(image, 8134) == 0x7FFFFFFFu && fat(image, 8135) == 0xFFFFFFFFu,
+          "FAT after format");
+    check(card.free_clusters() == 8000, "8000 free clusters after format");
+    // Blocks 0 to 5 written in full (each page with its error correction), the rest erased.
+    std::uint8_t ecc[12];
+    page_ecc(page(image, 85), ecc);
+    check(std::memcmp(page(image, 85) + 512, ecc, 12) == 0 && page(image, 85)[524] == 0, "unused page of a written block carries its ECC");
+    check(page(image, 96)[512] == 0xFF, "pages of unwritten blocks stay erased");
+    std::vector<Listing> list;
+    check(card.list("/*", 24, list) == 2 && std::strcmp(reinterpret_cast<const char *>(list[0].data() + 32), ".") == 0,
+          "the root lists . and ..");
+    check(card.entry_space("/") == 0, "no free entries in a new root");
+}
+
+void save_and_load() {
+    std::vector<std::uint8_t> image(kImageBytes, 0xFF);
+    Card card(image);
+    card.format(kNow);
+    card.commit();
+    const Time kLater = {0, 45, 4, 21, 8, 11, 0xEA, 0x07};
+    check(card.open("/SAVE", kCreateDir, kLater) == kOk, "make a directory");
+    card.commit();
+    {
+        // Its ".." carries the root's dates (from the format), its "." the time it was made.
+        const std::uint8_t *dot = page(image, (41 + 2) * 2), *dotdot = page(image, (41 + 2) * 2 + 1);
+        check(dot[9] == 45 && dotdot[9] == 44 && dotdot[25] == 44, "dates of a new directory's . and ..");
+    }
+    check(card.entry_space("/") == 1, "one free entry after the directory");
+    std::vector<std::uint8_t> data(3000);
+    for (std::size_t i = 0; i < data.size(); ++i) data[i] = static_cast<std::uint8_t>(i * 7);
+    const int fd = card.open("/SAVE/file", kCreate | kWrite, kNow);
+    check(fd == 0, "create a file");
+    check(card.write(fd, data.data(), static_cast<std::uint32_t>(data.size())) == 3000, "write 3000 bytes");
+    check(card.close(fd, kNow) == kOk, "close");
+    card.commit();
+    // Root grew by cluster 1, the directory took 2, its third entry 3, the file 4 to 6.
+    check(fat(image, 0) == 0x80000001u && fat(image, 2) == 0x80000003u && fat(image, 4) == 0x80000005u && fat(image, 6) == 0xFFFFFFFFu,
+          "lowest free clusters, in order");
+    check(card.free_clusters() == 8001 - 7, "free clusters after the save");
+    std::vector<Listing> list;
+    check(card.list("/SAVE/*", 24, list) == 3, "the directory lists 3 entries");
+    check(card.list("/SAVE", 24, list) == 1 && u32(std::vector<std::uint8_t>(list[0].begin(), list[0].end()), 16) == 0, "a directory lists a size of 0");
+    {
+        // "." shows the dates of the directory's own entry (in the root): change that entry's date and look.
+        const Time later = {0, 50, 4, 21, 8, 11, 0xEA, 0x07};
+        const int f = card.open("/SAVE/file", kWrite, later);
+        card.write(f, data.data(), 1);
+        card.close(f, later);  // dates the file, and the directory's own entry
+        card.commit();
+        card.list("/SAVE/*", 24, list);
+        // (byte 9: seconds of the modified date) "." is the directory's entry, dated at the close; ".." the root's ".", dated when the directory was made.
+        check(list[0][9] == 50 && list[1][9] == 45, "the dates of . and .. are those of the entries they stand for");
+    }
+    const int in = card.open("/SAVE/file", kRead, kNow);
+    std::vector<std::uint8_t> back(4000);
+    check(card.read(in, back.data(), 4000) == 3000 && std::memcmp(back.data(), data.data(), 3000) == 0, "read back what was written");
+    card.close(in, kNow);
+    check(card.open("/SAVE/none", kRead, kNow) == kNoEntry, "a missing file");
+    check(card.open("/NONE/file", kRead, kNow) == kNoEntry, "a file in a missing directory");
+    // The backup block holds the last block written, and the second backup block is erased.
+    const std::size_t block = 16 * kPageBytes;
+    bool backup_matches = false;
+    for (std::size_t b = 0; b < 1022 && !backup_matches; ++b)
+        backup_matches = std::memcmp(image.data() + 1023 * block, image.data() + b * block, block) == 0;
+    check(backup_matches && image[1022 * block] == 0xFF, "backup blocks");
+}
+
+void reads_do_not_write() {
+    std::vector<std::uint8_t> image(kImageBytes, 0xFF);
+    Card card(image);
+    card.format(kNow);
+    card.commit();
+    const std::vector<std::uint8_t> before = image;
+    std::vector<Listing> list;
+    card.list("/*", 24, list);
+    card.free_clusters();
+    check(!card.commit() && image == before, "listing and counting change nothing");
+}
+
+}  // namespace
+
+int main() {
+    ecc();
+    format_blank();
+    save_and_load();
+    reads_do_not_write();
+    if (g_failures) return 1;
+    std::printf("mcfs_test: all checks passed\n");
+    return 0;
+}
diff --git a/tests/native_convert_test.cpp b/tests/native_convert_test.cpp
new file mode 100644
index 0000000..3779211
--- /dev/null
+++ b/tests/native_convert_test.cpp
@@ -0,0 +1,180 @@
+// Tests the native renderer's translation of GS state and vertices into draw state and GPU vertices
+// (runtime/src/gs/native/convert.cpp), with register values the game uses (design, Phase 0 findings): run the
+// built native_convert_test; it exits 0 when every check passes and prints each failure otherwise.
+#include "gs/native/convert.hpp"
+
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+using namespace ps2::gs;
+using namespace ps2::gs::native;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+bool near(float a, float b) { return std::fabs(a - b) < 1e-4f; }
+
+// A state drawing with context 0, attributes from PRIM, into a 32-bit frame with 16-bit depth.
+State base(std::uint64_t prim) {
+    State s{};
+    s.prim = prim;
+    s.prmodecont = 1;
+    s.colclamp = 1;
+    s.ctx[0].frame = (8ull << 16) | (0x00ull << 24);                  // FBP 0, FBW 8 (512 pixels), CT32
+    s.ctx[0].zbuf = 0xA8ull | (0xAull << 24);                         // ZBP 0xA8, Z16S
+    s.ctx[0].test = (1ull << 16) | (2ull << 17);                      // ZTE, ZTST >=
+    s.ctx[0].xyoffset = (0x8000ull) | (0x8000ull << 32);              // 2048.0, 2048.0
+    return s;
+}
+
+Vertex vert(float x, float y, std::uint32_t z = 0) {
+    Vertex v{};
+    v.x = static_cast<std::uint32_t>((2048.0f + x) * 16.0f);
+    v.y = static_cast<std::uint32_t>((2048.0f + y) * 16.0f);
+    v.z = z;
+    v.r = v.g = v.b = v.a = 0x80;
+    v.q = 1.0f;
+    return v;
+}
+
+void sprite_is_two_triangles() {
+    const State s = base(6);  // sprite
+    const Vertex v[2] = {vert(100, 100), vert(200, 150)};
+    std::vector<GpuVertex> out;
+    convert(s, 0, v, 2, out);
+    check(out.size() == 6, "a sprite gives 6 vertices");
+    float x0 = 1e9f, y0 = 1e9f, x1 = -1e9f, y1 = -1e9f;
+    for (const GpuVertex &g : out) {
+        x0 = std::fmin(x0, g.x), y0 = std::fmin(y0, g.y), x1 = std::fmax(x1, g.x), y1 = std::fmax(y1, g.y);
+    }
+    check(near(x0, 100) && near(y0, 100) && near(x1, 200) && near(y1, 150), "the sprite's triangles cover its box");
+    check(key_of(s, 0).topology == 2, "a sprite draws as triangles");
+}
+
+void xyoffset_applied() {
+    const State s = base(3);
+    const Vertex v[3] = {vert(100, 7), vert(0, 0), vert(1, 1)};
+    std::vector<GpuVertex> out;
+    convert(s, 0, v, 3, out);
+    check(out.size() == 3 && near(out[0].x, 100.0f) && near(out[0].y, 7.0f), "XYOFFSET is subtracted, 12.4 fixed point");
+}
+
+void z16s_range() {
+    const State s = base(3);
+    const Vertex v[3] = {vert(0, 0, 0xFFFF), vert(1, 0, 0), vert(0, 1, 0x7FFF8)};
+    std::vector<GpuVertex> out;
+    convert(s, 0, v, 3, out);
+    check(near(out[0].z, 1.0f) && near(out[1].z, 0.0f), "Z16S depth 0xFFFF is 1.0, 0 is 0.0");
+    check(near(out[2].z, 1.0f), "depth past the format's range clamps");
+}
+
+void normal_alpha_blend() {
+    State s = base(3 | (1 << 6));  // ABE
+    s.ctx[0].alpha = 0x44;
+    const DrawKey k = key_of(s, 0);
+    check(k.blend && k.blend_a == 0 && k.blend_b == 1 && k.blend_c == 0 && k.blend_d == 1, "ALPHA 0x44 is (Cs-Cd)*As+Cd");
+}
+
+void additive_fix() {
+    State s = base(3 | (1 << 6));
+    s.ctx[0].alpha = 0x68 | (128ull << 32);
+    const DrawKey k = key_of(s, 0);
+    check(k.blend_a == 0 && k.blend_b == 2 && k.blend_c == 2 && k.blend_d == 1 && k.blend_fix == 128, "ALPHA 0x68 fix 128 is Cs*FIX+Cd");
+}
+
+// FBA (alpha correction) changes what is stored, so it is part of the key.
+void fba_kept() {
+    State s = base(3);
+    check(!key_of(s, 0).fba, "FBA 0 is off");
+    s.ctx[0].fba = 1;
+    check(key_of(s, 0).fba, "FBA 1 is kept");
+}
+
+// The shadow volumes (design, Phase 0 findings): red only into a 16-bit target, adding with wrap; each
+// face adds one 5-bit step (red 8) or takes one away (red 0xF8). Natively a stencil step.
+void shadow_volume_steps() {
+    State s = base(3 | (1 << 6));
+    s.ctx[0].frame = (8ull << 16) | (0x0Aull << 24) | (0xFFFFFF00ull << 32);  // CT16S, red only
+    s.ctx[0].alpha = 0x68 | (128ull << 32);                                  // Cs*FIX+Cd, FIX 128
+    s.colclamp = 0;
+    Vertex v = vert(0, 0);
+    v.r = 8;
+    check(shadow_step(s, 0, v) == 1, "red 8 into the shadow buffer is a step up");
+    v.r = 0xF8;
+    check(shadow_step(s, 0, v) == -1, "red 0xF8 is a step down");
+    s.colclamp = 1;
+    check(shadow_step(s, 0, v) == 0, "with colour clamping it is an ordinary draw");
+    s.colclamp = 0;
+    s.ctx[0].frame = (8ull << 16) | (0x00ull << 24) | (0xFFFFFF00ull << 32);
+    check(shadow_step(s, 0, v) == 0, "into a 32-bit target it is an ordinary draw");
+}
+
+void alpha_test_never_fb_only() {
+    State s = base(3);
+    s.ctx[0].test |= 0x1001;  // ATE, ATST never, AFAIL framebuffer only
+    const DrawKey k = key_of(s, 0);
+    check(k.alpha_test == 1 /* always */ && !k.depth_write, "never + fb-only draws colour and no depth");
+    check(k.colour_mask == 0, "never + fb-only writes every colour channel");
+}
+
+void shadow_pass_mask_and_wrap() {
+    State s = base(3);
+    s.ctx[0].frame = (8ull << 16) | (0x0Aull << 24) | (0xFFFFFF00ull << 32);  // CT16S, red only
+    s.colclamp = 0;
+    const DrawKey k = key_of(s, 0);
+    check(k.colour_mask == 0xFFFFFF00u && k.colour_wrap, "FBMSK 0xFFFFFF00 and COLCLAMP 0 are kept");
+    const Target t = target_of(s, 0);
+    check(t.psm == 0x0A && t.fbw == 8 && t.zbp == 0xA8 * 32 && t.zpsm == 0x3A, "the target's format, width and depth buffer");
+}
+
+void stq_and_uv() {
+    State s = base(3 | (1 << 4));  // TME, STQ
+    s.ctx[0].tex0 = (8ull << 26) | (8ull << 30);  // 256 x 256
+    Vertex v[3] = {vert(0, 0), vert(1, 0), vert(0, 1)};
+    v[0].s = 0.25f, v[0].t = 0.5f, v[0].q = 2.0f;
+    std::vector<GpuVertex> out;
+    convert(s, 0, v, 3, out);
+    check(near(out[0].s, 0.25f) && near(out[0].t, 0.5f) && near(out[0].q, 2.0f), "STQ is kept as given");
+    s.prim |= 1 << 8;  // FST: UV in texels, 12.4
+    v[0].u = 64 * 16 + 8, v[0].v = 32 * 16;
+    out.clear();
+    convert(s, 0, v, 3, out);
+    check(near(out[0].s, 64.5f) && near(out[0].t, 32.0f) && near(out[0].q, 1.0f), "UV gives texels and q 1");
+    check(!key_of(s, 0).stq, "FST draws are keyed as UV");
+}
+
+void flat_uses_last_colour() {
+    const State s = base(3);  // no IIP: flat
+    Vertex v[3] = {vert(0, 0), vert(1, 0), vert(0, 1)};
+    v[2].r = 10, v[2].g = 20, v[2].b = 30, v[2].a = 40;
+    std::vector<GpuVertex> out;
+    convert(s, 0, v, 3, out);
+    check(out[0].rgba[0] == 10 && out[1].rgba[2] == 30 && out[2].rgba[3] == 40, "flat shading takes the last vertex's colour");
+}
+
+}  // namespace
+
+int main() {
+    sprite_is_two_triangles();
+    xyoffset_applied();
+    z16s_range();
+    normal_alpha_blend();
+    additive_fix();
+    alpha_test_never_fb_only();
+    fba_kept();
+    shadow_volume_steps();
+    shadow_pass_mask_and_wrap();
+    stq_and_uv();
+    flat_uses_last_colour();
+    if (g_failures) return 1;
+    std::printf("native_convert_test: all checks passed\n");
+    return 0;
+}
diff --git a/tests/native_interpolate_test.cpp b/tests/native_interpolate_test.cpp
new file mode 100644
index 0000000..b9952f2
--- /dev/null
+++ b/tests/native_interpolate_test.cpp
@@ -0,0 +1,189 @@
+// Tests frame interpolation's matching (runtime/src/gs/native/interpolate.cpp): which draw and which primitive
+// of a frame is which of the frame before, and where each vertex was. Run the built native_interpolate_test;
+// it exits 0 when every check passes and prints each failure otherwise.
+#include "gs/native/interpolate.hpp"
+
+#include <array>
+#include <cmath>
+#include <cstdio>
+#include <vector>
+
+using namespace ps2::gs::native;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+GpuVertex at(float x, float y, float s = 0, float t = 0) {
+    GpuVertex v{};
+    v.x = x, v.y = y, v.z = 0.5f;
+    v.s = s, v.t = t, v.q = 1;
+    return v;
+}
+
+// A frame being built: draws of triangles, each triangle at (x, y) with texture coordinates (u, v).
+struct Frame {
+    std::vector<Draw> draws;
+    std::vector<GpuVertex> verts;
+    void draw(std::uint64_t what, const std::vector<std::array<float, 4>> &triangles) {
+        draws.push_back({what, static_cast<std::uint32_t>(verts.size()), static_cast<std::uint32_t>(triangles.size() * 3), 3, true});
+        for (const auto &[x, y, u, v] : triangles) {
+            verts.push_back(at(x, y, u, v));
+            verts.push_back(at(x + 4, y, u + 1, v));
+            verts.push_back(at(x, y + 4, u, v + 1));
+        }
+    }
+};
+
+void same_frames() {
+    Frame a, b;
+    for (Frame *f : {&a, &b}) f->draw(1, {{0, 0, 0, 0}}), f->draw(2, {{50, 0, 8, 0}}), f->draw(3, {{100, 0, 16, 0}});
+    check(match(a.draws, a.verts, b.draws, b.verts, 64) == std::vector<int>({0, 1, 2}), "same_frames: each draw is itself");
+}
+
+void a_draw_appears() {
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}}), a.draw(2, {{50, 0, 8, 0}});
+    b.draw(1, {{0, 0, 0, 0}}), b.draw(9, {{20, 0, 4, 0}}), b.draw(2, {{50, 0, 8, 0}});
+    check(match(a.draws, a.verts, b.draws, b.verts, 64) == std::vector<int>({0, -1, 1}), "a_draw_appears: the new draw unmatched, the rest kept");
+}
+
+void a_draw_goes() {
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}}), a.draw(9, {{20, 0, 4, 0}}), a.draw(2, {{50, 0, 8, 0}});
+    b.draw(1, {{0, 0, 0, 0}}), b.draw(2, {{50, 0, 8, 0}});
+    check(match(a.draws, a.verts, b.draws, b.verts, 64) == std::vector<int>({0, 2}), "a_draw_goes: the rest found past it");
+}
+
+void alike_draws_pair_by_place() {
+    // Three enemies drawn the same way: each pairs with the one nearest where it was, in order.
+    Frame a, b;
+    for (float x : {0.0f, 100.0f, 200.0f}) a.draw(5, {{x, 0, 0, 0}});
+    for (float x : {102.0f, 203.0f}) b.draw(5, {{x, 0, 0, 0}});
+    check(match(a.draws, a.verts, b.draws, b.verts, 64) == std::vector<int>({1, 2}), "alike_draws_pair_by_place: the first one went");
+}
+
+void a_cut_matches_nothing() {
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}});
+    b.draw(1, {{300, 200, 0, 0}});
+    check(match(a.draws, a.verts, b.draws, b.verts, 64) == std::vector<int>({-1}), "a_cut_matches_nothing: moved further than the limit");
+}
+
+void triangles_culled() {
+    // The same draw loses its middle triangle (a face turned away) and everything moved 2 pixels right.
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}, {10, 0, 8, 0}, {20, 0, 16, 0}});
+    b.draw(1, {{2, 0, 0, 0}, {22, 0, 16, 0}});
+    const auto m = match(a.draws, a.verts, b.draws, b.verts, 64);
+    check(m == std::vector<int>({0}), "triangles_culled: still the same draw");
+    const std::vector<float> p = previous(a.draws, a.verts, b.draws, b.verts, m, 64);
+    check(p.size() == 18, "triangles_culled: x, y, z per vertex");
+    check(p[0] == 0 && p[9] == 20, "triangles_culled: each triangle where it was");
+}
+
+void a_triangle_appears() {
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}});
+    b.draw(1, {{1, 0, 0, 0}, {30, 0, 40, 0}});
+    const auto m = match(a.draws, a.verts, b.draws, b.verts, 64);
+    const std::vector<float> p = previous(a.draws, a.verts, b.draws, b.verts, m, 64);
+    check(p[0] == 0 && p[9] == 30, "a_triangle_appears: the new one where it is now");
+}
+
+void repeated_tiles_dont_slip() {
+    // Floor tiles with the same texture coordinates; the first one is culled and the rest moved 1 pixel:
+    // each must pair with itself, not slip to its neighbour.
+    Frame a, b;
+    a.draw(1, {{0, 0, 0, 0}, {10, 0, 0, 0}, {20, 0, 0, 0}, {30, 0, 0, 0}});
+    b.draw(1, {{11, 0, 0, 0}, {21, 0, 0, 0}, {31, 0, 0, 0}});
+    const auto m = match(a.draws, a.verts, b.draws, b.verts, 64);
+    const std::vector<float> p = previous(a.draws, a.verts, b.draws, b.verts, m, 64);
+    check(p[0] == 10 && p[9] == 20 && p[18] == 30, "repeated_tiles_dont_slip: each tile from itself");
+}
+
+void a_big_mesh_loses_triangles() {
+    // Ground with 2000 triangles; every 100th is culled the next frame and the rest moved 1 pixel right.
+    Frame a, b;
+    std::vector<std::array<float, 4>> before, now;
+    for (int i = 0; i < 2000; ++i) {
+        const float x = static_cast<float>(i % 50) * 8, y = static_cast<float>(i / 50) * 8, u = static_cast<float>(i);
+        before.push_back({x, y, u, 0});
+        if (i % 100 != 7) now.push_back({x + 1, y, u, 0});
+    }
+    a.draw(1, before), b.draw(1, now);
+    const auto m = match(a.draws, a.verts, b.draws, b.verts, 64);
+    std::size_t paired = 0;
+    const std::vector<float> p = previous(a.draws, a.verts, b.draws, b.verts, m, 64, &paired);
+    check(paired == now.size() * 3, "a_big_mesh_loses_triangles: every remaining triangle paired");
+    bool each_from_itself = true;
+    for (std::size_t t = 0; t < now.size(); ++t) each_from_itself &= p[t * 9] == b.verts[t * 3].x - 1;
+    check(each_from_itself, "a_big_mesh_loses_triangles: each from where it was");
+}
+
+void blend_positions() {
+    std::vector<GpuVertex> now = {at(10, 20)};
+    now[0].z = 1.0f;
+    const std::vector<float> before = {0, 0, 0.5f};
+    const std::vector<GpuVertex> half = blend(before, now, 0.5f);
+    check(half[0].x == 5.0f && half[0].y == 10.0f && half[0].z == 0.75f, "blend: half way");
+    check(blend(before, now, 1.0f)[0].x == 10.0f, "blend: at 1, where it is now");
+}
+
+}
+
+using Pairs = std::vector<std::pair<std::uint32_t, std::uint32_t>>;
+
+void equal_sequences_pair_one_to_one() {
+    const std::vector<std::uint64_t> a{5, 6, 7};
+    check(align_equal(a, a, 8) == Pairs{{0, 0}, {1, 1}, {2, 2}}, "equal sequences pair one to one");
+}
+
+void an_inserted_key_is_skipped() {
+    check(align_equal({1, 2, 3, 4}, {1, 2, 9, 3, 4}, 8) == Pairs{{0, 0}, {1, 1}, {2, 3}, {3, 4}}, "an inserted key is skipped");
+}
+
+void a_removed_key_is_skipped() {
+    check(align_equal({1, 2, 3, 4}, {1, 3, 4}, 8) == Pairs{{0, 0}, {2, 1}, {3, 2}}, "a removed key is skipped");
+}
+
+void a_changed_key_pairs_with_nothing() {
+    check(align_equal({1, 2, 3}, {1, 8, 3}, 8) == Pairs{{0, 0}, {2, 2}}, "a changed key pairs with nothing");
+}
+
+void repeated_keys_keep_their_order() {
+    // Two alike chunks with one gone between: what is left keeps its order and pairs as much as it can.
+    check(align_equal({7, 7, 2, 7}, {7, 2, 7}, 8).size() == 3, "repeated keys keep their order");
+}
+
+void too_many_edits_pair_nothing() {
+    check(align_equal({1, 2, 3, 4}, {5, 6, 7, 8}, 3).empty(), "more edits than allowed pair nothing");
+    check(align_equal({}, {1}, 3).empty() && align_equal({1}, {}, 3).empty(), "an empty side pairs nothing");
+}
+
+int main() {
+    equal_sequences_pair_one_to_one();
+    an_inserted_key_is_skipped();
+    a_removed_key_is_skipped();
+    a_changed_key_pairs_with_nothing();
+    repeated_keys_keep_their_order();
+    too_many_edits_pair_nothing();
+    same_frames();
+    a_draw_appears();
+    a_draw_goes();
+    alike_draws_pair_by_place();
+    a_cut_matches_nothing();
+    triangles_culled();
+    a_triangle_appears();
+    repeated_tiles_dont_slip();
+    a_big_mesh_loses_triangles();
+    blend_positions();
+    if (!g_failures) std::printf("native_interpolate_test: all checks passed\n");
+    return g_failures ? 1 : 0;
+}
diff --git a/tests/native_ranges_test.cpp b/tests/native_ranges_test.cpp
new file mode 100644
index 0000000..fb6169e
--- /dev/null
+++ b/tests/native_ranges_test.cpp
@@ -0,0 +1,56 @@
+// Tests the native renderer's GS memory ranges (runtime/src/gs/native/ranges.cpp): which cached textures and
+// targets an upload overlaps. Run the built native_ranges_test; it exits 0 when every check passes.
+#include "gs/native/ranges.hpp"
+
+#include <algorithm>
+#include <cstdio>
+
+using namespace ps2::gs::native;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+bool has(const std::vector<std::uint32_t> &v, std::uint32_t id) { return std::find(v.begin(), v.end(), id) != v.end(); }
+
+void overlap_finds_partial() {
+    Ranges r;
+    r.add(7, 100, 200);
+    check(has(r.overlapping(150, 160), 7), "a range inside overlaps");
+    check(has(r.overlapping(50, 101), 7), "a range reaching its start overlaps");
+    check(!has(r.overlapping(200, 300), 7), "the end is exclusive");
+    check(!has(r.overlapping(0, 100), 7), "a range ending at its start doesn't overlap");
+}
+
+void remove_forgets() {
+    Ranges r;
+    r.add(1, 0, 10);
+    r.add(2, 5, 15);
+    r.remove(1);
+    const auto hit = r.overlapping(0, 20);
+    check(hit.size() == 1 && hit[0] == 2, "a removed range is gone, the other stays");
+}
+
+void many_ranges() {
+    Ranges r;
+    for (std::uint32_t i = 0; i < 10000; ++i) r.add(i, i * 10, i * 10 + 5);
+    const auto hit = r.overlapping(50, 72);
+    check(hit.size() == 3 && has(hit, 5) && has(hit, 6) && has(hit, 7), "10,000 ranges: only the overlapping three");
+}
+
+}  // namespace
+
+int main() {
+    overlap_finds_partial();
+    remove_forgets();
+    many_ranges();
+    if (g_failures) return 1;
+    std::printf("native_ranges_test: all checks passed\n");
+    return 0;
+}
diff --git a/tests/native_texture_test.cpp b/tests/native_texture_test.cpp
new file mode 100644
index 0000000..506cbd9
--- /dev/null
+++ b/tests/native_texture_test.cpp
@@ -0,0 +1,137 @@
+// Tests the native renderer's texture and palette decoding (runtime/src/gs/native/texture.cpp) against GS
+// memory written through the GS's own pixel layouts: run the built native_texture_test; it exits 0 when
+// every check passes and prints each failure otherwise.
+#include "gs/native/texture.hpp"
+#include "gs/gs.hpp"
+#include "gs/swizzle.hpp"
+
+#include <cstdio>
+#include <vector>
+
+using namespace ps2::gs;
+using namespace ps2::gs::native;
+
+namespace {
+
+int g_failures = 0;
+
+void check(bool ok, const char *what) {
+    if (ok) return;
+    std::fprintf(stderr, "FAIL: %s\n", what);
+    ++g_failures;
+}
+
+std::uint64_t tex0(std::uint32_t tbp, std::uint32_t tbw, std::uint32_t psm, std::uint32_t tw_log, std::uint32_t th_log, std::uint32_t cbp = 0,
+                   std::uint32_t cpsm = 0, std::uint32_t csa = 0) {
+    return tbp | (static_cast<std::uint64_t>(tbw) << 14) | (static_cast<std::uint64_t>(psm) << 20) | (static_cast<std::uint64_t>(tw_log) << 26) |
+           (static_cast<std::uint64_t>(th_log) << 30) | (static_cast<std::uint64_t>(cbp) << 37) | (static_cast<std::uint64_t>(cpsm) << 51) |
+           (static_cast<std::uint64_t>(csa) << 56);
+}
+
+// Where entry i of an 8-bit palette sits in its 16 x 16 CSM1 image.
+void csm1_position(std::uint32_t i, std::uint32_t &x, std::uint32_t &y) {
+    x = (i & 7u) | ((i & 16u) >> 1);
+    y = (i / 32u) * 2u + ((i & 8u) >> 3);
+}
+
+std::uint32_t colour(std::uint32_t i) { return 0x80000000u | (i * 0x010203u & 0xFFFFFFu); }
+
+void t8_through_palette() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    const std::uint32_t cbp = 0x3000;
+    for (std::uint32_t i = 0; i < 256; ++i) {
+        std::uint32_t x, y;
+        csm1_position(i, x, y);
+        swizzle::write_pixel(mem.data(), PSMCT32, cbp, 1, x, y, colour(i));
+    }
+    for (std::uint32_t y = 0; y < 16; ++y)
+        for (std::uint32_t x = 0; x < 16; ++x) swizzle::write_pixel(mem.data(), PSMT8, 0x100, 2, x, y, (x * 16 + y) & 0xFF);
+    const std::uint64_t t = tex0(0x100, 2, PSMT8, 4, 4, cbp, PSMCT32);
+    std::uint32_t palette[256];
+    decode_palette(mem.data(), t, 0, palette);
+    std::vector<std::uint32_t> rgba;
+    decode(mem.data(), t, 0, palette, rgba);
+    bool ok = rgba.size() == 256;
+    for (std::uint32_t y = 0; y < 16 && ok; ++y)
+        for (std::uint32_t x = 0; x < 16 && ok; ++x) ok = rgba[y * 16 + x] == colour((x * 16 + y) & 0xFF);
+    check(ok, "each T8 texel is its palette entry");
+}
+
+void t4_csa_offset() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    const std::uint32_t cbp = 0x3000;
+    for (std::uint32_t i = 0; i < 16; ++i) swizzle::write_pixel(mem.data(), PSMCT32, cbp, 1, i & 7u, i >> 3, colour(100 + i));
+    for (std::uint32_t x = 0; x < 16; ++x) swizzle::write_pixel(mem.data(), PSMT4, 0x200, 2, x, 0, x);
+    const std::uint64_t t = tex0(0x200, 2, PSMT4, 4, 0, cbp, PSMCT32, 1);
+    std::uint32_t palette[256] = {};
+    decode_palette(mem.data(), t, 0, palette);
+    check(palette[16] == colour(100) && palette[31] == colour(115) && palette[0] == 0, "a 4-bit palette with CSA 1 fills entries 16..31");
+    std::vector<std::uint32_t> rgba;
+    decode(mem.data(), t, 0, palette, rgba);
+    check(rgba.size() == 16 && rgba[0] == colour(100) && rgba[15] == colour(115), "T4 texels look up entries CSA*16 + index");
+}
+
+void csm1_order() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    const std::uint32_t cbp = 0x3000;
+    for (std::uint32_t y = 0; y < 16; ++y)
+        for (std::uint32_t x = 0; x < 16; ++x) swizzle::write_pixel(mem.data(), PSMCT32, cbp, 1, x, y, y * 16 + x);
+    std::uint32_t palette[256];
+    decode_palette(mem.data(), tex0(0, 1, PSMT8, 4, 4, cbp, PSMCT32), 0, palette);
+    check(palette[7] == 7 && palette[8] == 16 && palette[16] == 8 && palette[24] == 24, "entries 8..15 and 16..23 swap places");
+    check(palette[32] == 32 && palette[255] == 255, "the swap repeats every 32 entries");
+}
+
+void ct16_texa() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    swizzle::write_pixel(mem.data(), PSMCT16, 0x400, 1, 0, 0, 0x001F);           // red, A bit 0
+    swizzle::write_pixel(mem.data(), PSMCT16, 0x400, 1, 1, 0, 0x8000 | 0x03E0);  // green, A bit 1
+    swizzle::write_pixel(mem.data(), PSMCT16, 0x400, 1, 2, 0, 0x0000);           // black, A bit 0
+    const std::uint64_t texa = 0x20 | (0x70ull << 32);                            // TA0 0x20, TA1 0x70
+    std::vector<std::uint32_t> rgba;
+    decode(mem.data(), tex0(0x400, 1, PSMCT16, 2, 0), texa, nullptr, rgba);
+    check(rgba[0] == 0x200000F8u, "CT16 A bit 0 gets TA0 (red 0x1F becomes 0xF8)");
+    check(rgba[1] == 0x7000F800u, "CT16 A bit 1 gets TA1");
+    check(rgba[2] == 0x20000000u, "black without AEM keeps TA0");
+    decode(mem.data(), tex0(0x400, 1, PSMCT16, 2, 0), texa | (1u << 15), nullptr, rgba);
+    check(rgba[2] == 0x00000000u, "AEM makes black transparent");
+}
+
+void ct24_alpha_from_texa() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    swizzle::write_pixel(mem.data(), PSMCT32, 0x500, 1, 0, 0, 0xFF123456u);
+    std::vector<std::uint32_t> rgba;
+    decode(mem.data(), tex0(0x500, 1, PSMCT24, 0, 0), 0x40, nullptr, rgba);
+    check(rgba.size() == 1 && rgba[0] == 0x40123456u, "CT24 takes its alpha from TA0, not the stored byte");
+}
+
+// A palette change re-colours the raw values read once: the same as decoding again with the new palette.
+void raw_then_palette() {
+    std::vector<std::uint8_t> mem(kMemorySize, 0);
+    for (std::uint32_t y = 0; y < 64; ++y)
+        for (std::uint32_t x = 0; x < 128; ++x) swizzle::write_pixel(mem.data(), PSMT8, 128, 2, x, y, (x * 7 + y * 3) & 0xFFu);
+    const std::uint64_t t = tex0(128, 2, PSMT8, 7, 6);
+    std::uint32_t one[256], two[256];
+    for (std::uint32_t i = 0; i < 256; ++i) one[i] = colour(i), two[i] = colour(255 - i) ^ 0x00010101u;
+    std::vector<std::uint32_t> raw, coloured, decoded;
+    read_raw(mem.data(), t, raw);
+    for (const std::uint32_t *palette : {one, two}) {
+        to_rgba(t, 0, palette, raw, coloured);
+        decode(mem.data(), t, 0, palette, decoded);
+        check(coloured == decoded, "raw values coloured with a palette match a decode with it");
+    }
+}
+
+}  // namespace
+
+int main() {
+    raw_then_palette();
+    t8_through_palette();
+    t4_csa_offset();
+    csm1_order();
+    ct16_texa();
+    ct24_alpha_from_texa();
+    if (g_failures) return 1;
+    std::printf("native_texture_test: all checks passed\n");
+    return 0;
+}
diff --git a/tests/render_compare.py b/tests/render_compare.py
new file mode 100644
index 0000000..eee2776
--- /dev/null
+++ b/tests/render_compare.py
@@ -0,0 +1,126 @@
+"""Compares two folders of frames from render_scenes.py, scene by scene: a reference (usually PS2-accurate)
+and a test run (usually the native renderer).
+
+    python render_compare.py <ref dir> <test dir> [--tolerance dB]   one line per scene, exit 1 if any is under
+    python render_compare.py --self-test
+
+Each scene's score is the lowest PSNR (dB) over its frames, with the share of pixels off by more than 8 in any
+channel; a difference image (diff_<frame>.png, the difference amplified 4x) goes beside the test frames.
+Frames of different sizes (another internal resolution) are compared after scaling the test frame down."""
+import math
+import os
+import struct
+import sys
+import zlib
+
+
+def read_ppm(path):
+    data = open(path, 'rb').read()
+    parts = data.split(b'\n', 3)
+    w, h = map(int, parts[1].split())
+    return w, h, parts[3][:w * h * 3]
+
+
+def write_png(path, w, h, rgb):
+    raw = b''.join(b'\0' + bytes(rgb[y * w * 3:(y + 1) * w * 3]) for y in range(h))
+
+    def chunk(t, x):
+        return struct.pack('>I', len(x)) + t + x + struct.pack('>I', zlib.crc32(t + x) & 0xffffffff)
+    open(path, 'wb').write(b'\x89PNG\r\n\x1a\n' + chunk(b'IHDR', struct.pack('>IIBBBBB', w, h, 8, 2, 0, 0, 0)) +
+                           chunk(b'IDAT', zlib.compress(raw, 6)) + chunk(b'IEND', b''))
+
+
+def downscale(w, h, px, tw, th):
+    """Box-filters px (w x h) down to tw x th (integer factor)."""
+    fx, fy = w // tw, h // th
+    out = bytearray(tw * th * 3)
+    n = fx * fy
+    for y in range(th):
+        for x in range(tw):
+            for c in range(3):
+                s = 0
+                for dy in range(fy):
+                    row = ((y * fy + dy) * w + x * fx) * 3 + c
+                    s += sum(px[row + dx * 3] for dx in range(fx))
+                out[(y * tw + x) * 3 + c] = s // n
+    return bytes(out)
+
+
+def compare(a, b):
+    """PSNR in dB (inf when equal) and the share of pixels off by more than 8, for two equal-size RGB buffers."""
+    se = 0
+    off = 0
+    for i in range(0, len(a), 3):
+        d0, d1, d2 = a[i] - b[i], a[i + 1] - b[i + 1], a[i + 2] - b[i + 2]
+        se += d0 * d0 + d1 * d1 + d2 * d2
+        if max(abs(d0), abs(d1), abs(d2)) > 8:
+            off += 1
+    if se == 0:
+        return math.inf, 0.0
+    mse = se / len(a)
+    return 10 * math.log10(255 * 255 / mse), off / (len(a) // 3)
+
+
+def diff_image(a, b):
+    return bytes(min(255, abs(x - y) * 4) for x, y in zip(a, b))
+
+
+def compare_dirs(ref, test, tolerance):
+    failed = False
+    for scene in sorted(os.listdir(ref)):
+        rdir, tdir = os.path.join(ref, scene), os.path.join(test, scene)
+        if not os.path.isdir(rdir):
+            continue
+        if not os.path.isdir(tdir):
+            print(f'{scene:10s} missing in {test}')
+            failed = True
+            continue
+        worst, worst_off = math.inf, 0.0
+        for name in sorted(f for f in os.listdir(rdir) if f.endswith('.ppm')):
+            if not os.path.exists(os.path.join(tdir, name)):
+                print(f'{scene:10s} {name} missing')
+                failed = True
+                continue
+            rw, rh, rp = read_ppm(os.path.join(rdir, name))
+            tw, th, tp = read_ppm(os.path.join(tdir, name))
+            if (tw, th) != (rw, rh):
+                tp = downscale(tw, th, tp, rw, rh)
+            psnr, off = compare(rp, tp)
+            if psnr < math.inf:
+                write_png(os.path.join(tdir, 'diff_' + name[:-4] + '.png'), rw, rh, diff_image(rp, tp))
+            if psnr < worst:
+                worst, worst_off = psnr, off
+        ok = worst >= tolerance
+        failed |= not ok
+        print(f'{scene:10s} {"inf" if worst == math.inf else f"{worst:.2f}"} dB  {worst_off * 100:.2f}% off  {"ok" if ok else "UNDER"}')
+    return failed
+
+
+def self_test():
+    a = bytes([10, 20, 30] * 16)
+    b = bytearray(a)
+    b[0] = 255  # one pixel, one channel off by 245
+    psnr, off = compare(a, bytes(b))
+    expected = 10 * math.log10(255 * 255 / (245 * 245 / 48))
+    assert abs(psnr - expected) < 1e-9, psnr
+    assert abs(off - 1 / 16) < 1e-12, off
+    assert compare(a, a) == (math.inf, 0.0)
+    small = downscale(2, 2, bytes([0, 0, 0, 100, 100, 100, 200, 200, 200, 100, 100, 100]), 1, 1)
+    assert small == bytes([100, 100, 100]), small
+    print('render_compare self-test: ok')
+
+
+if __name__ == '__main__':
+    args = sys.argv[1:]
+    if args == ['--self-test']:
+        self_test()
+        sys.exit(0)
+    tol = 0.0
+    if '--tolerance' in args:
+        i = args.index('--tolerance')
+        tol = float(args[i + 1])
+        del args[i:i + 2]
+    if len(args) != 2:
+        print(__doc__)
+        sys.exit(2)
+    sys.exit(1 if compare_dirs(args[0], args[1], tol) else 0)
diff --git a/tests/render_scenes.py b/tests/render_scenes.py
new file mode 100644
index 0000000..ad98b2b
--- /dev/null
+++ b/tests/render_scenes.py
@@ -0,0 +1,88 @@
+"""Runs a list of scenes (save states, or boot) with the game and keeps 3 frames of each, for render_compare.py.
+
+    python render_scenes.py --exe <CastlevaniaLoI.exe> --scenes <folder> --out <dir>
+                            [--renderer native|accurate] [--scale n] [--only name,name] [--env KEY=VALUE ...]
+
+<folder> holds scenes.txt (lines: name, state file in the folder or "boot", first frame, frames to run, extra
+arguments for the game), the states, memcard.ps2 and settings.ini. Each scene runs with a fixed clock and its
+own copy of the memory card; its frames go to <dir>/<name>/frame_NNNNN.ppm and its log to <dir>/<name>/run.log.
+Save-state scenes run 3 at a time, boot scenes one at a time after them (more game instances at once
+run out of video memory)."""
+import argparse
+import concurrent.futures
+import os
+import shutil
+import subprocess
+import sys
+
+
+def run_scene(args, line):
+    parts = line.split()
+    name, state, first, frames = parts[0], parts[1], int(parts[2]), int(parts[3])
+    extra = parts[4:]
+    out = os.path.join(args.out, name)
+    shutil.rmtree(out, ignore_errors=True)
+    os.makedirs(out)
+    card = os.path.join(out, 'memcard.ps2')
+    shutil.copyfile(os.path.join(args.scenes, 'memcard.ps2'), card)
+    game_dir = os.path.dirname(os.path.abspath(args.exe))
+    cmd = [os.path.abspath(args.exe), os.path.join('game', 'SLUS_207.33'), '--memcard', card,
+           '--settings', os.path.join(args.scenes, 'settings.ini'), '--run', str(frames),
+           '--frames-dir', out, '--frames-from', str(first), '--frame-every', '1']
+    if state != 'boot':
+        cmd += ['--load-state', os.path.join(args.scenes, state)]
+    cmd += extra
+    env = dict(os.environ)
+    env['PS2_FIXED_CLOCK'] = '1794139200'
+    env['PS2_SCALE'] = str(args.scale)
+    if args.renderer == 'native':
+        env['PS2_RENDERER'] = 'native'
+    else:
+        env.pop('PS2_RENDERER', None)
+    for kv in args.env:
+        k, v = kv.split('=', 1)
+        env[k] = v
+    with open(os.path.join(out, 'run.log'), 'w') as log:
+        code = subprocess.call(cmd, cwd=game_dir, env=env, stdout=log, stderr=subprocess.STDOUT)
+    os.remove(card)
+    # keep the 3 frames from the first one
+    for f in os.listdir(out):
+        if f.startswith('frame_') and f.endswith('.ppm') and not (first <= int(f[6:-4]) < first + 3):
+            os.remove(os.path.join(out, f))
+    kept = len([f for f in os.listdir(out) if f.endswith('.ppm')])
+    return name, code, kept
+
+
+def main():
+    p = argparse.ArgumentParser(description=__doc__, formatter_class=argparse.RawDescriptionHelpFormatter)
+    p.add_argument('--exe', required=True)
+    p.add_argument('--scenes', required=True)
+    p.add_argument('--out', required=True)
+    p.add_argument('--renderer', choices=['native', 'accurate'], default='accurate')
+    p.add_argument('--scale', type=int, default=1)
+    p.add_argument('--only', default='')
+    p.add_argument('--env', action='append', default=[])
+    args = p.parse_args()
+    args.out, args.scenes = os.path.abspath(args.out), os.path.abspath(args.scenes)
+    lines = [l.strip() for l in open(os.path.join(args.scenes, 'scenes.txt')) if l.strip() and not l.startswith('#')]
+    if args.only:
+        wanted = set(args.only.split(','))
+        lines = [l for l in lines if l.split()[0] in wanted]
+    os.makedirs(args.out, exist_ok=True)
+    failed = False
+    # Boot scenes play the intro movie, whose decoding takes a lot of video memory: one at a time, after the rest.
+    states = [l for l in lines if l.split()[1] != 'boot']
+    boots = [l for l in lines if l.split()[1] == 'boot']
+    results = []
+    with concurrent.futures.ThreadPoolExecutor(max_workers=min(3, os.cpu_count() or 1)) as pool:
+        results += list(pool.map(lambda l: run_scene(args, l), states))
+    results += [run_scene(args, l) for l in boots]
+    for name, code, kept in results:
+        ok = code == 0 and kept == 3
+        failed |= not ok
+        print(f'{name:10s} exit {code}  frames {kept}  {"ok" if ok else "FAILED"}')
+    sys.exit(1 if failed else 0)
+
+
+if __name__ == '__main__':
+    main()
