+    if (!in) {
+        std::fprintf(stderr, "[disc] %s has no %s\n", dir.string().c_str(), kLayoutFile);
+        return false;
+    }
+    std::lock_guard lock(g_spans_mutex);
+    close_spans();
+    std::map<std::string, Entry> index;
+    std::uint64_t sectors = 0;
+    std::uint32_t layer1 = 0;
+    std::string line;
+    while (std::getline(in, line)) {
+        if (!line.empty() && line.back() == '\r') line.pop_back();
+        if (line.empty() || line[0] == '#') continue;
+        std::istringstream words(line);
+        std::string kind;
+        words >> kind;
+        if (kind == "sectors") words >> sectors;
+        else if (kind == "layer1") words >> layer1;
+        else if (kind == "F" || kind == "D") {
+            Entry e{0, 0, kind == "D"};
+            std::string path;
+            words >> e.sector >> e.size;
+            std::getline(words >> std::ws, path);
+            index[path] = e;
+            if (e.directory) continue;
+            std::FILE *f = open_read(dir / path);
+            if (!f) {
+                std::fprintf(stderr, "[disc] %s is missing from %s\n", path.c_str(), dir.string().c_str());
+                close_spans();
+                return false;
+            }
+            g_spans.push_back({e.sector, (e.size + kSector - 1) / kSector, e.size, f});
+        }
+    }
+    std::sort(g_spans.begin(), g_spans.end(), [](const Span &a, const Span &b) { return a.sector < b.sector; });
