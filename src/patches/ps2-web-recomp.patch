+        for (const Block &b : blocks) table += std::format("std::uint32_t {}(Cpu &c);\n", b.name);
+        table += std::format("const gen::Block kBlocks_{}[] = {{\n", id);
+        for (const Block &b : blocks) table += std::format("    {{0x{:08X}u, {}u, {}}},\n", b.pc, b.length, b.name);
+        if (blocks.empty()) table += "    {0, 0, nullptr},\n";
+        table += "};\n\n";
+        registration += std::format("    ps2::iop::gen::register_module({{\"{}\", 0x{:08X}u, {}u, 0x{:016X}ull, gen_iop::kBlocks_{}, {}u}});\n", m.name, m.base, m.text.size(), ps2::iop::gen::code_hash(m.text.data(), m.text.size()), id, blocks.size());
+        total_blocks += blocks.size();
+        for (const Block &b : blocks) total_insns += b.length;
