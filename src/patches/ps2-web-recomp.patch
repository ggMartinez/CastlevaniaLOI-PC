+void set_open(bool open) {
+    if (open == g_open) return;
+    g_open = open;
+    g_drawn = false;
+    if (g_can_pause) ps2::request_pause(open);
+    std::fprintf(stderr, "[menu] %s at frame %llu\n", open ? "opened" : "closed", static_cast<unsigned long long>(ps2::frame_count()));
