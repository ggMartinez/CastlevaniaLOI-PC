+
+#ifdef _WIN32
+void draw_osd(const std::vector<OsdLine> &lines) {
+    int window_w = 0, window_h = 0;
+    SDL_GetWindowSizeInPixels(g_window, &window_w, &window_h);
+    const int px = std::clamp(window_h / 40, 14, 32), pad = px / 2;
+    HDC dc = CreateCompatibleDC(nullptr);
+    HFONT font = CreateFontW(-px, 0, 0, 0, FW_SEMIBOLD, FALSE, FALSE, FALSE, DEFAULT_CHARSET, OUT_DEFAULT_PRECIS, CLIP_DEFAULT_PRECIS,
+                             ANTIALIASED_QUALITY, FIXED_PITCH | FF_MODERN, L"Consolas");
+    const HGDIOBJ old_font = SelectObject(dc, font);
+    TEXTMETRICW metrics{};
+    GetTextMetricsW(dc, &metrics);
+    const int line_h = metrics.tmHeight;
+    std::vector<std::wstring> text;
+    int text_w = 0;
+    for (const OsdLine &line : lines) {
+        text.emplace_back(line.text.begin(), line.text.end());
+        SIZE size{};
+        GetTextExtentPoint32W(dc, text.back().c_str(), static_cast<int>(text.back().size()), &size);
+        text_w = std::max(text_w, static_cast<int>(size.cx));
+    }
+    const int width = text_w + pad * 2, height = line_h * static_cast<int>(lines.size()) + pad * 2;
+    BITMAPINFO info{};
+    info.bmiHeader.biSize = sizeof(info.bmiHeader);
+    info.bmiHeader.biWidth = width;
+    info.bmiHeader.biHeight = -height;  // top-down rows
+    info.bmiHeader.biPlanes = 1;
+    info.bmiHeader.biBitCount = 32;
+    info.bmiHeader.biCompression = BI_RGB;
+    void *bits = nullptr;
+    HBITMAP bitmap = CreateDIBSection(dc, &info, DIB_RGB_COLORS, &bits, nullptr, 0);
+    if (bitmap && bits) {
+        const HGDIOBJ old_bitmap = SelectObject(dc, bitmap);
+        std::memset(bits, 0, static_cast<std::size_t>(width) * height * 4);
+        SetBkMode(dc, TRANSPARENT);
+        SetTextColor(dc, RGB(255, 255, 255));
+        for (std::size_t i = 0; i < text.size(); ++i) TextOutW(dc, pad, pad + static_cast<int>(i) * line_h, text[i].c_str(), static_cast<int>(text[i].size()));
+        GdiFlush();
+        // White text on black gives each pixel's coverage; the box is black at 60% under it.
+        std::vector<std::uint32_t> rgba(static_cast<std::size_t>(width) * height);
+        const auto *src = static_cast<const std::uint8_t *>(bits);
+        for (int y = 0; y < height; ++y) {
+            const std::uint32_t rgb = lines[static_cast<std::size_t>(std::clamp((y - pad) / line_h, 0, static_cast<int>(lines.size()) - 1))].rgb;
+            for (int x = 0; x < width; ++x) {
+                const std::uint8_t *b = src + (static_cast<std::size_t>(y) * width + x) * 4;
+                const float cover = static_cast<float>(std::max({b[0], b[1], b[2]})) / 255.0f;
+                const float alpha = cover + 0.6f * (1.0f - cover);
+                const auto channel = [&](int shift) { return static_cast<std::uint32_t>(static_cast<float>((rgb >> shift) & 0xFFu) * cover / alpha + 0.5f); };
+                rgba[static_cast<std::size_t>(y) * width + x] = channel(16) | channel(8) << 8 | channel(0) << 16 | static_cast<std::uint32_t>(alpha * 255.0f + 0.5f) << 24;
+            }
+        }
+        ps2::set_osd(rgba.data(), static_cast<std::uint32_t>(width), static_cast<std::uint32_t>(height));
+        SelectObject(dc, old_bitmap);
+    }
+    if (bitmap) DeleteObject(bitmap);
+    SelectObject(dc, old_font);
+    DeleteObject(font);
+    DeleteDC(dc);
+}
+#endif
