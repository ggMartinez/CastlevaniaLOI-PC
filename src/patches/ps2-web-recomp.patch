@@ -0,0 +1,91 @@
+#include "graphics_ui.hpp"
+
+#include "ps2/system.hpp"
+
+#include <imgui.h>
+
+namespace ps2ui {
+
+namespace {
+
+// A switch with an optional strength slider under it while it's on.
+bool with_strength(const char *label, bool &on, float *strength, const char *id) {
+    bool changed = ImGui::Checkbox(label, &on);
+    if (on && strength) {
+        ImGui::Indent();
+        ImGui::PushID(id);
+        changed |= ImGui::SliderFloat("Strength", strength, 0.0f, 1.0f, "%.2f");
+        ImGui::PopID();
+        ImGui::Unindent();
+    }
+    return changed;
+}
+
+}
+
+bool graphics_options(ps2::Graphics &g, bool in_game) {
+    bool changed = false;
+    const char *const apis[] = {"Direct3D 12", "Vulkan"};
+    int api = g.api == ps2::Api::vulkan ? 1 : 0;
+    if (ImGui::Combo(in_game ? "Graphics API (after restart)" : "Graphics API", &api, apis, 2)) {
+        g.api = api ? ps2::Api::vulkan : ps2::Api::d3d12;
+        changed = true;
+    }
+    const char *labels[6];
+    for (int i = 0; i < 6; ++i) labels[i] = ps2::scale_label(i + 1);
+    int scale = g.scale - 1;
+    if (ImGui::Combo("Internal resolution", &scale, labels, 6)) {
+        g.scale = scale + 1;
+        changed = true;
+    }
+    changed |= ImGui::Checkbox("Vsync", &g.vsync);
+    int aspect = g.widescreen ? 1 : 0;
+    ImGui::TextUnformatted(in_game && !ps2::widescreen_live() ? "Aspect ratio (after restart)" : "Aspect ratio");
+    ImGui::SameLine();
+    changed |= ImGui::RadioButton("4:3", &aspect, 0);
+    ImGui::SameLine();
+    changed |= ImGui::RadioButton("16:9", &aspect, 1);
+    g.widescreen = aspect == 1;
+    changed |= ImGui::Checkbox("Fullscreen", &g.fullscreen);
+
+    ImGui::SeparatorText("Picture");
+    const char *const aa[] = {"Off", "FXAA"};
+    int fxaa = g.fxaa ? 1 : 0;
+    if (ImGui::Combo("Anti-aliasing", &fxaa, aa, 2)) {
+        g.fxaa = fxaa == 1;
+        changed = true;
+    }
+    const char *const upscale[] = {"Default", "FSR-style"};
+    int fsr = g.fsr ? 1 : 0;
+    if (ImGui::Combo("Upscaling filter", &fsr, upscale, 2)) {
+        g.fsr = fsr == 1;
+        changed = true;
+    }
+    changed |= with_strength("Sharpening", g.sharpen, &g.sharpen_strength, "sharpen");
+    changed |= with_strength("Bloom", g.bloom, &g.bloom_strength, "bloom");
+    if (ImGui::TreeNode("Colour")) {
+        changed |= ImGui::SliderFloat("Brightness", &g.brightness, -0.5f, 0.5f, "%.2f");
+        changed |= ImGui::SliderFloat("Contrast", &g.contrast, 0.5f, 1.5f, "%.2f");
+        changed |= ImGui::SliderFloat("Saturation", &g.saturation, 0.0f, 2.0f, "%.2f");
+        changed |= ImGui::SliderFloat("Gamma", &g.gamma, 0.5f, 2.0f, "%.2f");
+        if (ImGui::Button("Reset colour")) {
+            g.brightness = 0.0f;
+            g.contrast = g.saturation = g.gamma = 1.0f;
+            changed = true;
+        }
+        ImGui::TreePop();
+    }
+    changed |= ImGui::Checkbox("Debanding", &g.deband);
+    changed |= ImGui::Checkbox("CRT", &g.crt);
+    if (g.crt) {
+        ImGui::Indent();
+        changed |= ImGui::SliderFloat("Scanlines", &g.crt_scanlines, 0.0f, 1.0f, "%.2f");
+        changed |= ImGui::Checkbox("Curvature", &g.crt_curvature);
+        ImGui::Unindent();
+    }
+    changed |= with_strength("Vignette", g.vignette, &g.vignette_strength, "vignette");
+    changed |= with_strength("Film grain", g.grain, &g.grain_strength, "grain");
+    return changed;
+}
+
+}
