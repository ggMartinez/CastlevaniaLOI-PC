+    }
+    table += "}\n\nvoid register_generated_iop() {\n" + registration + "}\n";
+    std::ofstream(out_dir / "iop_table.cpp") << table;
+    std::printf("%zu IOP modules, %zu blocks, %zu instructions\n", modules.size(), total_blocks, total_insns);
+    return 0;
+}
