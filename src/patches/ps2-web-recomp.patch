+const char *const kOverlayShader = R"(
+struct Overlay { width: u32, height: u32, surface_width: u32, surface_height: u32, margin: u32 }
+@group(0) @binding(0) var<storage, read> overlay_pixels: array<u32>;
+@group(0) @binding(1) var<uniform> overlay: Overlay;
+struct VertexOut { @builtin(position) position: vec4<f32>, @location(0) local: vec2<f32> }
+@vertex
+fn vs(@builtin(vertex_index) i: u32) -> VertexOut {
+    var corners = array<vec2<f32>, 6>(vec2(0.0, 0.0), vec2(1.0, 0.0), vec2(0.0, 1.0), vec2(0.0, 1.0), vec2(1.0, 0.0), vec2(1.0, 1.0));
+    let size = vec2<f32>(f32(overlay.width), f32(overlay.height));
+    let at = f32(overlay.margin) + corners[i] * size;
+    let surface = vec2<f32>(f32(overlay.surface_width), f32(overlay.surface_height));
+    var o: VertexOut;
+    o.position = vec4<f32>(at.x / surface.x * 2.0 - 1.0, 1.0 - at.y / surface.y * 2.0, 0.0, 1.0);
