+
+void convert(std::uint64_t a, std::uint64_t xyoffset, std::uint64_t zbuf, const Vertex *v, int count, std::vector<GpuVertex> &out) {
+    const std::uint32_t type = bits(a, 0, 3);
+    const bool gouraud = bits(a, 3, 1), uv = bits(a, 8, 1);
+    const int ofx = static_cast<int>(bits(xyoffset, 0, 16)), ofy = static_cast<int>(bits(xyoffset, 32, 16));
+    const double zmax = depth_range(bits(zbuf, 24, 4) | 0x30u);
+    const Vertex &last = v[count - 1];
+    const auto make = [&](const Vertex &p, const Vertex &shade) {
+        GpuVertex g;
+        g.x = static_cast<float>(static_cast<int>(p.x & 0xFFFFu) - ofx) / 16.0f;
+        g.y = static_cast<float>(static_cast<int>(p.y & 0xFFFFu) - ofy) / 16.0f;
+        g.z = static_cast<float>(std::min<double>(p.z, zmax) / zmax);
+        if (uv) {
+            g.s = static_cast<float>(p.u) / 16.0f, g.t = static_cast<float>(p.v) / 16.0f, g.q = 1.0f;
+        } else {
+            g.s = p.s, g.t = p.t, g.q = p.q;
+        }
+        g.rgba[0] = shade.r, g.rgba[1] = shade.g, g.rgba[2] = shade.b, g.rgba[3] = shade.a;
+        g.fog = static_cast<float>(p.f) / 255.0f;
+        return g;
+    };
+    if (type == 6) {
+        // A sprite: a rectangle from its two corners, colour, depth, fog and Q from the second.
+        GpuVertex g0 = make(v[0], last), g1 = make(last, last);
+        g0.z = g1.z, g0.fog = g1.fog;
+        if (!uv) g0.q = g1.q;
+        GpuVertex g01 = g0, g10 = g0;
+        g01.x = g1.x, g01.s = g1.s;  // top right
+        g10.y = g1.y, g10.t = g1.t;  // bottom left
+        out.insert(out.end(), {g0, g01, g10, g01, g1, g10});
+        return;
+    }
+    for (int i = 0; i < count; ++i) out.push_back(make(v[i], gouraud ? v[i] : last));
+}
+
+}
