index 0000000..6be675f
--- /dev/null
+++ b/host/graphics_ui.cpp
@@ -0,0 +1,212 @@
+#include "graphics_ui.hpp"
+
+#include "ps2/system.hpp"
+
+#include <SDL.h>
+#include <imgui.h>
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <iterator>
+#include <string>
+#include <vector>
+
+namespace ps2ui {
+
+namespace {
+
+// A switch with an optional strength slider under it while it's on.
+bool with_strength(const char *label, bool &on, float *strength, const char *id) {
+    bool changed = ImGui::Checkbox(label, &on);
+    if (on && strength) {
+        ImGui::Indent();
+        ImGui::PushID(id);
+        changed |= ImGui::SliderFloat("Strength", strength, 0.0f, 1.0f, "%.2f");
+        ImGui::PopID();
+        ImGui::Unindent();
+    }
+    return changed;
+}
+
+// The refresh rates the display (the one with the focused window, else the first) offers at its desktop
+// resolution, lowest first, and the one it is set to now (current; 0 if unknown). Looked up once a second.
+std::vector<int> refresh_rates(int &current) {
+    static std::vector<int> rates;
+    static int now_hz = 0;
+    static Uint64 asked = 0;
+    const Uint64 now = SDL_GetTicks64();
+    if (!asked || now - asked >= 1000) {
+        asked = now;
+        rates.clear();
+        SDL_Window *window = SDL_GetKeyboardFocus();
+        int display = window ? SDL_GetWindowDisplayIndex(window) : 0;
+        if (display < 0) display = 0;
+        SDL_DisplayMode desktop{};
+        if (SDL_GetDesktopDisplayMode(display, &desktop) == 0) {
+            now_hz = desktop.refresh_rate;
+            for (int i = 0, n = SDL_GetNumDisplayModes(display); i < n; ++i) {
+                SDL_DisplayMode m{};
+                if (SDL_GetDisplayMode(display, i, &m) == 0 && m.w == desktop.w && m.h == desktop.h && m.refresh_rate > 0 &&
+                    std::find(rates.begin(), rates.end(), m.refresh_rate) == rates.end())
+                    rates.push_back(m.refresh_rate);
+            }
+            if (now_hz > 0 && std::find(rates.begin(), rates.end(), now_hz) == rates.end()) rates.push_back(now_hz);
+        }
+        std::sort(rates.begin(), rates.end());
+    }
+    current = now_hz;
+    return rates;
+}
+
+}
+
+bool graphics_options(ps2::Graphics &g, bool in_game) {
+    bool changed = false;
+    const char *const apis[] = {"Direct3D 12", "Vulkan"};
+    int api = g.api == ps2::Api::vulkan ? 1 : 0;
+    if (ImGui::Combo(in_game ? "Graphics API (after restart)" : "Graphics API", &api, apis, 2)) {
+        g.api = api ? ps2::Api::vulkan : ps2::Api::d3d12;
+        changed = true;
+    }
+    // The native renderer (experimental) is chosen when the game starts.
+    const char *const renderers[] = {"Accurate (emulated GS)", "Native (experimental)"};
+    int renderer = g.native_renderer ? 1 : 0;
+    if (ImGui::Combo(in_game ? "Renderer (after restart)" : "Renderer", &renderer, renderers, 2)) {
+        g.native_renderer = renderer == 1;
+        changed = true;
+    }
+    // The accurate renderer: the multiples, then the direct resolutions (their width from the aspect ratio).
+    // The native renderer: the direct resolutions only; a multiple left in the settings becomes the nearest.
+    constexpr int kDirect = static_cast<int>(std::size(ps2::kResolutions));
+    if (g.native_renderer && !g.resolution) {
+        g.resolution = ps2::kResolutions[0];
+        for (const int lines : ps2::kResolutions)
+            if (std::abs(lines - 448 * g.scale) < std::abs(g.resolution - 448 * g.scale)) g.resolution = lines;
+        changed = true;
+    }
+    const int first = g.native_renderer ? 0 : 6;  // the first listed multiple-or-direct item's index
+    static char direct[kDirect][48];
+    const char *labels[6 + kDirect];
+    int count = 0, choice = g.scale - 1;
+    if (!g.native_renderer)
+        for (int i = 0; i < 6; ++i) labels[count++] = ps2::scale_label(i + 1);
+    for (int i = 0; i < kDirect; ++i) {
+        const int lines = ps2::kResolutions[i];
+        std::snprintf(direct[i], sizeof direct[i], "%s (%d x %d)", ps2::resolution_label(lines), lines * (g.widescreen ? 16 : 4) / (g.widescreen ? 9 : 3), lines);
+        if (g.resolution == lines) choice = count;
+        labels[count++] = direct[i];
+    }
+    // The native renderer's size is taken when the game starts; the accurate one changes while playing.
+    if (ImGui::Combo(in_game && g.native_renderer ? "Internal resolution (after restart)" : "Internal resolution", &choice, labels, count)) {
+        if (choice < first) g.scale = choice + 1, g.resolution = 0;
+        else g.resolution = ps2::kResolutions[choice - first];
+        changed = true;
+    }
+    if (g.resolution && !g.native_renderer) {
+        ImGui::PushStyleColor(ImGuiCol_Text, ImGui::GetStyleColorVec4(ImGuiCol_TextDisabled));
+        ImGui::TextWrapped("The accurate renderer draws whole multiples only: %s, then scaled. The native renderer draws this size exactly.",
+                           ps2::scale_label(ps2::whole_scale(g)));
+        ImGui::PopStyleColor();
+    }
+    // Frame interpolation needs the native renderer: the game stays at 60 fps, pictures in between come at
+    // the display's refresh rate.
+    if (g.native_renderer) {
+        int current = 0;
+        const std::vector<int> hz = refresh_rates(current);
+        std::vector<int> rates = {60};
+        for (const int r : hz)
+            if (r > 60) rates.push_back(r);
+        if (std::find(rates.begin(), rates.end(), g.frame_rate) == rates.end()) rates.push_back(g.frame_rate);  // another display's
+        std::sort(rates.begin(), rates.end());
+        static std::vector<std::string> names;
+        names.clear();
+        for (const int r : rates) names.push_back(r == 60 ? "60 fps (original)" : std::to_string(r) + " fps");
+        std::vector<const char *> labels;
+        for (const std::string &n : names) labels.push_back(n.c_str());
+        int choice = static_cast<int>(std::find(rates.begin(), rates.end(), g.frame_rate) - rates.begin());
+        if (ImGui::Combo("Frame rate", &choice, labels.data(), static_cast<int>(labels.size()))) {
+            g.frame_rate = rates[static_cast<std::size_t>(choice)];
+            changed = true;
+        }
+        if (g.frame_rate > 60 && current && g.frame_rate != current) {
+            ImGui::PushStyleColor(ImGuiCol_Text, ImGui::GetStyleColorVec4(ImGuiCol_TextDisabled));
+            if (g.frame_rate > current)
+                ImGui::TextWrapped("The display is set to %d Hz, so you'll get %d fps. Set it to %d Hz in Windows' display settings for the full rate.", current, current, g.frame_rate);
+            else
+                ImGui::TextWrapped("The display is set to %d Hz: %d fps on it won't be evenly spaced. Set it to %d Hz in Windows' display settings, or pick %d fps.", current, g.frame_rate,
+                                   g.frame_rate, current);
+            ImGui::PopStyleColor();
+        }
+    }
+    changed |= ImGui::Checkbox("Vsync", &g.vsync);
+    int aspect = g.widescreen ? 1 : 0;
+    ImGui::TextUnformatted(in_game && !ps2::widescreen_live() ? "Aspect ratio (after restart)" : "Aspect ratio");
+    ImGui::SameLine();
+    changed |= ImGui::RadioButton("4:3", &aspect, 0);
+    ImGui::SameLine();
+    changed |= ImGui::RadioButton("16:9", &aspect, 1);
+    g.widescreen = aspect == 1;
+    changed |= ImGui::Checkbox("Fullscreen", &g.fullscreen);
+
+    ImGui::SeparatorText("Picture");
+    const char *const aa[] = {"Off", "FXAA"};
+    int fxaa = g.fxaa ? 1 : 0;
+    if (ImGui::Combo("Anti-aliasing", &fxaa, aa, 2)) {
+        g.fxaa = fxaa == 1;
+        changed = true;
+    }
+    const char *const upscale[] = {"Default", "FSR-style"};
+    int fsr = g.fsr ? 1 : 0;
+    if (ImGui::Combo("Upscaling filter", &fsr, upscale, 2)) {
+        g.fsr = fsr == 1;
+        changed = true;
+    }
+    changed |= with_strength("Sharpening", g.sharpen, &g.sharpen_strength, "sharpen");
+    changed |= with_strength("Bloom", g.bloom, &g.bloom_strength, "bloom");
+    if (ImGui::TreeNode("Colour")) {
+        changed |= ImGui::SliderFloat("Brightness", &g.brightness, -0.5f, 0.5f, "%.2f");
+        changed |= ImGui::SliderFloat("Contrast", &g.contrast, 0.5f, 1.5f, "%.2f");
