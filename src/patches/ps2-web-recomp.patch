+// game picture into an offscreen texture the size of the window's picture area. Every effect is off
+// unless its flag is set; with all of them off, gpu.cpp skips this file entirely.
+//   easu: the FSR-style upscale, from the picture at its internal resolution to the window's size
+//   bright, blur_*: bloom's bright-pass and Gaussian blur rounds, at quarter size
+//   post: in this order, CRT curvature (it bends where everything is read), sharpening, bloom added back,
+//         colour, debanding, CRT scanlines and mask, vignette, film grain; written to the window
+
+struct Post {
+    flags: u32,   // 1 sharpen, 2 bloom, 4 colour, 8 deband, 16 CRT, 32 CRT curvature, 64 vignette, 128 grain
+    frame: u32,
+    out_w: f32,
+    out_h: f32,
+    sharpen: f32,
+    bloom: f32,
+    brightness: f32,
+    contrast: f32,
+    saturation: f32,
+    gamma: f32,
+    scanlines: f32,
+    vignette: f32,
+    grain: f32,
+    lines: f32,   // the game picture's lines (448), for the scanlines
+    pad0: f32,
+    pad1: f32,
+}
+
+@group(0) @binding(0) var source: texture_2d<f32>;
+@group(0) @binding(1) var glow: texture_2d<f32>;
+@group(0) @binding(2) var smp: sampler;
+@group(0) @binding(3) var<uniform> post: Post;
+
+struct VertexOut {
+    @builtin(position) position: vec4<f32>,
+    @location(0) uv: vec2<f32>,
+}
+
+@vertex
+fn vs(@builtin(vertex_index) i: u32) -> VertexOut {
+    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    var o: VertexOut;
+    o.position = vec4<f32>(p * 2.0 - 1.0, 0.0, 1.0);
+    o.uv = vec2<f32>(p.x, 1.0 - p.y);
+    return o;
+}
+
+fn at(t: texture_2d<f32>, uv: vec2<f32>) -> vec3<f32> { return textureSampleLevel(t, smp, uv, 0.0).rgb; }
+
+fn luma(c: vec3<f32>) -> f32 { return dot(c, vec3<f32>(0.299, 0.587, 0.114)); }
+
+// Bloom's bright-pass, into a quarter-size buffer: the average of the 4x4 picture pixels under each texel
+// (four bilinear taps, so small lights don't flicker), kept by a soft knee from luma 0.25 to full at 0.75.
+// The game is dark: a high threshold left only flame cores, and the bloom barely showed.
+@fragment
+fn bright(in: VertexOut) -> @location(0) vec4<f32> {
+    let t = 1.0 / vec2<f32>(textureDimensions(source));
+    let c = (at(source, in.uv + vec2<f32>(-t.x, -t.y)) + at(source, in.uv + vec2<f32>(t.x, -t.y)) +
+             at(source, in.uv + vec2<f32>(-t.x, t.y)) + at(source, in.uv + vec2<f32>(t.x, t.y))) * 0.25;
+    let k = smoothstep(0.25, 0.75, luma(c));
+    return vec4<f32>(c * k, 1.0);
+}
+
+// A 9-tap Gaussian (sigma about 2 texels), one direction per pass. Bloom runs it three times, at a
+// one-, two- and four-texel step (blur_*, blur_wide_*, blur_wider_*): a glow with a sigma of about 9
+// quarter-size texels, about 2% of the picture's width.
+const kWeights = array<f32, 5>(0.227027, 0.1945946, 0.1216216, 0.054054, 0.016216);
+
+@fragment
+fn blur_wide_h(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(2.0 / size.x, 0.0)), 1.0);
+}
+
+@fragment
+fn blur_wide_v(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(0.0, 2.0 / size.y)), 1.0);
+}
+
+@fragment
+fn blur_wider_h(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(4.0 / size.x, 0.0)), 1.0);
+}
+
+@fragment
+fn blur_wider_v(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(0.0, 4.0 / size.y)), 1.0);
+}
+
+fn blur(uv: vec2<f32>, dir: vec2<f32>) -> vec3<f32> {
+    var c = at(source, uv) * kWeights[0];
+    for (var k = 1; k < 5; k++) {
+        let d = dir * f32(k);
+        c += (at(source, uv + d) + at(source, uv - d)) * kWeights[k];
+    }
+    return c;
+}
+
+@fragment
+fn blur_h(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(1.0 / size.x, 0.0)), 1.0);
+}
+
+@fragment
+fn blur_v(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    return vec4<f32>(blur(in.uv, vec2<f32>(0.0, 1.0 / size.y)), 1.0);
+}
+
+// Contrast-adaptive sharpening (after AMD's published CAS idea): each pixel is pushed away from its four
+// neighbours' average, less where the neighbourhood already has strong contrast, so edges don't ring.
+fn sharpened(uv: vec2<f32>) -> vec3<f32> {
+    let t = 1.0 / vec2<f32>(post.out_w, post.out_h);
+    let c = at(source, uv);
+    let n = at(source, uv + vec2<f32>(0.0, -t.y));
+    let s = at(source, uv + vec2<f32>(0.0, t.y));
+    let e = at(source, uv + vec2<f32>(t.x, 0.0));
+    let w = at(source, uv + vec2<f32>(-t.x, 0.0));
+    let lo = min(c, min(min(n, s), min(e, w)));
+    let hi = max(c, max(max(n, s), max(e, w)));
+    let amp = sqrt(clamp(min(lo, 1.0 - hi) / max(hi, vec3<f32>(1e-5)), vec3<f32>(0.0), vec3<f32>(1.0)));
+    let weight = -amp / mix(8.0, 5.0, post.sharpen);
+    return clamp((c + (n + s + e + w) * weight) / (1.0 + 4.0 * weight), vec3<f32>(0.0), vec3<f32>(1.0));
+}
+
+// The FSR-style upscale, this port's own code after the published idea of FSR 1's EASU: 12 source pixels
+// around the output point, weighted by a Lanczos-like kernel that is stretched along the local edge
+// (so edges are smoothed along their length and stay sharp across it), and the result clamped to the
+// four nearest pixels' range so it can't ring.
+fn texel(p: vec2<i32>) -> vec3<f32> {
+    let size = vec2<i32>(textureDimensions(source));
+    return textureLoad(source, clamp(p, vec2<i32>(0), size - 1), 0).rgb;
+}
+
+fn kernel(d2: f32, lobe: f32) -> f32 {
+    let x = min(d2, 1.0 / lobe);  // past 1/lobe the window would rise into a second, wrong lobe
+    let a = 0.4 * x - 1.0;
+    let b = lobe * x - 1.0;
+    return (1.5625 * a * a - 0.5625) * (b * b);
+}
+
+@fragment
+fn easu(in: VertexOut) -> @location(0) vec4<f32> {
+    let size = vec2<f32>(textureDimensions(source));
+    let p = in.uv * size - 0.5;
+    let base = floor(p);
+    let f = p - base;
+    let b = vec2<i32>(base);
+    let c00 = texel(b);
+    let c10 = texel(b + vec2<i32>(1, 0));
+    let c01 = texel(b + vec2<i32>(0, 1));
+    let c11 = texel(b + vec2<i32>(1, 1));
+    let l00 = luma(c00);
+    let l10 = luma(c10);
+    let l01 = luma(c01);
+    let l11 = luma(c11);
+    var dir = vec2<f32>((l10 - l00) + (l11 - l01), (l01 - l00) + (l11 - l10));
+    let strength = length(dir);
+    dir = select(vec2<f32>(1.0, 0.0), dir / max(strength, 1e-6), strength > 1e-5);
+    let edge = clamp(strength * 4.0, 0.0, 1.0);
+    let stretch = 1.0 + edge;        // longer along the edge where there is one
+    let lobe = 0.5 - 0.25 * edge;    // a wider lobe (softer) on flat areas, sharper on edges
+    var sum = vec3<f32>(0.0);
+    var weight = 0.0;
+    for (var y = -1; y <= 2; y++) {
+        for (var x = -1; x <= 2; x++) {
+            if ((x == -1 || x == 2) && (y == -1 || y == 2)) { continue; }  // 12 taps: no corners
+            let o = vec2<f32>(f32(x), f32(y)) - f;
+            let r = vec2<f32>(dot(o, dir), dot(o, vec2<f32>(-dir.y, dir.x)) / stretch);
+            let w = kernel(dot(r, r), lobe);
+            sum += texel(b + vec2<i32>(x, y)) * w;
+            weight += w;
+        }
+    }
+    let lo = min(min(c00, c10), min(c01, c11));
+    let hi = max(max(c00, c10), max(c01, c11));
+    return vec4<f32>(clamp(sum / max(weight, 1e-5), lo, hi), 1.0);
+}
+
+fn hash(p: vec2<f32>) -> f32 { return fract(sin(dot(p, vec2<f32>(12.9898, 78.233))) * 43758.5453); }
+
+// Debanding: where four samples 16 pixels around are all within 1.5/255 of this pixel, the area is a
+// gradient that 8 bits cut into bands, so the pixel takes their average; then a little dither.
+fn debanded(uv: vec2<f32>, pixel: vec2<f32>, c: vec3<f32>) -> vec3<f32> {
+    let centre = at(source, uv);
+    let r = 16.0 / vec2<f32>(post.out_w, post.out_h) * (0.5 + 0.5 * hash(pixel + 1.7));
+    let a = hash(pixel) * 6.2831853;
+    var sum = vec3<f32>(0.0);
+    var smooth_area = true;
+    for (var k = 0; k < 4; k++) {
+        let angle = a + f32(k) * 1.5707963;
+        let s = at(source, uv + vec2<f32>(cos(angle), sin(angle)) * r);
+        smooth_area = smooth_area && all(abs(s - centre) < vec3<f32>(1.5 / 255.0));
+        sum += s;
+    }
+    var out = c;
+    if (smooth_area) { out = c + (sum * 0.25 - centre); }
+    return out + (hash(pixel + 3.1) - 0.5) / 255.0;
+}
+
+@fragment
+fn fs_post(in: VertexOut) -> @location(0) vec4<f32> {
+    var uv = in.uv;
+    if ((post.flags & 32u) != 0u) {
+        // CRT curvature: a gentle barrel (0.03); outside the bent picture is black.
+        let cc = uv * 2.0 - 1.0;
+        uv = cc * (1.0 + 0.03 * dot(cc, cc)) * 0.5 + 0.5;
+        if (any(uv < vec2<f32>(0.0)) || any(uv > vec2<f32>(1.0))) { return vec4<f32>(0.0, 0.0, 0.0, 1.0); }
+    }
+    var c = at(source, uv);
+    if ((post.flags & 1u) != 0u) { c = sharpened(uv); }
+    if ((post.flags & 2u) != 0u) { c = c + at(glow, uv) * (2.5 * post.bloom); }
+    if ((post.flags & 4u) != 0u) {
+        c = (c - 0.5) * post.contrast + 0.5 + post.brightness;
+        c = mix(vec3<f32>(luma(c)), c, post.saturation);
+        c = pow(clamp(c, vec3<f32>(0.0), vec3<f32>(1.0)), vec3<f32>(1.0 / post.gamma));
+    }
+    if ((post.flags & 8u) != 0u) { c = debanded(uv, in.position.xy, c); }
+    if ((post.flags & 16u) != 0u) {
+        // Scanlines at the game's own lines, then an aperture-grille mask by output column.
+        let row = fract(uv.y * post.lines);
+        let scan = mix(1.0, 0.55 + 0.45 * sin(row * 3.14159265), post.scanlines);
+        let column = u32(in.position.x) % 3u;
+        var mask = vec3<f32>(0.85);
+        mask[column] = 1.0;
+        c = c * scan * mix(vec3<f32>(1.0), mask, 0.5 * post.scanlines) * (1.0 + 0.25 * post.scanlines);
+    }
+    if ((post.flags & 64u) != 0u) {
+        let d = distance(uv, vec2<f32>(0.5)) * 1.4142136;
+        c = c * (1.0 - post.vignette * smoothstep(0.4, 1.0, d));
+    }
+    if ((post.flags & 128u) != 0u) {
+        c = c + (hash(in.position.xy + f32(post.frame % 4096u) * 7.31) - 0.5) * 0.12 * post.grain;
+    }
+    return vec4<f32>(clamp(c, vec3<f32>(0.0), vec3<f32>(1.0)), 1.0);
+}
