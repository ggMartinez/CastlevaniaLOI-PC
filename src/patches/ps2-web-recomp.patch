+
+enum class Api { d3d12, vulkan };
+
+struct Graphics {
+    Api api = Api::vulkan;  // the proven path; Direct3D 12 is the newer, less played one
+    int scale = 1;  // 1..6
+    // A direct internal resolution, in lines (one of kResolutions), instead of the multiple; 0: the multiple.
+    int resolution = 0;
+    bool vsync = true, widescreen = false, fullscreen = false, fxaa = false, fsr = false;
+    bool sharpen = false, bloom = false, deband = false, crt = false, crt_curvature = false, vignette = false, grain = false;
+    float sharpen_strength = 0.5f, bloom_strength = 0.5f, crt_scanlines = 0.5f, vignette_strength = 0.5f, grain_strength = 0.3f;  // 0..1
+    float brightness = 0.0f, contrast = 1.0f, saturation = 1.0f, gamma = 1.0f;  // -0.5..0.5, 0.5..1.5, 0..2, 0.5..2
+    // The player camera: the game's own, or a third-person one the right stick turns (R1 switches
+    // between the two while playing).
+    bool third_person = false;
+    float camera_distance = 1000.0f;  // 400..2000, from the player
+    float camera_speed = 1.0f;        // 0.25..3
+    bool camera_invert_x = false, camera_invert_y = false;
+    // The renderer: the GS emulated on the GPU (accurate, the default), or the game's drawing as native GPU
+    // draws (experimental; taken when the game starts).
+    bool native_renderer = false;
+    // Frame rate (native renderer), pictures per second: 60, the game's own, or more with in-between pictures
+    // (frame interpolation; the game still runs at 60). Offered: the display's refresh rates.
+    int frame_rate = 60;
