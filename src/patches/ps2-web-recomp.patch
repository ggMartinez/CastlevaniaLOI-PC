+    e[0].binding = 0;
+    e[0].textureView = source;
+    e[1].binding = 1;
+    e[1].textureView = glow;
+    e[2].binding = 2;
+    e[2].sampler = g_fx_sampler;
+    e[3].binding = 3;
+    e[3].buffer = g_fx_params;
+    e[3].size = 64;
+    WGPUBindGroupDescriptor d = WGPU_BIND_GROUP_DESCRIPTOR_INIT;
+    d.layout = g_fx_layout;
+    d.entryCount = 4;
+    d.entries = e;
+    return wgpuDeviceCreateBindGroup(g_device, &d);
+}
+
+// The targets for a picture area of w x h, created (or recreated) when that size changes.
+void ensure_fx_targets(std::uint32_t w, std::uint32_t h, std::uint32_t lo_w, std::uint32_t lo_h) {
+    if (w == g_fx_width && h == g_fx_height && lo_w == g_fx_lo_width && lo_h == g_fx_lo_height && g_fx_scene.view) return;
+    for (WGPUBindGroup *g : {&g_fx_bright_group, &g_fx_blur_h_group, &g_fx_blur_v_group, &g_fx_post_group, &g_fx_easu_group})
+        if (*g) {
+            wgpuBindGroupRelease(*g);
+            *g = nullptr;
+        }
+    release_target(g_fx_scene);
+    release_target(g_fx_a);
+    release_target(g_fx_b);
+    release_target(g_fx_lo);
+    g_fx_width = w;
+    g_fx_height = h;
+    g_fx_lo_width = lo_w;
+    g_fx_lo_height = lo_h;
+    if (lo_w && lo_h) {
+        g_fx_lo = make_target(lo_w, lo_h);
+        g_fx_easu_group = fx_group(g_fx_lo.view, g_fx_lo.view);
+    }
+    g_fx_scene = make_target(w, h);
+    g_fx_a = make_target(w / 4, h / 4);
+    g_fx_b = make_target(w / 4, h / 4);
+    g_fx_bright_group = fx_group(g_fx_scene.view, g_fx_scene.view);
+    g_fx_blur_h_group = fx_group(g_fx_a.view, g_fx_a.view);
+    g_fx_blur_v_group = fx_group(g_fx_b.view, g_fx_b.view);
+    g_fx_post_group = fx_group(g_fx_scene.view, g_fx_a.view);
+}
+
+void fx_pass(WGPUCommandEncoder enc, WGPUTextureView target, WGPURenderPipeline pipeline, WGPUBindGroup group) {
+    WGPURenderPassColorAttachment color = WGPU_RENDER_PASS_COLOR_ATTACHMENT_INIT;
+    color.view = target;
+    color.loadOp = WGPULoadOp_Clear;
+    color.storeOp = WGPUStoreOp_Store;
+    color.clearValue = WGPUColor{0.0, 0.0, 0.0, 1.0};
+    WGPURenderPassDescriptor rd = WGPU_RENDER_PASS_DESCRIPTOR_INIT;
+    rd.colorAttachmentCount = 1;
+    rd.colorAttachments = &color;
+    WGPURenderPassEncoder rp = wgpuCommandEncoderBeginRenderPass(enc, &rd);
+    wgpuRenderPassEncoderSetPipeline(rp, pipeline);
+    wgpuRenderPassEncoderSetBindGroup(rp, 0, group, 0, nullptr);
+    wgpuRenderPassEncoderDraw(rp, 3, 1, 0, 0);
+    wgpuRenderPassEncoderEnd(rp);
+    wgpuRenderPassEncoderRelease(rp);
+}
+
+// The presentation pass: the game picture at its aspect ratio, then the on-screen text. With every
+// picture effect off it is a single draw of blit.wgsl into the window, as it always was; otherwise the
+// picture goes through effects.wgsl first (bloom's passes, then the final pass into the window).
+void record_present(WGPUCommandEncoder enc, WGPUTextureView present_view) {
+    const Graphics g = graphics();
+    const float w = static_cast<float>(g_surface_width), h = static_cast<float>(g_surface_height);
+    const float aspect = g_options.widescreen ? 16.0f / 9.0f : 4.0f / 3.0f;
+    const float vw = std::min(w, h * aspect), vh = vw / aspect;
+    // Colour counts as on only when it isn't neutral, so the defaults draw exactly as before.
+    const bool colour = g.brightness != 0.0f || g.contrast != 1.0f || g.saturation != 1.0f || g.gamma != 1.0f;
+    const std::uint32_t fx_flags = (g.sharpen ? 1u : 0u) | (g.bloom ? 2u : 0u) | (colour ? 4u : 0u) | (g.deband ? 8u : 0u) | (g.crt ? 16u : 0u) |
+                                   (g.crt && g.crt_curvature ? 32u : 0u) | (g.vignette ? 64u : 0u) | (g.grain ? 128u : 0u);
+    // The FSR-style upscale runs only when the window's picture is larger than the internal one.
+    const bool fsr = g.fsr && g_fx_easu && g_blit_group_lo && g_internal_width && vw > static_cast<float>(g_internal_width) + 0.5f;
+    const bool effects = (fx_flags || fsr) && g_fx_post;
+    if (effects) {
+        ensure_fx_targets(static_cast<std::uint32_t>(vw), static_cast<std::uint32_t>(vh), fsr ? g_internal_width : 0u, fsr ? g_internal_height : 0u);
+        const struct {
+            std::uint32_t flags, frame;
+            float out_w, out_h, sharpen, bloom, brightness, contrast, saturation, gamma, scanlines, vignette, grain, lines, pad0, pad1;
+        } params = {fx_flags,     static_cast<std::uint32_t>(frame_count()), vw, vh, g.sharpen_strength, g.bloom_strength, g.brightness, g.contrast,
+                    g.saturation, g.gamma, g.crt_scanlines, g.vignette_strength, g.grain_strength, 448.0f, 0.0f, 0.0f};
+        static_assert(sizeof params == 64);
+        wgpuQueueWriteBuffer(g_queue, g_fx_params, 0, &params, sizeof params);
+        if (fsr) {
+            fx_pass(enc, g_fx_lo.view, g_blit, g_blit_group_lo);
+            fx_pass(enc, g_fx_scene.view, g_fx_easu, g_fx_easu_group);
+        } else {
+            fx_pass(enc, g_fx_scene.view, g_blit, g_blit_group);
+        }
+        if (g.bloom) {
+            fx_pass(enc, g_fx_a.view, g_fx_bright, g_fx_bright_group);
+            fx_pass(enc, g_fx_b.view, g_fx_blur_h, g_fx_blur_h_group);
+            fx_pass(enc, g_fx_a.view, g_fx_blur_v, g_fx_blur_v_group);
+            fx_pass(enc, g_fx_b.view, g_fx_wide_h, g_fx_blur_h_group);
+            fx_pass(enc, g_fx_a.view, g_fx_wide_v, g_fx_blur_v_group);
+            fx_pass(enc, g_fx_b.view, g_fx_wider_h, g_fx_blur_h_group);
+            fx_pass(enc, g_fx_a.view, g_fx_wider_v, g_fx_blur_v_group);
+        }
+    }
+    WGPURenderPassColorAttachment color = WGPU_RENDER_PASS_COLOR_ATTACHMENT_INIT;
+    color.view = present_view;
+    color.loadOp = WGPULoadOp_Clear;
+    color.storeOp = WGPUStoreOp_Store;
+    color.clearValue = WGPUColor{0.0, 0.0, 0.0, 1.0};
+    WGPURenderPassDescriptor rd = WGPU_RENDER_PASS_DESCRIPTOR_INIT;
+    rd.colorAttachmentCount = 1;
+    rd.colorAttachments = &color;
+    WGPURenderPassEncoder rp = wgpuCommandEncoderBeginRenderPass(enc, &rd);
+    wgpuRenderPassEncoderSetViewport(rp, (w - vw) * 0.5f, (h - vh) * 0.5f, vw, vh, 0.0f, 1.0f);
+    wgpuRenderPassEncoderSetPipeline(rp, effects ? g_fx_post : g_blit);
+    wgpuRenderPassEncoderSetBindGroup(rp, 0, effects ? g_fx_post_group : g_blit_group, 0, nullptr);
+    wgpuRenderPassEncoderDraw(rp, 3, 1, 0, 0);
+    if (g_overlay_shown && g_overlay) {
+        wgpuRenderPassEncoderSetViewport(rp, 0.0f, 0.0f, w, h, 0.0f, 1.0f);
+        wgpuRenderPassEncoderSetPipeline(rp, g_overlay);
+        wgpuRenderPassEncoderSetBindGroup(rp, 0, g_overlay_group, 0, nullptr);
+        wgpuRenderPassEncoderDraw(rp, 6, 1, 0, 0);
+    }
+    if (g_menu_draw) {
+        wgpuRenderPassEncoderSetViewport(rp, 0.0f, 0.0f, w, h, 0.0f, 1.0f);
+        g_menu_draw(rp);
+    }
+    wgpuRenderPassEncoderEnd(rp);
+    wgpuRenderPassEncoderRelease(rp);
+}
