index 0000000..7955239
--- /dev/null
+++ b/runtime/src/gs/swizzle.cpp
@@ -0,0 +1,213 @@
+#include "swizzle.hpp"
+
+#include "gs.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace ps2::gs::swizzle {
+
+namespace {
+
+const int kBlock32[4][8] = {{0, 1, 4, 5, 16, 17, 20, 21}, {2, 3, 6, 7, 18, 19, 22, 23}, {8, 9, 12, 13, 24, 25, 28, 29}, {10, 11, 14, 15, 26, 27, 30, 31}};
+const int kBlockZ32[4][8] = {{24, 25, 28, 29, 8, 9, 12, 13}, {26, 27, 30, 31, 10, 11, 14, 15}, {16, 17, 20, 21, 0, 1, 4, 5}, {18, 19, 22, 23, 2, 3, 6, 7}};
+const int kColumn32[2][8] = {{0, 1, 4, 5, 8, 9, 12, 13}, {2, 3, 6, 7, 10, 11, 14, 15}};
+const int kBlock16[8][4] = {{0, 2, 8, 10}, {1, 3, 9, 11}, {4, 6, 12, 14}, {5, 7, 13, 15}, {16, 18, 24, 26}, {17, 19, 25, 27}, {20, 22, 28, 30}, {21, 23, 29, 31}};
+const int kBlock16S[8][4] = {{0, 2, 16, 18}, {1, 3, 17, 19}, {8, 10, 24, 26}, {9, 11, 25, 27}, {4, 6, 20, 22}, {5, 7, 21, 23}, {12, 14, 28, 30}, {13, 15, 29, 31}};
+const int kBlockZ16[8][4] = {{24, 26, 16, 18}, {25, 27, 17, 19}, {28, 30, 20, 22}, {29, 31, 21, 23}, {8, 10, 0, 2}, {9, 11, 1, 3}, {12, 14, 4, 6}, {13, 15, 5, 7}};
+const int kBlockZ16S[8][4] = {{24, 26, 8, 10}, {25, 27, 9, 11}, {16, 18, 0, 2}, {17, 19, 1, 3}, {28, 30, 12, 14}, {29, 31, 13, 15}, {20, 22, 4, 6}, {21, 23, 5, 7}};
+const int kColumn16[2][16] = {{0, 2, 8, 10, 16, 18, 24, 26, 1, 3, 9, 11, 17, 19, 25, 27}, {4, 6, 12, 14, 20, 22, 28, 30, 5, 7, 13, 15, 21, 23, 29, 31}};
+const int kColumnWord[2][2][8] = {{{0, 1, 4, 5, 8, 9, 12, 13}, {2, 3, 6, 7, 10, 11, 14, 15}}, {{8, 9, 12, 13, 0, 1, 4, 5}, {10, 11, 14, 15, 2, 3, 6, 7}}};
+
+void build(Tables &t) {
+    for (int y = 0; y < 32; ++y)
+        for (int x = 0; x < 64; ++x) {
+            const int column = (y & 7) / 2, cy = y & 1, cx = x & 7;
+            t.off32[y][x] = static_cast<std::uint32_t>(kBlock32[y / 8][x / 8] * 256 + column * 64 + kColumn32[cy][cx] * 4);
+            t.offz32[y][x] = static_cast<std::uint32_t>(kBlockZ32[y / 8][x / 8] * 256 + column * 64 + kColumn32[cy][cx] * 4);
+        }
+    for (int y = 0; y < 64; ++y)
+        for (int x = 0; x < 64; ++x) {
+            const int column = (y & 7) / 2, cy = y & 1, cx = x & 15;
+            const int inner = column * 64 + kColumn16[cy][cx] * 2;
+            t.off16[y][x] = static_cast<std::uint32_t>(kBlock16[y / 8][x / 16] * 256 + inner);
+            t.off16s[y][x] = static_cast<std::uint32_t>(kBlock16S[y / 8][x / 16] * 256 + inner);
+            t.offz16[y][x] = static_cast<std::uint32_t>(kBlockZ16[y / 8][x / 16] * 256 + inner);
+            t.offz16s[y][x] = static_cast<std::uint32_t>(kBlockZ16S[y / 8][x / 16] * 256 + inner);
+        }
+    for (int y = 0; y < 64; ++y)
+        for (int x = 0; x < 128; ++x) {
+            const int block = kBlock32[(y / 16) & 3][(x / 16) & 7];
+            int wx = x % 16, wy = y % 16;
+            const int column = wy / 4;
+            wy %= 4;
+            std::uint32_t table = static_cast<std::uint32_t>((wy & 2) >> 1);
+            const std::uint32_t byte = static_cast<std::uint32_t>(((wx & 8) >> 2) + ((wy & 2) >> 1));
+            table ^= static_cast<std::uint32_t>((y / 4) & 1);
+            t.off8[y][x] = static_cast<std::uint32_t>(block * 256 + column * 64 + kColumnWord[table][wy & 1][wx & 7] * 4) + byte;
+        }
+    for (int y = 0; y < 128; ++y)
+        for (int x = 0; x < 128; ++x) {
+            const int block = kBlock16[(y / 16) & 7][(x / 32) & 3];
+            int wx = x % 32, wy = y % 16;
+            const int column = wy / 4;
+            wy %= 4;
+            const std::uint32_t shift = static_cast<std::uint32_t>((wx & 0x18) + ((wy & 2) << 1));
+            const std::uint32_t nibble = shift / 4;
+            std::uint32_t table = static_cast<std::uint32_t>((wy & 2) >> 1);
+            table ^= static_cast<std::uint32_t>(column & 1);
+            t.off4[y][x] = static_cast<std::uint32_t>((column * 64 + block * 256 + kColumnWord[table][wy & 1][wx & 7] * 4) * 2) + nibble;
+        }
+}
+
+std::uint32_t wrap(std::uint32_t a) { return a & (kMemorySize - 1); }
+
+template <typename T>
+T get(const std::uint8_t *mem, std::uint32_t a) {
+    T v;
+    std::memcpy(&v, mem + wrap(a), sizeof v);
+    return v;
+}
+
+template <typename T>
+void put(std::uint8_t *mem, std::uint32_t a, T v) { std::memcpy(mem + wrap(a), &v, sizeof v); }
+
+}  // namespace
+
+const Tables &tables() {
+    static const Tables t = [] {
+        Tables built{};
+        build(built);
+        return built;
+    }();
+    return t;
+}
+
+std::uint32_t page_address(std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y, std::uint32_t pw, std::uint32_t ph) {
+    const std::uint32_t per_row = std::max<std::uint32_t>(1, bw * 64 / pw);
+    return bp * 256 + ((x / pw) + (y / ph) * per_row) * 8192;
+}
+
+std::uint32_t read_pixel(const std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y) {
+    const Tables &t = tables();
+    switch (psm) {
+    case PSMCT32: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]);
+    case PSMCT24: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]) & 0xFFFFFFu;
+    case PSMZ32: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.offz32[y & 31][x & 63]);
+    case PSMZ24: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.offz32[y & 31][x & 63]) & 0xFFFFFFu;
+    case PSMCT16: return get<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.off16[y & 63][x & 63]);
+    case PSMCT16S: return get<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.off16s[y & 63][x & 63]);
+    case PSMZ16: return get<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.offz16[y & 63][x & 63]);
+    case PSMZ16S: return get<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.offz16s[y & 63][x & 63]);
+    case PSMT8: return get<std::uint8_t>(mem, page_address(bp, bw, x, y, 128, 64) + t.off8[y & 63][x & 127]);
+    case PSMT4: {
+        const std::uint32_t n = t.off4[y & 127][x & 127];
+        const std::uint8_t b = get<std::uint8_t>(mem, page_address(bp, bw, x, y, 128, 128) + n / 2);
+        return (n & 1u) ? b >> 4 : b & 15u;
+    }
+    case PSMT8H: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]) >> 24;
+    case PSMT4HL: return (get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]) >> 24) & 15u;
+    case PSMT4HH: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]) >> 28;
+    default: return get<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63]);
+    }
+}
+
+namespace {
+
+// One page-sized run at a time: the page's address once, then the row of the offset table.
+template <typename T, std::uint32_t PW, std::uint32_t PH, typename Value>
+void row_of(const std::uint8_t *mem, const std::uint32_t *offsets, std::uint32_t bp, std::uint32_t bw, std::uint32_t x0, std::uint32_t y,
+            std::uint32_t n, std::uint32_t *out, Value value) {
+    const std::uint32_t per_row = std::max<std::uint32_t>(1, bw * 64 / PW);
+    for (std::uint32_t x = x0, end = x0 + n; x < end;) {
+        const std::uint32_t page = bp * 256 + ((x / PW) + (y / PH) * per_row) * 8192;
+        const std::uint32_t stop = std::min(end, (x / PW + 1) * PW);
+        for (; x < stop; ++x) *out++ = value(get<T>(mem, page + offsets[x % PW]));
+    }
+}
+
+}  // namespace
+
+void read_row(const std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x0, std::uint32_t y, std::uint32_t n, std::uint32_t *out) {
+    const Tables &t = tables();
+    const auto same = [](std::uint32_t v) { return v; };
+    const auto low24 = [](std::uint32_t v) { return v & 0xFFFFFFu; };
+    switch (psm) {
+    case PSMCT32: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, same); break;
+    case PSMCT24: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, low24); break;
+    case PSMZ32: row_of<std::uint32_t, 64, 32>(mem, t.offz32[y & 31], bp, bw, x0, y, n, out, same); break;
+    case PSMZ24: row_of<std::uint32_t, 64, 32>(mem, t.offz32[y & 31], bp, bw, x0, y, n, out, low24); break;
+    case PSMCT16: row_of<std::uint16_t, 64, 64>(mem, t.off16[y & 63], bp, bw, x0, y, n, out, same); break;
+    case PSMCT16S: row_of<std::uint16_t, 64, 64>(mem, t.off16s[y & 63], bp, bw, x0, y, n, out, same); break;
+    case PSMZ16: row_of<std::uint16_t, 64, 64>(mem, t.offz16[y & 63], bp, bw, x0, y, n, out, same); break;
+    case PSMZ16S: row_of<std::uint16_t, 64, 64>(mem, t.offz16s[y & 63], bp, bw, x0, y, n, out, same); break;
+    case PSMT8: row_of<std::uint8_t, 128, 64>(mem, t.off8[y & 63], bp, bw, x0, y, n, out, same); break;
+    case PSMT4: {
+        const std::uint32_t per_row = std::max<std::uint32_t>(1, bw * 64 / 128);
+        const std::uint32_t *offsets = t.off4[y & 127];
+        for (std::uint32_t x = x0, end = x0 + n; x < end;) {
+            const std::uint32_t page = bp * 256 + ((x / 128) + (y / 128) * per_row) * 8192;
+            const std::uint32_t stop = std::min(end, (x / 128 + 1) * 128);
+            for (; x < stop; ++x) {
+                const std::uint32_t o = offsets[x % 128];
+                const std::uint8_t b = get<std::uint8_t>(mem, page + o / 2);
+                *out++ = (o & 1u) ? b >> 4 : b & 15u;
+            }
+        }
+        break;
+    }
+    case PSMT8H: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, [](std::uint32_t v) { return v >> 24; }); break;
+    case PSMT4HL: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, [](std::uint32_t v) { return (v >> 24) & 15u; }); break;
+    case PSMT4HH: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, [](std::uint32_t v) { return v >> 28; }); break;
+    default: row_of<std::uint32_t, 64, 32>(mem, t.off32[y & 31], bp, bw, x0, y, n, out, same); break;
+    }
+}
+
+void write_pixel(std::uint8_t *mem, std::uint32_t psm, std::uint32_t bp, std::uint32_t bw, std::uint32_t x, std::uint32_t y, std::uint32_t value) {
+    const Tables &t = tables();
+    switch (psm) {
+    case PSMCT32: put<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63], value); break;
+    case PSMZ32: put<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.offz32[y & 31][x & 63], value); break;
+    case PSMCT24: {
+        const std::uint32_t a = page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63];
+        put<std::uint32_t>(mem, a, (get<std::uint32_t>(mem, a) & 0xFF000000u) | (value & 0xFFFFFFu));
+        break;
+    }
+    case PSMZ24: {
+        const std::uint32_t a = page_address(bp, bw, x, y, 64, 32) + t.offz32[y & 31][x & 63];
+        put<std::uint32_t>(mem, a, (get<std::uint32_t>(mem, a) & 0xFF000000u) | (value & 0xFFFFFFu));
+        break;
+    }
+    case PSMCT16: put<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.off16[y & 63][x & 63], static_cast<std::uint16_t>(value)); break;
+    case PSMCT16S: put<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.off16s[y & 63][x & 63], static_cast<std::uint16_t>(value)); break;
+    case PSMZ16: put<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.offz16[y & 63][x & 63], static_cast<std::uint16_t>(value)); break;
+    case PSMZ16S: put<std::uint16_t>(mem, page_address(bp, bw, x, y, 64, 64) + t.offz16s[y & 63][x & 63], static_cast<std::uint16_t>(value)); break;
+    case PSMT8: put<std::uint8_t>(mem, page_address(bp, bw, x, y, 128, 64) + t.off8[y & 63][x & 127], static_cast<std::uint8_t>(value)); break;
+    case PSMT4: {
+        const std::uint32_t n = t.off4[y & 127][x & 127];
+        const std::uint32_t a = page_address(bp, bw, x, y, 128, 128) + n / 2;
+        std::uint8_t b = get<std::uint8_t>(mem, a);
+        b = (n & 1u) ? static_cast<std::uint8_t>((b & 0x0Fu) | ((value & 15u) << 4)) : static_cast<std::uint8_t>((b & 0xF0u) | (value & 15u));
+        put<std::uint8_t>(mem, a, b);
+        break;
+    }
+    case PSMT8H: {
+        const std::uint32_t a = page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63];
+        put<std::uint32_t>(mem, a, (get<std::uint32_t>(mem, a) & 0x00FFFFFFu) | (value << 24));
+        break;
+    }
+    case PSMT4HL: {
+        const std::uint32_t a = page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63];
+        put<std::uint32_t>(mem, a, (get<std::uint32_t>(mem, a) & 0xF0FFFFFFu) | ((value & 15u) << 24));
+        break;
+    }
+    case PSMT4HH: {
+        const std::uint32_t a = page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63];
+        put<std::uint32_t>(mem, a, (get<std::uint32_t>(mem, a) & 0x0FFFFFFFu) | ((value & 15u) << 28));
+        break;
+    }
+    default: put<std::uint32_t>(mem, page_address(bp, bw, x, y, 64, 32) + t.off32[y & 31][x & 63], value); break;
+    }
+}
+
+}
