diff --git a/host/menu.cpp b/host/menu.cpp
new file mode 100644
index 0000000..453bb7c
--- /dev/null
+++ b/host/menu.cpp
@@ -0,0 +1,106 @@
+#include "menu.hpp"
+
+#include "graphics_ui.hpp"
+#include "ps2/graphics.hpp"
+#include "ps2/system.hpp"
+
+#include <SDL.h>
+#include <imgui.h>
+#include <imgui_impl_sdl2.h>
+#include <imgui_impl_wgpu.h>
+#include <webgpu/webgpu.h>
+
+#include <cstdio>
+
+namespace menu {
+
+namespace {
+
+SDL_Window *g_window = nullptr;
+bool g_can_pause = false, g_ready = false, g_open = false, g_drawn = false;
+
+void draw(void *render_pass) {
+    if (g_open && g_drawn) ImGui_ImplWGPU_RenderDrawData(ImGui::GetDrawData(), static_cast<WGPURenderPassEncoder>(render_pass));
+}
+
+// ImGui starts the first time the menu opens: the GPU device exists by then.
+bool ensure() {
+    if (g_ready) return true;
+    if (!ps2::gpu_device()) return false;
+    IMGUI_CHECKVERSION();
+    ImGui::CreateContext();
+    ImGuiIO &io = ImGui::GetIO();
+    io.ConfigFlags |= ImGuiConfigFlags_NavEnableKeyboard | ImGuiConfigFlags_NavEnableGamepad;
+    io.IniFilename = nullptr;
+    ImGui::StyleColorsDark();
+    ImGui_ImplSDL2_InitForOther(g_window);
+    ImGui_ImplWGPU_InitInfo info;
+    info.Device = static_cast<WGPUDevice>(ps2::gpu_device());
+    info.NumFramesInFlight = 3;
+    info.RenderTargetFormat = static_cast<WGPUTextureFormat>(ps2::gpu_surface_format());
+    info.DepthStencilFormat = WGPUTextureFormat_Undefined;
+    if (!ImGui_ImplWGPU_Init(&info)) return false;
+    ps2::set_menu_draw(draw);
+    g_ready = true;
+    return true;
+}
+
+void set_open(bool open) {
+    if (open == g_open) return;
+    g_open = open;
+    g_drawn = false;
+    if (g_can_pause) ps2::request_pause(open);
+    std::fprintf(stderr, "[menu] %s at frame %llu\n", open ? "opened" : "closed", static_cast<unsigned long long>(ps2::frame_count()));
+}
+
+}
+
+void init(SDL_Window *window, bool can_pause) {
+    g_window = window;
+    g_can_pause = can_pause;
+}
+
+bool open() { return g_open; }
+
+void toggle() {
+    if (!g_open && !ensure()) return;
+    set_open(!g_open);
+}
+
+bool handle_event(const SDL_Event &e) {
+    if (!g_open) return false;
+    if (e.type == SDL_KEYDOWN && !e.key.repeat && e.key.keysym.scancode == SDL_SCANCODE_ESCAPE) {
+        set_open(false);
+        return true;
+    }
+    ImGui_ImplSDL2_ProcessEvent(&e);
+    return true;
+}
+
+void frame() {
+    if (!g_open || !g_ready) return;
+    ImGui_ImplWGPU_NewFrame();
+    ImGui_ImplSDL2_NewFrame();
+    ImGui::NewFrame();
+    const ImGuiViewport *vp = ImGui::GetMainViewport();
+    ImGui::SetNextWindowPos(ImVec2(vp->WorkPos.x + vp->WorkSize.x * 0.5f, vp->WorkPos.y + vp->WorkSize.y * 0.5f), ImGuiCond_Appearing, ImVec2(0.5f, 0.5f));
+    ImGui::Begin("Graphics", nullptr, ImGuiWindowFlags_AlwaysAutoResize | ImGuiWindowFlags_NoCollapse);
+    ps2::Graphics g = ps2::graphics();
+    const bool fullscreen = g.fullscreen;
+    if (ps2ui::graphics_options(g, true)) {
+        ps2::set_graphics(g);
+        if (!ps2::graphics_file().empty()) ps2::save_graphics(ps2::graphics_file(), g);
+        if (g.fullscreen != fullscreen) {
+            SDL_SetWindowFullscreen(g_window, g.fullscreen ? SDL_WINDOW_FULLSCREEN_DESKTOP : 0);
+            SDL_ShowCursor(g.fullscreen ? SDL_DISABLE : SDL_ENABLE);
+        }
+    }
+    ImGui::Separator();
+    const bool close = ImGui::Button("Close (F10)");
+    ImGui::End();
+    ImGui::Render();
+    g_drawn = true;
+    if (close) set_open(false);
+}
+
+}
