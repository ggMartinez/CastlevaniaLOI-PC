+// Development check (PS2_CAPTURE_PRESENT=<frame>:<file.ppm>): the presentation pass of that frame,
+// rendered again into a texture the window's size and written as a binary PPM, so tests can compare
+// exactly what the window shows.
+void capture_present(const char *path) {
+    const std::uint32_t w = g_surface_width, h = g_surface_height;
+    WGPUTextureDescriptor td = WGPU_TEXTURE_DESCRIPTOR_INIT;
+    td.size = {w, h, 1};
+    td.format = g_surface_format;
+    td.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_CopySrc;
+    WGPUTexture texture = wgpuDeviceCreateTexture(g_device, &td);
+    WGPUTextureView tv = wgpuTextureCreateView(texture, nullptr);
+    const std::uint32_t row = (w * 4 + 255) & ~255u;
+    WGPUBuffer out = make_buffer(static_cast<std::uint64_t>(row) * h, WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst);
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    record_present(enc, tv);
+    WGPUTexelCopyTextureInfo src = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+    src.texture = texture;
+    WGPUTexelCopyBufferInfo dst = WGPU_TEXEL_COPY_BUFFER_INFO_INIT;
+    dst.buffer = out;
+    dst.layout.bytesPerRow = row;
+    dst.layout.rowsPerImage = h;
+    const WGPUExtent3D size = {w, h, 1};
+    wgpuCommandEncoderCopyTextureToBuffer(enc, &src, &dst, &size);
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+    bool done = false;
+    WGPUBufferMapCallbackInfo cb = WGPU_BUFFER_MAP_CALLBACK_INFO_INIT;
+    cb.mode = WGPUCallbackMode_AllowProcessEvents;
+    cb.callback = [](WGPUMapAsyncStatus, WGPUStringView, void *flag, void *) { *static_cast<bool *>(flag) = true; };
+    cb.userdata1 = &done;
+    wgpuBufferMapAsync(out, WGPUMapMode_Read, 0, static_cast<std::uint64_t>(row) * h, cb);
+    wait_until(done);
+    const auto *p = static_cast<const std::uint8_t *>(wgpuBufferGetConstMappedRange(out, 0, static_cast<std::uint64_t>(row) * h));
+    const bool bgra = g_surface_format == WGPUTextureFormat_BGRA8Unorm || g_surface_format == WGPUTextureFormat_BGRA8UnormSrgb;
+    if (std::FILE *f = p ? std::fopen(path, "wb") : nullptr) {
+        std::fprintf(f, "P6\n%u %u\n255\n", w, h);
+        std::vector<std::uint8_t> line(static_cast<std::size_t>(w) * 3);
+        for (std::uint32_t y = 0; y < h; ++y) {
+            for (std::uint32_t x = 0; x < w; ++x) {
+                const std::uint8_t *px = p + static_cast<std::size_t>(y) * row + x * 4;
+                line[x * 3] = px[bgra ? 2 : 0];
+                line[x * 3 + 1] = px[1];
+                line[x * 3 + 2] = px[bgra ? 0 : 2];
+            }
+            std::fwrite(line.data(), 1, line.size(), f);
+        }
+        std::fclose(f);
+        std::fprintf(stderr, "[gpu] presented frame %llu captured to %s\n", static_cast<unsigned long long>(frame_count()), path);
+    }
+    wgpuBufferUnmap(out);
+    wgpuBufferRelease(out);
+    wgpuTextureViewRelease(tv);
+    wgpuTextureRelease(texture);
+}
