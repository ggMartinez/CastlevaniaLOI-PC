+}  // namespace
+
+bool enabled() {
+    // The settings' renderer, taken once (the renderers don't switch while playing); PS2_RENDERER=native or
+    // accurate overrides it (development runs and the scene tests).
+    static const bool on = [] {
+        if (const char *v = std::getenv("PS2_RENDERER")) return std::strcmp(v, "native") == 0;
+        return ps2::graphics().native_renderer;
+    }();
+    return on;
+}
+
+void output_scale(float &across, float &down) {
+    // Taken once, like the renderer: the targets keep their size while playing.
+    static const std::pair<float, float> scale = [] {
+        ps2::Graphics g = ps2::graphics();
+        if (const char *v = std::getenv("PS2_SCALE")) g.resolution = 0, g.scale = std::atoi(v);
+        if (const char *v = std::getenv("PS2_RESOLUTION")) g.resolution = std::atoi(v);
+        float x = 1.0f, y = 1.0f;
+        ps2::native_scale(g, x, y);
+        return std::pair{x, y};
+    }();
+    across = scale.first;
+    down = scale.second;
+}
+
+void output_size(std::uint32_t width, std::uint32_t height, std::uint32_t &out_w, std::uint32_t &out_h) {
+    float x = 1.0f, y = 1.0f;
+    output_scale(x, y);
+    out_w = static_cast<std::uint32_t>(std::lround(static_cast<float>(width) * x));
+    out_h = static_cast<std::uint32_t>(std::lround(static_cast<float>(height) * y));
+}
+
+void draw(const State &s, const Vertex *v, int count, const Origin *origin) {
+    std::lock_guard lock(g_mutex);
+    init();
+    const std::uint64_t attr = (s.prmodecont & 1u) ? s.prim : ((s.prim & 7u) | (s.prmode & ~7ull));
+    const int ctx = static_cast<int>(bits(attr, 9, 1));
+    const DrawKey key = key_of(s, ctx);
+    const Target target = target_of(s, ctx);
+    const std::uint64_t sc = s.ctx[ctx].scissor;
+    const std::uint32_t sx0 = bits(sc, 0, 11), sx1 = bits(sc, 16, 11), sy0 = bits(sc, 32, 11), sy1 = bits(sc, 48, 11);
+    const std::uint64_t cl = s.ctx[ctx].clamp, tex0 = s.ctx[ctx].tex0;
+    Params params{{static_cast<float>(bits(s.fogcol, 0, 8)), static_cast<float>(bits(s.fogcol, 8, 8)), static_cast<float>(bits(s.fogcol, 16, 8)), 0.0f},
+                  {bits(cl, 4, 10), bits(cl, 14, 10), bits(cl, 24, 10), bits(cl, 34, 10)},
+                  {0, 0, 1u << std::min(bits(tex0, 26, 4), 10u), 1u << std::min(bits(tex0, 30, 4), 10u)},
+                  {0, 0, bits(s.texa, 0, 8) | (bits(s.texa, 15, 1) << 8), bits(s.texa, 32, 8)}};
+    std::uint32_t texture = 0, read_fbp = 0, read_fbw = 0;
+    if (key.textured && !target_source(tex0, params, read_fbp, read_fbw)) texture = texture_for(s, ctx);
+    static const bool log_sources = std::getenv("PS2_NATIVE_LOG") != nullptr;
+    if (log_sources && key.textured) {
+        std::string live;
+        for (const Live &l : g_live) live += " " + std::to_string(l.fbp) + "/" + std::to_string(l.fbw) + "/" + std::to_string(l.psm) + "x" + std::to_string(l.rows);
+        const std::string line = "tex " + std::to_string(bits(tex0, 0, 14)) + "/" + std::to_string(bits(tex0, 14, 6)) + " psm " + std::to_string(bits(tex0, 20, 6)) +
+                                 " " + std::to_string(params.source[2]) + "x" + std::to_string(params.source[3]) + (params.source[0] ? " from target " + std::to_string(read_fbp) : " from memory") +
+                                 " into " + std::to_string(target.fbp) + "/" + std::to_string(target.fbw) + "/" + std::to_string(target.psm) + "; live" + live;
+        if (g_reported.insert(line).second) std::fprintf(stderr, "[native] %llu %s\n", static_cast<unsigned long long>(frame_count()), line.c_str());
+    }
+    if (g_upload.active) g_upload.drawn = true;
+    if (bits(s.pabe, 0, 1) && key.blend) unsupported("per-pixel alpha blending (PABE)");
+    if (bits(s.scanmsk, 0, 2) >= 2) unsupported("scan mask");
+    if (bits(s.dthe, 0, 1) && sixteen_bit(target.psm)) unsupported("dithering into a 16-bit target");
+    const int step = shadow_step(s, ctx, v[count - 1]);
+    Stencil stencil = step > 0 ? kUp : step < 0 ? kDown : sixteen_bit(target.psm) && (key.colour_mask & 0xFFFFFFu) != 0xFFFFFFu ? kClear : kKeep;
+    // The destination alpha test (DATE; DATM: which alpha top bit passes).
+    if (bits(s.ctx[ctx].test, 14, 1)) {
+        if (stencil == kKeep) stencil = bits(s.ctx[ctx].test, 15, 1) ? kDate1 : kDate0;
+        else unsupported("the destination alpha test with a shadow buffer");
+    }
+    // Reading a shadow buffer: its count is in the stencil of the depth buffer the volumes were drawn with.
+    if (params.source[0]) {
+        for (const Live &l : g_live)
+            if (l.fbp == read_fbp && l.fbw == read_fbw && l.stencil_zbp != ~0u) {
+                if (l.stencil_zbp == target.zbp && l.fbw == target.fbw) stencil = kCounted;
+                else unsupported("a shadow buffer read with another depth buffer: " + std::to_string(read_fbp) + " (stencil of " + std::to_string(l.stencil_zbp) + ") into " + std::to_string(target.fbp) + "/" + std::to_string(target.fbw) + " z " + std::to_string(target.zbp));
+                if (std::getenv("PS2_NATIVE_LOG")) {
+                    const std::string line = "shadow read of " + std::to_string(read_fbp) + " into " + std::to_string(target.fbp) + " mask " + std::to_string(key.colour_mask) + " stencil of " + std::to_string(l.stencil_zbp);
+                    if (g_reported.insert(line).second) std::fprintf(stderr, "[native] %llu %s%c", static_cast<unsigned long long>(frame_count()), line.c_str(), 10);
+                }
+            }
+    }
+    const std::uint32_t first = static_cast<std::uint32_t>(g_verts.size());
+    convert(s, ctx, v, count, g_verts);
+    const std::uint32_t added = static_cast<std::uint32_t>(g_verts.size()) - first;
+    if (!added) return;
+    if (g_recording && origin && (origin[0].kick || origin[count - 1].kick || (count == 3 && origin[1].kick))) {
+        Prim p{first, static_cast<std::uint16_t>(added), static_cast<std::uint8_t>(count), attributes_of(s), s.ctx[ctx].xyoffset, s.ctx[ctx].zbuf, {}, {}};
+        for (int i = 0; i < count; ++i) p.v[i] = v[i], p.origin[i] = origin[i];
+        g_prims.push_back(p);
+    }
+    // This target is live now, as far down as this draw reaches (its bottom edge is exclusive; within the
+    // scissor); a live target whose memory it draws over is not that target any more.
+    if ((key.colour_mask & 0xFFFFFFu) != 0xFFFFFFu) {
+        float bottom = 0.0f;
+        for (std::uint32_t i = first; i < first + added; ++i) bottom = std::max(bottom, g_verts[i].y);
+        const std::uint32_t rows = std::min({static_cast<std::uint32_t>(std::ceil(bottom)), sy1 + 1, kTargetHeight});
+        Live *live = nullptr;
+        for (Live &l : g_live)
+            if (l.fbp == target.fbp && l.fbw == target.fbw) live = &l;
+        if (!live || live->rows < rows || live->psm != target.psm) {
+            const auto [first_block, end_block] = span(target.fbp, target.fbw, target.psm, rows);
+            std::erase_if(g_live, [&](const Live &l) {
+                if (l.fbp == target.fbp && l.fbw == target.fbw) return false;
+                const auto [f, e] = span(l.fbp, l.fbw, l.psm, l.rows);
+                const bool gone = overlaps(f, e, first_block, end_block);
+                if (gone && std::getenv("PS2_NATIVE_LOG"))
+                    std::fprintf(stderr, "[native] %llu target %u/%u x%u drawn over by %u/%u x%u\n", static_cast<unsigned long long>(frame_count()), l.fbp, l.fbw, l.rows, target.fbp, target.fbw, rows);
+                return gone;
+            });
+            live = nullptr;
+            for (Live &l : g_live)
+                if (l.fbp == target.fbp && l.fbw == target.fbw) live = &l;
+            if (!live) live = &g_live.emplace_back(Live{target.fbp, target.fbw, target.psm, 0, 0});
+            live->psm = target.psm;
+            live->rows = std::max(live->rows, rows);
+        }
+        live->order = ++g_live_order;
+        if ((stencil == kUp || stencil == kDown) && std::getenv("PS2_NATIVE_LOG")) {
+            const std::string line = "shadow volumes into " + std::to_string(target.fbp) + " step " + std::to_string(step) + " z " + std::to_string(target.zbp);
+            if (g_reported.insert(line).second) std::fprintf(stderr, "[native] %llu %s%c", static_cast<unsigned long long>(frame_count()), line.c_str(), 10);
+        }
+        if (stencil == kUp || stencil == kDown) live->stencil_zbp = target.zbp;
+        else if (stencil == kClear) live->stencil_zbp = ~0u;
+    }
+    // A shadow buffer read is two batches over the same vertices: texel "counted" where the stencil is not 0,
+    // and texel 0 where it is (native.wgsl's target_texel).
+    Params uncounted = params;
+    if (stencil == kCounted) params.source[0] |= 0x10u, uncounted.source[0] |= 0x20u;
+    const auto same = [&](const Batch &b, const Params &p, Stencil st) {
+        return b.key == key && b.target == target && b.texture == texture && b.read_fbp == read_fbp && b.read_fbw == read_fbw && b.params == p && b.stencil == st &&
+               b.sx0 == sx0 && b.sx1 == sx1 && b.sy0 == sy0 && b.sy1 == sy1 && b.first + b.count == first;
+    };
+    if (stencil == kCounted) {
+        const std::size_t n = g_batches.size();
+        if (n >= 2 && same(g_batches[n - 2], params, kCounted) && same(g_batches[n - 1], uncounted, kUncounted)) {
+            g_batches[n - 2].count += added, g_batches[n - 1].count += added;
+            return;
+        }
+        g_batches.push_back({key, target, sx0, sy0, sx1, sy1, texture, read_fbp, read_fbw, params, first, added, kCounted});
+        g_batches.push_back({key, target, sx0, sy0, sx1, sy1, texture, read_fbp, read_fbw, uncounted, first, added, kUncounted});
+        g_last_target[{target.fbp, target.fbw}] = target;
+        return;
+    }
+    if (!g_batches.empty() && same(g_batches.back(), params, stencil)) {
+        g_batches.back().count += added;
+        return;
+    }
+    g_batches.push_back({key, target, sx0, sy0, sx1, sy1, texture, read_fbp, read_fbw, params, first, added, stencil});
+    g_last_target[{target.fbp, target.fbw}] = target;
+}
+
+void kick_size(std::uint32_t kick, std::uint16_t vertices) {
+    g_kick_sizes[kick & (kKickSizes - 1)].store((static_cast<std::uint64_t>(kick) << 16) | vertices, std::memory_order_relaxed);
+}
+
+void upload_begin(const State &s) {
+    std::lock_guard lock(g_mutex);
+    init();
+    Upload &u = g_upload;
+    u = Upload{};
+    u.active = true;
+    u.dbp = bits(s.bitbltbuf, 32, 14), u.dbw = bits(s.bitbltbuf, 48, 6), u.dpsm = bits(s.bitbltbuf, 56, 6);
+    u.dsax = bits(s.trxpos, 32, 11), u.dsay = bits(s.trxpos, 48, 11);
+    u.rrw = bits(s.trxreg, 0, 12), u.rrh = bits(s.trxreg, 32, 12);
+    if (!u.rrw || !u.rrh) {
+        u.active = false;
+        return;
+    }
+    std::tie(u.first, u.end) = span(u.dbp, u.dbw, u.dpsm, u.dsay + u.rrh);
+    forget(u.first, u.end);
+    // A target the upload writes over is memory again (the game reuses target memory for textures).
+    std::erase_if(g_live, [&](const Live &l) {
+        const auto [first, end] = span(l.fbp, l.fbw, l.psm, l.rows);
+        const bool gone = overlaps(first, end, u.first, u.end);
+        if (gone && std::getenv("PS2_NATIVE_LOG"))
+            std::fprintf(stderr, "[native] %llu target %u/%u x%u uploaded over: %u/%u psm %u at %u,%u %ux%u\n", static_cast<unsigned long long>(frame_count()), l.fbp, l.fbw, l.rows, u.dbp, u.dbw, u.dpsm, u.dsax, u.dsay, u.rrw, u.rrh);
+        return gone;
+    });
+}
+
+void upload(const std::uint8_t *data, std::size_t bytes) {
+    std::lock_guard lock(g_mutex);
+    Upload &u = g_upload;
+    if (!u.active) return;
+    if (u.drawn) {  // a draw between pieces of this transfer looked textures up: they may hold its old data
+        forget(u.first, u.end);
+        u.drawn = false;
+    }
+    const std::uint32_t bpp = bits_per_pixel(u.dpsm);
+    const auto put = [&](std::uint32_t v) {
+        swizzle::write_pixel(g_mem.data(), u.dpsm, u.dbp, u.dbw, (u.dsax + u.x) & 0x7FFu, (u.dsay + u.y) & 0x7FFu, v);
+        if (++u.x == u.rrw) {
+            u.x = 0;
+            if (++u.y == u.rrh) u.active = false;
+        }
+    };
+    if (bpp == 24) {
+        for (std::size_t i = 0; i < bytes && u.active; ++i) {
+            u.carry |= static_cast<std::uint32_t>(data[i]) << (8 * u.carried);
+            if (++u.carried == 3) {
+                put(u.carry);
+                u.carry = 0, u.carried = 0;
+            }
+        }
+        return;
+    }
+    for (std::size_t bit = 0; bit + bpp <= bytes * 8 && u.active; bit += bpp) {
+        std::uint32_t v = 0;
+        if (bpp == 4) v = (data[bit / 8] >> (bit & 4)) & 15u;
+        else std::memcpy(&v, data + bit / 8, bpp / 8);
+        put(v);
+    }
+}
+
+void load_palette(std::uint64_t tex0, std::uint64_t texclut) {
+    std::lock_guard lock(g_mutex);
+    (void)texclut;  // CSM2 (where TEXCLUT matters) is not used by this game
+    if (bits(tex0, 55, 1)) unsupported("palette layout CSM2");
+    decode_palette(g_mem.data(), tex0, 0, g_palette);
+    rehash_palette();
+}
+
+void load_memory(const std::uint8_t *memory) {
+    std::lock_guard lock(g_mutex);
+    init();
+    flush();
+    std::memcpy(g_mem.data(), memory, kMemorySize);
+    forget(0, kMemorySize / 256 * 2);
+    g_live.clear();
+    g_records[g_filling].whole = false;
+    g_upload = Upload{};
+}
+
+void vblank() {
+    std::lock_guard lock(g_mutex);
+    if (!g_ready) return;
+    flush();
+    end_frame();
+    // Frame interpolation follows the setting from the next frame (PS2_NATIVE_REPLAY turns it on).
+    static const bool replay_check = std::getenv("PS2_NATIVE_REPLAY") != nullptr;
+    static const bool engine_check = std::getenv("PS2_ENGINE_REPLAY") != nullptr;
+    const bool wanted = ps2::graphics().frame_rate > 60 || replay_check || engine_check || std::getenv("PS2_NATIVE_MATCH");
+    if (wanted != g_recording) {
+        g_recording = wanted;
+        reset_records();
+    }
+}
+
+bool interpolating() {
+    std::lock_guard lock(g_mutex);
+    return g_recording && g_recorded >= 2;
+}
+
+std::uint64_t frame_shown() {
+    std::lock_guard lock(g_mutex);
+    if (!g_ready) return 0;
+    g_frames_from_present = true;
+    flush();
+    if (!g_recording || g_records[g_filling].batches.empty()) return 0;
+    finish_record();
+    return g_recorded;
+}
+
+bool replay(std::uint64_t frame, float t, std::uint32_t fbp, std::uint32_t fbw) {
+    std::lock_guard lock(g_mutex);
+    if (!g_ready) return false;
+    return replay_at(frame, t, fbp, fbw);
+}
+
+void show_replay(bool on) {
+    std::lock_guard lock(g_mutex);
+    g_show_replay = on;
+}
+
+void display(const gpu::DisplaySource &src, WGPUBuffer scratch, std::uint32_t base) {
+    std::lock_guard lock(g_mutex);
+    init();
+    flush();
+    // PS2_NATIVE_SHOW=alpha[,fbp] (debugging): the target's (or that target's) alpha as grey (0x80 white).
+    static const char *show = std::getenv("PS2_NATIVE_SHOW");
+    // PS2_NATIVE_SHOW=colour,fbp: that target's colour instead of the displayed one.
+    static const bool show_alpha = show && std::strncmp(show, "alpha", 5) == 0;
+    static const bool show_colour = show && std::strncmp(show, "colour,", 7) == 0;
+    const std::uint32_t shown = show_alpha && show[5] == ',' ? static_cast<std::uint32_t>(std::strtoul(show + 6, nullptr, 10))
+                                : show_colour ? static_cast<std::uint32_t>(std::strtoul(show + 7, nullptr, 10)) : src.fbp;
+    // A frame is what is drawn between two displays (the game's display comes before the GS's vblank).
+    if (g_recording && !g_show_replay && !g_frames_from_present && !g_records[g_filling].batches.empty()) finish_record();
+    // PS2_NATIVE_REPLAY=<t> (checking frame interpolation): every display shows the last frame replayed at t
+    // (1: should be the frame itself).
+    static const char *const replay_check = std::getenv("PS2_NATIVE_REPLAY");
+    // PS2_ENGINE_REPLAY=1 (checking engine-level interpolation): every display shows the last frame drawn again
+    // from VU1's work run again (should be the frame itself).
+    static const bool engine_check = std::getenv("PS2_ENGINE_REPLAY") != nullptr;
+    const bool replayed = g_show_replay || (replay_check && g_recorded >= 2 && replay_at(g_recorded, std::strtof(replay_check, nullptr), src.fbp, src.fbw)) ||
+                          (engine_check && g_recorded >= 2 && replay_engine(g_recorded, src.fbp, src.fbw));
+    const auto &shown_targets = replayed ? g_replay_colour : g_colour;
+    const auto found = shown_targets.find({shown, src.fbw});
+    if (std::getenv("PS2_NATIVE_LOG")) {
+        const std::string line = "display " + std::to_string(src.fbp) + "/" + std::to_string(src.fbw) + " psm " + std::to_string(src.psm) + " " + std::to_string(src.dbx) + "," +
+                                 std::to_string(src.dby) + " " + std::to_string(src.width) + "x" + std::to_string(src.height) + (found == shown_targets.end() ? " (no target)" : "");
+        if (g_reported.insert(line).second) std::fprintf(stderr, "[native] %llu %s%c", static_cast<unsigned long long>(frame_count()), line.c_str(), 10);
+    }
+    if (found == shown_targets.end()) return;
+    std::uint32_t out_w = 0, out_h = 0;
+    output_size(src.width, src.height, out_w, out_h);
+    const std::uint32_t params[8] = {src.dbx, src.dby, out_w, out_h, src.halved ? 1u : 0u, base, 0, show_alpha ? 1u : 0u};
+    wgpuQueueWriteBuffer(g_queue, g_display_params, 0, params, sizeof params);
+    WGPUBindGroupEntry be[3] = {WGPU_BIND_GROUP_ENTRY_INIT, WGPU_BIND_GROUP_ENTRY_INIT, WGPU_BIND_GROUP_ENTRY_INIT};
+    be[0].binding = 0;
+    be[0].textureView = found->second.view;
+    be[1].binding = 1;
+    be[1].buffer = scratch;
+    be[1].size = WGPU_WHOLE_SIZE;
+    be[2].binding = 2;
+    be[2].buffer = g_display_params;
+    be[2].size = 32;
+    WGPUBindGroupDescriptor bd = WGPU_BIND_GROUP_DESCRIPTOR_INIT;
+    bd.layout = g_display_layout;
+    bd.entryCount = 3;
+    bd.entries = be;
+    WGPUBindGroup group = wgpuDeviceCreateBindGroup(g_device, &bd);
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    WGPUComputePassEncoder pass = wgpuCommandEncoderBeginComputePass(enc, nullptr);
+    wgpuComputePassEncoderSetPipeline(pass, g_display);
+    wgpuComputePassEncoderSetBindGroup(pass, 0, group, 0, nullptr);
+    wgpuComputePassEncoderDispatchWorkgroups(pass, (out_w + 7) / 8, (out_h + 7) / 8, 1);
+    wgpuComputePassEncoderEnd(pass);
+    wgpuComputePassEncoderRelease(pass);
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+    wgpuBindGroupRelease(group);
+    check_depth(src);
+}
+
+}
diff --git a/runtime/src/gs/native/renderer.hpp b/runtime/src/gs/native/renderer.hpp
new file mode 100644
index 0000000..101c4a2
--- /dev/null
+++ b/runtime/src/gs/native/renderer.hpp
@@ -0,0 +1,49 @@
+#pragma once
+
+#include "../gpu/gpu.hpp"
+#include "../gs.hpp"
+
+#include <webgpu/webgpu.h>
+
+// The native renderer: what the game sends the GS, drawn with ordinary GPU draws into real render targets
+// (docs/superpowers/specs/2026-11-08-native-rendering-design.md). It shares the GPU emulator's device; gs.cpp
+// hands it each primitive, and gpu.cpp's display step takes the picture from it instead of from the emulated
+// GS memory, so presentation, effects and frame dumps stay as they are.
+namespace ps2::gs::native {
+
+// On with PS2_RENDERER=native (while it is being built; a setting later).
+bool enabled();
+// One primitive, as gs.cpp draws it (1, 2 or 3 vertices).
+void draw(const State &s, const Vertex *v, int count, const Origin *origin = nullptr);
+// How many vertices VU1's kick took (gs::begin_kick), for frame interpolation's pairing.
+void kick_size(std::uint32_t kick, std::uint16_t vertices);
+// An image transfer into GS memory starts (TRXDIR 0, as BITBLTBUF, TRXPOS and TRXREG say), and its data,
+// in as many pieces as the GS gets it; and a palette load (after the GS's own check that it loads).
+void upload_begin(const State &s);
+void upload(const std::uint8_t *data, std::size_t bytes);
+void load_palette(std::uint64_t tex0, std::uint64_t texclut);
+// A save state was loaded: GS memory as it holds it (the native targets start over from memory).
+void load_memory(const std::uint8_t *memory);
+// Each frame, at vblank: pending draws go to the GPU, unused textures leave the cache.
+void vblank();
+// The displayed part of a target into the presentation buffer at word offset base, as gpu.cpp's display
+// step writes it (packed RGBA8 at the internal resolution).
+void display(const gpu::DisplaySource &src, WGPUBuffer scratch, std::uint32_t base);
+// Frame interpolation (the setting; interpolate.hpp): each frame's draws are recorded, and an in-between
+// picture replays the last whole frame with its vertices t of the way from where they were in the frame
+// before (0) to where they are (1). interpolating(): two whole frames recorded. replay(): draws picture t
+// of a frame frame_shown() named (one of the last two), false when it can't (a save state loaded, the
+// displayed target fbp/fbw not drawn, too old); show_replay(true): display() shows it.
+bool interpolating();
+// The game showed a frame (gs.cpp's present): the frame being recorded ends here. Its id for replay(), or 0
+// when nothing was recorded.
+std::uint64_t frame_shown();
+bool replay(std::uint64_t frame, float t, std::uint32_t fbp, std::uint32_t fbw);
+void show_replay(bool on);
+// PS2 pixels to target pixels, across and down: the settings' multiple or direct resolution
+// (ps2::native_scale); PS2_SCALE=<n>, or PS2_RESOLUTION=<lines> before it, override it (development).
+void output_scale(float &across, float &down);
+// The size a width x height PS2 picture is shown at.
+void output_size(std::uint32_t width, std::uint32_t height, std::uint32_t &out_w, std::uint32_t &out_h);
+
+}
diff --git a/runtime/src/gs/native/texture.cpp b/runtime/src/gs/native/texture.cpp
new file mode 100644
index 0000000..fa647ca
--- /dev/null
+++ b/runtime/src/gs/native/texture.cpp
@@ -0,0 +1,77 @@
+#include "texture.hpp"
+
+#include "../gs.hpp"
+#include "../swizzle.hpp"
+
+#include <algorithm>
+
+namespace ps2::gs::native {
+
+namespace {
+
+std::uint32_t bits(std::uint64_t v, int lo, int n) { return static_cast<std::uint32_t>((v >> lo) & ((1ull << n) - 1)); }
+
+// A 16-bit colour (RGBA5551) as RGBA8: its A bit picks TA1 or TA0; with AEM, black is transparent.
+std::uint32_t expand16(std::uint32_t c, std::uint64_t texa) {
+    const std::uint32_t r = (c & 0x1Fu) << 3, g = ((c >> 5) & 0x1Fu) << 3, b = ((c >> 10) & 0x1Fu) << 3;
+    std::uint32_t a = (c & 0x8000u) ? bits(texa, 32, 8) : bits(texa, 0, 8);
+    if (!(c & 0x8000u) && bits(texa, 15, 1) && (c & 0x7FFFu) == 0) a = 0;
+    return r | (g << 8) | (b << 16) | (a << 24);
+}
+
+std::uint32_t expand24(std::uint32_t c, std::uint64_t texa) {
+    const std::uint32_t rgb = c & 0xFFFFFFu;
+    const std::uint32_t a = (bits(texa, 15, 1) && rgb == 0) ? 0 : bits(texa, 0, 8);
+    return rgb | (a << 24);
+}
+
+bool eight_bit(std::uint32_t psm) { return psm == PSMT8 || psm == PSMT8H; }
+bool four_bit(std::uint32_t psm) { return psm == PSMT4 || psm == PSMT4HL || psm == PSMT4HH; }
+
+}  // namespace
+
+void decode_palette(const std::uint8_t *mem, std::uint64_t tex0, std::uint64_t texa, std::uint32_t out[256]) {
+    const std::uint32_t psm = bits(tex0, 20, 6), cbp = bits(tex0, 37, 14), cpsm = bits(tex0, 51, 4), csa = bits(tex0, 56, 5);
+    const auto entry = [&](std::uint32_t x, std::uint32_t y) {
+        const std::uint32_t c = swizzle::read_pixel(mem, cpsm == 0 ? PSMCT32 : cpsm, cbp, 1, x, y);
+        return cpsm == 0 ? c : expand16(c, texa);
+    };
+    if (eight_bit(psm)) {
+        // CSM1: a 16 x 16 image whose entries 8..15 and 16..23 of every 32 swap places.
+        for (std::uint32_t i = 0; i < 256; ++i) out[i] = entry((i & 7u) | ((i & 16u) >> 1), (i / 32u) * 2u + ((i & 8u) >> 3));
+    } else if (four_bit(psm)) {
+        const std::uint32_t at = (csa & 15u) * 16u;  // the palette buffer holds 16 four-bit palettes of 32-bit colours
+        for (std::uint32_t i = 0; i < 16; ++i) out[at + i] = entry(i & 7u, i >> 3);
+    }
+}
+
+void read_raw(const std::uint8_t *mem, std::uint64_t tex0, std::vector<std::uint32_t> &raw) {
+    const std::uint32_t tbp = bits(tex0, 0, 14), tbw = bits(tex0, 14, 6), psm = bits(tex0, 20, 6);
+    const std::uint32_t tw = 1u << std::min(bits(tex0, 26, 4), 10u), th = 1u << std::min(bits(tex0, 30, 4), 10u);
+    raw.resize(static_cast<std::size_t>(tw) * th);
+    for (std::uint32_t y = 0; y < th; ++y) swizzle::read_row(mem, psm, tbp, tbw, 0, y, tw, raw.data() + static_cast<std::size_t>(y) * tw);
+}
+
+void to_rgba(std::uint64_t tex0, std::uint64_t texa, const std::uint32_t *palette, const std::vector<std::uint32_t> &raw, std::vector<std::uint32_t> &rgba) {
+    const std::uint32_t psm = bits(tex0, 20, 6), at4 = (bits(tex0, 56, 5) & 15u) * 16u;
+    rgba.resize(raw.size());
+    const std::size_t n = raw.size();
+    switch (psm) {
+    case PSMCT32: rgba = raw; break;
+    case PSMCT24: for (std::size_t i = 0; i < n; ++i) rgba[i] = expand24(raw[i], texa); break;
+    case PSMCT16: case PSMCT16S: for (std::size_t i = 0; i < n; ++i) rgba[i] = expand16(raw[i], texa); break;
+    default:
+        if (!palette) std::fill(rgba.begin(), rgba.end(), 0u);
+        else if (eight_bit(psm)) for (std::size_t i = 0; i < n; ++i) rgba[i] = palette[raw[i] & 0xFFu];
+        else for (std::size_t i = 0; i < n; ++i) rgba[i] = palette[at4 + (raw[i] & 15u)];
+        break;
+    }
+}
+
+void decode(const std::uint8_t *mem, std::uint64_t tex0, std::uint64_t texa, const std::uint32_t *palette, std::vector<std::uint32_t> &rgba) {
+    std::vector<std::uint32_t> raw;
+    read_raw(mem, tex0, raw);
+    to_rgba(tex0, texa, palette, raw, rgba);
+}
+
+}
