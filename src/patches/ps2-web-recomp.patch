diff --git a/runtime/src/iop/mcfs.cpp b/runtime/src/iop/mcfs.cpp
new file mode 100644
index 0000000..c8743de
--- /dev/null
+++ b/runtime/src/iop/mcfs.cpp
@@ -0,0 +1,530 @@
+#include "mcfs.hpp"
+
+#include <algorithm>
+#include <cstring>
+
+namespace ps2::iop::mcfs {
+
+namespace {
+
+constexpr std::uint32_t kEnd = 0xFFFFFFFFu, kFree = 0x7FFFFFFFu, kUsed = 0x80000000u;
+constexpr std::uint32_t kEntriesPerFatCluster = kClusterBytes / 4;
+
+// Entry modes.
+constexpr std::uint16_t kExists = 0x8000, kHidden = 0x2000, kPs2 = 0x0400, kClosed = 0x0080, kSubdir = 0x0020, kFileMode = 0x0010;
+constexpr std::uint16_t kRwx = 0x0007;
+constexpr std::uint16_t kDirMode = kExists | kPs2 | kSubdir | kRwx;            // 0x8427
+constexpr std::uint16_t kNewFileMode = kExists | kPs2 | kFileMode | kRwx;      // 0x8417; closed adds 0x80
+
+// Directory entry layout.
+constexpr std::size_t kMode = 0, kLength = 4, kCreated = 8, kCluster = 16, kDirEntry = 20, kModified = 24, kAttr = 32, kName = 64;
+constexpr std::size_t kNameBytes = 32;
+
+constexpr char kMagic[] = "Sony PS2 Memory Card Format ";
+
+std::uint32_t u32(const std::uint8_t *p) { std::uint32_t v; std::memcpy(&v, p, 4); return v; }
+std::uint16_t u16(const std::uint8_t *p) { std::uint16_t v; std::memcpy(&v, p, 2); return v; }
+void put32(std::uint8_t *p, std::uint32_t v) { std::memcpy(p, &v, 4); }
+void put16(std::uint8_t *p, std::uint16_t v) { std::memcpy(p, &v, 2); }
+
+std::string name_of(const std::uint8_t *e) {
+    const char *n = reinterpret_cast<const char *>(e + kName);
+    return std::string(n, strnlen(n, kNameBytes));
+}
+
+void make_entry(std::uint8_t *e, std::uint16_t mode, std::uint32_t length, std::uint32_t cluster, std::uint32_t dir_entry,
+                const Time &now, const std::string &name) {
+    std::memset(e, 0, kEntryBytes);
+    put16(e + kMode, mode);
+    put32(e + kLength, length);
+    std::memcpy(e + kCreated, now.data(), 8);
+    put32(e + kCluster, cluster);
+    put32(e + kDirEntry, dir_entry);
+    std::memcpy(e + kModified, now.data(), 8);
+    std::memcpy(e + kName, name.data(), std::min(name.size(), kNameBytes));
+}
+
+// '*' matches any run of characters, '?' any one.
+bool matches(const char *pattern, const char *name) {
+    if (*pattern == 0) return *name == 0;
+    if (*pattern == '*') return matches(pattern + 1, name) || (*name && matches(pattern, name + 1));
+    if (*name == 0) return false;
+    return (*pattern == '?' || *pattern == *name) && matches(pattern + 1, name + 1);
+}
+
+std::uint8_t parity(std::uint8_t b) {
+    b ^= b >> 4;
+    b ^= b >> 2;
+    b ^= b >> 1;
+    return b & 1;
+}
+
+}  // namespace
+
+void page_ecc(const std::uint8_t *data, std::uint8_t *ecc) {
+    static const std::uint8_t kColumnMasks[7] = {0x55, 0x33, 0x0F, 0x00, 0xAA, 0xCC, 0xF0};
+    for (int chunk = 0; chunk < 4; ++chunk) {
+        const std::uint8_t *s = data + chunk * 128;
+        std::uint8_t column = 0x77, line0 = 0x7F, line1 = 0x7F;
+        for (int i = 0; i < 128; ++i) {
+            std::uint8_t mask = 0;
+            for (int m = 0; m < 7; ++m) mask |= static_cast<std::uint8_t>(parity(s[i] & kColumnMasks[m]) << m);
+            column ^= mask;
+            if (parity(s[i])) {
+                line0 ^= static_cast<std::uint8_t>(~i);
+                line1 ^= static_cast<std::uint8_t>(i);
+            }
+        }
+        ecc[chunk * 3 + 0] = column;
+        ecc[chunk * 3 + 1] = line0 & 0x7F;
+        ecc[chunk * 3 + 2] = line1 & 0x7F;
+    }
+}
+
+bool Card::formatted() const {
+    return image_.size() >= kImageBytes && std::memcmp(page(0), kMagic, sizeof kMagic - 1) == 0;
+}
+
+Card::Geometry Card::geometry() {
+    Geometry g;
+    const std::uint8_t *sb = cluster(0).data();  // through the cache: a format in progress has it there
+    g.alloc_offset = u32(sb + 0x34);
+    g.alloc_end = u32(sb + 0x38);
+    g.root = u32(sb + 0x3C);
+    g.backup1 = u32(sb + 0x40);
+    g.backup2 = u32(sb + 0x44);
+    for (int i = 0; i < 32; ++i) g.ifc[i] = u32(sb + 0x50 + 4 * i);
+    g.search_from = u32(sb + 0x16C);
+    g.max_alloc = u32(sb + 0x170);
+    return g;
+}
+
+Card::Cluster &Card::cluster(std::uint32_t absolute) {
+    auto it = cache_.find(absolute);
+    if (it != cache_.end()) return it->second;
+    Cluster &c = cache_[absolute];
+    for (std::uint32_t p = 0; p < kPagesPerCluster; ++p) {
+        const std::uint32_t n = absolute * kPagesPerCluster + p;
+        if (n < kPages) std::memcpy(c.data() + p * kPageData, page(n), kPageData);
+        else std::memset(c.data() + p * kPageData, 0xFF, kPageData);
+    }
+    return c;
+}
+
+Card::Cluster &Card::change(std::uint32_t absolute) {
+    const std::uint32_t block = absolute * kPagesPerCluster / kPagesPerBlock;
+    if (std::find(dirty_blocks_.begin(), dirty_blocks_.end(), block) == dirty_blocks_.end()) dirty_blocks_.push_back(block);
+    return cluster(absolute);
+}
+
+std::uint32_t Card::fat(std::uint32_t n) {
+    const std::uint32_t indirect = g_.ifc[(n / kEntriesPerFatCluster / kEntriesPerFatCluster) % 32];
+    const std::uint32_t table = u32(cluster(indirect).data() + 4 * (n / kEntriesPerFatCluster % kEntriesPerFatCluster));
+    return u32(cluster(table).data() + 4 * (n % kEntriesPerFatCluster));
+}
+
+void Card::set_fat(std::uint32_t n, std::uint32_t v) {
+    const std::uint32_t indirect = g_.ifc[(n / kEntriesPerFatCluster / kEntriesPerFatCluster) % 32];
+    const std::uint32_t table = u32(cluster(indirect).data() + 4 * (n / kEntriesPerFatCluster % kEntriesPerFatCluster));
+    put32(change(table).data() + 4 * (n % kEntriesPerFatCluster), v);
+}
+
+// The lowest free cluster, marked as the end of a chain (MCMAN's search, from the superblock's start).
+std::uint32_t Card::allocate() {
+    for (std::uint32_t n = g_.search_from; n < g_.max_alloc; ++n) {
+        if (fat(n) & kUsed) continue;
+        set_fat(n, kEnd);
+        return n;
+    }
+    return kEnd;
+}
+
+int Card::free_clusters() {
+    if (!formatted()) return 0;
+    g_ = geometry();
+    int count = 0;
+    for (std::uint32_t n = g_.search_from; n < g_.max_alloc; ++n)
+        if (!(fat(n) & kUsed)) ++count;
+    return count;
+}
+
+// The cluster `steps` links after `first` in its chain; with `extend`, clusters are added at the end as needed.
+std::uint32_t Card::chain_at(std::uint32_t first, std::uint32_t steps, bool extend) {
+    std::uint32_t c = first;
+    for (std::uint32_t i = 0; i < steps; ++i) {
+        const std::uint32_t next = fat(c);
+        if (next == kEnd || !(next & kUsed)) {
+            if (!extend) return kEnd;
+            const std::uint32_t added = allocate();
+            if (added == kEnd) return kEnd;
+            set_fat(c, kUsed | added);
+            c = added;
+        } else {
+            c = next & ~kUsed;
+        }
+    }
+    return c;
+}
+
+std::uint8_t *Card::entry(std::uint32_t dir_cluster, std::uint32_t index, bool for_change) {
+    const std::uint32_t c = chain_at(dir_cluster, index / 2, for_change);
+    if (c == kEnd) return nullptr;
+    const std::uint32_t absolute = c + g_.alloc_offset;
+    Cluster &data = for_change ? change(absolute) : cluster(absolute);
+    return data.data() + (index % 2) * kEntryBytes;
+}
+
+std::uint32_t Card::dir_length(const Dir &d) {
+    const std::uint8_t *e = entry(d.holder_cluster, d.holder_index, false);
+    return e ? u32(e + kLength) : 0;
+}
+
+void Card::set_dir_length(const Dir &d, std::uint32_t n) {
+    if (std::uint8_t *e = entry(d.holder_cluster, d.holder_index, true)) put32(e + kLength, n);
+}
+
+// A directory whose entry is entry `index` of the directory starting at `cluster`.
+Card::Dir Card::dir_of(std::uint32_t cluster, std::uint32_t index) {
+    const std::uint8_t *e = entry(cluster, index, false);
+    return Dir{e ? u32(e + kCluster) : kEnd, cluster, index};
+}
+
+int Card::find(const Dir &d, const std::string &name) {
+    const std::uint32_t n = dir_length(d);
+    for (std::uint32_t i = 0; i < n; ++i) {
+        const std::uint8_t *e = entry(d.cluster, i, false);
+        if (e && (u16(e + kMode) & kExists) && name_of(e) == name) return static_cast<int>(i);
+    }
+    return -1;
+}
+
+// Splits a path into the directory it is in and its last part; every directory on the way must exist.
+int Card::resolve_dir(const std::string &path, Dir &dir, std::string &last) {
+    dir = Dir{g_.root, g_.root, 0};
+    std::vector<std::string> parts;
+    std::size_t at = 0;
+    while (at <= path.size()) {
+        const std::size_t slash = path.find('/', at);
+        const std::string part = path.substr(at, slash == std::string::npos ? std::string::npos : slash - at);
+        if (!part.empty()) parts.push_back(part);
+        if (slash == std::string::npos) break;
+        at = slash + 1;
+    }
+    last = parts.empty() ? std::string() : parts.back();
+    for (std::size_t i = 0; i + 1 < parts.size(); ++i) {
+        const int index = find(dir, parts[i]);
+        if (index < 0) return kNoEntry;
+        const std::uint8_t *e = entry(dir.cluster, static_cast<std::uint32_t>(index), false);
+        if (!(u16(e + kMode) & kSubdir)) return kNoEntry;
+        dir = dir_of(dir.cluster, static_cast<std::uint32_t>(index));
+    }
+    return kOk;
+}
+
+// A place for a new entry: the first deleted one, else one past the end (adding a cluster if needed).
+int Card::add_entry(const Dir &d, std::uint32_t &index) {
+    const std::uint32_t n = dir_length(d);
+    for (std::uint32_t i = 0; i < n; ++i) {
+        const std::uint8_t *e = entry(d.cluster, i, false);
+        if (e && !(u16(e + kMode) & kExists)) {
+            index = i;
+            return kOk;
+        }
+    }
+    if (!entry(d.cluster, n, true)) return kFull;
+    set_dir_length(d, n + 1);
+    index = n;
+    return kOk;
+}
+
+int Card::format(const Time &now) {
+    std::fill(image_.begin(), image_.end(), 0xFF);
+    cache_.clear();
+    dirty_blocks_.clear();
+    files = {};
+    // An 8 MB card with no bad blocks, as MCMAN formats it.
+    constexpr std::uint32_t kClustersPerCard = 8192, kIfc = 8, kFirstFat = 9, kFatClusters = 32, kAllocOffset = 41;
+    constexpr std::uint32_t kAllocEnd = 8135, kMaxAlloc = 8001;
+    std::uint8_t *sb = change(0).data();
+    std::memset(sb, 0, kPageData);
+    std::memcpy(sb, "Sony PS2 Memory Card Format 1.2.0.0", 35);
+    put16(sb + 0x28, kPageData);
+    put16(sb + 0x2A, kPagesPerCluster);
+    put16(sb + 0x2C, kPagesPerBlock);
+    put16(sb + 0x2E, 0xFF00);
+    put32(sb + 0x30, kClustersPerCard);
+    put32(sb + 0x34, kAllocOffset);
+    put32(sb + 0x38, kAllocEnd);
+    put32(sb + 0x3C, 0);
+    put32(sb + 0x40, 1023);
+    put32(sb + 0x44, 1022);
+    put32(sb + 0x50, kIfc);
+    std::memset(sb + 0xD0, 0xFF, 0x80);  // no bad blocks
+    sb[0x150] = 2;                        // a PS2 card
+    sb[0x151] = 0x2B;
+    put32(sb + 0x154, kClusterBytes);
+    put32(sb + 0x158, kEntriesPerFatCluster);
+    put32(sb + 0x15C, kPagesPerBlock / kPagesPerCluster);
+    put32(sb + 0x160, kEnd);
+    put32(sb + 0x170, kMaxAlloc);
+    put32(sb + 0x17C, kEnd);
+    std::memset(sb + 0x184, 0xFF, kPageData - 0x184);
+    std::uint8_t *ifc = change(kIfc).data();
+    for (std::uint32_t i = 0; i < kFatClusters; ++i) put32(ifc + 4 * i, kFirstFat + i);
+    for (std::uint32_t c = 0; c < kFatClusters; ++c) {
+        std::uint8_t *t = change(kFirstFat + c).data();
+        for (std::uint32_t i = 0; i < kEntriesPerFatCluster; ++i) put32(t + 4 * i, c * kEntriesPerFatCluster + i < kAllocEnd ? kFree : kEnd);
+    }
+    g_ = geometry();
+    set_fat(0, kEnd);
+    std::uint8_t *root = change(kAllocOffset).data();
+    make_entry(root, kDirMode, 2, 0, 0, now, ".");
+    make_entry(root + kEntryBytes, kExists | kHidden | kPs2 | kSubdir | 0x6, 0, 0, 0, now, "..");
+    return kOk;
+}
+
+int Card::open(const std::string &path, int flags, const Time &now) {
+    if (!formatted()) return kNoFormat;
+    g_ = geometry();
+    Dir dir;
+    std::string name;
+    if (const int r = resolve_dir(path, dir, name); r < 0) return r;
+    if (name.empty()) return kNoEntry;
+    int index = find(dir, name);
+    if (flags & kCreateDir) {
+        if (index >= 0) return kDenied;
+        std::uint32_t at;
+        if (const int r = add_entry(dir, at); r < 0) return r;
+        const std::uint32_t c = allocate();
+        if (c == kEnd) return kFull;
+        make_entry(entry(dir.cluster, at, true), kDirMode, 2, c, 0, now, name);
+        const std::uint8_t *self = entry(dir.cluster, 0, false);
+        const std::uint32_t up_cluster = u32(self + kCluster), up_entry = u32(self + kDirEntry);
+        std::uint8_t *inside = change(c + g_.alloc_offset).data();
+        make_entry(inside, kDirMode, 0, dir.cluster, at, now, ".");
+        make_entry(inside + kEntryBytes, kDirMode, 0, up_cluster, up_entry, now, "..");
+        // ".." takes the dates of the entry it stands for, as they were before this change.
+        if (const std::uint8_t *up = entry(up_cluster, up_entry, false)) {
+            std::memcpy(inside + kEntryBytes + kCreated, up + kCreated, 8);
+            std::memcpy(inside + kEntryBytes + kModified, up + kModified, 8);
+        }
+        if (std::uint8_t *h = entry(dir.holder_cluster, dir.holder_index, true)) std::memcpy(h + kModified, now.data(), 8);
+        return kOk;
+    }
+    int fd = -1;
+    for (int i = 0; i < kMaxFiles; ++i)
+        if (!files[i].used) { fd = i; break; }
+    if (fd < 0) return kTooManyOpen;
+    if (index < 0) {
+        if (!(flags & kCreate)) return kNoEntry;
+        std::uint32_t at;
+        if (const int r = add_entry(dir, at); r < 0) return r;
+        make_entry(entry(dir.cluster, at, true), kNewFileMode, 0, kEnd, 0, now, name);
+        if (std::uint8_t *h = entry(dir.holder_cluster, dir.holder_index, true)) std::memcpy(h + kModified, now.data(), 8);
+        index = static_cast<int>(at);
+    } else if (flags & kCreate) {
+        std::uint8_t *e = entry(dir.cluster, static_cast<std::uint32_t>(index), true);
+        if (u16(e + kMode) & kSubdir) return kDenied;
+        std::memcpy(e + kCreated, now.data(), 8);
+    }
+    const std::uint8_t *e = entry(dir.cluster, static_cast<std::uint32_t>(index), false);
+    if (u16(e + kMode) & kSubdir) return kDenied;
+    File &f = files[fd];
+    f = File{};
+    f.used = 1;
+    f.writing = (flags & kWrite) ? 1 : 0;
+    f.dir_cluster = dir.cluster;
+    f.index = static_cast<std::uint32_t>(index);
+    f.cluster = u32(e + kCluster);
+    f.length = u32(e + kLength);
+    return fd;
+}
+
+int Card::close(int fd, const Time &now) {
+    if (fd < 0 || fd >= kMaxFiles || !files[fd].used) return kNoEntry;
+    g_ = geometry();
+    File &f = files[fd];
+    if (f.written) {
+        std::uint8_t *e = entry(f.dir_cluster, f.index, true);
+        put32(e + kLength, f.length);
+        put16(e + kMode, u16(e + kMode) | kClosed);
+        std::memcpy(e + kModified, now.data(), 8);
+        // The directory's own entry is dated too.
+        const std::uint8_t *self = entry(f.dir_cluster, 0, false);
+        if (std::uint8_t *h = entry(u32(self + kCluster), u32(self + kDirEntry), true)) std::memcpy(h + kModified, now.data(), 8);
+    }
+    f = File{};
+    return kOk;
+}
+
+int Card::read(int fd, std::uint8_t *out, std::uint32_t size) {
+    if (fd < 0 || fd >= kMaxFiles || !files[fd].used) return kNoEntry;
+    g_ = geometry();
+    File &f = files[fd];
+    std::uint32_t done = 0;
+    while (done < size && f.position < f.length) {
+        const std::uint32_t c = chain_at(f.cluster, f.position / kClusterBytes, false);
+        if (c == kEnd) break;
+        const std::uint32_t offset = f.position % kClusterBytes;
+        const std::uint32_t n = std::min({size - done, kClusterBytes - offset, f.length - f.position});
+        std::memcpy(out + done, cluster(c + g_.alloc_offset).data() + offset, n);
+        done += n;
+        f.position += n;
+    }
+    return static_cast<int>(done);
+}
+
+int Card::write(int fd, const std::uint8_t *in, std::uint32_t size) {
+    if (fd < 0 || fd >= kMaxFiles || !files[fd].used) return kNoEntry;
+    g_ = geometry();
+    File &f = files[fd];
+    if (!f.writing) return kDenied;
+    std::uint32_t done = 0;
+    while (done < size) {
+        if (f.cluster == kEnd) {
+            const std::uint32_t c = allocate();
+            if (c == kEnd) break;
+            f.cluster = c;
+            put32(entry(f.dir_cluster, f.index, true) + kCluster, c);
+        }
+        const std::uint32_t c = chain_at(f.cluster, f.position / kClusterBytes, true);
+        if (c == kEnd) break;
+        const std::uint32_t offset = f.position % kClusterBytes;
+        const std::uint32_t n = std::min(size - done, kClusterBytes - offset);
+        std::memcpy(change(c + g_.alloc_offset).data() + offset, in + done, n);
+        done += n;
+        f.position += n;
+        f.length = std::max(f.length, f.position);
+        f.written = 1;
+    }
+    return done || !size ? static_cast<int>(done) : kFull;
+}
+
+int Card::seek(int fd, std::int32_t offset, int origin) {
+    if (fd < 0 || fd >= kMaxFiles || !files[fd].used) return kNoEntry;
+    File &f = files[fd];
+    const std::int64_t base = origin == 1 ? f.position : origin == 2 ? f.length : 0;
+    const std::int64_t at = std::max<std::int64_t>(0, base + offset);
+    f.position = static_cast<std::uint32_t>(at);
+    return static_cast<int>(f.position);
+}
+
+int Card::flush(int fd) {
+    if (fd < 0 || fd >= kMaxFiles || !files[fd].used) return kNoEntry;
+    return kOk;
+}
+
+int Card::remove(const std::string &path) {
+    if (!formatted()) return kNoFormat;
+    g_ = geometry();
+    Dir dir;
+    std::string name;
+    if (const int r = resolve_dir(path, dir, name); r < 0) return r;
+    const int index = find(dir, name);
+    if (index < 0) return kNoEntry;
+    std::uint8_t *e = entry(dir.cluster, static_cast<std::uint32_t>(index), false);
+    if (u16(e + kMode) & kSubdir) {
+        const Dir inside = dir_of(dir.cluster, static_cast<std::uint32_t>(index));
+        const std::uint32_t n = dir_length(inside);
+        for (std::uint32_t i = 2; i < n; ++i) {
+            const std::uint8_t *x = entry(inside.cluster, i, false);
+            if (x && (u16(x + kMode) & kExists)) return kNotEmpty;
+        }
+        e = entry(dir.cluster, static_cast<std::uint32_t>(index), false);
+    }
+    for (const File &f : files)
+        if (f.used && f.dir_cluster == dir.cluster && f.index == static_cast<std::uint32_t>(index)) return kDenied;
+    // Freed clusters keep their links; only the "used" bit goes.
+    for (std::uint32_t c = u32(e + kCluster); c != kEnd && c < g_.max_alloc;) {
+        const std::uint32_t next = fat(c);
+        if (!(next & kUsed)) break;
+        set_fat(c, next & ~kUsed);
+        c = next == kEnd ? kEnd : next & ~kUsed;
+    }
+    e = entry(dir.cluster, static_cast<std::uint32_t>(index), true);
+    put16(e + kMode, u16(e + kMode) & ~kExists);
+    return kOk;
+}
+
+int Card::list(const std::string &path, int max, std::vector<Listing> &out) {
+    out.clear();
+    if (!formatted()) return kNoFormat;
+    g_ = geometry();
+    Dir dir;
+    std::string pattern;
+    if (const int r = resolve_dir(path, dir, pattern); r < 0) return r;
+    const bool wild = pattern.find_first_of("*?") != std::string::npos;
+    const std::uint32_t n = dir_length(dir);
+    for (std::uint32_t i = 0; i < n && static_cast<int>(out.size()) < max; ++i) {
+        const std::uint8_t *e = entry(dir.cluster, i, false);
+        if (!e || !(u16(e + kMode) & kExists)) continue;
+        const std::string name = name_of(e);
+        if (wild ? !matches(pattern.c_str(), name.c_str()) : name != pattern) continue;
+        Listing l{};
+        // "." and ".." show the dates of the entry they stand for (the directory's own entry, and its
+        // parent's); a directory shows a size of 0.
+        const std::uint8_t *dated = e;
+        if (i < 2 && (name == "." || name == ".."))
+            if (const std::uint8_t *target = entry(u32(e + kCluster), u32(e + kDirEntry), false)) dated = target;
+        std::memcpy(l.data() + 0, dated + kCreated, 8);
+        std::memcpy(l.data() + 8, dated + kModified, 8);
+        if (!(u16(e + kMode) & kSubdir)) std::memcpy(l.data() + 16, e + kLength, 4);
+        std::memcpy(l.data() + 20, e + kMode, 2);
+        std::memcpy(l.data() + 22, e + 2, 2);
+        std::memcpy(l.data() + 24, e + kAttr, 4);
+        std::memcpy(l.data() + 32, e + kName, kNameBytes);
+        out.push_back(l);
+        if (!wild) break;
+    }
+    return static_cast<int>(out.size());
+}
+
+int Card::entry_space(const std::string &path) {
+    if (!formatted()) return kNoFormat;
+    g_ = geometry();
+    Dir dir;
+    std::string name;
+    if (const int r = resolve_dir(path, dir, name); r < 0) return r;
+    if (!name.empty()) {
+        const int index = find(dir, name);
+        if (index < 0) return kNoEntry;
+        dir = dir_of(dir.cluster, static_cast<std::uint32_t>(index));
+    }
+    const std::uint32_t n = dir_length(dir);
+    std::uint32_t clusters = 0;
+    while (chain_at(dir.cluster, clusters, false) != kEnd) ++clusters;
+    int space = static_cast<int>(clusters * 2) - static_cast<int>(n);
+    for (std::uint32_t i = 0; i < n; ++i) {
+        const std::uint8_t *e = entry(dir.cluster, i, false);
+        if (e && !(u16(e + kMode) & kExists)) ++space;
+    }
+    return std::max(space, 0);
+}
+
+bool Card::commit() {
+    const bool wrote = !dirty_blocks_.empty();
+    for (const std::uint32_t block : dirty_blocks_) {
+        std::uint8_t *at = image_.data() + static_cast<std::size_t>(block) * kPagesPerBlock * kPageBytes;
+        for (std::uint32_t p = 0; p < kPagesPerBlock; ++p) {
+            const std::uint32_t n = block * kPagesPerBlock + p;
+            std::uint8_t *pg = at + p * kPageBytes;
+            if (auto it = cache_.find(n / kPagesPerCluster); it != cache_.end())
+                std::memcpy(pg, it->second.data() + (n % kPagesPerCluster) * kPageData, kPageData);
+            page_ecc(pg, pg + kPageData);
+            std::memset(pg + kPageData + 12, 0, 4);
+        }
+        // As MCMAN writes a block: its new contents go first to the backup block, the block number to the
+        // second backup block, then the block itself, and the second backup block is erased.
+        const Geometry g = geometry();
+        const std::size_t block_bytes = static_cast<std::size_t>(kPagesPerBlock) * kPageBytes;
+        if (g.backup1 < kPages / kPagesPerBlock && g.backup1 != block)
+            std::memcpy(image_.data() + g.backup1 * block_bytes, at, block_bytes);
+        if (g.backup2 < kPages / kPagesPerBlock && g.backup2 != block)
+            std::memset(image_.data() + g.backup2 * block_bytes, 0xFF, block_bytes);
+    }
+    dirty_blocks_.clear();
+    cache_.clear();
+    return wrote;
+}
+
+}
diff --git a/runtime/src/iop/mcfs.hpp b/runtime/src/iop/mcfs.hpp
new file mode 100644
index 0000000..05fbcc5
--- /dev/null
+++ b/runtime/src/iop/mcfs.hpp
@@ -0,0 +1,102 @@
+#pragma once
+
+#include <array>
+#include <cstdint>
+#include <map>
+#include <string>
+#include <vector>
+
+// The PS2 memory card file system, as the console's memory card driver (MCMAN) keeps it, on an image of
+// the card's flash in PCSX2's .ps2 layout: 16,384 pages of 512 data bytes and 16 spare bytes (error
+// correction for each 128 bytes, then 4 zero bytes). It reads and writes the card the way MCMAN does, so
+// that a card it writes is byte for byte the card MCMAN writes: clusters of two pages, allocation of the
+// lowest free cluster, directory entries of 512 bytes, and each change written as whole erase blocks of
+// 16 pages, the last one also copied to the card's backup block. Its geometry (allocation offset, FAT,
+// backup blocks) comes from the card's superblock, so a card formatted elsewhere is used as it is.
+namespace ps2::iop::mcfs {
+
+constexpr std::uint32_t kPageData = 512, kPageSpare = 16, kPageBytes = kPageData + kPageSpare;
+constexpr std::uint32_t kPages = 0x4000, kPagesPerCluster = 2, kPagesPerBlock = 16;
+constexpr std::uint32_t kClusterBytes = kPageData * kPagesPerCluster, kEntryBytes = 512;
+constexpr std::size_t kImageBytes = static_cast<std::size_t>(kPageBytes) * kPages;
+
+// Results, as MCMAN returns them.
+constexpr int kOk = 0, kNoFormat = -2, kFull = -3, kNoEntry = -4, kDenied = -5, kNotEmpty = -6, kTooManyOpen = -7;
+
+// Open flags.
+constexpr int kRead = 1, kWrite = 2, kCreateDir = 0x40, kCreate = 0x200;
+
+// A date as the card stores it (sceMcStDateTime): 0, seconds, minutes, hours, day, month, year (16 bits).
+using Time = std::array<std::uint8_t, 8>;
+
+// One entry of a directory listing (sceMcTblGetDir), 64 bytes.
+using Listing = std::array<std::uint8_t, 64>;
+
+// The 12 error-correction bytes of a page's 512 data bytes (3 for each 128).
+void page_ecc(const std::uint8_t *data, std::uint8_t *ecc);
+
+class Card {
+public:
+    explicit Card(std::vector<std::uint8_t> &image) : image_(image) {}
+
+    bool formatted() const;
+    int format(const Time &now);
+    int free_clusters();
+
+    int open(const std::string &path, int flags, const Time &now);
+    int close(int fd, const Time &now);
+    int read(int fd, std::uint8_t *out, std::uint32_t size);
+    int write(int fd, const std::uint8_t *in, std::uint32_t size);
+    int seek(int fd, std::int32_t offset, int origin);
+    int flush(int fd);
+    int remove(const std::string &path);
+    int list(const std::string &path, int max, std::vector<Listing> &out);
+    int entry_space(const std::string &path);
+
+    // Writes every changed erase block to the image. Returns whether anything was written.
+    bool commit();
+
+    // Open files: kept across calls (and in save states).
+    struct File {
+        std::uint8_t used = 0, writing = 0, written = 0, pad = 0;
+        std::uint32_t dir_cluster = 0, index = 0;  // the file's entry: its directory's first cluster, and its place there
+        std::uint32_t cluster = 0, position = 0, length = 0;
+    };
+    static constexpr int kMaxFiles = 3;
+    std::array<File, kMaxFiles> files{};
+
+private:
+    struct Geometry {
+        std::uint32_t alloc_offset = 0, alloc_end = 0, root = 0, backup1 = 0, backup2 = 0, max_alloc = 0, search_from = 0;
+        std::uint32_t ifc[32] = {};
+    };
+    struct Dir {
+        std::uint32_t cluster = 0;            // first cluster (relative to the allocation offset)
+        std::uint32_t holder_cluster = 0;     // the entry holding its length: directory cluster and index
+        std::uint32_t holder_index = 0;
+    };
+    using Cluster = std::array<std::uint8_t, kClusterBytes>;
+
+    Geometry geometry();
+    const std::uint8_t *page(std::uint32_t n) const { return image_.data() + static_cast<std::size_t>(n) * kPageBytes; }
+    Cluster &cluster(std::uint32_t absolute);
+    Cluster &change(std::uint32_t absolute);
+    std::uint32_t fat(std::uint32_t n);
+    void set_fat(std::uint32_t n, std::uint32_t v);
+    std::uint32_t allocate();
+    std::uint32_t chain_at(std::uint32_t first, std::uint32_t steps, bool extend);
+    std::uint8_t *entry(std::uint32_t dir_cluster, std::uint32_t index, bool for_change);
+    std::uint32_t dir_length(const Dir &d);
+    void set_dir_length(const Dir &d, std::uint32_t n);
+    Dir dir_of(std::uint32_t cluster, std::uint32_t index);
+    int resolve_dir(const std::string &path, Dir &dir, std::string &last);
+    int find(const Dir &d, const std::string &name);
+    int add_entry(const Dir &d, std::uint32_t &index);
+
+    std::vector<std::uint8_t> &image_;
+    Geometry g_{};
+    std::map<std::uint32_t, Cluster> cache_;  // clusters read or changed since the last commit (absolute numbers)
+    std::vector<std::uint32_t> dirty_blocks_; // in the order they were first changed
+};
+
+}
diff --git a/runtime/src/iop/mcserv.cpp b/runtime/src/iop/mcserv.cpp
new file mode 100644
index 0000000..04f6636
--- /dev/null
+++ b/runtime/src/iop/mcserv.cpp
@@ -0,0 +1,236 @@
+#include "mcserv.hpp"
+
+#include "iop.hpp"
+#include "kernel.hpp"
+#include "mcfs.hpp"
+#include "sif.hpp"
+#include "sio2.hpp"
+
+#include "ps2/memory.hpp"
+#include "ps2/state.hpp"
+#include "ps2/system.hpp"
+
+#include <algorithm>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <string>
+#include <vector>
+
+// A native MCSERV and MCMAN. Each RPC is what MCSERV's handler for it does (base 0x46700 in this game):
+// it unpacks the request into one MCMAN call, moves data between the card and the EE in the same places,
+// and replies with MCMAN's result. MCMAN's part is the file system in mcfs.cpp. Only slot 1 (port 0, slot
+// 0) holds a card; the other port answers as an empty slot.
+namespace ps2::iop::mcserv {
+
+namespace {
+
+constexpr std::uint32_t kMcmanBase = 0x21000, kMcservBase = 0x46700, kMcservEnd = 0x49F00;  // their memory, kept for them
+constexpr std::uint32_t kServer = 0x80000400;
+constexpr std::uint32_t kServerVersion = 0x20F, kDriverVersion = 0x220;  // MCSERV's and MCMAN's, as init reports them
+constexpr int kNoCard = -11, kNotHandled = -1;
+
+bool g_installed = false;
+bool g_seen = false;              // a card has been reported (MCMAN reports a card once as new: formatted or not)
+std::uint32_t g_known_insertion = 0;
+
+mcfs::Card &card() {
+    static mcfs::Card c(sio2::card_image());
+    return c;
+}
+
+std::uint8_t *ee(std::uint32_t a) { return ps2::g_ram + (a & (ps2::kRamSize - 1)); }
+void ee_write(std::uint32_t dst, const void *src, std::uint32_t size) { std::memcpy(ee(dst), src, size); }
+
+// The console clock, as MCMAN dates entries: binary fields, the year from 2000.
+mcfs::Time now() {
+    std::uint8_t clock[8];
+    read_clock(clock);
+    const auto bin = [](std::uint8_t b) { return static_cast<std::uint8_t>((b >> 4) * 10 + (b & 15)); };
+    const std::uint16_t year = static_cast<std::uint16_t>(2000 + bin(clock[7]));
+    return {0, bin(clock[1]), bin(clock[2]), bin(clock[3]), bin(clock[5]), bin(clock[6]), static_cast<std::uint8_t>(year), static_cast<std::uint8_t>(year >> 8)};
+}
+
+bool has_card(std::uint32_t port, std::uint32_t slot) { return port == 0 && slot == 0 && sio2::card_present(); }
+
+// After a call: changed blocks go to the image, and the image to its file once writes stop.
+void commit() {
+    if (card().commit()) sio2::card_written();
+}
+
+// Card info (1): the result says whether the card is new (-1 formatted, -2 not) or the same as last time
+// (0); the info block (0xC0 bytes, to the EE) holds its type, free clusters and whether it is formatted.
+int info(const std::uint32_t *w) {
+    const std::uint32_t port = w[1], slot = w[2];
+    std::uint8_t block[0xC0] = {};
+    int result;
+    if (!has_card(port, slot)) {
+        result = kNoCard;
+    } else {
+        if (w[5]) block[0] = 2;  // a PS2 memory card
+        if (!g_seen || g_known_insertion != sio2::card_insertions()) {
+            g_seen = true;
+            g_known_insertion = sio2::card_insertions();
+            card().files = {};
+            result = card().formatted() ? -1 : -2;
+        } else {
+            result = 0;
+        }
+        if (result >= -1) {
+            if (w[4]) {
+                const std::int32_t free = card().free_clusters();
+                std::memcpy(block + 4, &free, 4);
+            }
+            if (w[3]) block[0x90] = card().formatted() ? 1 : 0;
+        }
+        commit();
+    }
+    ee_write(w[7], block, sizeof block);
+    return result;
+}
+
+// Read (5): the data in place in the EE buffer; the unaligned start and end (up to 64 bytes each) also
+// go in a 0xC0-byte block at the EE's address (their sizes, addresses and bytes), which libmc copies.
+int read(const std::uint32_t *w) {
+    const int fd = static_cast<int>(w[0]);
+    const std::uint32_t size = w[3], buffer = w[6];
+    std::vector<std::uint8_t> data(size);
+    const int got = card().read(fd, data.data(), size);
+    commit();
+    std::uint32_t head = size <= 64 ? size : ((buffer - 1) & ~63u) - (buffer - 64);
+    std::uint32_t middle = size - head;
+    std::uint32_t tail = middle & 63;
+    middle -= tail;
+    std::uint8_t block[0xC0] = {};
+    if (got >= 0) {
+        const std::uint32_t n = static_cast<std::uint32_t>(got);
+        head = std::min(head, n);
+        middle = std::min(middle, n - head);
+        tail = std::min(tail, n - head - middle);
+        for (std::uint32_t at = 0; at < middle; at += 0x2000)  // in MCSERV's pieces
+            ee_write(buffer + head + at, data.data() + head + at, std::min<std::uint32_t>(middle - at, 0x2000));
+        std::memcpy(block + 16, data.data(), head);
+        std::memcpy(block + 80, data.data() + head + middle, tail);
+        std::memcpy(block + 0, &head, 4);
+        std::memcpy(block + 4, &tail, 4);
+        if (head) std::memcpy(block + 8, &buffer, 4);
+        const std::uint32_t tail_at = buffer + head + middle;
+        if (tail) std::memcpy(block + 12, &tail_at, 4);
+    }
+    ee_write(w[7], block, sizeof block);
+    return got;
+}
+
+// Write (6): the first bytes (up to 16, to reach an aligned address) come in the request, the rest from
+// the EE buffer.
+int write(const std::uint32_t *w, const std::uint8_t *request) {
+    const int fd = static_cast<int>(w[0]);
+    const std::uint32_t head = std::min<std::uint32_t>(w[5], 16), size = w[3];
+    std::vector<std::uint8_t> data(head + size);
+    std::memcpy(data.data(), request + 32, head);
+    std::memcpy(data.data() + head, ee(w[6]), size);
+    const int r = card().write(fd, data.data(), static_cast<std::uint32_t>(data.size()));
+    commit();
+    return r;
+}
+
+// Directory listing (13): up to w[3] entries of 64 bytes, to the EE table at w[4].
+int list(const std::uint32_t *w, const std::string &path) {
+    if (!has_card(w[0], w[1])) return kNoCard;
+    const int max = static_cast<std::int32_t>(w[3]);
+    std::vector<mcfs::Listing> out;
+    const int n = card().list(path, max < 0 ? 0x7FFFFFFF : max, out);
+    commit();
+    if (max >= 0)
+        for (std::size_t i = 0; i < out.size(); ++i) ee_write(w[4] + static_cast<std::uint32_t>(i) * 64, out[i].data(), 64);
+    return n;
+}
+
+bool rpc(std::uint32_t method, std::uint32_t args, std::uint32_t args_size, std::uint32_t ret, std::uint32_t ret_size) {
+    std::uint8_t request[1044] = {};
+    std::memcpy(request, ee(args), std::min<std::uint32_t>(args_size, sizeof request));
+    std::uint32_t w[8];
+    std::memcpy(w, request, sizeof w);
+    const std::string path(reinterpret_cast<const char *>(request + 20), strnlen(reinterpret_cast<const char *>(request + 20), 1023));
+    std::int32_t reply[3] = {0, 0, 0};
+    std::int32_t &r = reply[0];
+    switch (method) {
+    case 254:  // init
+        reply[1] = kServerVersion;
+        reply[2] = kDriverVersion;
+        break;
+    case 1: r = info(w); break;
+    case 2:  // open (also makes directories)
+        r = has_card(w[0], w[1]) ? card().open(path, static_cast<int>(w[2]), now()) : kNoCard;
+        commit();
+        break;
+    case 3: r = card().close(static_cast<int>(w[0]), now()); commit(); break;
+    case 4: r = card().seek(static_cast<int>(w[0]), static_cast<std::int32_t>(w[4]), static_cast<int>(w[5])); break;
+    case 5: r = read(w); break;
+    case 6: r = write(w, request); break;
+    case 10: r = card().flush(static_cast<int>(w[0])); break;
+    case 13: r = list(w, path); break;
+    case 15:  // delete
+        r = has_card(w[0], w[1]) ? card().remove(path) : kNoCard;
+        commit();
+        break;
+    case 16:  // format
+        r = has_card(w[1], w[2]) ? card().format(now()) : kNoCard;
+        commit();
+        break;
+    case 18:  // free directory entries
+        r = has_card(w[0], w[1]) ? card().entry_space(path) : kNoCard;
+        commit();
+        break;
+    case 20: break;  // thread priority
+    default:
+        std::fprintf(stderr, "[mcserv] RPC %u not handled\n", method);
+        r = kNotHandled;
+        break;
+    }
+    std::memcpy(ee(ret), reply, std::min<std::uint32_t>(ret_size, sizeof reply));
+    return true;
+}
+
+}  // namespace
+
+// On unless PS2_NATIVE_MC=0, which runs the game's own MCMAN.IRX and MCSERV.IRX translated instead (for
+// comparing the two). A save state keeps whichever drivers it was saved with.
+bool enabled() {
+    static const bool on = [] {
+        const char *v = std::getenv("PS2_NATIVE_MC");
+        return !v || v[0] != '0';
+    }();
+    return on;
+}
+
+void install() {
+    if (!enabled()) return;
+    kernel::register_hle_module("MCMAN", [] {
+        if (!kernel::alloc(kMcservBase - kMcmanBase, 2, kMcmanBase)) std::fprintf(stderr, "[mcserv] could not keep 0x%X..0x%X\n", kMcmanBase, kMcservBase);
+        std::memset(ram_ptr(kMcmanBase), 0, kMcservBase - kMcmanBase);
+    });
+    kernel::register_hle_module("MCSERV", [] {
+        if (!kernel::alloc(kMcservEnd - kMcservBase, 2, kMcservBase)) std::fprintf(stderr, "[mcserv] could not keep 0x%X..0x%X\n", kMcservBase, kMcservEnd);
+        std::memset(ram_ptr(kMcservBase), 0, kMcservEnd - kMcservBase);
+        g_installed = true;
+        g_seen = false;
+        card().files = {};
+        sif::register_hle_server(kServer, rpc);
+        std::fprintf(stderr, "[mcserv] native\n");
+    });
+}
+
+void state(ps2::state::Stream &s) {
+    s.tag("mcserv");
+    s.pod(g_installed);
+    s.pod(g_seen);
+    s.pod(card().files);
+    if (s.loading()) {
+        // The card in the slot is taken as the one the state saw (MCMAN would know it from its own memory).
+        g_known_insertion = sio2::card_insertions();
+        if (g_installed) sif::register_hle_server(kServer, rpc);
+    }
+}
+
+}
diff --git a/runtime/src/iop/mcserv.hpp b/runtime/src/iop/mcserv.hpp
new file mode 100644
index 0000000..d03a124
--- /dev/null
+++ b/runtime/src/iop/mcserv.hpp
@@ -0,0 +1,19 @@
+#pragma once
+
+namespace ps2::state {
+class Stream;
+}
+
+namespace ps2::iop::mcserv {
+
+// The game's memory card drivers (MCMAN.IRX and MCSERV.IRX) in native code, in place of their translated
+// modules: the libmc RPC server (0x80000400) answering each call the game makes, on the card in slot 1
+// through the native file system (mcfs.cpp), which writes the card as MCMAN does. Installed when the game
+// loads the modules (unless PS2_NATIVE_MC=0); their memory is kept so the modules after them load where
+// they always do. Checked against the translated modules: boot, saving over a save, a new save, and
+// formatting a blank card then saving, card images compared byte for byte.
+void install();
+bool enabled();
+void state(ps2::state::Stream &s);
+
+}
diff --git a/runtime/src/iop/padman.cpp b/runtime/src/iop/padman.cpp
new file mode 100644
index 0000000..aae7e2b
--- /dev/null
+++ b/runtime/src/iop/padman.cpp
@@ -0,0 +1,715 @@
+#include "padman.hpp"
+
+#include "iop.hpp"
+#include "kernel.hpp"
+#include "sif.hpp"
+#include "sio2.hpp"
+
+#include "ps2/memory.hpp"
+#include "ps2/state.hpp"
+#include "ps2/system.hpp"
+
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <vector>
+
+// A native PADMAN. What it does, and where each value lives, follows the translated module's code
+// (base 0x49F00 in this game; see docs/superpowers/plans/2026-11-08-native-pad.md): per port, a 0x1C4-
+// byte slot at 0x51FA0 + port * 0x710, whose first 0x80 bytes are the block the EE reads and the rest
+// PADMAN's own fields, named here by their offsets. Only slot 0 of each port is used (no multitap).
+namespace ps2::iop::padman {
+
+namespace {
+
+constexpr std::uint32_t kModuleBase = 0x49F00, kModuleEnd = 0x53D00;  // PADMAN's memory, kept for it
+constexpr std::uint32_t kSlots = 0x51FA0, kPortStride = 0x710;
+constexpr std::uint32_t kServer = 0x80000100;
+
+// Tasks, as PADMAN numbers them (field 432 the current one, 434 the requested one).
+constexpr std::uint16_t kUpdate = 1, kQuery = 2, kMainMode = 4, kActAlign = 5, kButtonInfo = 6;
+
+// Field offsets in a slot (PADMAN's own layout).
+enum : std::uint32_t {
+    kMailbox = 128,       // the EE writes vibration here: two 32-byte halves (counter, new flag, data from +12)
+    kConfigured = 192,    // 2: queried in config mode, 1: a pad without config mode
+    kModeId = 193,        // the pad's id as last found (0x41 digital, 0x73 analog, 0x79 pressure)
+    kModel = 194,
+    kModes = 195,
+    kModeOffset = 196,
+    kActuators = 197,
+    kCombinations = 198,
+    kFirstFind = 199,     // set at open and while no pad answers: the next find resets the align to FF
+    kActInfo = 200,       // 4 bytes per actuator
+    kCombInfo = 216,      // 4 bytes per combination
+    kModeTable = 232,     // u16 per mode
+    kButtonMask = 240,    // what button info asks for
+    kButtonsFound = 244,  // what the pad's 0x41 reported
+    kVref = 248,          // 12 bytes
+    kButtonInfoDone = 262,
+    kCommand = 264,       // the command sent (32 bytes)
+    kReply = 296,         // the reply (32 bytes)
+    kData = 328,          // the last good reply
+    kDataReady = 360,     // u16
+    kMainModeArg = 362,
+    kLockArg = 363,
+    kActDirect = 364,     // 6 bytes (plus 2)
+    kActDirectSize = 372, // u16
+    kAlign = 374,         // 6 bytes
+    kState = 380,         // u16: 0 disconnected, 2 digital only, 5 executing, 6 stable, 7 error
+    kRequestState = 382,  // u16: 0 complete, 1 failed, 2 busy
+    kFrame = 384,         // u32
+    kEeBuffer = 388,      // u32
+    kRetries = 392,       // u32
+    kCurrentTask = 432,   // u16
+    kRequestedTask = 434, // u16
+    kPortType = 440,      // u32
+};
+
+// Where a port's task is: the translated module keeps this in each task thread's registers.
+struct Run {
+    std::uint16_t step = 0;
+    std::uint16_t item = 0;
+    std::uint16_t tries = 0;
+    std::uint8_t found = 0;          // the query's mode id found by its first find
+    std::uint8_t spare = 0;
+    std::uint16_t update_fails = 0;  // failed polls in a row, in the update task
+    std::uint8_t query_pending = 0;  // a query started this frame, to run from the next
+    std::uint8_t pad0 = 0;
+};
+
+struct Port {
+    std::uint8_t open = 0;
+    std::uint8_t fresh = 0;   // a request arrived since the last block: it is started a frame later
+    std::uint8_t opened = 0;  // opened since the last block: the first frame only writes the block
+    std::uint8_t pad0 = 0;
+    Run run;
+};
+
+Port g_ports[2];
+bool g_installed = false;
+
+std::uint32_t slot_address(int port) { return kSlots + static_cast<std::uint32_t>(port) * kPortStride; }
+std::uint8_t *slot(int port) { return ram_ptr(slot_address(port)); }
+std::uint8_t u8(int port, std::uint32_t o) { return slot(port)[o]; }
+void set8(int port, std::uint32_t o, std::uint8_t v) { slot(port)[o] = v; }
+std::uint16_t u16(int port, std::uint32_t o) {
+    std::uint16_t v;
+    std::memcpy(&v, slot(port) + o, 2);
+    return v;
+}
+void set16(int port, std::uint32_t o, std::uint16_t v) { std::memcpy(slot(port) + o, &v, 2); }
+std::uint32_t u32(int port, std::uint32_t o) {
+    std::uint32_t v;
+    std::memcpy(&v, slot(port) + o, 4);
+    return v;
+}
+void set32(int port, std::uint32_t o, std::uint32_t v) { std::memcpy(slot(port) + o, &v, 4); }
+
+// The size of a transfer to a pad in a given mode: 3 bytes, then the mode's halfwords (its low
+// nibble); unknown (0) uses 5.
+std::size_t transfer_size(std::uint8_t id) { return id == 0 ? 5u : 3u + 2u * (id & 0x0Fu); }
+
+// One command exchange with the port's DualShock. The reply buffer is cleared first, as PADMAN does;
+// false when the pad does not answer.
+bool transfer(int port, const std::vector<std::uint8_t> &command) {
+    std::uint8_t *s = slot(port);
+    std::memset(s + kCommand, 0, 32);
+    std::memset(s + kReply, 0, 32);
+    std::memcpy(s + kCommand, command.data(), std::min<std::size_t>(command.size(), 32));
+    std::vector<std::uint8_t> reply(command.size(), 0xFF);
+    if (!sio2::answer(sio2::pad(port), sio2::feel(port), command.data(), command.size(), reply.data(), reply.size())) return false;
+    std::memcpy(s + kReply, reply.data(), std::min<std::size_t>(reply.size(), 32));
+    return true;
+}
+
+bool known_id(std::uint8_t id) { return id != 0 && (id & 0x0Fu) != 0; }
+
+// The commands. Each returns whether the pad answered as expected; their results go into the slot.
+std::vector<std::uint8_t> command(std::uint8_t cmd, std::size_t size, std::uint8_t fill) {
+    std::vector<std::uint8_t> c(size, fill);
+    c[0] = 0x01;
+    c[1] = cmd;
+    c[2] = 0x00;
+    return c;
+}
+
+bool reply_ok(int port, std::uint8_t expect_id) {
+    const std::uint8_t *r = slot(port) + kReply;
+    return r[2] == 0x5A && (expect_id == 0 || r[1] == expect_id);
+}
+
+bool find(int port) {
+    if (!transfer(port, command(0x42, 5, 0x00))) return false;
+    const std::uint8_t id = slot(port)[kReply + 1];
+    if (!known_id(id) || slot(port)[kReply + 2] != 0x5A) return false;
+    set8(port, kModeId, id);
+    return true;
+}
+
+bool poll(int port) {
+    std::vector<std::uint8_t> c = command(0x42, transfer_size(u8(port, kModeId)), 0x00);
+    for (std::uint16_t i = 0; i < u16(port, kActDirectSize) && 3u + i < c.size(); ++i)
+        c[3 + i] = u8(port, kAlign + i) != 0xFF ? u8(port, kActDirect + i) : 0x00;
+    return transfer(port, c);
+}
+
+bool enter_config(int port, std::uint8_t id) {
+    std::vector<std::uint8_t> c = command(0x43, transfer_size(id), 0x00);
+    c[3] = 0x01;
+    return transfer(port, c) && reply_ok(port, 0);
+}
+
+bool exit_config(int port) {
+    std::vector<std::uint8_t> c = command(0x43, 9, 0x5A);
+    c[3] = 0x00;
+    return transfer(port, c) && reply_ok(port, 0xF3);
+}
+
+bool model(int port) {
+    if (!transfer(port, command(0x45, 9, 0x5A)) || !reply_ok(port, 0xF3)) return false;
+    const std::uint8_t *r = slot(port) + kReply;
+    set8(port, kModel, r[3]);
+    set8(port, kModes, r[4]);
+    set8(port, kModeOffset, r[5]);
+    set8(port, kActuators, r[6]);
+    set8(port, kCombinations, r[7]);
+    return true;
+}
+
+bool table(int port, std::uint8_t cmd, std::uint8_t index) {
+    std::vector<std::uint8_t> c = command(cmd, 9, 0x5A);
+    c[3] = index;
+    if (!transfer(port, c) || !reply_ok(port, 0xF3)) return false;
+    const std::uint8_t *r = slot(port) + kReply;
+    if (cmd == 0x46) std::memcpy(slot(port) + kActInfo + index * 4u, r + 5, 4);
+    if (cmd == 0x47) std::memcpy(slot(port) + kCombInfo + index * 4u, r + 5, 4);
+    if (cmd == 0x4C) set16(port, kModeTable + index * 2u, static_cast<std::uint16_t>((r[5] << 8) | r[6]));
+    return true;
+}
+
+bool set_main_mode(int port) {
+    std::vector<std::uint8_t> c = command(0x44, 9, 0x00);
+    c[3] = u8(port, kMainModeArg);
+    c[4] = u8(port, kLockArg);
+    return transfer(port, c) && reply_ok(port, 0xF3);
+}
+
+bool set_align(int port) {
+    std::vector<std::uint8_t> c = command(0x4D, 9, 0xFF);
+    for (int i = 0; i < 6; ++i) c[3 + static_cast<std::size_t>(i)] = u8(port, kAlign + static_cast<std::uint32_t>(i));
+    return transfer(port, c) && reply_ok(port, 0xF3);
+}
+
+bool button_mask(int port) {
+    if (!transfer(port, command(0x41, 9, 0x5A)) || !reply_ok(port, 0xF3)) return false;
+    std::memcpy(slot(port) + kButtonsFound, slot(port) + kReply + 3, 4);
+    return true;
+}
+
+bool set_buttons(int port) {
+    std::vector<std::uint8_t> c = command(0x4F, 9, 0x00);
+    for (int i = 0; i < 3; ++i) c[3 + static_cast<std::size_t>(i)] = u8(port, kButtonMask + static_cast<std::uint32_t>(i));
+    return transfer(port, c) && reply_ok(port, 0xF3);
+}
+
+bool set_vref(int port, std::uint8_t index) {
+    std::vector<std::uint8_t> c = command(0x40, 9, 0x00);
+    c[3] = index;
+    c[4] = u8(port, kVref + index);
+    return transfer(port, c) && reply_ok(port, 0xF3);
+}
+
+// A query starts: PADMAN's query thread clears what it will find out.
+void query_reset(int port) {
+    for (std::uint32_t o : {kModeId, kConfigured, kModel, kModes, kActuators, kCombinations}) set8(port, o, 0);
+    set16(port, kDataReady, 0);
+    set16(port, kActDirectSize, 0);
+    set32(port, kRetries, 0);
+    for (std::uint32_t i = 0; i < 4; ++i) {
+        set8(port, kButtonMask + i, 0);
+        set8(port, kButtonsFound + i, 0);
+    }
+    const std::uint8_t align[6] = {0x00, 0x01, 0xFF, 0xFF, 0xFF, 0xFF};
+    std::memcpy(slot(port) + kAlign, align, 6);
+    std::memset(slot(port) + kActDirect, 0, 6);
+}
+
+// A query starts. In the translated module it is a thread the port's update task starts, and its first
+// act, the reset, waits for a lower priority to run: before this frame's block only when the main loop
+// still has to wait for port 2's transfer, so for port 1 with port 2 busy this frame; otherwise it shows
+// a frame later (measured on both ports, at boot, on a mode change and after a lost pad).
+void start_query(int port) {
+    Run &r = g_ports[port].run;
+    set16(port, kCurrentTask, kQuery);
+    r.step = 0;
+    r.item = 0;
+    r.tries = 0;
+    r.update_fails = 0;
+    if (port == 0 && g_ports[1].open && !g_ports[1].opened) query_reset(port);
+    else r.query_pending = 1;
+}
+
+// A task step that failed: up to 10 tries, then the task gives up with what PADMAN sets then.
+bool give_up(int port, std::uint16_t request_state, bool clear_id) {
+    Run &r = g_ports[port].run;
+    if (++r.tries < 10) return false;
+    if (clear_id) set8(port, kModeId, 0);
+    if (request_state) set16(port, kRequestState, request_state);
+    set16(port, kCurrentTask, kUpdate);
+    r.tries = 0;
+    return true;
+}
+
+void next(Run &r, std::uint16_t step) {
+    r.step = step;
+    r.tries = 0;
+    r.item = 0;
+}
+
+// Act direct (vibration values), from the EE's mailbox: the newer half, if it is flagged.
+void mailbox(int port) {
+    const std::uint32_t c0 = u32(port, kMailbox), c1 = u32(port, kMailbox + 32);
+    const std::uint32_t half = kMailbox + (c0 < c1 ? 32u : 0u);
+    if (!u32(port, half + 4)) return;
+    if (u8(port, kConfigured) != 1 && u16(port, kCurrentTask) == kUpdate) {
+        std::memcpy(slot(port) + kActDirect, slot(port) + half + 12, 6);
+        set16(port, kActDirectSize, 6);
+    }
+    set32(port, half + 4, 0);
+}
+
+void update_step(int port) {
+    Run &r = g_ports[port].run;
+    mailbox(port);
+    if (poll(port)) {
+        const std::uint8_t *reply = slot(port) + kReply;
+        if (reply[2] != 0x5A || reply[1] != u8(port, kModeId) || reply[1] == 0xF3) {
+            set16(port, kDataReady, 0);
+            set16(port, kState, 5);
+            start_query(port);
+            return;
+        }
+        std::memcpy(slot(port) + kData, reply, 32);
+        set16(port, kDataReady, 1);
+        set16(port, kState, u8(port, kConfigured) == 1 ? 2 : 6);
+        if (u16(port, kRequestState) == 2 && u16(port, kRequestedTask) == 0) set16(port, kRequestState, 0);
+        r.update_fails = 0;
+        return;
+    }
+    set16(port, kDataReady, 0);
+    set16(port, kState, 7);
+    set32(port, kRetries, u32(port, kRetries) + 1);
+    if (++r.update_fails >= 10) {
+        r.update_fails = 0;
+        start_query(port);
+    }
+}
+
+// The query, one command per frame (PADMAN's 0x4C4E0).
+enum QueryStep : std::uint16_t { qFind, qEnter, qModel, qDigital, qActuators, qCombinations, qModes, qAlign, qMask, qExit, qFinal };
+
+void query_step(int port) {
+    Run &r = g_ports[port].run;
+    if (r.query_pending) {
+        r.query_pending = 0;
+        query_reset(port);
+    }
+    switch (r.step) {
+    case qFind:
+        if (find(port)) {
+            r.found = u8(port, kModeId);
+            set8(port, kModeId, 0);
+            set16(port, kState, 5);
+            if (u8(port, kFirstFind)) std::memset(slot(port) + kAlign, 0xFF, 6);
+            next(r, qEnter);
+        } else {
+            set16(port, kState, 0);
+            set8(port, kFirstFind, 1);
+        }
+        return;
+    case qEnter:
+        if (enter_config(port, r.found)) {
+            set8(port, kConfigured, 2);
+            next(r, qModel);
+        } else if (++r.tries >= 10) {
+            set8(port, kConfigured, 1);
+            set8(port, kModeId, r.found);
+            set16(port, kCurrentTask, kUpdate);
+        }
+        return;
+    case qModel:
+        if (model(port)) {
+            next(r, u8(port, kFirstFind) == 1 && u8(port, kModeOffset) != 0 ? qDigital : qActuators);
+            if (r.step == qDigital) {
+                set8(port, kMainModeArg, 0);
+                set8(port, kLockArg, 0);
+            }
+        } else {
+            give_up(port, 0, true);
+        }
+        return;
+    case qDigital:
+        if (set_main_mode(port)) {
+            set8(port, kModeId, 0);
+            set16(port, kCurrentTask, kUpdate);
+            set8(port, kFirstFind, 0);
+        } else if (give_up(port, 1, false)) {
+        }
+        return;
+    default: break;
+    }
+    // The table steps: each runs once per item, skipped when there are none.
+    auto table_step = [&](std::uint16_t step, std::uint8_t count, std::uint8_t cmd, std::uint16_t after) {
+        if (r.step != step) return false;
+        if (r.item >= count) {
+            next(r, after);
+            return false;  // nothing sent this frame for an empty table: fall through to the next step
+        }
+        if (table(port, cmd, static_cast<std::uint8_t>(r.item))) {
+            r.tries = 0;
+            if (++r.item >= count) next(r, after);
+        } else {
+            give_up(port, 0, true);
+        }
+        return true;
+    };
+    if (table_step(qActuators, u8(port, kActuators), 0x46, qCombinations)) return;
+    if (table_step(qCombinations, u8(port, kCombinations), 0x47, qModes)) return;
+    if (table_step(qModes, u8(port, kModes), 0x4C, qAlign)) return;
+    switch (r.step) {
+    case qAlign:
+        if (set_align(port)) next(r, u8(port, kConfigured) == 2 && (u8(port, kModel) & 2u) ? qMask : qExit);
+        else give_up(port, 1, false);
+        return;
+    case qMask:
+        if (button_mask(port)) next(r, qExit);
+        else give_up(port, 0, true);
+        return;
+    case qExit:
+        if (exit_config(port)) next(r, qFinal);
+        else give_up(port, 0, true);
+        return;
+    case qFinal:
+        if (find(port)) {
+            const std::uint8_t id = u8(port, kModeId);
+            set16(port, kState, 5);
+            set16(port, kCurrentTask, kUpdate);
+            set8(port, kFirstFind, 0);
+            set8(port, kModeId, id);
+        } else {
+            give_up(port, 0, true);
+        }
+        return;
+    default: return;
+    }
+}
+
+// The settings tasks: enter config, their command(s), exit config, one per frame.
+void settings_step(int port, std::uint16_t task) {
+    Run &r = g_ports[port].run;
+    if (r.step == 0 && r.item == 0 && r.tries == 0 && !r.found) {
+        // First frame of the task: no data while it runs.
+        set16(port, kDataReady, 0);
+        set16(port, kState, 5);
+        r.found = 1;
+    }
+    auto finish = [&] {
+        if (task == kButtonInfo) set16(port, kButtonInfoDone, 1);
+        set16(port, kCurrentTask, kUpdate);
+        r.found = 0;
+    };
+    auto fail = [&] {
+        if (++r.tries >= 10) {
+            set16(port, kRequestState, 1);
+            set16(port, kCurrentTask, kUpdate);
+            r.found = 0;
+        }
+    };
+    switch (r.step) {
+    case 0:
+        if (enter_config(port, u8(port, kModeId))) next(r, 1);
+        else fail();
+        return;
+    case 1: {
+        bool ok = false;
+        if (task == kMainMode) ok = set_main_mode(port);
+        else if (task == kActAlign) ok = set_align(port);
+        else if (task == kButtonInfo) ok = set_buttons(port);
+        if (ok) next(r, task == kButtonInfo ? 2 : 3);
+        else fail();
+        return;
+    }
+    case 2:
+        if (set_vref(port, static_cast<std::uint8_t>(r.item))) {
+            r.tries = 0;
+            if (++r.item >= 12) next(r, 3);
+        } else {
+            fail();
+        }
+        return;
+    case 3:
+        if (exit_config(port)) finish();
+        else fail();
+        return;
+    default: return;
+    }
+}
+
+// The block the EE reads, from the slot's fields (PADMAN's 0x4A248), and its copy to the EE.
+void build_block(int port) {
+    std::uint8_t *s = slot(port);
+    const std::uint32_t frame = u32(port, kFrame);
+    set32(port, kFrame, frame + 1);
+    set32(port, 88, frame);
+    set32(port, 92, u32(port, kRetries));
+    s[100] = s[kConfigured];
+    s[101] = s[kModeId];
+    s[102] = s[kModel];
+    s[103] = s[kDataReady];
+    s[104] = s[kModes];
+    s[105] = s[kModeOffset];
+    s[106] = s[kActuators];
+    s[107] = s[kCombinations];
+    s[108] = s[kButtonInfoDone];
+    s[109] = s[kMainModeArg];
+    s[110] = s[kLockArg];
+    s[111] = s[kActDirectSize];
+    s[112] = s[kState];
+    s[113] = s[kRequestState];
+    s[114] = s[kCurrentTask];
+    s[115] = s[kRequestedTask];
+    std::memcpy(s + 32, s + kActDirect, 8);
+    std::memcpy(s + 40, s + kAlign, 8);  // the align, then the state again
+    std::memcpy(s + 48, s + kActInfo, 40);
+    s[116] = s[kPortType];
+    std::memcpy(s + 117, s + kButtonMask, 4);
+    std::memcpy(s + 121, s + kButtonsFound, 4);
+    if (u16(port, kDataReady) == 1) {
+        // The data (PADMAN's 0x4DA38): 0, the mode id, the reply after its 0x5A, and the 0x5A last.
+        const std::uint8_t id = s[kModeId];
+        s[0] = 0;
+        s[1] = id;
+        s[31] = s[kData + 2];
+        for (int i = 2; i < 31; ++i) s[i] = s[kData + 1 + i];
+        if (id == 0x12) {
+            s[2] = s[3] = 0xFF;
+            s[4] = s[5] = 0;
+        }
+        if (id == 0x79) {
+            // Each pressure agrees with its button: pressed reads at least 1, released reads 0.
+            const std::uint16_t buttons = static_cast<std::uint16_t>(~((s[2] << 8) | s[3]));
+            static const std::uint16_t kBits[12] = {0x2000, 0x8000, 0x1000, 0x4000, 0x0010, 0x0020, 0x0040, 0x0080, 0x0004, 0x0008, 0x0001, 0x0002};
+            for (int i = 0; i < 12; ++i) {
+                std::uint8_t &p = s[8 + i];
+                if (buttons & kBits[i]) {
+                    if (p == 0) p = 1;
+                } else if (p != 0) {
+                    p = 0;
+                }
+            }
+        }
+        set32(port, 96, 32);
+    } else {
+        set32(port, 96, 0);
+    }
+    const std::uint32_t dst = u32(port, kEeBuffer) + ((frame & 1u) ? 0x80u : 0u);
+    std::memcpy(ps2::g_ram + (dst & (ps2::kRamSize - 1)), s, 0x80);
+    ps2::watch_span(dst, 0x80, "padman:block");
+}
+
+void open_port(int port, std::uint32_t ee_buffer) {
+    std::uint8_t *s = slot(port);
+    std::memset(s, 0, 0x1C4);
+    set16(port, kState, 5);
+    set32(port, kEeBuffer, ee_buffer);
+    set8(port, kFirstFind, 1);
+    set16(port, kCurrentTask, kUpdate);
+    g_ports[port] = Port{};
+    g_ports[port].open = 1;
+    g_ports[port].opened = 1;
+}
+
+// A request from the game (PADMAN's 0x4E27C and its neighbours): accepted when the port is in the
+// update task, has been queried and is not busy.
+bool request(int port, std::uint16_t task) {
+    if (u16(port, kCurrentTask) != kUpdate || u8(port, kConfigured) < 2 || u16(port, kRequestState) == 2) return false;
+    set16(port, kRequestState, 2);
+    set16(port, kRequestedTask, task);
+    g_ports[port].fresh = 1;
+    return true;
+}
+
+bool rpc(std::uint32_t, std::uint32_t args, std::uint32_t args_size, std::uint32_t ret, std::uint32_t ret_size) {
+    // The reply is the request, with the results written into it.
+    std::uint8_t buffer[128] = {};
+    std::memcpy(buffer, ps2::g_ram + (args & (ps2::kRamSize - 1)), std::min<std::uint32_t>(args_size, 128));
+    auto word = [&](int i) {
+        std::uint32_t v;
+        std::memcpy(&v, buffer + i * 4, 4);
+        return v;
+    };
+    auto set_word = [&](int i, std::uint32_t v) { std::memcpy(buffer + i * 4, &v, 4); };
+    const std::uint32_t cmd = word(0);
+    const int port = static_cast<int>(word(1) & 1u);
+    const bool slot0 = word(2) == 0 && word(1) < 2;
+    switch (cmd) {
+    case 0x01:  // open
+        if (slot0) {
+            open_port(port, word(4));
+            set_word(3, 1);
+            set_word(5, slot_address(port) + 0x80);
+        } else {
+            set_word(3, 0);
+        }
+        break;
+    case 0x06:  // set main mode
+        set_word(5, slot0 && word(3) < u8(port, kModes) && request(port, kMainMode) ? (set8(port, kMainModeArg, static_cast<std::uint8_t>(word(3))), set8(port, kLockArg, static_cast<std::uint8_t>(word(4))), 1u) : 0u);
+        break;
+    case 0x08:  // set actuator align
+        if (slot0 && u16(port, kCurrentTask) == kUpdate && u8(port, kConfigured) >= 2 && u16(port, kRequestState) != 2) {
+            std::memcpy(slot(port) + kAlign, buffer + 12, 6);
+            request(port, kActAlign);
+            set_word(5, 1);
+        } else {
+            set_word(5, 0);
+        }
+        break;
+    case 0x07:  // set actuator direct
+        if (slot0 && u8(port, kConfigured) != 1 && u16(port, kCurrentTask) == kUpdate) {
+            std::memcpy(slot(port) + kActDirect, buffer + 12, 6);
+            set16(port, kActDirectSize, 6);
+            set_word(5, 1);
+        } else {
+            set_word(5, 0);
+        }
+        break;
+    case 0x09:  // the buttons the pad reports
+        set_word(3, slot0 && u16(port, kCurrentTask) == kUpdate && u8(port, kConfigured) >= 2 && u8(port, kModel) >= 2 ? u32(port, kButtonsFound) : 0u);
+        break;
+    case 0x0A:  // set button info
+        if (slot0 && u16(port, kCurrentTask) == kUpdate && u8(port, kConfigured) >= 2 && (u8(port, kModel) & 2u) && u16(port, kRequestState) != 2) {
+            set32(port, kButtonMask, (word(3) << 6) | 0x3Fu);
+            std::memset(slot(port) + kVref, 2, 12);
+            request(port, kButtonInfo);
+            set_word(4, 1);
+        } else {
+            set_word(4, 0);
+        }
+        break;
+    case 0x0C: set_word(3, 2); break;  // port max
+    case 0x0D: set_word(3, 1); break;  // slot max: no multitap
+    case 0x10: set_word(3, 1); break;  // init
+    case 0x12: set_word(3, 0x403); break;  // module version
+    case 0x14: set_word(2, 1); break;
+    default:
+        std::fprintf(stderr, "[padman] RPC command 0x%X not handled\n", cmd);
+        break;
+    }
+    std::memcpy(ps2::g_ram + (ret & (ps2::kRamSize - 1)), buffer, std::min<std::uint32_t>(ret_size, 128));
+    return true;
+}
+
+// PADMAN's two servers: the game binds both, and calls only the first; the second answers with the
+// request, as an idle server would.
+void register_servers() {
+    sif::register_hle_server(kServer, rpc);
+    sif::register_hle_server(kServer + 1, [](std::uint32_t method, std::uint32_t args, std::uint32_t args_size, std::uint32_t ret, std::uint32_t ret_size) {
+        std::fprintf(stderr, "[padman] RPC 0x%X to the second server\n", method);
+        std::memmove(ps2::g_ram + (ret & (ps2::kRamSize - 1)), ps2::g_ram + (args & (ps2::kRamSize - 1)), std::min(args_size, ret_size));
+        return true;
+    });
+}
+
+}  // namespace
+
+// On unless PS2_NATIVE_PAD=0, which runs the game's own PADMAN.IRX translated instead (for comparing
+// the two). A save state keeps whichever driver it was saved with.
+bool enabled() {
+    static const bool on = [] {
+        const char *v = std::getenv("PS2_NATIVE_PAD");
+        return !v || v[0] != '0';
+    }();
+    return on;
+}
+
+// Each frame's work comes in two parts, where the translated module did them in normal play (one pad
+// in pressure mode, measured in EE cycles after vblank starts): the requested tasks and the vibration
+// mailbox at about 11,000 (each port's command follows); the blocks at about 40,500. A request the game makes
+// between the two shows in this frame's block and starts next frame; a mailbox write then is read
+// next frame. (The translated module's times move with the transfers: blocks from 33,000 to 62,000.)
+constexpr std::uint64_t kTasksDelay = 1375, kBlocksDelay = 5063;  // IOP cycles (an EE cycle is 1/8)
+
+void tasks();
+void blocks();
+
+void install() {
+    kernel::register_job(kernel::kJobPadmanFrame, [](const kernel::Job &j) {
+        if (j.a == 0) tasks();
+        else blocks();
+    });
+    if (!enabled()) return;
+    kernel::register_hle_module("PADMAN", [] {
+        // Keep PADMAN's memory: the modules after it load where they always do (their translated code
+        // depends on it), and the game writes vibration into it.
+        if (!kernel::alloc(kModuleEnd - kModuleBase, 2, kModuleBase)) std::fprintf(stderr, "[padman] could not keep 0x%X..0x%X\n", kModuleBase, kModuleEnd);
+        std::memset(ram_ptr(kModuleBase), 0, kModuleEnd - kModuleBase);
+        g_ports[0] = Port{};
+        g_ports[1] = Port{};
+        g_installed = true;
+        register_servers();
+        std::fprintf(stderr, "[padman] native\n");
+    });
+}
+
+void vblank() {
+    if (!g_installed) return;
+    kernel::schedule(kernel::now() + kTasksDelay, kernel::Job{kernel::kJobPadmanFrame, 0});
+    kernel::schedule(kernel::now() + kBlocksDelay, kernel::Job{kernel::kJobPadmanFrame, 1});
+}
+
+void tasks() {
+    if (!g_installed) return;
+    for (int port = 0; port < 2; ++port) {
+        Port &p = g_ports[port];
+        if (!p.open || p.opened) continue;
+        // A requested task starts (the request has waited a frame, as the module's RPC thread made it).
+        const std::uint16_t requested = u16(port, kRequestedTask);
+        if (requested && !p.fresh) {
+            if (u16(port, kCurrentTask) == kUpdate) {
+                set16(port, kCurrentTask, requested);
+                set16(port, kRequestedTask, 0);
+                set16(port, kRequestState, 2);
+                p.run = Run{};
+            } else {
+                set16(port, kRequestedTask, 0);
+                set16(port, kRequestState, 1);
+            }
+        }
+        switch (u16(port, kCurrentTask)) {
+        case kUpdate: update_step(port); break;
+        case kQuery: query_step(port); break;
+        case kMainMode: case kActAlign: case kButtonInfo: settings_step(port, u16(port, kCurrentTask)); break;
+        default: break;
+        }
+    }
+}
+
+void blocks() {
+    if (!g_installed) return;
+    for (int port = 0; port < 2; ++port) {
+        if (!g_ports[port].open) continue;
+        build_block(port);
+        g_ports[port].fresh = 0;
+        g_ports[port].opened = 0;
+    }
+}
+
+void state(ps2::state::Stream &s) {
+    s.tag("padman");
+    s.pod(g_installed);
+    s.pod(g_ports);
+    if (s.loading() && g_installed) register_servers();
+}
+
+}
