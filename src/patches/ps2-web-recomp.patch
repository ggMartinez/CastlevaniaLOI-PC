+    flag("vsync", g.vsync);
+    flag("widescreen", g.widescreen);
+    flag("fullscreen", g.fullscreen);
+    if (const std::string *s = text("aa")) g.fxaa = *s == "fxaa";
+    if (const std::string *s = text("upscale")) g.fsr = *s == "fsr";
+    flag("sharpen", g.sharpen);
+    number("sharpen_strength", g.sharpen_strength, 0.0f, 1.0f);
+    flag("bloom", g.bloom);
+    number("bloom_strength", g.bloom_strength, 0.0f, 1.0f);
+    number("brightness", g.brightness, -0.5f, 0.5f);
+    number("contrast", g.contrast, 0.5f, 1.5f);
+    number("saturation", g.saturation, 0.0f, 2.0f);
+    number("gamma", g.gamma, 0.5f, 2.0f);
+    flag("deband", g.deband);
+    flag("crt", g.crt);
+    number("crt_scanlines", g.crt_scanlines, 0.0f, 1.0f);
+    flag("crt_curvature", g.crt_curvature);
+    flag("vignette", g.vignette);
+    number("vignette_strength", g.vignette_strength, 0.0f, 1.0f);
+    flag("grain", g.grain);
+    number("grain_strength", g.grain_strength, 0.0f, 1.0f);
+    return g;
+}
+
+void save_graphics(const std::string &ini, const Graphics &g) {
+    std::vector<std::string> kept;
+    {
+        std::ifstream in(ini);
+        std::string line;
+        while (std::getline(in, line)) {
+            if (!line.empty() && line.back() == '\r') line.pop_back();
+            const auto eq = line.find('=');
+            if (eq == std::string::npos || !is_graphics_key(line.substr(0, eq))) kept.push_back(line);
+        }
+    }
+    std::ostringstream out;
+    for (const std::string &line : kept)
+        if (!line.empty()) out << line << "\n";
+    const auto b = [](bool v) { return v ? "1" : "0"; };
+    out << "api=" << (g.api == Api::vulkan ? "vulkan" : "d3d12") << "\nscale=" << g.scale << "\nvsync=" << b(g.vsync) << "\nwidescreen=" << b(g.widescreen)
+        << "\nfullscreen=" << b(g.fullscreen) << "\naa=" << (g.fxaa ? "fxaa" : "off") << "\nupscale=" << (g.fsr ? "fsr" : "default")
+        << "\nsharpen=" << b(g.sharpen) << "\nsharpen_strength=" << g.sharpen_strength << "\nbloom=" << b(g.bloom)
+        << "\nbloom_strength=" << g.bloom_strength << "\nbrightness=" << g.brightness << "\ncontrast=" << g.contrast << "\nsaturation=" << g.saturation
+        << "\ngamma=" << g.gamma << "\ndeband=" << b(g.deband) << "\ncrt=" << b(g.crt) << "\ncrt_scanlines=" << g.crt_scanlines
+        << "\ncrt_curvature=" << b(g.crt_curvature) << "\nvignette=" << b(g.vignette) << "\nvignette_strength=" << g.vignette_strength
+        << "\ngrain=" << b(g.grain) << "\ngrain_strength=" << g.grain_strength << "\n";
+    std::ofstream(ini, std::ios::binary) << out.str();
+}
+
+const char *scale_label(int scale) {
+    static const char *const kLabels[] = {"1x (~480p)", "2x (~900p)", "3x (~1440p)", "4x (~1800p)", "5x (~2160p, 4K)", "6x (~2880p, 5K)"};
+    return kLabels[std::clamp(scale, 1, 6) - 1];
+}
+
+Graphics graphics() {
+    std::lock_guard lock(g_mutex);
+    return g_graphics;
+}
+
+void set_graphics(const Graphics &g) {
+    Graphics before;
+    std::vector<std::function<void(const Graphics &, const Graphics &)>> listeners;
+    {
+        std::lock_guard lock(g_mutex);
+        before = g_graphics;
+        g_graphics = g;
+        listeners = g_listeners;
+    }
+    for (const auto &l : listeners) l(before, g);
+}
+
+void add_graphics_listener(std::function<void(const Graphics &, const Graphics &)> listener) {
+    std::lock_guard lock(g_mutex);
+    g_listeners.push_back(std::move(listener));
+}
+
+std::string &graphics_file() {
+    static std::string path;
+    return path;
+}
+
+}
