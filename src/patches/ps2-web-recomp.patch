+                break;
+            }
+            ++n;
+            if (i.kind == Kind::Syscall) {
+                body += std::format("    c.pc = {}; c.npc = {}; gen::syscall(c, {}); return {}u;\n", hex(pc + 4), hex(pc + 8), hex(pc), n);
+                closed = true;
+                break;
