+#pragma once
+// What the IOP modules' translated code (ioprecomp) uses from the runtime: the IOP's registers,
+// its memory and the kernel calls that can switch threads. Each block is a run of the module's
+// instructions that the interpreter's dispatch loop calls in place of interpreting them.
+
+#include <cstddef>
+#include <cstdint>
+#include <vector>
+
+namespace ps2::iop {
+
+struct Cpu {
+    std::uint32_t r[32];
+    std::uint32_t hi, lo;
+    std::uint32_t pc, npc;
+    std::uint32_t status, cause, epc;
+};
+
+// A module's text relocated to base, as the loader leaves it before linking its imports: what
+// the launcher's build translates (false if data is no IOP module). Runtime only.
+bool relocated_text(const std::vector<std::uint8_t> &data, std::uint32_t base, std::vector<std::uint8_t> &text);
+
+namespace gen {
+
+// Memory and kernel access for translated blocks (they also keep PS2_IOP_CHECK's write journal).
+std::uint32_t ld8(std::uint32_t a);
+std::uint32_t ld16(std::uint32_t a);
+std::uint32_t ld32(std::uint32_t a);
+void st8(std::uint32_t a, std::uint32_t v);
+void st16(std::uint32_t a, std::uint32_t v);
+void st32(std::uint32_t a, std::uint32_t v);
+bool switch_pending();
+void syscall(Cpu &c, std::uint32_t pc);
+void set_status(Cpu &c, std::uint32_t value);
+void brk(std::uint32_t pc);
+
+// A block runs from its first instruction with c.pc on it and c.npc right after, and leaves
+// c.pc/c.npc on the next instruction to run. It returns how many instructions it ran: all of
+// them, or fewer when a store made a thread switch pending.
+using BlockFn = std::uint32_t (*)(Cpu &c);
+
+struct Block {
+    std::uint32_t pc;
+    std::uint32_t length;
+    BlockFn fn;
+};
+
+// One module's translated code, valid when the module is loaded at base and its text, import
+// stubs left out, hashes to hash (see code_hash).
+struct Module {
+    const char *name;
+    std::uint32_t base, text_size;
+    std::uint64_t hash;
+    const Block *blocks;
+    std::uint32_t count;
+};
+
+void register_module(const Module &m);
+
+// FNV-1a over a module's text with its import stub tables left out: the loader rewrites those
+// stubs (to jumps or native calls), so the hash is the same before and after linking.
+inline std::uint64_t code_hash(const std::uint8_t *text, std::size_t size) {
+    const auto word = [&](std::size_t at) {
+        return static_cast<std::uint32_t>(text[at]) | static_cast<std::uint32_t>(text[at + 1]) << 8 | static_cast<std::uint32_t>(text[at + 2]) << 16 |
+               static_cast<std::uint32_t>(text[at + 3]) << 24;
+    };
+    std::uint64_t h = 1469598103934665603ull;
+    std::size_t at = 0;
+    while (at + 4 <= size) {
+        if (word(at) == 0x41E00000u && at + 20 <= size) {
+            std::size_t stub = at + 20;
+            while (stub + 8 <= size) {
+                const std::uint32_t w0 = word(stub), w1 = word(stub + 4);
+                const bool original = w0 == 0x03E00008u && (w1 & 0xFFFF0000u) == 0x24000000u;
+                const bool jump = (w0 >> 26) == 2u && w1 == 0;
+                const bool native = (w0 >> 26) == 0x3Fu && (w1 & 0xFFFF0000u) == 0x24000000u;
+                if (!original && !jump && !native) break;
+                stub += 8;
+            }
+            at = stub;
+            continue;
+        }
+        for (int i = 0; i < 4; ++i) h = (h ^ text[at + static_cast<std::size_t>(i)]) * 1099511628211ull;
+        at += 4;
+    }
+    return h;
+}
+
+}
+
+}
