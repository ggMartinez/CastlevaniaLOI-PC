@@ -0,0 +1,210 @@
+#include "interpolate.hpp"
+
+#include <algorithm>
+#include <cmath>
+#include <cstddef>
+#include <limits>
+
+namespace ps2::gs::native {
+
+namespace {
+
+struct Point {
+    float x = 0, y = 0;
+};
+
+Point centre(const std::vector<GpuVertex> &v, std::uint32_t first, std::uint32_t count) {
+    Point c;
+    if (!count) return c;
+    for (std::uint32_t i = first; i < first + count; ++i) c.x += v[i].x, c.y += v[i].y;
+    c.x /= static_cast<float>(count), c.y /= static_cast<float>(count);
+    return c;
+}
+
+float apart(Point a, Point b) { return std::max(std::fabs(a.x - b.x), std::fabs(a.y - b.y)); }
+
+// The cheapest in-order pairing of a's items with b's: cost(i, j) < 0 when they can't pair, gap for each item
+// left out. Within a band around the diagonal as wide as the counts differ plus 32 (culling shifts items by
+// about as many as were culled), or the whole table when it is small. For each a, its b or -1.
+template <typename Cost>
+std::vector<int> align(std::size_t na, std::size_t nb, Cost cost, float gap) {
+    std::vector<int> paired(na, -1);
+    if (!na || !nb) return paired;
+    const std::size_t differ = na > nb ? na - nb : nb - na;
+    const std::size_t band = na * nb <= (1u << 14) ? nb : std::min(nb, differ + 32);
+    const std::size_t width = std::min(nb, 2 * band) + 1;
+    const auto lo = [&](std::size_t i) {
+        const std::size_t c = i * nb / na;
+        return c > band ? c - band : 0;
+    };
+    constexpr float kInf = std::numeric_limits<float>::infinity();
+    // Row i holds columns lo(i) .. lo(i)+width-1; move: 0 pair, 1 a left out, 2 b left out.
+    std::vector<float> d((na + 1) * width, kInf);
+    std::vector<std::uint8_t> how((na + 1) * width, 0);
+    const auto at = [&](std::size_t i, std::size_t j) -> float {
+        if (j < lo(i) || j - lo(i) >= width || j > nb) return kInf;
+        return d[i * width + (j - lo(i))];
+    };
+    for (std::size_t i = 0; i <= na; ++i)
+        for (std::size_t j = lo(i); j < lo(i) + width && j <= nb; ++j) {
+            float best = kInf;
+            std::uint8_t move = 0;
+            if (!i && !j) best = 0;
+            if (i && j) {
+                const float c = cost(i - 1, j - 1);
+                if (c >= 0 && at(i - 1, j - 1) + c < best) best = at(i - 1, j - 1) + c, move = 0;
+            }
+            if (i && at(i - 1, j) + gap < best) best = at(i - 1, j) + gap, move = 1;
+            if (j && at(i, j - 1) + gap < best) best = at(i, j - 1) + gap, move = 2;
+            d[i * width + (j - lo(i))] = best;
+            how[i * width + (j - lo(i))] = move;
+        }
+    if (at(na, nb) == kInf) return paired;
+    for (std::size_t i = na, j = nb; i || j;) {
+        const std::uint8_t move = how[i * width + (j - lo(i))];
+        if (move == 0) paired[--i] = static_cast<int>(--j);
+        else if (move == 1) --i;
+        else --j;
+    }
+    return paired;
+}
+
+// What tells a draw's primitive from the others: its texture coordinates (or colours), quantised.
+std::uint64_t primitive_key(const Draw &d, const std::vector<GpuVertex> &v, std::uint32_t p) {
+    std::uint64_t h = 1469598103934665603ull;
+    const auto mix = [&](std::uint64_t x) { h = (h ^ x) * 1099511628211ull; };
+    for (std::uint32_t k = 0; k < d.per; ++k) {
+        const GpuVertex &g = v[d.first + p * d.per + k];
+        if (d.textured) {
+            const float q = g.q != 0 ? g.q : 1.0f;
+            mix(static_cast<std::uint64_t>(std::llround(g.s / q * 4096.0f)));
+            mix(static_cast<std::uint64_t>(std::llround(g.t / q * 4096.0f)));
+        } else {
+            mix(g.rgba[0] | (g.rgba[1] << 8) | (g.rgba[2] << 16) | (static_cast<std::uint32_t>(g.rgba[3]) << 24));
+        }
+    }
+    return h;
+}
+
+}
+
+std::vector<int> match(const std::vector<Draw> &before, const std::vector<GpuVertex> &before_verts, const std::vector<Draw> &now,
+                       const std::vector<GpuVertex> &now_verts, float limit) {
+    std::vector<Point> cb, cn;
+    for (const Draw &d : before) cb.push_back(centre(before_verts, d.first, d.count));
+    for (const Draw &d : now) cn.push_back(centre(now_verts, d.first, d.count));
+    return align(
+        now.size(), before.size(),
+        [&](std::size_t i, std::size_t j) {
+            if (now[i].what != before[j].what || now[i].per != before[j].per) return -1.0f;
+            const float far = apart(cn[i], cb[j]);
+            return far > limit ? -1.0f : far;
+        },
+        limit);
+}
+
+std::vector<float> previous(const std::vector<Draw> &before, const std::vector<GpuVertex> &before_verts, const std::vector<Draw> &now,
+                            const std::vector<GpuVertex> &now_verts, const std::vector<int> &matched, float limit, std::size_t *paired) {
+    if (paired) *paired = 0;
+    std::vector<float> where(now_verts.size() * 3);
+    for (std::size_t i = 0; i < now_verts.size(); ++i) {
+        where[i * 3] = now_verts[i].x;
+        where[i * 3 + 1] = now_verts[i].y;
+        where[i * 3 + 2] = now_verts[i].z;
+    }
+    for (std::size_t d = 0; d < now.size(); ++d) {
+        if (matched[d] < 0) continue;
+        const Draw &n = now[d], &b = before[static_cast<std::size_t>(matched[d])];
+        if (!n.per || n.per != b.per || b.first + b.count > before_verts.size() || n.first + n.count > now_verts.size()) continue;
+        const std::uint32_t pn = n.count / n.per, pb = b.count / b.per;
+        std::vector<std::uint64_t> kn(pn), kb(pb);
+        std::vector<Point> cn(pn), cb(pb);
+        for (std::uint32_t p = 0; p < pn; ++p) kn[p] = primitive_key(n, now_verts, p), cn[p] = centre(now_verts, n.first + p * n.per, n.per);
+        for (std::uint32_t p = 0; p < pb; ++p) kb[p] = primitive_key(b, before_verts, p), cb[p] = centre(before_verts, b.first + p * b.per, b.per);
+        std::vector<int> pairs;
+        if (pn == pb && kn == kb) {
+            // The common case: nothing culled or added; still a cut if it moved too far.
+            pairs.resize(pn);
+            for (std::uint32_t p = 0; p < pn; ++p) pairs[p] = apart(cn[p], cb[p]) > limit ? -1 : static_cast<int>(p);
+        } else {
+            pairs = align(
+                pn, pb,
+                [&](std::size_t i, std::size_t j) {
+                    if (kn[i] != kb[j]) return -1.0f;
+                    const float far = apart(cn[i], cb[j]);
+                    return far > limit ? -1.0f : far;
+                },
+                limit);
+        }
+        for (std::uint32_t p = 0; p < pn; ++p) {
+            if (pairs[p] < 0) continue;
+            if (paired) *paired += n.per;
+            for (std::uint32_t k = 0; k < n.per; ++k) {
+                const GpuVertex &v = before_verts[b.first + static_cast<std::uint32_t>(pairs[p]) * b.per + k];
+                float *w = &where[(n.first + p * n.per + k) * 3];
+                w[0] = v.x, w[1] = v.y, w[2] = v.z;
+            }
+        }
+    }
+    return where;
+}
+
+std::vector<GpuVertex> blend(const std::vector<float> &before, const std::vector<GpuVertex> &now, float t) {
+    std::vector<GpuVertex> out(now);
+    for (std::size_t i = 0; i < out.size(); ++i) {
+        out[i].x = before[i * 3] + (now[i].x - before[i * 3]) * t;
+        out[i].y = before[i * 3 + 1] + (now[i].y - before[i * 3 + 1]) * t;
+        out[i].z = before[i * 3 + 2] + (now[i].z - before[i * 3 + 2]) * t;
+    }
+    return out;
+}
+
+}
+
+namespace ps2::gs::native {
+
+std::vector<std::pair<std::uint32_t, std::uint32_t>> align_equal(const std::vector<std::uint64_t> &a, const std::vector<std::uint64_t> &b, std::size_t max_edits) {
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> pairs;
+    const int n = static_cast<int>(a.size()), m = static_cast<int>(b.size());
+    if (!n || !m) return pairs;
+    const int most = static_cast<int>(std::min<std::size_t>(max_edits, static_cast<std::size_t>(n + m)));
+    const int off = most + 1;
+    // v[k + off]: the furthest x along diagonal k (x - y) after d edits; trace[d]: v after d edits.
+    std::vector<int> v(2 * off + 1, 0);
+    std::vector<std::vector<int>> trace;
+    int done = -1;
+    for (int d = 0; d <= most && done < 0; ++d) {
+        for (int k = -d; k <= d; k += 2) {
+            int x = (k == -d || (k != d && v[k - 1 + off] < v[k + 1 + off])) ? v[k + 1 + off] : v[k - 1 + off] + 1;
+            int y = x - k;
+            while (x < n && y < m && a[x] == b[y]) ++x, ++y;
+            v[k + off] = x;
+            if (x >= n && y >= m) {
+                done = d;
+                break;
+            }
+        }
+        trace.push_back(v);
+    }
+    if (done < 0) return pairs;
+    int x = n, y = m;
+    for (int d = done; d > 0; --d) {
+        const std::vector<int> &p = trace[d - 1];
+        const int k = x - y;
+        const int prev_k = (k == -d || (k != d && p[k - 1 + off] < p[k + 1 + off])) ? k + 1 : k - 1;
+        const int px = p[prev_k + off], py = px - prev_k;
+        while (x > px && y > py) {
+            --x, --y;
+            pairs.emplace_back(x, y);
+        }
+        x = px, y = py;
+    }
+    while (x > 0 && y > 0) {
+        --x, --y;
+        pairs.emplace_back(x, y);
+    }
+    std::reverse(pairs.begin(), pairs.end());
+    return pairs;
+}
+
+}
diff --git a/runtime/src/gs/native/interpolate.hpp b/runtime/src/gs/native/interpolate.hpp
new file mode 100644
index 0000000..fd8ca4c
--- /dev/null
+++ b/runtime/src/gs/native/interpolate.hpp
@@ -0,0 +1,44 @@
+#pragma once
+
+#include "convert.hpp"
+
+#include <cstdint>
+#include <utility>
+#include <vector>
+
+// Frame interpolation (in-between pictures at the display's refresh rate while the game runs at 60 fps):
+// which draw, and which primitive in it, of a frame is which of the frame before, so a picture between them
+// can move each vertex part of the way from where it was to where it is.
+//
+// Draws pair in order when their state and target agree; a draw's primitive count can change between frames
+// (faces turning away are culled), so its primitives pair again, in order, by their texture coordinates (or
+// colours, untextured), which don't change as things move. Pairing is the cheapest in-order alignment, each
+// pair costing how far it moved and each primitive left out a fixed amount, so repeated primitives (tiles with
+// the same texture coordinates) pair with themselves rather than slip to a neighbour.
+namespace ps2::gs::native {
+
+struct Draw {
+    std::uint64_t what;          // state and target: what must agree for two draws to be the same
+    std::uint32_t first, count;  // its vertices
+    std::uint8_t per = 3;        // vertices per primitive (3 triangles, 2 lines, 1 points)
+    bool textured = true;        // primitives told apart by texture coordinates, else by colour
+};
+
+// For each draw of now, the index of the same draw in before, or -1 (new, or moved further than limit PS2
+// pixels: a cut).
+std::vector<int> match(const std::vector<Draw> &before, const std::vector<GpuVertex> &before_verts, const std::vector<Draw> &now,
+                       const std::vector<GpuVertex> &now_verts, float limit);
+
+// Where each vertex of now was in before (x, y, z, one after the other): a paired primitive's vertices from
+// before, else where it is now. paired (if given): how many of now's vertices were paired.
+std::vector<float> previous(const std::vector<Draw> &before, const std::vector<GpuVertex> &before_verts, const std::vector<Draw> &now,
+                            const std::vector<GpuVertex> &now_verts, const std::vector<int> &matched, float limit, std::size_t *paired = nullptr);
+
+// The longest in-order pairing of equal keys of a and b (indices into each, increasing), found with at most
+// max_edits keys left out of either side; nothing when it would take more (Myers' difference).
+std::vector<std::pair<std::uint32_t, std::uint32_t>> align_equal(const std::vector<std::uint64_t> &a, const std::vector<std::uint64_t> &b, std::size_t max_edits);
+
+// now's vertices moved t of the way from where they were (0) to where they are (1).
+std::vector<GpuVertex> blend(const std::vector<float> &before, const std::vector<GpuVertex> &now, float t);
+
+}
diff --git a/runtime/src/gs/native/native.wgsl b/runtime/src/gs/native/native.wgsl
new file mode 100644
index 0000000..4c1d951
--- /dev/null
+++ b/runtime/src/gs/native/native.wgsl
@@ -0,0 +1,254 @@
+// The native renderer (renderer.cpp): GS primitives drawn as ordinary GPU draws into RGBA16Float targets
+// whose colour is stored as the GS's bytes / 255 and alpha as the GS's alpha / 128 (so 0x80 is 1.0, as the
+// GS counts it, and blending by source or destination alpha works with the GPU's own blend factors).
+// Each pipeline is specialised by override constants from its draw key.
+
+override ATST: u32 = 1u;   // alpha test: 0 never, 1 always, 2 <, 3 <=, 4 ==, 5 >=, 6 >, 7 !=
+override AREF: u32 = 0u;
+override AFAILED: bool = false;  // the second draw of a test with a fail mode: only the pixels that fail
+override TEXTURED: bool = false;
+override STQ: bool = false;      // s, t are normalised and divided by q (else texels)
+override TFX: u32 = 0u;          // modulate, decal, highlight, highlight2
+override TCC: bool = false;      // the texture's alpha counts
+override FOG: bool = false;
+override WRAP_S: u32 = 0u;       // CLAMP: repeat, clamp, region clamp, region repeat
+override WRAP_T: u32 = 0u;
+override LINEAR: bool = false;   // bilinear (TEX1 MMAG), else nearest
+override FBA: bool = false;
+override SX: f32 = 1.0;          // PS2 pixels to target pixels, across and down (renderer.cpp's output_scale)
+override SY: f32 = 1.0;      // alpha correction: the stored alpha gets its top bit
+
+struct VertexIn {
+    @location(0) pos: vec3<f32>,     // NDC x, y, and depth 0..1
+    @location(1) stq: vec3<f32>,
+    @location(2) colour: vec4<f32>,  // GS bytes / 255
+    @location(3) fog: f32,
+};
+
+struct VertexOut {
+    @builtin(position) pos: vec4<f32>,
+    @location(0) colour: vec4<f32>,
+    @location(1) stq: vec3<f32>,
+    @location(2) fog: f32,
+};
+
+// What changes between draws without changing the pipeline: FOGCOL (bytes) and CLAMP's region.
+struct Params {
+    fogcol: vec4<f32>,
+    region: vec4<u32>,  // MINU, MAXU, MINV, MAXV
+    source: vec4<u32>,  // what tex is (0 a decoded texture, 1 a 32-bit target, 2 one read as 24-bit, 3 a 16-bit one; +0x10/0x20 a shadow buffer's counted/uncounted pixels), scale, TW, TH
+    origin: vec4<u32>,  // in a target: where the texture starts (PS2 pixels); TEXA's TA0 (AEM in bit 8), TA1
+};
+@group(0) @binding(0) var tex: texture_2d<f32>;
+@group(1) @binding(0) var<uniform> params: Params;
+
+@vertex
+fn vs(v: VertexIn) -> VertexOut {
+    var o: VertexOut;
+    o.pos = vec4<f32>(v.pos.xy, v.pos.z, 1.0);
+    o.colour = v.colour;
+    o.stq = v.stq;
+    o.fog = v.fog;
+    return o;
+}
+
+fn alpha_passes(a: u32) -> bool {
+    switch ATST {
+        case 0u: { return false; }
+        case 2u: { return a < AREF; }
+        case 3u: { return a <= AREF; }
+        case 4u: { return a == AREF; }
+        case 5u: { return a >= AREF; }
+        case 6u: { return a > AREF; }
+        case 7u: { return a != AREF; }
+        default: { return true; }
+    }
+}
+
+// A texel coordinate through CLAMP's mode for its axis, as the GS addresses: size is TW or TH.
+fn wrap(c: i32, mode: u32, size: i32, lo: u32, hi: u32) -> i32 {
+    switch mode {
+        case 1u: { return clamp(c, 0, size - 1); }
+        case 2u: { return clamp(c, i32(lo), i32(hi)); }
+        case 3u: { return (c & i32(lo)) | i32(hi); }
+        default: { return c & (size - 1); }
+    }
+}
+
+fn texel(x: i32, y: i32) -> vec4<f32> {
+    let size = vec2<i32>(textureDimensions(tex));
+    let p = vec2<i32>(wrap(x, WRAP_S, size.x, params.region.x, params.region.y), wrap(y, WRAP_T, size.y, params.region.z, params.region.w));
+    return textureLoad(tex, clamp(p, vec2<i32>(0), size - 1), 0) * 255.0;
+}
+
+// A pixel of a target read as a texture (p in the target's own pixels, at the internal resolution), in GS
+// bytes as its format holds them.
+fn target_texel(p: vec2<i32>) -> vec4<f32> {
+    let c = textureLoad(tex, clamp(p, vec2<i32>(0), vec2<i32>(textureDimensions(tex)) - 1), 0);
+    var t = vec4<f32>(round(clamp(c.rgb, vec3<f32>(0.0), vec3<f32>(1.0)) * 255.0), round(clamp(c.a, 0.0, 2.0) * 128.0));
+    // A shadow buffer, whose count is in the stencil (renderer.cpp's Stencil): this draw covers the pixels
+    // where it is not 0 (one step of red) or where it is (0).
+    if ((params.source.x & 0x30u) != 0u) {
+        t = select(vec4<f32>(0.0), vec4<f32>(8.0, 0.0, 0.0, 0.0), (params.source.x & 0x10u) != 0u);
+    }
+    // As the GS expands 24- and 16-bit colours: alpha from TEXA (TA0, or TA1 for a 16-bit colour's A bit), and
+    // with AEM, black without that bit is transparent.
+    let ta0 = f32(params.origin.z & 0xFFu);
+    let aem = (params.origin.z & 0x100u) != 0u;
+    let format = params.source.x & 0xFu;
+    if (format == 2u) {
+        t.a = select(ta0, 0.0, aem && all(t.rgb == vec3<f32>(0.0)));
+    } else if (format == 3u) {
+        let rgb = floor(t.rgb / 8.0) * 8.0;
+        let bit = t.a >= 128.0;
+        t = vec4<f32>(rgb, select(select(ta0, 0.0, aem && all(rgb == vec3<f32>(0.0))), f32(params.origin.w), bit));
+    }
+    return t;
+}
+
+// The texture's colour at this pixel, in GS bytes.
+fn sample(stq: vec3<f32>) -> vec4<f32> {
+    var uv = stq.xy;
+    if (STQ) {
+        uv = stq.xy / stq.z * vec2<f32>(params.source.zw);
+    }
+    // UV (2D) coordinates step exactly across a sprite; GPU interpolation lands a hair either side of a
+    // whole texel, which nearest sampling turns into a texel off: nudge them up by far less than the GS's
+    // 1/16 texel precision.
+    if (!STQ && !LINEAR) {
+        uv = uv + 1.0 / 2048.0;
+    }
+    if (params.source.x != 0u) {
+        // A target: read at the internal resolution, inside the texture's TW x TH.
+        let scale = vec2<f32>(SX, SY);
+        let o = vec2<f32>(params.origin.xy) * scale;
+        let q = clamp(o + uv * scale, o, o + vec2<f32>(params.source.zw) * scale - 0.001);
+        if (!LINEAR) {
+            return target_texel(vec2<i32>(floor(q)));
+        }
+        let f = q - 0.5;
+        let p = vec2<i32>(floor(f));
+        let w = f - floor(f);
+        let top = mix(target_texel(p), target_texel(p + vec2<i32>(1, 0)), w.x);
+        let bottom = mix(target_texel(p + vec2<i32>(0, 1)), target_texel(p + vec2<i32>(1, 1)), w.x);
+        return floor(mix(top, bottom, w.y) + 0.5);  // rounded, as the GS emulation filters
+    }
+    if (!LINEAR) {
+        let p = vec2<i32>(floor(uv));
+        return texel(p.x, p.y);
+    }
+    let f = uv - 0.5;
+    let p = vec2<i32>(floor(f));
+    let w = f - floor(f);
+    let top = mix(texel(p.x, p.y), texel(p.x + 1, p.y), w.x);
+    let bottom = mix(texel(p.x, p.y + 1), texel(p.x + 1, p.y + 1), w.x);
+    return floor(mix(top, bottom, w.y) + 0.5);  // rounded, as the GS emulation filters
+}
+
+// The pixel's colour as the target stores it (colour / 255, alpha / 128), or discarded by the alpha test.
+fn colour_of(i: VertexOut) -> vec4<f32> {
+    // Interpolated colours and fog are truncated, as the GS emulation does (a hair over for the float error at
+    // the vertices themselves).
+    let c = floor(i.colour * 255.0 + 0.001);
+    var rgb = c.rgb;
+    var a = c.a;
+    if (TEXTURED) {
+        let t = sample(i.stq);
+        switch TFX {
+            case 1u: {
+                rgb = t.rgb;
+                if (TCC) { a = t.a; }
+            }
+            case 2u: {
+                rgb = floor(t.rgb * c.rgb / 128.0) + c.a;
+                if (TCC) { a = t.a + c.a; }
+            }
+            case 3u: {
+                rgb = floor(t.rgb * c.rgb / 128.0) + c.a;
+                if (TCC) { a = t.a; }
+            }
+            default: {
+                rgb = floor(t.rgb * c.rgb / 128.0);
+                if (TCC) { a = floor(t.a * c.a / 128.0); }
+            }
+        }
+        rgb = min(rgb, vec3<f32>(255.0));
+        a = min(a, 255.0);
+    }
+    if (FOG) {
+        let f = floor(i.fog * 255.0 + 0.001);
+        rgb = floor((f * rgb + (255.0 - f) * params.fogcol.rgb) / 256.0);
+    }
+    let a_byte = u32(a);
+    if (alpha_passes(a_byte) == AFAILED) {
+        discard;
+    }
+    return vec4<f32>(rgb / 255.0, a / 128.0);
+}
+
+fn with_fba(c: vec4<f32>) -> vec4<f32> {
+    if (FBA) {
+        return vec4<f32>(c.rgb, f32(u32(round(c.a * 128.0)) | 0x80u) / 128.0);
+    }
+    return c;
+}
+
+@fragment
+fn fs(i: VertexOut) -> @location(0) vec4<f32> {
+    return with_fba(colour_of(i));
+}
+
+// The destination alpha test's stencil marks (renderer.cpp's mark_pipeline): a triangle over the whole
+// target; fs_mark keeps the pixels whose alpha (a copy of the target, as tex) has its top bit.
+@vertex
+fn vs_full(@builtin(vertex_index) i: u32) -> @builtin(position) vec4<f32> {
+    let p = vec2<f32>(f32((i << 1u) & 2u), f32(i & 2u));
+    return vec4<f32>(p * 2.0 - 1.0, 0.0, 1.0);
+}
+
+@fragment
+fn fs_unmark() -> @location(0) vec4<f32> {
+    return vec4<f32>(0.0);
+}
+
+@fragment
+fn fs_mark(@builtin(position) pos: vec4<f32>) -> @location(0) vec4<f32> {
+    if (textureLoad(tex, vec2<i32>(pos.xy), 0).a < 0.999) {
+        discard;
+    }
+    return vec4<f32>(0.0);
+}
+
+// The display: the displayed part of a target into the presentation buffer, as packed RGBA8, at the
+// internal resolution (gs.wgsl's display, from a real target). width x height: the picture's size there.
+struct Display {
+    dbx: u32, dby: u32, width: u32, height: u32,
+    halved: u32, base: u32, unused: u32, pad: u32,
+};
+@group(0) @binding(0) var target_tex: texture_2d<f32>;
+@group(0) @binding(1) var<storage, read_write> scratch: array<u32>;
+@group(0) @binding(2) var<uniform> disp: Display;
+
+@compute @workgroup_size(8, 8)
+fn display(@builtin(global_invocation_id) gid: vec3<u32>) {
+    let w = disp.width;
+    let h = disp.height;
+    if (gid.x >= w || gid.y >= h) {
+        return;
+    }
+    // The PS2 position this pixel shows (a field holds every other line), then the target pixel there.
+    var line = (f32(gid.y) + 0.5) / SY;
+    if (disp.halved != 0u) {
+        line = line / 2.0;
+    }
+    let column = (f32(gid.x) + 0.5) / SX;
+    let size = textureDimensions(target_tex);
+    let px = min(u32(floor((f32(disp.dbx) + column) * SX)), size.x - 1u);
+    let py = min(u32(floor((f32(disp.dby) + line) * SY)), size.y - 1u);
+    var c = clamp(textureLoad(target_tex, vec2<u32>(px, py), 0), vec4<f32>(0.0), vec4<f32>(1.0));
+    if (disp.pad != 0u) {
+        c = vec4<f32>(c.a);
+    }
+    let b = vec3<u32>(round(c.rgb * 255.0));
+    scratch[disp.base + gid.y * w + gid.x] = b.x | (b.y << 8u) | (b.z << 16u) | 0xFF000000u;
+}
diff --git a/runtime/src/gs/native/native_dual.wgsl b/runtime/src/gs/native/native_dual.wgsl
new file mode 100644
index 0000000..f1969c4
--- /dev/null
+++ b/runtime/src/gs/native/native_dual.wgsl
@@ -0,0 +1,14 @@
+// Appended to native.wgsl (after "enable dual_source_blending;") when the device has dual-source blending:
+// a draw with FBA that blends by source alpha stores its alpha with the top bit set but blends with the
+// alpha it computed, which needs a second blend source.
+
+struct DualOut {
+    @location(0) @blend_src(0) colour: vec4<f32>,
+    @location(0) @blend_src(1) blend: vec4<f32>,
+};
+
+@fragment
+fn fs_dual(i: VertexOut) -> DualOut {
+    let c = colour_of(i);
+    return DualOut(with_fba(c), c);
+}
diff --git a/runtime/src/gs/native/ranges.cpp b/runtime/src/gs/native/ranges.cpp
new file mode 100644
index 0000000..e82e076
--- /dev/null
+++ b/runtime/src/gs/native/ranges.cpp
@@ -0,0 +1,20 @@
+#include "ranges.hpp"
+
+#include <algorithm>
+
+namespace ps2::gs::native {
+
+void Ranges::add(std::uint32_t id, std::uint32_t first_block, std::uint32_t end_block) { ranges_.push_back({id, first_block, end_block}); }
+
+std::vector<std::uint32_t> Ranges::overlapping(std::uint32_t first, std::uint32_t end) const {
+    std::vector<std::uint32_t> out;
+    for (const Range &r : ranges_)
+        if (r.first < end && first < r.end) out.push_back(r.id);
+    return out;
+}
+
+void Ranges::remove(std::uint32_t id) {
+    ranges_.erase(std::remove_if(ranges_.begin(), ranges_.end(), [id](const Range &r) { return r.id == id; }), ranges_.end());
+}
+
+}
diff --git a/runtime/src/gs/native/ranges.hpp b/runtime/src/gs/native/ranges.hpp
new file mode 100644
index 0000000..fe5a3ef
--- /dev/null
+++ b/runtime/src/gs/native/ranges.hpp
@@ -0,0 +1,23 @@
+#pragma once
+
+#include <cstdint>
+#include <vector>
+
+// Ranges of GS memory, in 256-byte blocks (TBP's unit), by id: which cached textures, or which live render
+// targets, a write to GS memory touches. Ends are exclusive.
+namespace ps2::gs::native {
+
+class Ranges {
+public:
+    void add(std::uint32_t id, std::uint32_t first_block, std::uint32_t end_block);
+    std::vector<std::uint32_t> overlapping(std::uint32_t first, std::uint32_t end) const;
+    void remove(std::uint32_t id);
+
+private:
+    struct Range {
+        std::uint32_t id, first, end;
+    };
+    std::vector<Range> ranges_;
+};
+
+}
diff --git a/runtime/src/gs/native/renderer.cpp b/runtime/src/gs/native/renderer.cpp
new file mode 100644
index 0000000..bed807a
--- /dev/null
+++ b/runtime/src/gs/native/renderer.cpp
@@ -0,0 +1,1804 @@
+#include "renderer.hpp"
+
+#include "convert.hpp"
+#include "interpolate.hpp"
+#include "ranges.hpp"
+#include "texture.hpp"
+#include "../gif.hpp"
+#include "../swizzle.hpp"
+#include "../../vif.hpp"
+
+#include "ps2/graphics.hpp"
+#include "ps2/system.hpp"
+
+#include <webgpu/wgpu.h>
+
+#include <algorithm>
+#include <atomic>
+#include <chrono>
+#include <cmath>
+#include <cstdio>
+#include <cstdlib>
+#include <cstring>
+#include <future>
+#include <map>
+#include <unordered_map>
+#include <mutex>
+#include <set>
+#include <string>
+#include <tuple>
+#include <vector>
+
+extern const char kNativeShader[];
+extern const char kNativeDualShader[];
+
+namespace ps2::gs::native {
+
+namespace {
+
+constexpr std::uint32_t kTargetHeight = 512;  // PS2 pixels: every target is this tall (the GS has no height)
+
+struct Texture {
+    WGPUTexture texture = nullptr;
+    WGPUTextureView view = nullptr;
+    std::uint32_t width = 0, height = 0;
+    WGPUBindGroup group = nullptr;  // as a draw's texture (colour targets)
+};
+
+// A colour target the game has drawn into since the last upload over its memory: a draw whose texture lies
+// in it reads the target itself (render to texture).
+struct Live {
+    std::uint32_t fbp, fbw, psm, rows;  // rows: as far down as a draw's scissor has reached
+    std::uint64_t order;                // the latest drawn into wins where targets overlap
+    std::uint32_t stencil_zbp = ~0u;    // a shadow buffer: the depth buffer whose stencil holds its count
+};
+
+// What a batch does with the stencil (the shadow volumes, design Task 9): the game counts shadow volume faces
+// in a 16-bit buffer's red channel, wrapping; natively that count is the stencil of the depth buffer the
+// volumes are tested against. Draws into a 16-bit target clear it where they write; the volumes step it;
+// a draw reading the shadow buffer becomes two, where the count is not 0 (mod 32) and where it is.
+// Bit 7 is the destination alpha test's (kDate0/kDate1: draw where the target's alpha has its top bit
+// clear/set), copied from the target's alpha just before such a batch.
+enum Stencil : std::uint8_t { kKeep, kClear, kUp, kDown, kCounted, kUncounted, kDate0, kDate1 };
+
+// native.wgsl's Params: what changes between draws without changing the pipeline (256 bytes apart).
+struct Params {
+    float fogcol[4];
+    std::uint32_t region[4];  // CLAMP's MINU, MAXU, MINV, MAXV
+    std::uint32_t source[4];  // what the texture is (0 decoded, 1 a 32-bit target, 2 read as 24-bit, 3 a 16-bit target), scale, TW, TH
+    std::uint32_t origin[4];  // a target's: where the texture starts in it (PS2 pixels), TEXA's TA0 (AEM in bit 8) and TA1
+    bool operator==(const Params &) const = default;
+};
+constexpr std::uint64_t kParamsStride = 256;
+
+struct Batch {
+    DrawKey key;
+    Target target;
+    std::uint32_t sx0, sy0, sx1, sy1;  // scissor, PS2 pixels, inclusive
+    std::uint32_t texture;             // the cached texture's id, 0 when untextured or a target
+    std::uint32_t read_fbp, read_fbw;  // the target it reads, when params.source[0] is not 0
+    Params params;
+    std::uint32_t first, count;
+    Stencil stencil;
+};
+
+// A texture decoded from GS memory with its palette, on the GPU.
+struct Cached {
+    TexKey key;
+    std::uint32_t id;
+    WGPUTexture texture;
+    WGPUTextureView view;
+    std::uint64_t used;  // frame last drawn with
+    WGPUBindGroup group = nullptr;
+};
+
+// An image transfer into GS memory, pixel by pixel as the data comes.
+struct Upload {
+    bool active = false;
+    std::uint32_t dbp = 0, dbw = 0, dpsm = 0, dsax = 0, dsay = 0, rrw = 0, rrh = 0, x = 0, y = 0;
+    std::uint32_t carry = 0, carried = 0;
+    std::uint32_t first = 0, end = 0;  // the blocks it can touch
+    bool drawn = false;                // a draw came while it was under way
+};
+
+struct Pipeline {
+    DrawKey key;
+    bool failed;  // the draw of the pixels that fail the alpha test
+    Stencil stencil;
+    WGPURenderPipeline pipeline;
+};
+
+std::mutex g_mutex;
+bool g_ready = false;
+WGPUDevice g_device = nullptr;
+WGPUQueue g_queue = nullptr;
+// PS2 pixels to target pixels, across and down: a whole multiple, or a direct resolution's exact fraction.
+float g_sx = 1.0f, g_sy = 1.0f;
+
+// A PS2 position (or size) in target pixels: the first target pixel at or past it (exact for whole multiples).
+std::uint32_t scaled(std::uint32_t v, float s) { return static_cast<std::uint32_t>(std::ceil(static_cast<float>(v) * s - 0.001f)); }
+WGPUShaderModule g_module = nullptr;
+WGPUPipelineLayout g_draw_layout = nullptr;
+WGPUTextureFormat g_depth_format = WGPUTextureFormat_Depth24PlusStencil8;  // 32-bit float with stencil when the GPU has it
+bool g_dual = false;  // dual-source blending: FBA with blending by source alpha
+WGPUBindGroupLayout g_texture_layout = nullptr, g_params_layout = nullptr;
+WGPUBindGroup g_no_texture = nullptr, g_params_group = nullptr;  // untextured draws' texture; Params by offset
+WGPUBuffer g_params = nullptr;
+std::uint64_t g_params_bytes = 0;
+WGPUComputePipeline g_display = nullptr;
+WGPUBindGroupLayout g_display_layout = nullptr;
+WGPUBuffer g_display_params = nullptr;
+WGPUBuffer g_vertices = nullptr;
+std::uint64_t g_vertex_bytes = 0;
+std::map<std::pair<std::uint32_t, std::uint32_t>, Texture> g_colour, g_depth;  // (fbp or zbp, fbw)
+std::vector<Pipeline> g_pipelines;
+std::unordered_map<std::uint64_t, std::size_t> g_pipeline_index;  // by pipeline_hash: where in g_pipelines
+std::vector<GpuVertex> g_verts;
+std::map<std::pair<std::uint32_t, std::uint32_t>, Target> g_last_target;  // by (fbp, fbw): the last draw into it
+std::vector<Batch> g_batches;
+// A primitive with vertices VU1 kicked, as drawn (frame interpolation): its GPU vertices, and what converting
+// them again from other values of the same vertices takes.
+struct Prim {
+    std::uint32_t first;  // its GPU vertices: first in the frame's (g_verts while pending)
+    std::uint16_t added;  // and how many
+    std::uint8_t count;   // GS vertices
+    std::uint64_t attributes, xyoffset, zbuf;
+    Vertex v[3];
+    Origin origin[3];
+};
+std::vector<Prim> g_prims;
+// kick_size: by kick & (kKickSizes - 1), the kick << 16 | its vertex count (read by the pairing's thread).
+constexpr std::size_t kKickSizes = 1u << 17;
+std::atomic<std::uint64_t> g_kick_sizes[kKickSizes];
+// A kick's vertex count, or -1 when not known (any more).
+int size_of_kick(std::uint32_t kick) {
+    const std::uint64_t e = g_kick_sizes[kick & (kKickSizes - 1)].load(std::memory_order_relaxed);
+    return (e >> 16) == kick ? static_cast<int>(e & 0xFFFFu) : -1;
+}
+std::vector<Live> g_live;
+std::uint64_t g_live_order = 0;
+Texture g_copy;  // a target as it was before a batch that reads the target it draws into
+
+// Frame interpolation (interpolate.hpp): while it is on, each game frame's batches are recorded as they are
+// flushed, and every target the frame draws into or reads is copied (a snapshot) just before its first use in
+// the frame. An in-between picture replays the last whole frame from those snapshots into replay targets,
+// with each vertex moved part of the way from where it was in the frame before. Three of each, by frame: one
+// being recorded and the last two whole ones (pictures run a little behind the game, so the one before the
+// newest is still being shown when the newest comes).
+struct Record {
+    std::vector<Batch> batches;
+    std::vector<GpuVertex> verts;  // PS2 pixels, as drawn
+    std::vector<Draw> draws;       // the batches, for matching (at the frame's end)
+    std::vector<float> before;     // x, y, z per vertex in the frame before (its own where nothing matched)
+    std::vector<std::pair<std::uint32_t, std::uint32_t>> colours, depths;  // snapshotted, (fbp or zbp, fbw)
+    std::vector<Prim> prims;     // the primitives drawn from VU1's kicks (Prim)
+    std::uint32_t first_kick = 0, last_kick = 0;  // and the kicks they came from
+    bool whole = true;  // nothing a replay can't redo happened (a save state load)
+    std::uint64_t id = 0;        // which whole frame (1, 2, ...); 0 while being recorded
+    std::future<void> pairing;   // working out before, on another thread
+};
+bool g_recording = false;
+constexpr std::uint32_t kSlots = 3;
+Record g_records[kSlots];
+std::uint32_t g_filling = 0;   // the record being filled
+std::uint64_t g_recorded = 0;  // whole frames recorded since recording started (the newest's id)
+std::map<std::pair<std::uint32_t, std::uint32_t>, Texture> g_snap_colour[kSlots], g_snap_depth[kSlots], g_replay_colour, g_replay_depth;
+bool g_show_replay = false;  // display() shows the replay's targets
+bool g_frames_from_present = false;  // frame_shown() ends frames (the window's present); else display() does
+constexpr float kJump = 64.0f;  // PS2 pixels: a draw's vertex moving further in one frame is a cut, not motion
+std::set<std::string> g_reported;
+std::vector<std::uint8_t> g_mem(kMemorySize);  // the GS memory as uploads write it (textures, palettes)
+std::uint32_t g_palette[256] = {};            // the GS's palette buffer, as the last loads left it
+Upload g_upload;
+std::vector<Cached> g_cache;
+std::uint32_t g_next_texture = 1;
+double g_decode_ms = 0, g_decode_ms_max = 0;
+std::uint64_t g_decodes_new = 0, g_decodes_palette = 0, g_decoded_texels = 0;  // PS2_NATIVE_TIME: why textures were decoded
+std::uint32_t g_frames_timed = 0;
+
+void unsupported(const std::string &what) {
+    if (g_reported.insert(what).second) std::fprintf(stderr, "[native] unsupported %s\n", what.c_str());
+}
+
+WGPUStringView view(const char *s) { return WGPUStringView{s, WGPU_STRLEN}; }
+
+std::uint32_t bits(std::uint64_t v, int lo, int n) { return static_cast<std::uint32_t>((v >> lo) & ((1ull << n) - 1)); }
+
+void init() {
+    if (g_ready) return;
+    g_device = gpu::device();
+    g_queue = gpu::queue();
+    output_scale(g_sx, g_sy);
+    WGPUShaderSourceWGSL source = WGPU_SHADER_SOURCE_WGSL_INIT;
+    g_dual = wgpuDeviceHasFeature(g_device, WGPUFeatureName_DualSourceBlending);
+    if (wgpuDeviceHasFeature(g_device, WGPUFeatureName_Depth32FloatStencil8)) g_depth_format = WGPUTextureFormat_Depth32FloatStencil8;
+    const std::string code = g_dual ? std::string("enable dual_source_blending;\n") + kNativeShader + kNativeDualShader : std::string(kNativeShader);
+    source.code = view(code.c_str());
+    WGPUShaderModuleDescriptor md = WGPU_SHADER_MODULE_DESCRIPTOR_INIT;
+    md.nextInChain = &source.chain;
+    g_module = wgpuDeviceCreateShaderModule(g_device, &md);
+    // Draws: the texture (group 0) and their Params (group 1, by dynamic offset).
+    WGPUBindGroupLayoutEntry te = WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT;
+    te.binding = 0;
+    te.visibility = WGPUShaderStage_Fragment;
+    te.texture.sampleType = WGPUTextureSampleType_Float;
+    te.texture.viewDimension = WGPUTextureViewDimension_2D;
+    WGPUBindGroupLayoutDescriptor tld = WGPU_BIND_GROUP_LAYOUT_DESCRIPTOR_INIT;
+    tld.entryCount = 1;
+    tld.entries = &te;
+    g_texture_layout = wgpuDeviceCreateBindGroupLayout(g_device, &tld);
+    WGPUBindGroupLayoutEntry pe = WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT;
+    pe.binding = 0;
+    pe.visibility = WGPUShaderStage_Fragment;
+    pe.buffer.type = WGPUBufferBindingType_Uniform;
+    pe.buffer.hasDynamicOffset = true;
+    pe.buffer.minBindingSize = sizeof(Params);
+    tld.entries = &pe;
+    g_params_layout = wgpuDeviceCreateBindGroupLayout(g_device, &tld);
+    const WGPUBindGroupLayout draw_groups[2] = {g_texture_layout, g_params_layout};
+    WGPUPipelineLayoutDescriptor pld = WGPU_PIPELINE_LAYOUT_DESCRIPTOR_INIT;
+    pld.bindGroupLayoutCount = 2;
+    pld.bindGroupLayouts = draw_groups;
+    g_draw_layout = wgpuDeviceCreatePipelineLayout(g_device, &pld);
+    {
+        WGPUTextureDescriptor td = WGPU_TEXTURE_DESCRIPTOR_INIT;
+        td.size = {1, 1, 1};
+        td.format = WGPUTextureFormat_RGBA8Unorm;
+        td.usage = WGPUTextureUsage_TextureBinding;
+        WGPUTexture none = wgpuDeviceCreateTexture(g_device, &td);
+        WGPUBindGroupEntry be = WGPU_BIND_GROUP_ENTRY_INIT;
+        be.binding = 0;
+        be.textureView = wgpuTextureCreateView(none, nullptr);
+        WGPUBindGroupDescriptor bgd = WGPU_BIND_GROUP_DESCRIPTOR_INIT;
+        bgd.layout = g_texture_layout;
+        bgd.entryCount = 1;
+        bgd.entries = &be;
+        g_no_texture = wgpuDeviceCreateBindGroup(g_device, &bgd);
+    }
+    // The display pass: a target's texture, the presentation buffer, its parameters.
+    WGPUBindGroupLayoutEntry e[3] = {WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT, WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT, WGPU_BIND_GROUP_LAYOUT_ENTRY_INIT};
+    e[0].binding = 0;
+    e[0].visibility = WGPUShaderStage_Compute;
+    e[0].texture.sampleType = WGPUTextureSampleType_UnfilterableFloat;
+    e[0].texture.viewDimension = WGPUTextureViewDimension_2D;
+    e[1].binding = 1;
+    e[1].visibility = WGPUShaderStage_Compute;
+    e[1].buffer.type = WGPUBufferBindingType_Storage;
+    e[2].binding = 2;
+    e[2].visibility = WGPUShaderStage_Compute;
+    e[2].buffer.type = WGPUBufferBindingType_Uniform;
+    WGPUBindGroupLayoutDescriptor bld = WGPU_BIND_GROUP_LAYOUT_DESCRIPTOR_INIT;
+    bld.entryCount = 3;
+    bld.entries = e;
+    g_display_layout = wgpuDeviceCreateBindGroupLayout(g_device, &bld);
+    WGPUPipelineLayoutDescriptor dl = WGPU_PIPELINE_LAYOUT_DESCRIPTOR_INIT;
+    dl.bindGroupLayoutCount = 1;
+    dl.bindGroupLayouts = &g_display_layout;
+    WGPUPipelineLayout display_layout = wgpuDeviceCreatePipelineLayout(g_device, &dl);
+    WGPUComputePipelineDescriptor cd = WGPU_COMPUTE_PIPELINE_DESCRIPTOR_INIT;
+    cd.layout = display_layout;
+    cd.compute.module = g_module;
+    cd.compute.entryPoint = view("display");
+    WGPUConstantEntry display_scale[2] = {WGPU_CONSTANT_ENTRY_INIT, WGPU_CONSTANT_ENTRY_INIT};
+    display_scale[0].key = view("SX");
+    display_scale[0].value = g_sx;
+    display_scale[1].key = view("SY");
+    display_scale[1].value = g_sy;
+    cd.compute.constantCount = 2;
+    cd.compute.constants = display_scale;
+    g_display = wgpuDeviceCreateComputePipeline(g_device, &cd);
+    wgpuPipelineLayoutRelease(display_layout);
+    WGPUBufferDescriptor bd = WGPU_BUFFER_DESCRIPTOR_INIT;
+    bd.size = 32;
+    bd.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+    g_display_params = wgpuDeviceCreateBuffer(g_device, &bd);
+    g_ready = true;
+    std::fprintf(stderr, "[native] renderer on, %.4g x %.4g (512 x 448 drawn at %u x %u)\n", g_sx, g_sy, static_cast<unsigned>(std::lround(512 * g_sx)),
+                 static_cast<unsigned>(std::lround(448 * g_sy)));
+}
+
+WGPUBindGroup texture_group(WGPUTextureView view) {
+    WGPUBindGroupEntry be = WGPU_BIND_GROUP_ENTRY_INIT;
+    be.binding = 0;
+    be.textureView = view;
+    WGPUBindGroupDescriptor bgd = WGPU_BIND_GROUP_DESCRIPTOR_INIT;
+    bgd.layout = g_texture_layout;
+    bgd.entryCount = 1;
+    bgd.entries = &be;
+    return wgpuDeviceCreateBindGroup(g_device, &bgd);
+}
+
+Texture &texture(std::map<std::pair<std::uint32_t, std::uint32_t>, Texture> &all, std::uint32_t at, std::uint32_t fbw, bool depth) {
+    Texture &t = all[{at, fbw}];
+    if (t.texture) return t;
+    t.width = scaled(std::max<std::uint32_t>(fbw, 1) * 64, g_sx);
+    t.height = scaled(kTargetHeight, g_sy);
+    WGPUTextureDescriptor td = WGPU_TEXTURE_DESCRIPTOR_INIT;
+    td.size = {t.width, t.height, 1};
+    td.format = depth ? g_depth_format : WGPUTextureFormat_RGBA16Float;
+    td.usage = WGPUTextureUsage_RenderAttachment | WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopySrc | WGPUTextureUsage_CopyDst;
+    t.texture = wgpuDeviceCreateTexture(g_device, &td);
+    t.view = wgpuTextureCreateView(t.texture, nullptr);
+    if (!depth) t.group = texture_group(t.view);
+    return t;
+}
+
+WGPUBlendFactor factor(std::uint8_t c, bool inverse) {
+    switch (c) {
+    case 0: return inverse ? WGPUBlendFactor_OneMinusSrcAlpha : WGPUBlendFactor_SrcAlpha;
+    case 1: return inverse ? WGPUBlendFactor_OneMinusDstAlpha : WGPUBlendFactor_DstAlpha;
+    default: return inverse ? WGPUBlendFactor_OneMinusConstant : WGPUBlendFactor_Constant;
+    }
+}
+
+// (A-B)*C+D with A, B, D among source, destination and zero, as GPU blending; false when it has no form.
+bool blend_of(const DrawKey &k, WGPUBlendComponent &c) {
+    const std::uint8_t a = k.blend_a, b = k.blend_b, d = k.blend_d;
+    c.operation = WGPUBlendOperation_Add;
+    if (a == b) {  // (0)*C + D
+        c.srcFactor = d == 0 ? WGPUBlendFactor_One : WGPUBlendFactor_Zero;
+        c.dstFactor = d == 1 ? WGPUBlendFactor_One : WGPUBlendFactor_Zero;
+        return true;
+    }
+    if (a == 0 && b == 1 && d == 1) c.srcFactor = factor(k.blend_c, false), c.dstFactor = factor(k.blend_c, true);
+    else if (a == 0 && b == 2 && d == 1) c.srcFactor = factor(k.blend_c, false), c.dstFactor = WGPUBlendFactor_One;
+    else if (a == 0 && b == 2 && d == 2) c.srcFactor = factor(k.blend_c, false), c.dstFactor = WGPUBlendFactor_Zero;
+    else if (a == 0 && b == 1 && d == 2) c.operation = WGPUBlendOperation_Subtract, c.srcFactor = factor(k.blend_c, false), c.dstFactor = factor(k.blend_c, false);
+    else if (a == 1 && b == 0 && d == 0) c.srcFactor = factor(k.blend_c, true), c.dstFactor = factor(k.blend_c, false);
+    else if (a == 2 && b == 0 && d == 1) c.operation = WGPUBlendOperation_ReverseSubtract, c.srcFactor = factor(k.blend_c, false), c.dstFactor = WGPUBlendFactor_One;
+    else if (a == 1 && b == 2 && d == 0) c.srcFactor = WGPUBlendFactor_One, c.dstFactor = factor(k.blend_c, false);
+    else return false;
+    return true;
+}
+
+// The destination alpha test's stencil bit from the target's alpha (a copy of it bound as the texture):
+// cleared everywhere, then set where the alpha's top bit is.
+WGPURenderPipeline g_mark_clear = nullptr, g_mark_set = nullptr;
+
+WGPURenderPipeline mark_pipeline(bool set) {
+    WGPURenderPipeline &p = set ? g_mark_set : g_mark_clear;
+    if (p) return p;
+    WGPUColorTargetState ct = WGPU_COLOR_TARGET_STATE_INIT;
+    ct.format = WGPUTextureFormat_RGBA16Float;
+    ct.writeMask = WGPUColorWriteMask_None;
+    WGPUFragmentState fs = WGPU_FRAGMENT_STATE_INIT;
+    fs.module = g_module;
+    fs.entryPoint = view(set ? "fs_mark" : "fs_unmark");
+    fs.targetCount = 1;
+    fs.targets = &ct;
+    WGPUDepthStencilState ds = WGPU_DEPTH_STENCIL_STATE_INIT;
+    ds.format = g_depth_format;
+    ds.depthWriteEnabled = WGPUOptionalBool_False;
+    ds.depthCompare = WGPUCompareFunction_Always;
+    WGPUStencilFaceState face = WGPU_STENCIL_FACE_STATE_INIT;
+    face.compare = WGPUCompareFunction_Always;
+    face.failOp = face.depthFailOp = WGPUStencilOperation_Keep;
+    face.passOp = set ? WGPUStencilOperation_Replace : WGPUStencilOperation_Zero;
+    ds.stencilFront = ds.stencilBack = face;
+    ds.stencilReadMask = 0x80;
+    ds.stencilWriteMask = 0x80;
+    WGPURenderPipelineDescriptor rd = WGPU_RENDER_PIPELINE_DESCRIPTOR_INIT;
+    rd.layout = g_draw_layout;
+    rd.vertex.module = g_module;
+    rd.vertex.entryPoint = view("vs_full");
+    rd.primitive.topology = WGPUPrimitiveTopology_TriangleList;
+    rd.primitive.cullMode = WGPUCullMode_None;
+    rd.depthStencil = &ds;
+    rd.fragment = &fs;
+    p = wgpuDeviceCreateRenderPipeline(g_device, &rd);
+    return p;
+}
+
+std::uint64_t pipeline_hash(const DrawKey &k, Stencil stencil, bool failed) {
+    std::uint64_t h = 1469598103934665603ull;
+    const auto mix = [&](std::uint64_t v) { h = (h ^ v) * 1099511628211ull; };
+    mix(k.topology | (k.textured << 8) | (k.fog << 9) | (k.gouraud << 10) | (k.stq << 11) | (k.tfx << 12) | (k.tcc << 14) | (k.blend << 16) | (k.blend_a << 17) |
+        (k.blend_b << 19) | (k.blend_c << 21) | (k.blend_d << 23) | (static_cast<std::uint64_t>(k.blend_fix) << 25) | (static_cast<std::uint64_t>(k.alpha_test) << 33) |
+        (static_cast<std::uint64_t>(k.alpha_ref) << 36) | (static_cast<std::uint64_t>(k.alpha_fail) << 44));
+    mix(k.depth_test | (k.depth_write << 1) | (k.depth_func << 2) | (k.colour_wrap << 4) | (k.wrap_s << 5) | (k.wrap_t << 7) | (k.linear_mag << 9) | (k.fba << 10) |
+        (static_cast<std::uint64_t>(stencil) << 11) | (static_cast<std::uint64_t>(failed) << 19));
+    mix(k.colour_mask);
+    return h;
+}
+
+WGPURenderPipeline pipeline(const DrawKey &k, Stencil stencil, bool failed = false) {
+    const std::uint64_t hash = pipeline_hash(k, stencil, failed);
+    if (const auto found = g_pipeline_index.find(hash); found != g_pipeline_index.end()) {
+        const Pipeline &p = g_pipelines[found->second];
+        if (p.key == k && p.failed == failed && p.stencil == stencil) return p.pipeline;
+    }
+    for (std::size_t i = 0; i < g_pipelines.size(); ++i) {
+        const Pipeline &p = g_pipelines[i];
+        if (p.key == k && p.failed == failed && p.stencil == stencil) {
+            g_pipeline_index[hash] = i;
+            return p.pipeline;
+        }
+    }
+    WGPUVertexAttribute attrs[4] = {};
+    attrs[0] = {nullptr, WGPUVertexFormat_Float32x3, 0, 0};
+    attrs[1] = {nullptr, WGPUVertexFormat_Float32x3, 12, 1};
+    attrs[2] = {nullptr, WGPUVertexFormat_Unorm8x4, 24, 2};
+    attrs[3] = {nullptr, WGPUVertexFormat_Float32, 28, 3};
+    WGPUVertexBufferLayout vbl = WGPU_VERTEX_BUFFER_LAYOUT_INIT;
+    vbl.arrayStride = sizeof(GpuVertex);
+    vbl.stepMode = WGPUVertexStepMode_Vertex;
+    vbl.attributeCount = 4;
+    vbl.attributes = attrs;
+    const std::pair<const char *, double> values[] = {
+        {"ATST", k.alpha_test}, {"AREF", k.alpha_ref}, {"AFAILED", failed ? 1.0 : 0.0}, {"TEXTURED", k.textured ? 1.0 : 0.0},
+        {"STQ", k.stq ? 1.0 : 0.0}, {"TFX", k.tfx}, {"TCC", k.tcc ? 1.0 : 0.0}, {"FOG", k.fog ? 1.0 : 0.0},
+        {"WRAP_S", k.wrap_s}, {"WRAP_T", k.wrap_t}, {"LINEAR", k.linear_mag ? 1.0 : 0.0}, {"FBA", k.fba ? 1.0 : 0.0},
+        {"SX", g_sx}, {"SY", g_sy}};
+    constexpr std::size_t kConstants = sizeof values / sizeof values[0];
+    WGPUConstantEntry constants[kConstants];
+    for (std::size_t i = 0; i < kConstants; ++i) {
+        constants[i] = WGPU_CONSTANT_ENTRY_INIT;
+        constants[i].key = view(values[i].first);
+        constants[i].value = values[i].second;
+    }
+    WGPUBlendState blend = WGPU_BLEND_STATE_INIT;
+    if (k.blend && !blend_of(k, blend.color))
+        unsupported("blend " + std::to_string(k.blend_a) + std::to_string(k.blend_b) + std::to_string(k.blend_c) + std::to_string(k.blend_d));
+    blend.alpha.operation = WGPUBlendOperation_Add;  // the GS writes the source alpha as it is
+    blend.alpha.srcFactor = WGPUBlendFactor_One;
+    blend.alpha.dstFactor = WGPUBlendFactor_Zero;
+    // FBA stores alpha with its top bit; blending by source alpha then reads the alpha it computed, the
+    // second blend source.
+    const bool dual = k.fba && k.blend && k.blend_c == 0 && (k.blend_a != k.blend_b);
+    if (dual && !g_dual) unsupported("alpha correction with blending by source alpha (no dual-source blending)");
+    if (dual && g_dual) {
+        const auto second = [](WGPUBlendFactor &f) {
+            if (f == WGPUBlendFactor_SrcAlpha) f = WGPUBlendFactor_Src1Alpha;
+            else if (f == WGPUBlendFactor_OneMinusSrcAlpha) f = WGPUBlendFactor_OneMinusSrc1Alpha;
+        };
+        second(blend.color.srcFactor);
+        second(blend.color.dstFactor);
+    }
+    WGPUColorTargetState ct = WGPU_COLOR_TARGET_STATE_INIT;
+    ct.format = WGPUTextureFormat_RGBA16Float;
+    ct.blend = k.blend ? &blend : nullptr;
+    // The failing pixels write what AFAIL says: 1 the frame buffer only, 2 depth only, 3 RGB only.
+    const std::uint32_t mask = !failed ? k.colour_mask : k.alpha_fail == 2 ? 0xFFFFFFFFu : k.alpha_fail == 3 ? (k.colour_mask | 0xFF000000u) : k.colour_mask;
+    const auto written = [&](int byte) { return ((mask >> (byte * 8)) & 0xFFu) != 0xFFu; };
+    for (int byte = 0; byte < 4; ++byte) {
+        const std::uint32_t m = (k.colour_mask >> (byte * 8)) & 0xFFu;
+        if (m != 0 && m != 0xFF) unsupported("partial channel mask " + std::to_string(m));
+    }
+    ct.writeMask = (written(0) ? WGPUColorWriteMask_Red : 0) | (written(1) ? WGPUColorWriteMask_Green : 0) | (written(2) ? WGPUColorWriteMask_Blue : 0) |
+                   (written(3) ? WGPUColorWriteMask_Alpha : 0);
+    if (stencil == kUp || stencil == kDown) ct.writeMask = WGPUColorWriteMask_None;  // the count is the stencil's
+    // Colours wrap instead of clamping: only a sum can leave 0..255 (a blend between two colours cannot).
+    else if (k.colour_wrap && k.blend && !(k.blend_a == 0 && k.blend_b == 1 && k.blend_d == 1)) unsupported("colour wrap");
+    WGPUFragmentState fs = WGPU_FRAGMENT_STATE_INIT;
+    fs.module = g_module;
+    fs.entryPoint = view(dual && g_dual ? "fs_dual" : "fs");
+    fs.constantCount = kConstants;
+    fs.constants = constants;
+    fs.targetCount = 1;
+    fs.targets = &ct;
+    WGPUDepthStencilState ds = WGPU_DEPTH_STENCIL_STATE_INIT;
+    ds.format = g_depth_format;
+    WGPUStencilFaceState face = WGPU_STENCIL_FACE_STATE_INIT;
+    face.compare = WGPUCompareFunction_Always;
+    face.failOp = face.depthFailOp = face.passOp = WGPUStencilOperation_Keep;
+    ds.stencilReadMask = 0x1F;  // the 16-bit buffer's red channel: 5 bits
+    ds.stencilWriteMask = 0;
+    switch (stencil) {
+    case kClear: face.passOp = WGPUStencilOperation_Zero, ds.stencilWriteMask = 0xFF; break;
+    case kUp: face.passOp = WGPUStencilOperation_IncrementWrap, ds.stencilWriteMask = 0x1F; break;
+    case kDown: face.passOp = WGPUStencilOperation_DecrementWrap, ds.stencilWriteMask = 0x1F; break;
+    case kDate0: case kDate1: face.compare = WGPUCompareFunction_Equal, ds.stencilReadMask = 0x80; break;
+    case kCounted: face.compare = WGPUCompareFunction_NotEqual; break;
+    case kUncounted: face.compare = WGPUCompareFunction_Equal; break;
+    default: break;
+    }
+    ds.stencilFront = ds.stencilBack = face;
+    const bool depth_write = k.depth_write && (!failed || k.alpha_fail == 2);
+    ds.depthWriteEnabled = depth_write ? WGPUOptionalBool_True : WGPUOptionalBool_False;
+    static const WGPUCompareFunction kCompare[4] = {WGPUCompareFunction_Never, WGPUCompareFunction_Always, WGPUCompareFunction_GreaterEqual, WGPUCompareFunction_Greater};
+    ds.depthCompare = k.depth_test ? kCompare[k.depth_func & 3] : WGPUCompareFunction_Always;
+    WGPURenderPipelineDescriptor rd = WGPU_RENDER_PIPELINE_DESCRIPTOR_INIT;
+    rd.layout = g_draw_layout;
+    rd.vertex.module = g_module;
+    rd.vertex.entryPoint = view("vs");
+    rd.vertex.bufferCount = 1;
+    rd.vertex.buffers = &vbl;
+    rd.primitive.topology = k.topology == 0 ? WGPUPrimitiveTopology_PointList : k.topology == 1 ? WGPUPrimitiveTopology_LineList : WGPUPrimitiveTopology_TriangleList;
+    rd.primitive.cullMode = WGPUCullMode_None;
+    rd.depthStencil = &ds;
+    rd.fragment = &fs;
+    WGPURenderPipeline p = wgpuDeviceCreateRenderPipeline(g_device, &rd);
+    g_pipeline_index[hash] = g_pipelines.size();
+    g_pipelines.push_back({k, failed, stencil, p});
+    return p;
+}
+
+std::uint32_t bits_per_pixel(std::uint32_t psm) {
+    switch (psm) {
+    case PSMCT24: case PSMZ24: return 24;
+    case PSMCT16: case PSMCT16S: case PSMZ16: case PSMZ16S: return 16;
+    case PSMT8: case PSMT8H: return 8;
+    case PSMT4: case PSMT4HL: case PSMT4HH: return 4;
+    default: return 32;
+    }
+}
+
+// The blocks a buffer at bp, bw x 64 pixels wide, `rows` tall, can touch: whole pages of its format.
+std::pair<std::uint32_t, std::uint32_t> span(std::uint32_t bp, std::uint32_t bw, std::uint32_t psm, std::uint32_t rows) {
+    std::uint32_t pw = 64, ph = 32;
+    if (psm == PSMCT16 || psm == PSMCT16S || psm == PSMZ16 || psm == PSMZ16S) ph = 64;
+    else if (psm == PSMT8) pw = 128, ph = 64;
+    else if (psm == PSMT4) pw = 128, ph = 128;
+    const std::uint32_t per_row = std::max<std::uint32_t>(1, bw * 64 / pw);
+    // One page more when bp is inside a page (the last row of pages then reaches into the next one).
+    const std::uint32_t pages = per_row * ((rows + ph - 1) / ph) + (bp % 32 ? 1 : 0);
+    return {bp, bp + pages * 32};
+}
+
+void release(Cached &c) {
+    if (c.group) wgpuBindGroupRelease(c.group);
+    wgpuTextureViewRelease(c.view);
+    wgpuTextureDestroy(c.texture);
+    wgpuTextureRelease(c.texture);
+}
+
+void flush();
+
+std::uint64_t hash_words(const std::uint32_t *w, std::size_t n) {
+    std::uint64_t h = 1469598103934665603ull;
+    for (std::size_t i = 0; i < n; ++i) h = (h ^ w[i]) * 1099511628211ull;
+    return h;
+}
+
+// A hash of GS memory blocks [first, end) (wrapping at 4 MB): what a texture's decode depends on.
+std::uint64_t hash_blocks(std::uint32_t first, std::uint32_t end) {
+    std::uint64_t h = 1469598103934665603ull;
+    for (std::uint32_t b = first; b < end; ++b) {
+        const std::uint8_t *p = g_mem.data() + (b % (kMemorySize / 256)) * 256;
+        for (int i = 0; i < 256; i += 8) {
+            std::uint64_t w;
+            std::memcpy(&w, p + i, 8);
+            h = (h ^ w) * 1099511628211ull;
+        }
+    }
+    return h;
+}
+
+// Recent lookups, so a draw seldom hashes: the same TEX0 and palette with no upload into its memory since
+// gives the same texture (Memo), and the same memory the same data hash (DataMemo). An upload drops the
+// entries whose blocks it can touch.
+struct Memo {
+    std::uint64_t tex0 = 0, texa = 0, palette_hash = 0;
+    std::uint32_t first = 0, end = 0, id = 0;
+    std::uint64_t frame = 0;
+};
+struct DataMemo {
+    std::uint32_t tbp = 0, tbw = 0, psm = 0, th = 0, first = 0, end = 0;
+    std::uint64_t hash = 0;
+    bool valid = false;
+};
+Memo g_memo[256];
+DataMemo g_data_memo[128];
+std::uint32_t g_memo_next = 0, g_memo_last = 0, g_data_memo_next = 0;
+
+// The palette's hashes, as texture keys use them: all 256 entries (8-bit textures) and each 16 (4-bit, by CSA).
+std::uint64_t g_palette_hash256 = 0, g_palette_hash16[16] = {};
+
+void rehash_palette() {
+    g_palette_hash256 = hash_words(g_palette, 256);
+    for (std::uint32_t i = 0; i < 16; ++i) g_palette_hash16[i] = hash_words(g_palette + i * 16, 16) ^ i;
+}
+
+// Block ranges [a0, a1) and [b0, b1) meet, in memory that wraps at 4 MB (16384 blocks).
+bool overlaps(std::uint32_t a0, std::uint32_t a1, std::uint32_t b0, std::uint32_t b1) {
+    constexpr std::uint32_t kBlocks = kMemorySize / 256;
+    return (a0 < b1 && b0 < a1) || (a0 < b1 + kBlocks && b0 + kBlocks < a1) || (a0 + kBlocks < b1 && b0 < a1 + kBlocks);
+}
+
+void forget(std::uint32_t first, std::uint32_t end) {
+    for (Memo &m : g_memo)
+        if (m.id && overlaps(m.first, m.end, first, end)) m.id = 0;
+    for (DataMemo &d : g_data_memo)
+        if (d.valid && overlaps(d.first, d.end, first, end)) d.valid = false;
+}
+
+Cached *cached(std::uint32_t id) {
+    for (Cached &c : g_cache)
+        if (c.id == id) return &c;
+    return nullptr;
+}
+
+// The raw values (palette indices, for the palette formats) of recently decoded textures, so a palette change,
+// which the game makes often (fades, flashes), only re-colours: bounded to 64 MB, least recently used out.
+struct Raw {
+    TexKey key;  // palette_hash unused
+    std::vector<std::uint32_t> values;
+    std::uint64_t used;
+};
+std::vector<Raw> g_raw;
+
+const std::vector<std::uint32_t> &raw_for(const TexKey &texture, std::uint64_t tex0) {
+    if (!(texture.psm == PSMT8 || texture.psm == PSMT8H || texture.psm == PSMT4 || texture.psm == PSMT4HL || texture.psm == PSMT4HH)) {
+        static std::vector<std::uint32_t> direct;  // colours: nothing to keep
+        read_raw(g_mem.data(), tex0, direct);
+        g_decoded_texels += direct.size();
+        return direct;
+    }
+    TexKey key = texture;
+    key.palette_hash = 0;
+    for (Raw &r : g_raw)
+        if (r.key == key) {
+            r.used = frame_count();
+            return r.values;
+        }
+    std::size_t bytes = 0;
+    for (const Raw &r : g_raw) bytes += r.values.size() * 4;
+    while (!g_raw.empty() && bytes > (std::size_t{64} << 20)) {
+        auto oldest = std::min_element(g_raw.begin(), g_raw.end(), [](const Raw &a, const Raw &b) { return a.used < b.used; });
+        bytes -= oldest->values.size() * 4;
+        g_raw.erase(oldest);
+    }
+    Raw r{key, {}, frame_count()};
+    read_raw(g_mem.data(), tex0, r.values);
+    g_decoded_texels += r.values.size();
+    g_raw.push_back(std::move(r));
+    return g_raw.back().values;
+}
+
+bool sixteen_bit(std::uint32_t psm) { return psm == PSMCT16 || psm == PSMCT16S; }
+
+// When the texture TEX0 describes lies in a live target: that target (its fbp, fbw) and Params' source and
+// origin for reading it; false when the texture is GS memory.
+bool target_source(std::uint64_t tex0, Params &params, std::uint32_t &fbp, std::uint32_t &fbw) {
+    const std::uint32_t tbp = bits(tex0, 0, 14), tbw = bits(tex0, 14, 6), psm = bits(tex0, 20, 6);
+    const Live *found = nullptr;
+    for (const Live &l : g_live) {
+        const auto [first, end] = span(l.fbp, l.fbw, l.psm, l.rows);
+        if (tbp >= first && tbp < end && tbp >= l.fbp && (!found || l.order > found->order)) found = &l;
+    }
+    if (!found) return false;
+    const bool target16 = sixteen_bit(found->psm), texture16 = sixteen_bit(psm);
+    if (target16 != texture16 || !(psm == PSMCT32 || psm == PSMCT24 || texture16)) {
+        unsupported("a target read in another format");
+        return false;
+    }
+    // Another buffer width changes how pages follow each other, not what is inside one: a texture within one
+    // page reads the same pixels whatever its width.
+    const std::uint32_t tw = 1u << std::min(bits(tex0, 26, 4), 10u), th = 1u << std::min(bits(tex0, 30, 4), 10u);
+    const bool one_page = tw <= 64 && th <= (texture16 ? 64u : 32u);
+    if (tbw != found->fbw && !one_page) {
+        unsupported("a target read with another width: " + std::to_string(found->fbp) + "/" + std::to_string(found->fbw) + " psm " + std::to_string(found->psm) + " as " + std::to_string(tbp) + "/" + std::to_string(tbw) + " psm " + std::to_string(psm));
+        return false;
+    }
+    const std::uint32_t offset = tbp - found->fbp;
+    if (offset % 32) {
+        unsupported("a target read from inside a page");
+        return false;
+    }
+    const std::uint32_t page = offset / 32, per_row = std::max<std::uint32_t>(1, found->fbw);
+    params.source[0] = texture16 ? 3 : psm == PSMCT24 ? 2 : 1;
+    params.origin[0] = (page % per_row) * 64;
+    params.origin[1] = (page / per_row) * (texture16 ? 64 : 32);
+    fbp = found->fbp, fbw = found->fbw;
+    return true;
+}
+
+// The cached texture a textured draw uses, decoded now if it isn't cached yet; its id. Textures are keyed by
+// content (the memory they span and their palette): the game re-uploads its textures every frame.
+std::uint32_t texture_for(const State &s, int ctx) {
+    const std::uint64_t tex0 = s.ctx[ctx].tex0, now = frame_count();
+    static const bool timed = std::getenv("PS2_NATIVE_TIME") != nullptr;  // hashing, lookup and decoding
+    const auto start = timed ? std::chrono::steady_clock::now() : std::chrono::steady_clock::time_point{};
+    const auto stop = [&] {
+        if (timed) g_decode_ms += std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - start).count();
+    };
+    const std::uint32_t psm = bits(tex0, 20, 6), csa = bits(tex0, 56, 5);
+    std::uint64_t palette_hash = s.texa;
+    if (psm == PSMT8 || psm == PSMT8H) palette_hash = g_palette_hash256;
+    else if (psm == PSMT4 || psm == PSMT4HL || psm == PSMT4HH) palette_hash = g_palette_hash16[csa & 15u];
+    const auto hit = [&](Memo &m) {
+        if (!(m.id && m.tex0 == tex0 && m.texa == s.texa && m.palette_hash == palette_hash)) return false;
+        if (m.frame != now) {
+            m.frame = now;
+            if (Cached *c = cached(m.id)) c->used = now;
+        }
+        stop();
+        return true;
+    };
+    if (hit(g_memo[g_memo_last])) return g_memo[g_memo_last].id;
+    for (std::uint32_t i = 0; i < 256; ++i)
+        if (hit(g_memo[i])) {
+            g_memo_last = i;
+            return g_memo[i].id;
+        }
+    TexKey key{bits(tex0, 0, 14), bits(tex0, 14, 6), psm, bits(tex0, 26, 4), bits(tex0, 30, 4), palette_hash, 0};
+    const std::uint32_t tw = 1u << std::min(key.tw, 10u), th = 1u << std::min(key.th, 10u);
+    const auto [first, end] = span(key.tbp, key.tbw, psm, th);
+    DataMemo *data = nullptr;
+    for (DataMemo &d : g_data_memo)
+        if (d.valid && d.tbp == key.tbp && d.tbw == key.tbw && d.psm == psm && d.th == th) data = &d;
+    if (!data) {
+        data = &g_data_memo[g_data_memo_next++ % 128];
+        *data = DataMemo{key.tbp, key.tbw, psm, th, first, end, hash_blocks(first, end), true};
+    }
+    key.data_hash = data->hash;
+    std::uint32_t id = 0;
+    for (Cached &c : g_cache)
+        if (c.key == key) {
+            c.used = now;
+            id = c.id;
+            break;
+        }
+    if (!id) {
+        bool seen = false;
+        for (const Cached &c : g_cache)
+            if (c.key.tbp == key.tbp && c.key.psm == key.psm && c.key.tw == key.tw && c.key.th == key.th) seen = true;
+        (seen ? g_decodes_palette : g_decodes_new) += 1;
+        std::vector<std::uint32_t> rgba;
+        to_rgba(tex0, s.texa, g_palette, raw_for(key, tex0), rgba);
+        // PS2_NATIVE_DUMP=<tbp>[,<dir>]: textures decoded from that block, as PPMs (colour, then alpha x2).
+        if (const char *dump = std::getenv("PS2_NATIVE_DUMP"); dump && std::strtoul(dump, nullptr, 10) == key.tbp) {
+            const char *comma = std::strchr(dump, ',');
+            const std::string name = std::string(comma ? comma + 1 : ".") + "/tex_" + std::to_string(key.tbp) + "_" + std::to_string(g_next_texture) + ".ppm";
+            if (std::FILE *f = std::fopen(name.c_str(), "wb")) {
+                std::fprintf(f, "P6 %u %u 255\n", tw * 2, th);
+                for (std::uint32_t y = 0; y < th; ++y)
+                    for (std::uint32_t x = 0; x < tw * 2; ++x) {
+                        const std::uint32_t c = rgba[y * tw + (x % tw)];
+                        const std::uint8_t a = static_cast<std::uint8_t>(std::min<std::uint32_t>((c >> 24) * 2, 255));
+                        const std::uint8_t px[3] = {x < tw ? static_cast<std::uint8_t>(c) : a, x < tw ? static_cast<std::uint8_t>(c >> 8) : a, x < tw ? static_cast<std::uint8_t>(c >> 16) : a};
+                        std::fwrite(px, 1, 3, f);
+                    }
+                std::fclose(f);
+            }
+        }
+        WGPUTextureDescriptor td = WGPU_TEXTURE_DESCRIPTOR_INIT;
+        td.size = {tw, th, 1};
+        td.format = WGPUTextureFormat_RGBA8Unorm;
+        td.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+        Cached c{key, g_next_texture++, wgpuDeviceCreateTexture(g_device, &td), nullptr, now};
+        c.view = wgpuTextureCreateView(c.texture, nullptr);
+        c.group = texture_group(c.view);
+        WGPUTexelCopyTextureInfo dst = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+        dst.texture = c.texture;
+        WGPUTexelCopyBufferLayout layout = WGPU_TEXEL_COPY_BUFFER_LAYOUT_INIT;
+        layout.bytesPerRow = tw * 4;
+        layout.rowsPerImage = th;
+        const WGPUExtent3D size{tw, th, 1};
+        wgpuQueueWriteTexture(g_queue, &dst, rgba.data(), rgba.size() * 4, &layout, &size);
+        g_cache.push_back(c);
+        id = c.id;
+    }
+    stop();
+    g_memo_last = g_memo_next++ % 256;
+    g_memo[g_memo_last] = Memo{tex0, s.texa, palette_hash, first, end, id, now};
+    return id;
+}
+
+// Once a frame: textures not drawn with for 600 frames go; with PS2_NATIVE_TIME, decoding time and cache size.
+void end_frame() {
+    const std::uint64_t now = frame_count();
+    // A texture still drawn with this frame (pending draws) is never dropped.
+    const auto drop = [](std::size_t i) {
+        for (Memo &m : g_memo)
+            if (m.id == g_cache[i].id) m.id = 0;
+        release(g_cache[i]);
+        g_cache.erase(g_cache.begin() + static_cast<std::ptrdiff_t>(i));
+    };
+    for (std::size_t i = 0; i < g_cache.size();) {
+        if (now - g_cache[i].used > 600) drop(i);
+        else ++i;
+    }
+    while (g_cache.size() > 512) {  // movies: new content every frame
+        std::size_t oldest = 0;
+        for (std::size_t i = 1; i < g_cache.size(); ++i)
+            if (g_cache[i].used < g_cache[oldest].used) oldest = i;
+        if (g_cache[oldest].used + kSlots >= now) break;  // this frame's and the last few (frame interpolation replays them)
+        drop(oldest);
+    }
+    static const bool timed = std::getenv("PS2_NATIVE_TIME") != nullptr;
+    if (!timed) return;
+    g_decode_ms_max = std::max(g_decode_ms_max, g_decode_ms);
+    g_decode_ms = 0;
+    if (++g_frames_timed % 60 == 0) {
+        std::fprintf(stderr, "[native] frame %llu: texture lookups and decoding at most %.2f ms per frame over the last 60, %zu textures cached; decodes: %llu new, %llu with another palette, %llu texels read\n",
+                     static_cast<unsigned long long>(now), g_decode_ms_max, g_cache.size(), static_cast<unsigned long long>(g_decodes_new),
+                     static_cast<unsigned long long>(g_decodes_palette), static_cast<unsigned long long>(g_decoded_texels));
+        g_decodes_new = g_decodes_palette = g_decoded_texels = 0;
+        g_decode_ms_max = 0;
+    }
+}
+
+// The copy a batch reads when it draws into the target it reads, taken now (in the encoder's order).
+void copy_of(WGPUCommandEncoder enc, const Texture &from) {
+    if (g_copy.width != from.width || g_copy.height != from.height) {
+        if (g_copy.texture) {
+            wgpuBindGroupRelease(g_copy.group);
+            wgpuTextureViewRelease(g_copy.view);
+            wgpuTextureDestroy(g_copy.texture);
+            wgpuTextureRelease(g_copy.texture);
+        }
+        WGPUTextureDescriptor td = WGPU_TEXTURE_DESCRIPTOR_INIT;
+        td.size = {from.width, from.height, 1};
+        td.format = WGPUTextureFormat_RGBA16Float;
+        td.usage = WGPUTextureUsage_TextureBinding | WGPUTextureUsage_CopyDst;
+        g_copy.texture = wgpuDeviceCreateTexture(g_device, &td);
+        g_copy.view = wgpuTextureCreateView(g_copy.texture, nullptr);
+        g_copy.width = from.width, g_copy.height = from.height;
+        g_copy.group = texture_group(g_copy.view);
+    }
+    WGPUTexelCopyTextureInfo src = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT, dst = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+    src.texture = from.texture;
+    dst.texture = g_copy.texture;
+    const WGPUExtent3D size{from.width, from.height, 1};
+    wgpuCommandEncoderCopyTextureToTexture(enc, &src, &dst, &size);
+}
+
+// Copies a target whole (colour, or depth with stencil), outside any pass.
+void copy_whole(WGPUCommandEncoder enc, const Texture &from, const Texture &to) {
+    WGPUTexelCopyTextureInfo src = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT, dst = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+    src.texture = from.texture;
+    dst.texture = to.texture;
+    const WGPUExtent3D size{from.width, from.height, 1};
+    wgpuCommandEncoderCopyTextureToTexture(enc, &src, &dst, &size);
+}
+
+// While recording: a target's snapshot, taken before its first use in the frame being recorded.
+void snapshot(WGPUCommandEncoder enc, bool depth, std::uint32_t at, std::uint32_t fbw) {
+    Record &r = g_records[g_filling];
+    auto &taken = depth ? r.depths : r.colours;
+    const std::pair<std::uint32_t, std::uint32_t> key{at, fbw};
+    if (std::find(taken.begin(), taken.end(), key) != taken.end()) return;
+    taken.push_back(key);
+    copy_whole(enc, texture(depth ? g_depth : g_colour, at, fbw, depth), texture(depth ? g_snap_depth[g_filling] : g_snap_colour[g_filling], at, fbw, depth));
+}
+
+// Encodes and submits batches (vertices in PS2 pixels) into the targets, or into the replay's targets with
+// each vertex t of the way from where it was (before: x, y, z per vertex) to where it is.
+void encode(const std::vector<Batch> &batches, const std::vector<GpuVertex> &verts, bool replay, const std::vector<float> *before = nullptr, float t = 1.0f) {
+    auto &colours = replay ? g_replay_colour : g_colour;
+    auto &depths = replay ? g_replay_depth : g_depth;
+    // Positions to the target's clip space; the GS samples at integer positions, the GPU at pixel centres.
+    static std::vector<GpuVertex> out;
+    out.assign(verts.begin(), verts.end());
+    if (before)
+        for (std::size_t i = 0; i < out.size(); ++i) {
+            const float *w = &(*before)[i * 3];
+            out[i].x = w[0] + (out[i].x - w[0]) * t;
+            out[i].y = w[1] + (out[i].y - w[1]) * t;
+            out[i].z = w[2] + (out[i].z - w[2]) * t;
+        }
+    for (std::size_t n = 0; n < batches.size(); ++n) {
+        const Batch &b = batches[n];
+        if (n && batches[n - 1].first == b.first) continue;  // a shadow buffer read's second batch: the same vertices
+        const float w = static_cast<float>(std::max<std::uint32_t>(b.target.fbw, 1) * 64), h = static_cast<float>(kTargetHeight);
+        const float half_x = 0.5f / g_sx, half_y = 0.5f / g_sy;
+        for (std::uint32_t i = b.first; i < b.first + b.count; ++i) {
+            out[i].x = (out[i].x + half_x) / w * 2.0f - 1.0f;
+            out[i].y = 1.0f - (out[i].y + half_y) / h * 2.0f;
+        }
+    }
+    const std::uint64_t bytes = out.size() * sizeof(GpuVertex);
+    if (bytes > g_vertex_bytes) {
+        if (g_vertices) wgpuBufferRelease(g_vertices);
+        g_vertex_bytes = std::max<std::uint64_t>(bytes * 2, 1u << 20);
+        WGPUBufferDescriptor bd = WGPU_BUFFER_DESCRIPTOR_INIT;
+        bd.size = g_vertex_bytes;
+        bd.usage = WGPUBufferUsage_Vertex | WGPUBufferUsage_CopyDst;
+        g_vertices = wgpuDeviceCreateBuffer(g_device, &bd);
+    }
+    wgpuQueueWriteBuffer(g_queue, g_vertices, 0, out.data(), (bytes + 3) & ~3ull);
+    const std::uint64_t params_bytes = batches.size() * kParamsStride;
+    if (params_bytes > g_params_bytes) {
+        if (g_params_group) wgpuBindGroupRelease(g_params_group);
+        if (g_params) wgpuBufferRelease(g_params);
+        g_params_bytes = std::max<std::uint64_t>(params_bytes * 2, 64 * kParamsStride);
+        WGPUBufferDescriptor bd = WGPU_BUFFER_DESCRIPTOR_INIT;
+        bd.size = g_params_bytes;
+        bd.usage = WGPUBufferUsage_Uniform | WGPUBufferUsage_CopyDst;
+        g_params = wgpuDeviceCreateBuffer(g_device, &bd);
+        WGPUBindGroupEntry be = WGPU_BIND_GROUP_ENTRY_INIT;
+        be.binding = 0;
+        be.buffer = g_params;
+        be.size = sizeof(Params);
+        WGPUBindGroupDescriptor bgd = WGPU_BIND_GROUP_DESCRIPTOR_INIT;
+        bgd.layout = g_params_layout;
+        bgd.entryCount = 1;
+        bgd.entries = &be;
+        g_params_group = wgpuDeviceCreateBindGroup(g_device, &bgd);
+    }
+    {
+        std::vector<std::uint8_t> params(params_bytes);
+        for (std::size_t i = 0; i < batches.size(); ++i) std::memcpy(params.data() + i * kParamsStride, &batches[i].params, sizeof(Params));
+        wgpuQueueWriteBuffer(g_queue, g_params, 0, params.data(), params.size());
+    }
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    for (std::size_t i = 0; i < batches.size();) {
+        const Target t = batches[i].target;
+        if (g_recording && !replay) {
+            snapshot(enc, false, t.fbp, t.fbw);
+            snapshot(enc, true, t.zbp, t.fbw);
+            for (std::size_t j = i; j < batches.size() && batches[j].target == t; ++j)
+                if (batches[j].params.source[0]) snapshot(enc, false, batches[j].read_fbp, batches[j].read_fbw);
+        }
+        Texture &colour = texture(colours, t.fbp, t.fbw, false);
+        Texture &depth = texture(depths, t.zbp, t.fbw, true);
+        WGPURenderPassEncoder pass = nullptr;
+        WGPUBindGroup bound = nullptr;
+        // The pass's state as last set, so a batch only sets what changes.
+        struct Set {
+            std::uint32_t x = ~0u, y = 0, w = 0, h = 0, reference = ~0u;
+            std::uint8_t fix = 0;
+            bool fixed = false;
+            WGPURenderPipeline pipeline = nullptr;
+        } set;
+        const auto begin = [&] {
+            WGPURenderPassColorAttachment ca = WGPU_RENDER_PASS_COLOR_ATTACHMENT_INIT;
+            ca.view = colour.view;
+            ca.loadOp = WGPULoadOp_Load;
+            ca.storeOp = WGPUStoreOp_Store;
+            WGPURenderPassDepthStencilAttachment da = WGPU_RENDER_PASS_DEPTH_STENCIL_ATTACHMENT_INIT;
+            da.view = depth.view;
+            da.depthLoadOp = WGPULoadOp_Load;
+            da.depthStoreOp = WGPUStoreOp_Store;
+            da.stencilLoadOp = WGPULoadOp_Load;
+            da.stencilStoreOp = WGPUStoreOp_Store;
+            WGPURenderPassDescriptor rp = WGPU_RENDER_PASS_DESCRIPTOR_INIT;
+            rp.colorAttachmentCount = 1;
+            rp.colorAttachments = &ca;
+            rp.depthStencilAttachment = &da;
+            pass = wgpuCommandEncoderBeginRenderPass(enc, &rp);
+            wgpuRenderPassEncoderSetVertexBuffer(pass, 0, g_vertices, 0, bytes);
+            bound = nullptr;
+            set = Set{};
+        };
+        begin();
+        for (; i < batches.size() && batches[i].target == t; ++i) {
+            const Batch &b = batches[i];
+            WGPUBindGroup group = g_no_texture;
+            if (b.stencil == kDate0 || b.stencil == kDate1) {
+                // The destination alpha test: the target's alpha top bit into stencil bit 7, from a copy.
+                wgpuRenderPassEncoderEnd(pass);
+                wgpuRenderPassEncoderRelease(pass);
+                copy_of(enc, colour);
+                begin();
+                const std::uint32_t offset = static_cast<std::uint32_t>(i * kParamsStride);
+                wgpuRenderPassEncoderSetBindGroup(pass, 0, g_copy.group, 0, nullptr);
+                wgpuRenderPassEncoderSetBindGroup(pass, 1, g_params_group, 1, &offset);
+                wgpuRenderPassEncoderSetScissorRect(pass, 0, 0, colour.width, colour.height);
+                wgpuRenderPassEncoderSetStencilReference(pass, 0x80);
+                wgpuRenderPassEncoderSetPipeline(pass, mark_pipeline(false));
+                wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+                wgpuRenderPassEncoderSetPipeline(pass, mark_pipeline(true));
+                wgpuRenderPassEncoderDraw(pass, 3, 1, 0, 0);
+                bound = nullptr;
+                set = Set{};
+            }
+            if (b.params.source[0] && b.read_fbp == t.fbp && b.read_fbw == t.fbw) {
+                // It reads what it draws into: from a copy of the target as it is now.
+                wgpuRenderPassEncoderEnd(pass);
+                wgpuRenderPassEncoderRelease(pass);
+                copy_of(enc, colour);
+                group = g_copy.group;
+                begin();
+            } else if (b.params.source[0]) {
+                group = texture(colours, b.read_fbp, b.read_fbw, false).group;
+            } else if (b.texture) {
+                if (const Cached *c = cached(b.texture)) group = c->group;
+            }
+            // A target pixel samples the PS2 position (its index) / scale: inside the scissor from ceil(edge * scale).
+            const std::uint32_t x0 = std::min(scaled(b.sx0, g_sx), colour.width), y0 = std::min(scaled(b.sy0, g_sy), colour.height);
+            const std::uint32_t x1 = std::min(scaled(b.sx1 + 1, g_sx), colour.width), y1 = std::min(scaled(b.sy1 + 1, g_sy), colour.height);
+            if (x1 <= x0 || y1 <= y0) continue;
+            if (group != bound) {
+                wgpuRenderPassEncoderSetBindGroup(pass, 0, group, 0, nullptr);
+                bound = group;
+            }
+            const std::uint32_t offset = static_cast<std::uint32_t>(i * kParamsStride);
+            wgpuRenderPassEncoderSetBindGroup(pass, 1, g_params_group, 1, &offset);
+            if (x0 != set.x || y0 != set.y || x1 - x0 != set.w || y1 - y0 != set.h) {
+                wgpuRenderPassEncoderSetScissorRect(pass, x0, y0, x1 - x0, y1 - y0);
+                set.x = x0, set.y = y0, set.w = x1 - x0, set.h = y1 - y0;
+            }
+            if (!set.fixed || set.fix != b.key.blend_fix) {
+                const double fix = b.key.blend_fix / 128.0;
+                const WGPUColor constant{fix, fix, fix, fix};
+                wgpuRenderPassEncoderSetBlendConstant(pass, &constant);
+                set.fix = b.key.blend_fix, set.fixed = true;
+            }
+            static const bool log_roles = std::getenv("PS2_NATIVE_LOG") != nullptr;
+            if (b.stencil != kKeep && log_roles) {
+                const std::string line = "flush role " + std::to_string(b.stencil) + " into " + std::to_string(t.fbp) + " z " + std::to_string(t.zbp) + " mask " + std::to_string(b.key.colour_mask) +
+                                         " count " + std::to_string(b.count) + " scissor " + std::to_string(x0) + "," + std::to_string(y0) + "-" + std::to_string(x1) + "," + std::to_string(y1) +
+                                         " source " + std::to_string(b.params.source[0]) + " dt " + std::to_string(b.key.depth_test) + std::to_string(b.key.depth_func);
+                if (g_reported.insert(line).second) std::fprintf(stderr, "[native] %llu %s%c", static_cast<unsigned long long>(frame_count()), line.c_str(), 10);
+            }
+            const std::uint32_t reference = b.stencil == kDate1 ? 0x80 : 0;
+            if (reference != set.reference) wgpuRenderPassEncoderSetStencilReference(pass, set.reference = reference);
+            const auto use = [&](WGPURenderPipeline p) {
+                if (p != set.pipeline) wgpuRenderPassEncoderSetPipeline(pass, set.pipeline = p);
+            };
+            use(pipeline(b.key, b.stencil));
+            wgpuRenderPassEncoderDraw(pass, b.count, 1, b.first, 0);
+            if (b.key.alpha_test != 1 && b.key.alpha_fail != 0) {  // the failing pixels, as AFAIL says
+                use(pipeline(b.key, b.stencil, true));
+                wgpuRenderPassEncoderDraw(pass, b.count, 1, b.first, 0);
+            }
+        }
+        wgpuRenderPassEncoderEnd(pass);
+        wgpuRenderPassEncoderRelease(pass);
+    }
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+}
+
+// Encodes and submits every batch drawn since the last flush (recording them while interpolation is on).
+void flush() {
+    if (g_batches.empty()) return;
+    if (g_recording) {
+        Record &r = g_records[g_filling];
+        // Nothing ended the frame for far longer than any frame draws (no display: a run without a window):
+        // not a frame to replay.
+        if (r.verts.size() > (1u << 20)) {
+            r.batches.clear();
+            r.verts.clear();
+            r.prims.clear();
+            r.whole = false;
+        }
+        const std::uint32_t base = static_cast<std::uint32_t>(r.verts.size());
+        r.verts.insert(r.verts.end(), g_verts.begin(), g_verts.end());
+        for (Batch b : g_batches) {
+            b.first += base;
+            r.batches.push_back(b);
+        }
+        for (Prim p : g_prims) {
+            p.first += base;
+            for (int i = 0; i < p.count; ++i) {
+                const std::uint32_t k = p.origin[i].kick;
+                if (!k) continue;
+                if (!r.first_kick || k < r.first_kick) r.first_kick = k;
+                r.last_kick = std::max(r.last_kick, k);
+            }
+            r.prims.push_back(p);
+        }
+    }
+    encode(g_batches, g_verts, false);
+    g_verts.clear();
+    g_batches.clear();
+    g_prims.clear();
+}
+
+// What must agree for a batch to be the same draw as one in the frame before (not its vertex count: faces
+// turning away are culled).
+std::uint64_t what_of(const Batch &b) {
+    std::uint64_t h = 1469598103934665603ull;
+    const auto mix = [&](std::uint64_t v) { h = (h ^ v) * 1099511628211ull; };
+    const DrawKey &k = b.key;
+    mix(k.topology | (k.textured << 8) | (k.fog << 9) | (k.gouraud << 10) | (k.stq << 11) | (k.tfx << 12) | (k.tcc << 14) | (k.blend << 16) | (k.blend_a << 17) |
+        (k.blend_b << 19) | (k.blend_c << 21) | (k.blend_d << 23) | (static_cast<std::uint64_t>(k.alpha_test) << 25) | (static_cast<std::uint64_t>(k.depth_test) << 28) |
+        (static_cast<std::uint64_t>(k.depth_write) << 29) | (static_cast<std::uint64_t>(k.depth_func) << 30));
+    mix(k.colour_mask);
+    mix(b.target.fbp | (static_cast<std::uint64_t>(b.target.zbp) << 16) | (static_cast<std::uint64_t>(b.target.fbw) << 32));
+    mix(b.stencil | (static_cast<std::uint64_t>(b.params.source[0]) << 8) | (static_cast<std::uint64_t>(b.read_fbp) << 16));
+    mix(b.params.source[2] | (static_cast<std::uint64_t>(b.params.source[3]) << 16));
+    return h;
+}
+
+// A frame's end while recording: where its vertices were the frame before, and the next record starts.
+// Where now's vertices were in before (another thread; replay waits for it).
+// Where now's primitives from VU1's kicks were in before, exactly: VU1's microprogram calls of the two frames
+// paired by what they are (vif::chunks), a call's kicks with the same kicks of its partner, and a kick's
+// vertices with the same vertices of its partner when the two took as many. Such a vertex in before, converted
+// as now draws it, is where it was. Primitives that don't pair keep what the matching by texture coordinates
+// found; those that moved further than kJump (a cut) don't move. How many of now's vertices it paired.
+std::size_t vu1_vertices(const Record &r) {
+    std::size_t n = 0;
+    for (const Prim &p : r.prims) n += p.added;
+    return n;
+}
+
+std::size_t pair_kicks(Record &now, const Record &before, const std::vector<std::uint32_t> &volume, std::vector<std::uint8_t> &exact) {
+    if (!now.first_kick || !before.first_kick) return 0;
+    std::vector<vif::Chunk> cn, cb;
+    vif::chunks(now.first_kick, now.last_kick, cn);
+    vif::chunks(before.first_kick, before.last_kick, cb);
+    if (cn.empty() || cb.empty()) return 0;
+    std::vector<std::uint64_t> kn(cn.size()), kb(cb.size());
+    for (std::size_t i = 0; i < cn.size(); ++i) kn[i] = cn[i].key;
+    for (std::size_t i = 0; i < cb.size(); ++i) kb[i] = cb[i].key;
+    const auto pairs = align_equal(kb, kn, 512);
+    const std::uint32_t nf = now.first_kick, nl = now.last_kick, bf = before.first_kick, bl = before.last_kick;
+    std::vector<std::uint32_t> partner(nl - nf + 1, 0);
+    std::vector<std::uint64_t> sizes_b, sizes_n;
+    for (const auto &[i, j] : pairs) {
+        const vif::Chunk &b = cb[i], &n = cn[j];
+        if (b.kicks == n.kicks) {
+            for (std::uint32_t t = 0; t < n.kicks; ++t) {
+                const std::uint32_t k = n.kicks_before + 1 + t;
+                if (k >= nf && k <= nl) partner[k - nf] = b.kicks_before + 1 + t;
+            }
+            continue;
+        }
+        // A call that kicked more or fewer packets (clipping adds some): its kicks pair in order by size.
+        sizes_b.resize(b.kicks), sizes_n.resize(n.kicks);
+        for (std::uint32_t t = 0; t < b.kicks; ++t) sizes_b[t] = static_cast<std::uint64_t>(size_of_kick(b.kicks_before + 1 + t));
+        for (std::uint32_t t = 0; t < n.kicks; ++t) sizes_n[t] = static_cast<std::uint64_t>(size_of_kick(n.kicks_before + 1 + t));
+        for (const auto &[tb, tn] : align_equal(sizes_b, sizes_n, 64)) {
+            const std::uint32_t k = n.kicks_before + 1 + tn;
+            if (k >= nf && k <= nl) partner[k - nf] = b.kicks_before + 1 + tb;
+        }
+    }
+    // before's VU1 vertices by kick and place.
+    std::vector<std::uint32_t> base(bl - bf + 2, 0);
+    for (std::uint32_t k = bf; k <= bl; ++k) base[k - bf + 1] = base[k - bf] + static_cast<std::uint32_t>(std::max(size_of_kick(k), 0));
+    std::vector<Vertex> table(base.back());
+    std::vector<std::uint8_t> have(base.back(), 0);
+    for (const Prim &p : before.prims)
+        for (int i = 0; i < p.count; ++i) {
+            const Origin &o = p.origin[i];
+            if (!o.kick || o.kick < bf || o.kick > bl || o.index >= base[o.kick - bf + 1] - base[o.kick - bf]) continue;
+            table[base[o.kick - bf] + o.index] = p.v[i];
+            have[base[o.kick - bf] + o.index] = 1;
+        }
+    std::size_t paired = 0;
+    std::vector<GpuVertex> again;
+    for (const Prim &p : now.prims) {
+        Vertex v[3];
+        bool ok = true;
+        for (int i = 0; i < p.count && ok; ++i) {
+            const Origin &o = p.origin[i];
+            ok = o.kick >= nf && o.kick <= nl;
+            const std::uint32_t k = ok ? partner[o.kick - nf] : 0;
+            ok = ok && k >= bf && k <= bl;
+            const int size = ok ? size_of_kick(o.kick) : -1;
+            ok = ok && size >= 0 && size == size_of_kick(k) && o.index < size && have[base[k - bf] + o.index];
+            if (ok) v[i] = table[base[k - bf] + o.index];
+        }
+        if (!ok) continue;
+        again.clear();
+        convert(p.attributes, p.xyoffset, p.zbuf, v, p.count, again);
+        if (again.size() != p.added) continue;
+        // A cut: moved further than kJump. Not for shadow volumes, whose far ends move far as things turn.
+        bool cut = false;
+        for (std::uint32_t i = 0; i < p.added && !cut && !volume[p.first]; ++i) {
+            const GpuVertex &at = now.verts[p.first + i];
+            cut = std::fabs(again[i].x - at.x) > kJump || std::fabs(again[i].y - at.y) > kJump;
+        }
+        for (std::uint32_t i = 0; i < p.added; ++i) {
+            const GpuVertex &from = cut ? now.verts[p.first + i] : again[i];
+            float *b = &now.before[(p.first + i) * 3];
+            b[0] = from.x, b[1] = from.y, b[2] = from.z;
+            exact[p.first + i] = !cut;
+        }
+        paired += p.added;
+    }
+    return paired;
+}
+
+void pair_with(Record &now, const Record &before, bool partner) {
+    const auto started = std::chrono::steady_clock::now();
+    const std::vector<int> matched = partner ? match(before.draws, before.verts, now.draws, now.verts, kJump) : std::vector<int>(now.draws.size(), -1);
+    std::size_t paired = 0;
+    now.before = previous(before.draws, before.verts, now.draws, now.verts, matched, kJump, &paired);
+    // Shadow volumes (the stencil counts of a depth buffer) move whole or not at all: one moved in part is
+    // no longer closed, and its sides show as streaks. So they move only when every vertex of the volumes
+    // into that depth buffer paired exactly; else they stay as they are now.
+    std::vector<std::uint32_t> volume(now.verts.size(), 0);  // the depth buffer + 1, for a volume's vertices
+    for (const Batch &b : now.batches)
+        if (b.stencil == kUp || b.stencil == kDown)
+            for (std::uint32_t i = b.first; i < b.first + b.count; ++i) volume[i] = b.target.zbp + 1;
+    std::vector<std::uint8_t> paired_exactly(now.verts.size(), 0);
+    const std::size_t exact = partner ? pair_kicks(now, before, volume, paired_exactly) : 0;
+    std::set<std::uint32_t> broken;
+    for (std::size_t i = 0; i < volume.size(); ++i)
+        if (volume[i] && !paired_exactly[i]) broken.insert(volume[i]);
+    for (std::size_t i = 0; i < volume.size(); ++i)
+        if (volume[i] && broken.count(volume[i])) {
+            float *b = &now.before[i * 3];
+            b[0] = now.verts[i].x, b[1] = now.verts[i].y, b[2] = now.verts[i].z;
+        }
+    // PS2_NATIVE_MATCH=1: how much of each frame lines up with the frame before.
+    static const bool report = std::getenv("PS2_NATIVE_MATCH") != nullptr;
+    if (report && partner) {
+        std::size_t draws = 0, moved = 0;
+        const std::size_t verts = paired;
+        for (std::size_t d = 0; d < now.draws.size(); ++d)
+            if (matched[d] >= 0) ++draws;
+        for (std::size_t v = 0; v < now.verts.size(); ++v)
+            if (now.before[v * 3] != now.verts[v].x || now.before[v * 3 + 1] != now.verts[v].y) ++moved;  // paired and moving
+        std::fprintf(stderr, "[native] match %llu: %zu of %zu draws, %zu of %zu vertices; %zu moved; %zu of %zu VU1 vertices paired exactly; %.2f ms\n",
+                     static_cast<unsigned long long>(frame_count()), draws, now.draws.size(), verts, now.verts.size(), moved, exact, vu1_vertices(now),
+                     std::chrono::duration<double, std::milli>(std::chrono::steady_clock::now() - started).count());
+    }
+}
+
+// A frame's end while recording: its draws for matching, its pairing with the frame before started on another
+// thread, and the next record begins in the oldest slot.
+void finish_record() {
+    const std::uint32_t slot = g_filling, prior = (slot + kSlots - 1) % kSlots;
+    Record &now = g_records[slot];
+    Record &before = g_records[prior];
+    now.draws.clear();
+    for (const Batch &b : now.batches)
+        now.draws.push_back({what_of(b), b.first, b.count, static_cast<std::uint8_t>(b.key.topology == 2 ? 3 : b.key.topology == 1 ? 2 : 1), b.key.textured});
+    now.id = ++g_recorded;
+    const bool partner = before.whole && before.id && before.id + 1 == now.id;
+    now.pairing = std::async(std::launch::async, [&now, &before, partner] { pair_with(now, before, partner); });
+    // The oldest record is reused: the pairing reading it (before's, with it) must be done.
+    if (before.pairing.valid()) before.pairing.wait();
+    g_filling = (slot + 1) % kSlots;
+    Record &next = g_records[g_filling];
+    if (next.pairing.valid()) next.pairing.wait();
+    next.id = 0;
+    next.batches.clear();
+    next.verts.clear();
+    next.draws.clear();
+    next.before.clear();
+    next.colours.clear();
+    next.depths.clear();
+    next.prims.clear();
+    next.first_kick = next.last_kick = 0;
+    next.whole = true;
+}
+
+// Recording starts over: every record empty (no pairing still running over them).
+void reset_records() {
+    for (Record &r : g_records)
+        if (r.pairing.valid()) r.pairing.wait();
+    for (Record &r : g_records) r = Record{};
+    g_filling = 0;
+    g_recorded = 0;
+}
+
+// What puts a replayed frame's picture on the shown target: a game that draws its 3D into a target of its own
+// can copy that onto the shown target first thing in the next frame (Lament of Innocence: target 0 into the
+// display buffer, the frame's first draw), so at the frame's end the shown target holds the frame before, and
+// a replay of the frame alone shows nothing of it. That copy (the first draw into the shown target, reading a
+// target nothing in the frame drew into before it) and what the frame draws into the shown target after it,
+// drawn again after the replay, show the replay's own 3D, as the next frame will show the frame's. Empty when
+// the frame draws its picture into the shown target itself.
+std::vector<Batch> shown_again(const Record &r, std::uint32_t fbp, std::uint32_t fbw) {
+    std::vector<Batch> out;
+    const auto into = [&](const Batch &b, std::uint32_t p, std::uint32_t w) { return b.target.fbp == p && b.target.fbw == w; };
+    std::size_t i = 0;
+    while (i < r.batches.size() && !into(r.batches[i], fbp, fbw)) ++i;
+    if (i == r.batches.size()) return out;
+    const Batch &copy = r.batches[i];
+    if (!copy.params.source[0] || (copy.read_fbp == fbp && copy.read_fbw == fbw)) return out;
+    for (std::size_t j = 0; j < i; ++j)
+        if (into(r.batches[j], copy.read_fbp, copy.read_fbw)) return out;
+    for (std::size_t j = i; j < r.batches.size(); ++j)
+        if (into(r.batches[j], fbp, fbw)) out.push_back(r.batches[j]);
+    return out;
+}
+
+// Whole frame id's in-between picture t (0: as the frame before it, 1: as it) into the replay targets.
+bool replay_at(std::uint64_t id, float t, std::uint32_t fbp, std::uint32_t fbw) {
+    if (!g_recording || !id) return false;
+    std::uint32_t slot = 0;
+    while (slot < kSlots && (slot == g_filling || g_records[slot].id != id)) ++slot;
+    if (slot == kSlots) return false;
+    Record &r = g_records[slot];
+    if (r.pairing.valid()) r.pairing.wait();
+    if (!r.whole || r.batches.empty() || std::find(r.colours.begin(), r.colours.end(), std::pair{fbp, fbw}) == r.colours.end()) return false;
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    for (const auto &[at, w] : r.colours) copy_whole(enc, texture(g_snap_colour[slot], at, w, false), texture(g_replay_colour, at, w, false));
+    for (const auto &[at, w] : r.depths) copy_whole(enc, texture(g_snap_depth[slot], at, w, true), texture(g_replay_depth, at, w, true));
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+    encode(r.batches, r.verts, true, &r.before, std::clamp(t, 0.0f, 1.0f));
+    const std::vector<Batch> again = shown_again(r, fbp, fbw);
+    if (!again.empty()) encode(again, r.verts, true, &r.before, std::clamp(t, 0.0f, 1.0f));
+    return true;
+}
+
+// Whole frame id drawn again into the replay targets from VU1's work run again (vif::replay_kicks), each
+// primitive VU1 kicked with the vertices the run kicked in its place; anything else as drawn. With the
+// game's own log that is the frame itself (PS2_ENGINE_REPLAY checks it).
+bool replay_engine(std::uint64_t id, std::uint32_t fbp, std::uint32_t fbw) {
+    if (!g_recording || !id) return false;
+    std::uint32_t slot = 0;
+    while (slot < kSlots && (slot == g_filling || g_records[slot].id != id)) ++slot;
+    if (slot == kSlots) return false;
+    Record &r = g_records[slot];
+    static const bool log = std::getenv("PS2_ENGINE_LOG") != nullptr;
+    const auto fail = [&](const char *why) {
+        if (log) std::fprintf(stderr, "[engine] %llu: not replayed (%s)\n", static_cast<unsigned long long>(frame_count()), why);
+        return false;
+    };
+    if (!r.whole || r.batches.empty()) return fail("not a whole frame");
+    if (!r.first_kick) return fail("nothing from VU1");
+    if (std::find(r.colours.begin(), r.colours.end(), std::pair{fbp, fbw}) == r.colours.end()) return fail("the displayed target not drawn");
+    static std::vector<std::vector<std::uint8_t>> packets;
+    const auto t0 = std::chrono::steady_clock::now();
+    if (!vif::replay_kicks(r.first_kick, r.last_kick, packets)) return fail("VIF1's log doesn't reach");
+    const auto t1 = std::chrono::steady_clock::now();
+    static std::vector<std::vector<gif::PacketVertex>> kicked;
+    kicked.resize(packets.size());
+    gif::PacketRegs regs;
+    for (std::size_t k = 0; k < packets.size(); ++k) {
+        kicked[k].clear();
+        gif::vertices(packets[k].data(), static_cast<std::uint32_t>(packets[k].size() / 16), regs, kicked[k]);
+    }
+    static std::vector<GpuVertex> verts, again;
+    verts = r.verts;
+    std::size_t moved = 0, kept = 0;
+    for (const Prim &p : r.prims) {
+        Vertex v[3] = {p.v[0], p.v[1], p.v[2]};
+        bool found = true;
+        for (int i = 0; i < p.count && found; ++i) {
+            if (!p.origin[i].kick) continue;
+            const std::size_t k = p.origin[i].kick - r.first_kick;
+            if (k >= kicked.size() || p.origin[i].index >= kicked[k].size()) {
+                found = false;
+                break;
+            }
+            const gif::PacketVertex &pv = kicked[k][p.origin[i].index];
+            Vertex &o = v[i];
+            o.x = pv.x, o.y = pv.y, o.z = pv.z;
+            if (pv.known & gif::kKnownFog) o.f = pv.f;
+            if (pv.known & gif::kKnownRgbaq) {
+                o.r = static_cast<std::uint8_t>(pv.rgbaq), o.g = static_cast<std::uint8_t>(pv.rgbaq >> 8);
+                o.b = static_cast<std::uint8_t>(pv.rgbaq >> 16), o.a = static_cast<std::uint8_t>(pv.rgbaq >> 24);
+                const std::uint32_t qbits = static_cast<std::uint32_t>(pv.rgbaq >> 32);
+                std::memcpy(&o.q, &qbits, 4);
+            }
+            if (pv.known & gif::kKnownSt) {
+                const std::uint32_t sbits = static_cast<std::uint32_t>(pv.st), tbits = static_cast<std::uint32_t>(pv.st >> 32);
+                std::memcpy(&o.s, &sbits, 4);
+                std::memcpy(&o.t, &tbits, 4);
+            }
+            if (pv.known & gif::kKnownUv) o.u = static_cast<std::uint32_t>(pv.uv) & 0x3FFFu, o.v = static_cast<std::uint32_t>(pv.uv >> 16) & 0x3FFFu;
+        }
+        again.clear();
+        if (found) convert(p.attributes, p.xyoffset, p.zbuf, v, p.count, again);
+        if (!found || again.size() != p.added) {
+            ++kept;
+            continue;
+        }
+        std::copy(again.begin(), again.end(), verts.begin() + p.first);
+        ++moved;
+    }
+    if (log) {
+        const auto t2 = std::chrono::steady_clock::now();
+        std::size_t differ = 0;
+        for (std::size_t i = 0; i < verts.size(); ++i)
+            if (std::memcmp(&verts[i], &r.verts[i], sizeof(GpuVertex)) != 0) ++differ;
+        std::fprintf(stderr, "[engine] %llu: kicks %u..%u (%zu run), %zu primitives redrawn, %zu kept, %zu of %zu vertices differ; VU1 %.2f ms, vertices %.2f ms\n",
+                     static_cast<unsigned long long>(frame_count()), r.first_kick, r.last_kick, packets.size(), moved, kept, differ, verts.size(),
+                     std::chrono::duration<double, std::milli>(t1 - t0).count(), std::chrono::duration<double, std::milli>(t2 - t1).count());
+    }
+    if (r.pairing.valid()) r.pairing.wait();
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    for (const auto &[at, w] : r.colours) copy_whole(enc, texture(g_snap_colour[slot], at, w, false), texture(g_replay_colour, at, w, false));
+    for (const auto &[at, w] : r.depths) copy_whole(enc, texture(g_snap_depth[slot], at, w, true), texture(g_replay_depth, at, w, true));
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+    encode(r.batches, verts, true);
+    const std::vector<Batch> shown = shown_again(r, fbp, fbw);
+    if (!shown.empty()) encode(shown, verts, true);
+    return true;
+}
+
+// PS2_NATIVE_CHECK=depth: the native depth target against the GS emulation's depth buffer, every display.
+void check_depth(const gpu::DisplaySource &src) {
+    static const char *check = std::getenv("PS2_NATIVE_CHECK");
+    if (!check || std::strcmp(check, "depth") != 0) return;
+    const auto last = g_last_target.find({src.fbp, src.fbw});
+    if (last == g_last_target.end()) return;
+    const std::uint32_t zbp = last->second.zbp, zpsm = last->second.zpsm;
+    std::vector<std::uint8_t> gs(kMemorySize);
+    gpu::download(gs.data());
+    // The native depth, read back.
+    const Texture &d = g_depth[{zbp, src.fbw}];
+    const std::uint32_t row = (d.width * 4 + 255) & ~255u;
+    WGPUBufferDescriptor bd = WGPU_BUFFER_DESCRIPTOR_INIT;
+    bd.size = static_cast<std::uint64_t>(row) * d.height;
+    bd.usage = WGPUBufferUsage_MapRead | WGPUBufferUsage_CopyDst;
+    WGPUBuffer buf = wgpuDeviceCreateBuffer(g_device, &bd);
+    WGPUCommandEncoder enc = wgpuDeviceCreateCommandEncoder(g_device, nullptr);
+    WGPUTexelCopyTextureInfo from = WGPU_TEXEL_COPY_TEXTURE_INFO_INIT;
+    from.texture = d.texture;
+    from.aspect = WGPUTextureAspect_DepthOnly;
+    if (g_depth_format != WGPUTextureFormat_Depth32FloatStencil8) {
+        unsupported("the depth check without 32-bit float depth with stencil");
+        return;
+    }
+    WGPUTexelCopyBufferInfo to = WGPU_TEXEL_COPY_BUFFER_INFO_INIT;
+    to.buffer = buf;
+    to.layout.bytesPerRow = row;
+    to.layout.rowsPerImage = d.height;
+    const WGPUExtent3D size{d.width, d.height, 1};
+    wgpuCommandEncoderCopyTextureToBuffer(enc, &from, &to, &size);
+    WGPUCommandBuffer cmd = wgpuCommandEncoderFinish(enc, nullptr);
+    wgpuQueueSubmit(g_queue, 1, &cmd);
+    wgpuCommandBufferRelease(cmd);
+    wgpuCommandEncoderRelease(enc);
+    bool done = false;
+    WGPUBufferMapCallbackInfo cb = WGPU_BUFFER_MAP_CALLBACK_INFO_INIT;
+    cb.mode = WGPUCallbackMode_AllowProcessEvents;
+    cb.callback = [](WGPUMapAsyncStatus, WGPUStringView, void *flag, void *) { *static_cast<bool *>(flag) = true; };
+    cb.userdata1 = &done;
+    wgpuBufferMapAsync(buf, WGPUMapMode_Read, 0, bd.size, cb);
+    while (!done) wgpuDevicePoll(g_device, true, nullptr);
+    const auto *native = static_cast<const std::uint8_t *>(wgpuBufferGetConstMappedRange(buf, 0, bd.size));
+    std::uint64_t within = 0, total = 0;
+    const double range = zpsm == 0x30 ? 4294967295.0 : zpsm == 0x31 ? 16777215.0 : 65535.0;
+    for (std::uint32_t y = 0; y < src.height; ++y)
+        for (std::uint32_t x = 0; x < src.width; ++x) {
+            float n;
+            std::memcpy(&n, native + static_cast<std::size_t>(scaled(y, g_sy)) * row + static_cast<std::size_t>(scaled(x, g_sx)) * 4, 4);
+            const double e = swizzle::read_pixel(gs.data(), zpsm, zbp, src.fbw, x, y) / range;
+            ++total;
+            if (std::fabs(e - n) <= 1.0 / 4096.0) ++within;
+        }
+    // PS2_NATIVE_CHECK_OUT=<dir>: both depth buffers and where they differ, as images (white: further than 1/4096).
+    if (const char *dir = std::getenv("PS2_NATIVE_CHECK_OUT")) {
+        const std::string base = std::string(dir) + "/depth_" + std::to_string(frame_count());
+        std::FILE *fe = std::fopen((base + "_gs.pgm").c_str(), "wb"), *fn = std::fopen((base + "_native.pgm").c_str(), "wb"),
+                  *fd = std::fopen((base + "_diff.pgm").c_str(), "wb");
+        for (std::FILE *f : {fe, fn, fd})
+            if (f) std::fprintf(f, "P5\n%u %u\n255\n", src.width, src.height);
+        for (std::uint32_t y = 0; y < src.height; ++y)
+            for (std::uint32_t x = 0; x < src.width; ++x) {
+                float n;
+                std::memcpy(&n, native + static_cast<std::size_t>(scaled(y, g_sy)) * row + static_cast<std::size_t>(scaled(x, g_sx)) * 4, 4);
+                const double e = swizzle::read_pixel(gs.data(), zpsm, zbp, src.fbw, x, y) / range;
+                const std::uint8_t pe = static_cast<std::uint8_t>(std::clamp(e, 0.0, 1.0) * 255.0), pn = static_cast<std::uint8_t>(std::clamp<double>(n, 0.0, 1.0) * 255.0);
+                const std::uint8_t pd = std::fabs(e - n) <= 1.0 / 4096.0 ? 0 : 255;
+                if (fe) std::fputc(pe, fe);
+                if (fn) std::fputc(pn, fn);
+                if (fd) std::fputc(pd, fd);
+            }
+        for (std::FILE *f : {fe, fn, fd})
+            if (f) std::fclose(f);
+    }
+    wgpuBufferUnmap(buf);
+    wgpuBufferRelease(buf);
+    std::fprintf(stderr, "[native] depth check frame %llu: %.2f%% within 1/4096 (%llu pixels)\n", static_cast<unsigned long long>(frame_count()),
+                 total ? 100.0 * static_cast<double>(within) / static_cast<double>(total) : 0.0, static_cast<unsigned long long>(total));
+}
